<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wh-Question VIP Investigator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .tab-active {
            background-color: #4f46e5;
            color: #ffffff;
            box-shadow: 0 4px 14px 0 rgba(79, 70, 229, 0.38);
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 pb-12">

    <!-- Header Navigation -->
    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-white/10 p-2.5 rounded-xl border border-white/20">
                    <i class="fa-solid me-1 fa-user-secret text-2xl text-amber-300"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">Wh-Question VIP Investigator</h1>
                    <p class="text-xs text-indigo-200">Interactive English Grammar & Interview Game</p>
                </div>
            </div>

            <!-- Tab Navigation Buttons -->
            <nav class="flex flex-wrap gap-2 bg-indigo-800/60 p-1.5 rounded-xl border border-white/10">
                <button onclick="switchTab('detective')" id="tab-detective" class="tab-btn tab-active px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all">
                    <i class="fa-solid fa-magnifying-glass mr-1.5"></i>Detective Conversations
                </button>
                <button onclick="switchTab('interview')" id="tab-interview" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-indigo-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-id-card mr-1.5"></i>VIP Interview
                </button>
                <button onclick="switchTab('matcher')" id="tab-matcher" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-indigo-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-puzzle-piece mr-1.5"></i>Question Matcher
                </button>
                <button onclick="switchTab('reference')" id="tab-reference" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-indigo-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-book-open mr-1.5"></i>Grammar Focus
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-6xl mx-auto px-4 mt-6">

        <!-- ================= MODE 1: CONVERSATION DETECTIVE ================= -->
        <section id="sec-detective" class="space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-comments text-indigo-600"></i> Complete the Detective Conversations
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Select the correct Wh-question word or phrase to complete each line.</p>
                </div>
                <div class="bg-indigo-50 border border-indigo-100 text-indigo-700 px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-star text-amber-500"></i> Score: <span id="detective-score" class="text-lg font-bold">0</span> / 12
                </div>
            </div>

            <!-- Dialogue Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Conversation 1: Yoo-jin -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm relative">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-sm">1</span>
                            <h3 class="font-bold text-slate-700">Yoo-jin (South Korea)</h3>
                        </div>
                        <i class="fa-solid fa-user-graduate text-slate-400"></i>
                    </div>
                    <div class="space-y-3 text-sm">
                        <p class="text-slate-600"><strong>A:</strong> Look! <span class="bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded font-semibold">Who's that?</span></p>
                        <p class="text-slate-600"><strong>B:</strong> Oh, she's a new student.</p>
                        
                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 1:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q1" onchange="checkDetectiveAnswer('q1', 'What\'s her name', 'fb1')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="What's her name">What's her name?</option>
                                    <option value="Where is she">Where is she?</option>
                                    <option value="How old is she">How old is she?</option>
                                </select>
                                <button onclick="speakText('What is her name?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb1" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> I think her name is Yoo-jin.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 2:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q2" onchange="checkDetectiveAnswer('q2', 'Where is she from', 'fb2')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Who is she from">Who is she from?</option>
                                    <option value="Where is she from">Where is she from?</option>
                                    <option value="What is she like">What is she like?</option>
                                </select>
                                <button onclick="speakText('Where is she from?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb2" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> She's from South Korea.</p>
                    </div>
                </div>

                <!-- Conversation 2: Leandro -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm relative">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center text-sm">2</span>
                            <h3 class="font-bold text-slate-700">Leandro (Argentina)</h3>
                        </div>
                        <i class="fa-solid fa-user-ninja text-slate-400"></i>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 3:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q3" onchange="checkDetectiveAnswer('q3', 'How are you', 'fb3')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Where are you">Where are you?</option>
                                    <option value="How are you">Hi, Brittany. How are you?</option>
                                    <option value="Who are you">Who are you?</option>
                                </select>
                                <button onclick="speakText('Hi Brittany, How are you?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb3" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> I'm fine, thanks. My friend Leandro is here this week—from Argentina.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 4:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q4" onchange="checkDetectiveAnswer('q4', 'What\'s he like', 'fb4')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="What's he like">What's he like?</option>
                                    <option value="Who is he">Who is he?</option>
                                    <option value="Where is he">Where is he?</option>
                                </select>
                                <button onclick="speakText('What is he like?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb4" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> He's really friendly.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 5:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q5" onchange="checkDetectiveAnswer('q5', 'How old is he', 'fb5')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="How old is he">How old is he?</option>
                                    <option value="How is he">How is he?</option>
                                    <option value="Where is he from">Where is he from?</option>
                                </select>
                                <button onclick="speakText('How old is he?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb5" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> He's twenty-five years old.</p>
                    </div>
                </div>

                <!-- Conversation 3: Azra -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm relative">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center text-sm">3</span>
                            <h3 class="font-bold text-slate-700">Azra (Turkey)</h3>
                        </div>
                        <i class="fa-solid fa-user-tie text-slate-400"></i>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 6:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q6" onchange="checkDetectiveAnswer('q6', 'Where are you from', 'fb6')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Where are you from">Azra, where are you from?</option>
                                    <option value="Who are you from">Azra, who are you from?</option>
                                    <option value="What are you like">Azra, what are you like?</option>
                                </select>
                                <button onclick="speakText('Azra, where are you from?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb6" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> I'm from Turkey. From Ankara.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 7:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q7" onchange="checkDetectiveAnswer('q7', 'What\'s Ankara like', 'fb7')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Where is Ankara">Where is Ankara?</option>
                                    <option value="What's Ankara like">What's Ankara like?</option>
                                    <option value="Who is Ankara">Who is Ankara?</option>
                                </select>
                                <button onclick="speakText('What is Ankara like?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb7" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> Well, Ankara is the capital of Turkey. It's very old.</p>
                    </div>
                </div>

                <!-- Conversation 4: Luke & Friends -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm relative">
                    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-amber-100 text-amber-700 font-bold flex items-center justify-center text-sm">4</span>
                            <h3 class="font-bold text-slate-700">Luke's Friends (Miami)</h3>
                        </div>
                        <i class="fa-solid fa-users text-slate-400"></i>
                    </div>
                    <div class="space-y-3 text-sm">
                        <p class="text-slate-600"><strong>A:</strong> Good morning, Luke. How are you today?</p>
                        <p class="text-slate-600"><strong>B:</strong> I'm great, thanks.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 8:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q8" onchange="checkDetectiveAnswer('q8', 'Who are they', 'fb8')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Who are they">Cool. Who are they?</option>
                                    <option value="Where are they">Cool. Where are they?</option>
                                    <option value="What are they">Cool. What are they?</option>
                                </select>
                                <button onclick="speakText('Who are they?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb8" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> They're my friends from school.</p>

                        <div class="p-2.5 bg-slate-50 rounded-xl space-y-2">
                            <label class="block text-xs font-semibold text-slate-500">Question 9:</label>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-700">A:</span>
                                <select id="q9" onchange="checkDetectiveAnswer('q9', 'Where are they from', 'fb9')" class="border rounded-lg px-2.5 py-1.5 text-sm bg-white border-slate-300 w-full focus:ring-2 focus:ring-indigo-500">
                                    <option value="">-- Choose Wh-question --</option>
                                    <option value="Where are they from">Where are they from?</option>
                                    <option value="How old are they">How old are they?</option>
                                    <option value="What are they like">What are they like?</option>
                                </select>
                                <button onclick="speakText('Where are they from?')" class="bg-slate-200 hover:bg-slate-300 p-2 rounded-lg text-slate-600"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div id="fb9" class="text-xs font-semibold min-h-[16px]"></div>
                        </div>
                        <p class="text-slate-600"><strong>B:</strong> They're from Miami, like me.</p>
                    </div>
                </div>

            </div>
        </section>


        <!-- ================= MODE 2: VIP INTERVIEW SIMULATOR ================= -->
        <section id="sec-interview" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-id-badge text-indigo-600"></i> Secret VIP Interview Roleplay
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Ask questions to reveal the VIP's profile details. Click buttons to practice oral questions!</p>
                </div>
                <button onclick="generateRandomVIP()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl text-sm transition-all flex items-center gap-2 shadow-md">
                    <i class="fa-solid fa-arrows-rotate"></i> New VIP Profile
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- VIP Profile Card (Left) -->
                <div class="glass-card rounded-2xl p-6 border border-slate-200 text-center shadow-sm relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute top-3 right-3 bg-indigo-100 text-indigo-700 text-xs font-bold px-3 py-1 rounded-full">
                        TOP SECRET
                    </div>
                    <div>
                        <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 text-white mx-auto flex items-center justify-center text-4xl shadow-inner mb-4 mt-2">
                            <i id="vip-avatar" class="fa-solid fa-user-astronaut"></i>
                        </div>
                        <h3 id="vip-name" class="text-xl font-bold text-slate-800">???</h3>
                        <p id="vip-tag" class="text-xs text-indigo-600 font-semibold mt-1">Secret Identity</p>
                    </div>

                    <div class="space-y-2 mt-6 text-left border-t border-slate-100 pt-4">
                        <div class="flex justify-between items-center text-xs py-1 border-b border-slate-50">
                            <span class="text-slate-400 font-semibold"><i class="fa-solid fa-earth-americas mr-1"></i> Origin:</span>
                            <span id="vip-origin-display" class="font-bold text-slate-700">🔒 Locked</span>
                        </div>
                        <div class="flex justify-between items-center text-xs py-1 border-b border-slate-50">
                            <span class="text-slate-400 font-semibold"><i class="fa-solid fa-cake-candles mr-1"></i> Age:</span>
                            <span id="vip-age-display" class="font-bold text-slate-700">🔒 Locked</span>
                        </div>
                        <div class="flex justify-between items-center text-xs py-1 border-b border-slate-50">
                            <span class="text-slate-400 font-semibold"><i class="fa-solid fa-face-smile mr-1"></i> Personality:</span>
                            <span id="vip-like-display" class="font-bold text-slate-700">🔒 Locked</span>
                        </div>
                        <div class="flex justify-between items-center text-xs py-1 border-b border-slate-50">
                            <span class="text-slate-400 font-semibold"><i class="fa-solid fa-city mr-1"></i> Hometown Vibe:</span>
                            <span id="vip-city-display" class="font-bold text-slate-700">🔒 Locked</span>
                        </div>
                        <div class="flex justify-between items-center text-xs py-1">
                            <span class="text-slate-400 font-semibold"><i class="fa-solid fa-user-group mr-1"></i> Best Friend:</span>
                            <span id="vip-friend-display" class="font-bold text-slate-700">🔒 Locked</span>
                        </div>
                    </div>
                </div>

                <!-- Detective Action Panel (Right) -->
                <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800 mb-2 border-b border-slate-100 pb-2">
                            <i class="fa-solid fa-microphone text-indigo-600 mr-2"></i>Select Question to Ask VIP:
                        </h3>
                        <p class="text-xs text-slate-500 mb-4">Click any question below to ask the VIP and hear their spoken answer!</p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <button onclick="askVIP('name')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
                                <span class="text-xs text-indigo-600 font-bold block mb-0.5">Identity</span>
                                <span class="text-sm font-semibold text-slate-800">"What's your name?"</span>
                            </button>

                            <button onclick="askVIP('origin')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
                                <span class="text-xs text-indigo-600 font-bold block mb-0.5">Origin</span>
                                <span class="text-sm font-semibold text-slate-800">"Where are you from?"</span>
                            </button>

                            <button onclick="askVIP('age')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
                                <span class="text-xs text-indigo-600 font-bold block mb-0.5">Age</span>
                                <span class="text-sm font-semibold text-slate-800">"How old are you?"</span>
                            </button>

                            <button onclick="askVIP('like')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
                                <span class="text-xs text-indigo-600 font-bold block mb-0.5">Personality</span>
                                <span class="text-sm font-semibold text-slate-800">"What are you like?"</span>
                            </button>

                            <button onclick="askVIP('city')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
                                <span class="text-xs text-indigo-600 font-bold block mb-0.5">City Description</span>
                                <span class="text-sm font-semibold text-slate-800">"What's your city like?"</span>
                            </button>

                            <button onclick="askVIP('friend')" class="p-3 rounded-xl border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-left transition-all">
