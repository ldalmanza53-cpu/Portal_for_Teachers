    <!-- JavaScript Logic -->
    <script>
        // Tab Navigation
        function switchTab(tabId) {
            ['detective', 'interview', 'matcher', 'reference'].forEach(id => {
                document.getElementById(`sec-${id}`).classList.add('hidden');
                document.getElementById(`tab-${id}`).classList.remove('tab-active');
                document.getElementById(`tab-${id}`).classList.add('text-indigo-100');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeTabBtn = document.getElementById(`tab-${tabId}`);
            activeTabBtn.classList.add('tab-active');
            activeTabBtn.classList.remove('text-indigo-100');
        }

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Detective Score Tracker
        let currentScore = 0;
        const solvedQuestions = new Set();

        function checkDetectiveAnswer(selectId, correctAnswer, feedbackId) {
            const selectEl = document.getElementById(selectId);
            const feedbackEl = document.getElementById(feedbackId);

            if (selectEl.value === correctAnswer) {
                feedbackEl.textContent = "✓ Correct!";
                feedbackEl.className = "text-xs font-semibold text-emerald-600";
                selectEl.className = "border rounded-lg px-2.5 py-1.5 text-sm bg-emerald-50 border-emerald-500 text-emerald-900 w-full";
                
                if (!solvedQuestions.has(selectId)) {
                    solvedQuestions.add(selectId);
                    currentScore++;
                    document.getElementById('detective-score').textContent = currentScore;
                }
            } else if (selectEl.value !== "") {
                feedbackEl.textContent = "✗ Try again!";
                feedbackEl.className = "text-xs font-semibold text-rose-600";
                selectEl.className = "border rounded-lg px-2.5 py-1.5 text-sm bg-rose-50 border-rose-400 text-rose-900 w-full";
            } else {
                feedbackEl.textContent = "";
            }
        }

        // VIP Random Generator
        const vipProfiles = [
            { name: "Sophia Martinez", avatar: "fa-user-astronaut", origin: "Madrid, Spain", age: "26 years old", like: "Very friendly and energetic", city: "Historic and lively", friend: "Carlos from Barcelona" },
            { name: "Kenji Sato", avatar: "fa-user-ninja", origin: "Tokyo, Japan", age: "29 years old", like: "Kind and polite", city: "Modern and beautiful", friend: "Yuki from Osaka" },
            { name: "Amina Hassan", avatar: "fa-user-tie", origin: "Istanbul, Turkey", age: "24 years old", like: "Smart and funny", city: "Ancient and colorful", friend: "Emre from Ankara" },
            { name: "Lucas Silva", avatar: "fa-user-graduate", origin: "Rio de Janeiro, Brazil", age: "22 years old", like: "Cool and athletic", city: "Sunny and gorgeous", friend: "Mateo from São Paulo" }
        ];

        let currentVIP = vipProfiles[0];

        function generateRandomVIP() {
            const randomIndex = Math.floor(Math.random() * vipProfiles.length);
            currentVIP = vipProfiles[randomIndex];

            document.getElementById('vip-avatar').className = `fa-solid ${currentVIP.avatar}`;
            document.getElementById('vip-name').textContent = "???";
            document.getElementById('vip-origin-display').textContent = "🔒 Locked";
            document.getElementById('vip-age-display').textContent = "🔒 Locked";
            document.getElementById('vip-like-display').textContent = "🔒 Locked";
            document.getElementById('vip-city-display').textContent = "🔒 Locked";
            document.getElementById('vip-friend-display').textContent = "🔒 Locked";

            document.getElementById('vip-response-text').textContent = `"New secret VIP loaded! Select a question to start..."`;
        }

        function askVIP(topic) {
            let answerText = "";

            if (topic === 'name') {
                answerText = `My name is ${currentVIP.name}.`;
                document.getElementById('vip-name').textContent = currentVIP.name;
            } else if (topic === 'origin') {
                answerText = `I'm from ${currentVIP.origin}.`;
                document.getElementById('vip-origin-display').textContent = currentVIP.origin;
            } else if (topic === 'age') {
                answerText = `I'm ${currentVIP.age}.`;
                document.getElementById('vip-age-display').textContent = currentVIP.age;
            } else if (topic === 'like') {
                answerText = `I'm ${currentVIP.like.toLowerCase()}.`;
                document.getElementById('vip-like-display').textContent = currentVIP.like;
            } else if (topic === 'city') {
                answerText = `My city is ${currentVIP.city.toLowerCase()}.`;
                document.getElementById('vip-city-display').textContent = currentVIP.city;
            } else if (topic === 'friend') {
                answerText = `My best friend is ${currentVIP.friend}.`;
                document.getElementById('vip-friend-display').textContent = currentVIP.friend;
            }

            document.getElementById('vip-response-text').textContent = `"${answerText}"`;
            speakText(answerText);
        }

        // Question Matcher Logic
        function checkMatch(selectEl, correctValue) {
            if (selectEl.value === correctValue) {
                selectEl.className = "border rounded-lg px-3 py-2 text-sm font-semibold bg-emerald-100 text-emerald-800 border-emerald-500";
            } else {
                selectEl.className = "border rounded-lg px-3 py-2 text-sm font-semibold bg-rose-100 text-rose-800 border-rose-400";
            }
        }

        // Initialize default VIP
        window.onload = function() {
            generateRandomVIP();
        };
    </script>
</body>
</html>
