<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Possessives Detective & Mystery Box</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .tab-active {
            background-color: #d97706;
            color: #ffffff;
            box-shadow: 0 4px 14px 0 rgba(217, 119, 6, 0.38);
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 pb-12">

    <!-- Header Navigation -->
    <header class="bg-amber-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-white/10 p-2.5 rounded-xl border border-white/20">
                    <i class="fa-solid fa-box-open text-2xl text-amber-200"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">Possessives Mystery Box</h1>
                    <p class="text-xs text-amber-100">Interactive English Possessives & Belongings Game</p>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <nav class="flex flex-wrap gap-2 bg-amber-700/60 p-1.5 rounded-xl border border-white/10">
                <button onclick="switchTab('conversations')" id="tab-conversations" class="tab-btn tab-active px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all">
                    <i class="fa-solid fa-comments mr-1.5"></i>Conversations
                </button>
                <button onclick="switchTab('mystery')" id="tab-mystery" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-amber-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-user-secret mr-1.5"></i>Mystery Box Game
                </button>
                <button onclick="switchTab('sorter')" id="tab-sorter" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-amber-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-layer-group mr-1.5"></i>Speed Sorter
                </button>
                <button onclick="switchTab('reference')" id="tab-reference" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-amber-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-book-open mr-1.5"></i>Grammar Focus
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-6xl mx-auto px-4 mt-6">

        <!-- ================= MODE 1: CONVERSATIONS PRACTICE ================= -->
        <section id="sec-conversations" class="space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-amber-600"></i> Complete the Conversations
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Choose between Possessive Adjectives (<em>my, your, her</em>) and Possessive Pronouns (<em>mine, yours, hers</em>).</p>
                </div>
                <div class="bg-amber-50 border border-amber-200 text-amber-800 px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-500"></i> Score: <span id="conv-score" class="text-lg font-bold">0</span> / 10
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Dialogue 1: Raincoat -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <span class="font-bold text-amber-700 text-sm flex items-center gap-2"><i class="fa-solid fa-coat"></i> 1. The Raincoat</span>
                        <button onclick="speakText('This isn\'t my raincoat. Is it yours? No, it\'s not mine. Ask Emma. Maybe it\'s hers.')" class="text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i> Listen All</button>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">A:</strong> This isn't
                            <select id="c1_1" onchange="checkAnswer('c1_1', 'my')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(my / mine)</option>
                                <option value="my">my</option>
                                <option value="mine">mine</option>
                            </select>
                            raincoat. Is it
                            <select id="c1_2" onchange="checkAnswer('c1_2', 'yours')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(your / yours)</option>
                                <option value="your">your</option>
                                <option value="yours">yours</option>
                            </select>?
                        </div>

                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">B:</strong> No, it's not
                            <select id="c1_3" onchange="checkAnswer('c1_3', 'mine')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(my / mine)</option>
                                <option value="my">my</option>
                                <option value="mine">mine</option>
                            </select>. Ask Emma. Maybe it's
                            <select id="c1_4" onchange="checkAnswer('c1_4', 'hers')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(her / hers)</option>
                                <option value="her">her</option>
                                <option value="hers">hers</option>
                            </select>.
                        </div>
                    </div>
                </div>

                <!-- Dialogue 2: Sneakers -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <span class="font-bold text-amber-700 text-sm flex items-center gap-2"><i class="fa-solid fa-shoe-prints"></i> 2. The Sneakers</span>
                        <button onclick="speakText('Hey! These aren\'t our sneakers! You\'re right. Ours are over there.')" class="text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i> Listen All</button>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">A:</strong> Hey! These aren't
                            <select id="c2_1" onchange="checkAnswer('c2_1', 'our')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(our / ours)</option>
                                <option value="our">our</option>
                                <option value="ours">ours</option>
                            </select>
                            sneakers!
                        </div>

                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">B:</strong> You're right.
                            <select id="c2_2" onchange="checkAnswer('c2_2', 'Ours')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(Our / Ours)</option>
                                <option value="Our">Our</option>
                                <option value="Ours">Ours</option>
                            </select>
                            are over there.
                        </div>
                    </div>
                </div>

                <!-- Dialogue 3: Gloves -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <span class="font-bold text-amber-700 text-sm flex items-center gap-2"><i class="fa-solid fa-mitten"></i> 3. The Gloves</span>
                        <button onclick="speakText('Are these your gloves, Erin? No, they\'re not mine. Maybe they are Logan\'s. His gloves are gray.')" class="text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i> Listen All</button>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">A:</strong> Are these
                            <select id="c3_1" onchange="checkAnswer('c3_1', 'your')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(your / yours)</option>
                                <option value="your">your</option>
                                <option value="yours">yours</option>
                            </select>
                            gloves, Erin?
                        </div>

                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">B:</strong> No, they're not
                            <select id="c3_2" onchange="checkAnswer('c3_2', 'mine')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(my / mine)</option>
                                <option value="my">my</option>
                                <option value="mine">mine</option>
                            </select>. Maybe they are Logan's.
                            <select id="c3_3" onchange="checkAnswer('c3_3', 'His')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(His / Your)</option>
                                <option value="His">His</option>
                                <option value="Your">Your</option>
                            </select>
                            gloves are gray.
                        </div>
                    </div>
                </div>

                <!-- Dialogue 4: T-shirts -->
                <div class="glass-card rounded-2xl p-5 border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <span class="font-bold text-amber-700 text-sm flex items-center gap-2"><i class="fa-solid fa-shirt"></i> 4. The T-shirts</span>
                        <button onclick="speakText('Whose T-shirts are these? Are they Hayley\'s and Brad\'s? No, they\'re not their T-shirts. Theirs are white, not blue.')" class="text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i> Listen All</button>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">A:</strong>
                            <select id="c4_1" onchange="checkAnswer('c4_1', 'Whose')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(Whose / Yours)</option>
                                <option value="Whose">Whose</option>
                                <option value="Yours">Yours</option>
                            </select>
                            T-shirts are these? Are they Hayley's and Brad's?
                        </div>

                        <div class="flex items-center gap-1.5 flex-wrap">
                            <strong class="text-slate-700">B:</strong> No, they're not
                            <select id="c4_2" onchange="checkAnswer('c4_2', 'their')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(their / theirs)</option>
                                <option value="their">their</option>
                                <option value="theirs">theirs</option>
                            </select>
                            T-shirts.
                            <select id="c4_3" onchange="checkAnswer('c4_3', 'Theirs')" class="border rounded px-2 py-1 bg-white font-semibold text-xs border-slate-300">
                                <option value="">(Their / Theirs)</option>
                                <option value="Their">Their</option>
                                <option value="Theirs">Theirs</option>
                            </select>
                            are white, not blue.
                        </div>
                    </div>
                </div>

            </div>
        </section>


        <!-- ================= MODE 2: MYSTERY BOX DETECTIVE ================= -->
        <section id="sec-mystery" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-box-open text-amber-600"></i> Mystery Box Owner Finder
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Pull an object out of the mystery box and answer questions using possessives!</p>
                </div>
                <button onclick="drawMysteryItem()" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded-xl text-sm transition-all flex items-center gap-2 shadow-md">
                    <i class="fa-solid fa-hand-holding"></i> Pull New Item
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Mystery Box Display (Left) -->
                <div class="glass-card rounded-2xl p-6 border border-slate-200 text-center shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="w-28 h-28 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-400 text-white mx-auto flex items-center justify-center text-5xl shadow-lg mb-4">
                            <i id="item-icon" class="fa-solid fa-box-open"></i>
                        </div>
                        <h3 id="item-name" class="text-xl font-bold text-slate-800">Ready to Search?</h3>
                        <p id="item-hint" class="text-xs text-amber-600 font-semibold mt-1">Click "Pull New Item" to start!</p>
                    </div>

                    <div class="mt-6 bg-slate-900 text-white p-4 rounded-xl text-left space-y-1">
                        <span class="text-xs text-amber-400 font-bold uppercase tracking-wider block">Detective Clue:</span>
                        <p id="item-clue" class="text-xs text-slate-300 italic">"Items in the box belong to Greg, Taylor, Emma, Logan, or you!"</p>
                    </div>
                </div>

                <!-- Detective Action Panel (Right) -->
                <div class="lg:col-span-2 glass-card rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div class="space-y-4">
                        <h3 class="font-bold text-slate-800 border-b border-slate-100 pb-2">
                            <i class="fa-solid fa-question text-amber-600 mr-2"></i>Question: <span id="mystery-question-text" class="text-slate-600">"Whose item is this?"</span>
                        </h3>

                        <div class="space-y-3">
                            <label class="block text-xs font-bold text-slate-500 uppercase">Choose the Correct Response:</label>
                            <div id="mystery-options" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="text-xs text-slate-400 italic p-3 border border-dashed rounded-xl">Draw an item from the box to reveal options!</div>
                            </div>
                        </div>
                    </div>

                    <div id="mystery-feedback" class="mt-6 p-4 rounded-xl hidden text-sm font-semibold flex items-center justify-between">
                        <span id="mystery-feedback-text"></span>
                        <button onclick="speakText(document.getElementById('mystery-feedback-text').textContent)" class="p-2 bg-white/20 rounded-lg"><i class="fa-solid fa-volume-high"></i></button>
                    </div>
                </div>

            </div>
        </section>


        <!-- ================= MODE 3: SPEED SORTER ================= -->
        <section id="sec-sorter" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-amber-600"></i> Possessive Adjective vs. Pronoun Sorter
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Remember: <strong>Adjectives</strong> need a noun after them (<em>my coat</em>). <strong>Pronouns</strong> stand alone (<em>mine</em>).</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Adjectives Basket -->
                <div class="glass-card rounded-2xl p-5 border-2 border-blue-200 bg-blue-50/30 text-center space-y-3">
                    <h3 class="font-bold text-blue-700 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-font"></i> Possessive Adjectives (+ Noun)
                    </h3>
                    <p class="text-xs text-slate-500">e.g., my, your, his, her, our, their</p>
                    <div id="basket-adj" class="min-h-[120px] bg-white border border-blue-200 rounded-xl p-3 flex flex-wrap gap-2 justify-center items-center">
                        <span class="text-xs text-slate-400 italic">Drop/Click Adjectives Here</span>
                    </div>
                </div>

                <!-- Pronouns Basket -->
                <div class="glass-card rounded-2xl p-5 border-2 border-emerald-200 bg-emerald-50/30 text-center space-y-3">
                    <h3 class="font-bold text-emerald-700 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-user-shield"></i> Possessive Pronouns (Stand Alone)
                    </h3>
                    <p class="text-xs text-slate-500">e.g., mine, yours, his, hers, ours, theirs</p>
                    <div id="basket-pro" class="min-h-[120px] bg-white border border-emerald-200 rounded-xl p-3 flex flex-wrap gap-2 justify-center items-center">
                        <span class="text-xs text-slate-400 italic">Drop/Click Pronouns Here</span>
                    </div>
                </div>

            </div>

            <!-- Words Pool -->
            <div class="glass-card rounded-2xl p-5 border border-slate-200 text-center space-y-3">
                <h4 class="font-bold text-slate-700 text-xs uppercase tracking-wider">Words to Sort:</h4>
                <div id="words-pool" class="flex flex-wrap gap-3 justify-center">
                    <!-- Dynamic JS buttons -->
                </div>
            </div>
        </section>


        <!-- ================= MODE 4: GRAMMAR FOCUS REFERENCE ================= -->
        <section id="sec-reference" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-book-open text-amber-600"></i> Grammar Focus Reference: Possessives
                </h2>
                <p class="text-sm text-slate-500 mt-1">Click the speaker buttons to listen to exact textbook audio pronunciations.</p>
            </div>

            <!-- Possessives Table -->
            <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-slate-200 bg-amber-50/50 text-amber-900 font-bold">
                            <th class="p-3">Adjectives (+ Noun)</th>
                            <th class="p-3">Pronouns (Stand Alone)</th>
                            <th class="p-3">Names ('s) & Pronunciation</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">my <span class="text-xs text-slate-400 block font-normal">These are my shoes.</span></td>
                            <td class="p-3 font-semibold text-slate-700">mine <span class="text-xs text-slate-400 block font-normal">These shoes are mine.</span></td>
                            <td class="p-3">
                                <span class="font-bold text-indigo-700">Jack's tie</span> <span class="text-xs bg-slate-100 px-2 py-0.5 rounded text-slate-600 font-mono">/'s/</span>
                                <button onclick="speakText('Jack\'s tie')" class="ml-2 text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">your</td>
                            <td class="p-3 font-semibold text-slate-700">yours</td>
                            <td class="p-3">
                                <span class="font-bold text-indigo-700">Taylor's shoes</span> <span class="text-xs bg-slate-100 px-2 py-0.5 rounded text-slate-600 font-mono">/'z/</span>
                                <button onclick="speakText('Taylor\'s shoes')" class="ml-2 text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">his</td>
                            <td class="p-3 font-semibold text-slate-700">his</td>
                            <td class="p-3">
                                <span class="font-bold text-indigo-700">Alex's coat</span> <span class="text-xs bg-slate-100 px-2 py-0.5 rounded text-slate-600 font-mono">/ɪz/</span>
                                <button onclick="speakText('Alex\'s coat')" class="ml-2 text-slate-400 hover:text-amber-600"><i class="fa-solid fa-volume-high"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">her</td>
                            <td class="p-3 font-semibold text-slate-700">hers</td>
                            <td class="p-3 font-semibold text-slate-500 italic">Whose questions:</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">our</td>
                            <td class="p-3 font-semibold text-slate-700">ours</td>
                            <td class="p-3">
                                <div class="text-xs space-y-1">
                                    <p><strong>A:</strong> Whose tie is this? <button onclick="speakText('Whose tie is this? It\'s Greg\'s.')" class="text-amber-600"><i class="fa-solid fa-volume-high"></i></button></p>
                                    <p><strong>B:</strong> It's Greg's.</p>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-slate-700">their</td>
                            <td class="p-3 font-semibold text-slate-700">theirs</td>
                            <td class="p-3">
                                <div class="text-xs space-y-1">
                                    <p><strong>A:</strong> Whose shoes are these? <button onclick="speakText('Whose shoes are these? They\'re Taylor\'s.')" class="text-amber-600"><i class="fa-solid fa-volume-high"></i></button></p>
                                    <p><strong>B:</strong> They're Taylor's.</p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- JavaScript Engine -->
    <script>
        // Tab Navigation
        function switchTab(tabId) {
            ['conversations', 'mystery', 'sorter', 'reference'].forEach(id => {
                document.getElementById(`sec-${id}`).classList.add('hidden');
                document.getElementById(`tab-${id}`).classList.remove('tab-active');
                document.getElementById(`tab-${id}`).classList.add('text-amber-100');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeTabBtn = document.getElementById(`tab-${tabId}`);
            activeTabBtn.classList.add('tab-active');
            activeTabBtn.classList.remove('text-amber-100');
        }

        // Web Speech API
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Mode 1: Conversation Checkers
        let convScore = 0;
        const checkedFields = new Set();

        function checkAnswer(selectId, correctAnswer) {
            const selectEl = document.getElementById(selectId);
            if (selectEl.value === correctAnswer) {
                selectEl.className = "border rounded px-2 py-1 font-semibold text-xs bg-emerald-100 text-emerald-900 border-emerald-500";
                if (!checkedFields.has(selectId)) {
                    checkedFields.add(selectId);
                    convScore++;
                    document.getElementById('conv-score').textContent = convScore;
                }
            } else if (selectEl.value !== "") {
                selectEl.className = "border rounded px-2 py-1 font-semibold text-xs bg-rose-100 text-rose-900 border-rose-400";
            }
        }

        // Mode 2: Mystery Box Items
        const mysteryItems = [
            {
                name: "Tie",
                icon: "fa-user-tie",
                question: "Whose tie is this?",
                clue: "It belongs to Greg.",
                options: [
                    { text: "It's Greg's.", correct: true, feedback: "Correct! Whose tie is this? It's Greg's." },
                    { text: "It's Greg.", correct: false, feedback: "Incorrect. Remember to add 's for possession: Greg's." },
                    { text: "They're Greg's.", correct: false, feedback: "Incorrect. A tie is singular, so use 'It's'." }
                ]
            },
            {
                name: "Gray Gloves",
                icon: "fa-mitten",
                question: "Whose gloves are these?",
                clue: "Look at Logan. His gloves are gray.",
                options: [
                    { text: "They're Logan's.", correct: true, feedback: "Correct! They are Logan's gloves!" },
                    { text: "It's Logan's.", correct: false, feedback: "Incorrect. Gloves are plural, use 'They're'." },
                    { text: "They're his glove.", correct: false, feedback: "Incorrect. Use 'They're Logan's'." }
                ]
            },
            {
                name: "Raincoat",
                icon: "fa-coat",
                question: "Is this raincoat yours?",
                clue: "It belongs to Emma.",
                options: [
                    { text: "No, it's not mine. It's hers.", correct: true, feedback: "Correct! It's not mine. Maybe it's hers." },
                    { text: "No, it's not my. It's her.", correct: false, feedback: "Incorrect. Use pronouns 'mine' and 'hers'." },
                    { text: "Yes, it's mine raincoat.", correct: false, feedback: "Incorrect. Say 'my raincoat' or 'it's mine'." }
                ]
            },
            {
                name: "White T-shirts",
                icon: "fa-shirt",
                question: "Whose T-shirts are these?",
                clue: "They belong to Hayley and Brad.",
                options: [
                    { text: "Theirs are white. They're theirs.", correct: true, feedback: "Correct! Theirs are white T-shirts." },
                    { text: "Their are white.", correct: false, feedback: "Incorrect. Use 'Theirs' when standing alone without a noun." },
                    { text: "They're them T-shirts.", correct: false, feedback: "Incorrect. Use possessive form 'their'." }
                ]
            }
        ];

        let currentMysteryItem = null;

        function drawMysteryItem() {
            const randomIndex = Math.floor(Math.random() * mysteryItems.length);
            currentMysteryItem = mysteryItems[randomIndex];

            document.getElementById('item-icon').className = `fa-solid ${currentMysteryItem.icon}`;
            document.getElementById('item-name').textContent = currentMysteryItem.name;
            document.getElementById('item-hint').textContent = "Item pulled from box!";
            document.getElementById('item-clue').textContent = `"${currentMysteryItem.clue}"`;
            document.getElementById('mystery-question-text').textContent = `"${currentMysteryItem.question}"`;

            const optionsContainer = document.getElementById('mystery-options');
            optionsContainer.innerHTML = '';

            currentMysteryItem.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "p-3 rounded-xl border border-amber-200 bg-amber-50/50 hover:bg-amber-100 text-left text-xs font-semibold text-slate-800 transition-all";
                btn.textContent = opt.text;
                btn.onclick = () => selectMysteryOption(opt);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('mystery-feedback').classList.add('hidden');
            speakText(currentMysteryItem.question);
        }

        function selectMysteryOption(option) {
            const fbBox = document.getElementById('mystery-feedback');
            const fbText = document.getElementById('mystery-feedback-text');
            fbBox.classList.remove('hidden');

            if (option.correct) {
                fbBox.className = "mt-6 p-4 rounded-xl text-sm font-semibold flex items-center justify-between bg-emerald-100 text-emerald-900 border border-emerald-300";
                fbText.textContent = `✓ ${option.feedback}`;
            } else {
                fbBox.className = "mt-6 p-4 rounded-xl text-sm font-semibold flex items-center justify-between bg-rose-100 text-rose-900 border border-rose-300";
                fbText.textContent = `✗ ${option.feedback}`;
            }
            speakText(option.feedback);
        }

        // Mode 3: Speed Sorter Logic
        const wordsToSort = [
            { word: "my", type: "adj" },
            { word: "mine", type: "pro" },
            { word: "your", type: "adj" },
            { word: "yours", type: "pro" },
            { word: "her", type: "adj" },
            { word: "hers", type: "pro" },
            { word: "our", type: "adj" },
            { word: "ours", type: "pro" },
            { word: "their", type: "adj" },
            { word: "theirs", type: "pro" }
        ];

        function initSorter() {
            const pool = document.getElementById('words-pool');
            pool.innerHTML = '';
            wordsToSort.sort(() => Math.random() - 0.5);

            wordsToSort.forEach(item => {
                const btn = document.createElement('button');
                btn.id = `sort-btn-${item.word}`;
                btn.className = "px-3 py-1.5 rounded-lg border border-slate-300 bg-white font-bold text-sm text-slate-700 hover:bg-amber-50 shadow-sm transition-all";
                btn.textContent = item.word;
                btn.onclick = () => openSortChoice(item);
                pool.appendChild(btn);
            });
        }

        function openSortChoice(item) {
            const choice = prompt(`Where does "${item.word}" belong?\nType '1' for Possessive Adjective (+ Noun)\nType '2' for Possessive Pronoun (Stand Alone)`);
            const btn = document.getElementById(`sort-btn-${item.word}`);

            if (choice === '1' && item.type === 'adj') {
                document.getElementById('basket-adj').appendChild(btn);
                btn.className = "px-3 py-1 rounded-lg bg-blue-100 text-blue-800 text-xs font-bold border border-blue-300";
            } else if (choice === '2' && item.type === 'pro') {
                document.getElementById('basket-pro').appendChild(btn);
                btn.className = "px-3 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-bold border border-emerald-300";
            } else if (choice !== null) {
                alert(`Oops! "${item.word}" is a possessive ${item.type === 'adj' ? 'Adjective (needs a noun like "my coat")' : 'Pronoun (stands alone like "it\'s mine")'}.`);
            }
        }

        window.onload = function() {
            initSorter();
        };
    </script>
</body>
</html>
