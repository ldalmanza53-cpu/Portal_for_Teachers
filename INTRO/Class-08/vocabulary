                <!-- /ɪz/ Bucket -->
                <div onclick="sortCurrentWordTo('/ɪz/')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, '/ɪz/')" class="sound-bucket glass-panel p-6 rounded-2xl border-2 border-purple-500/30 hover:border-purple-500 cursor-pointer transition-all flex flex-col items-center justify-between min-h-[220px] text-center group">
