    <!-- Footer -->
    <footer class="glass-panel border-t border-slate-800 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center text-slate-500 text-xs space-y-2">
            <p>Word Power Studio • Beginner A1 Possessives & Phonetics</p>
            <p>Built for interactive ESL/EFL classroom practice & self-study.</p>
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Global App State
        let score = 0;
        let streak = 0;
        let soundEnabled = true;

        // Audio Context initialization for Sound Effects
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            return audioCtx;
        }

        function playBeep(freq = 440, type = 'sine', duration = 0.15) {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {
                console.error("Audio Web API error:", e);
            }
        }

        function playCorrectSound() {
            if (!soundEnabled) return;
            playBeep(523.25, 'sine', 0.1); // C5
            setTimeout(() => playBeep(659.25, 'sine', 0.1), 100); // E5
            setTimeout(() => playBeep(783.99, 'sine', 0.2), 200); // G5
        }

        function playIncorrectSound() {
            if (!soundEnabled) return;
            playBeep(220, 'sawtooth', 0.15); // A3
            setTimeout(() => playBeep(196, 'sawtooth', 0.25), 150); // G3
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high';
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-rose-400';
            }
        }

        function addScore(pts) {
            score += pts;
            streak += 1;
            document.getElementById('score-display').textContent = score + ' XP';
            document.getElementById('streak-display').textContent = streak;

            if (streak > 0 && streak % 5 === 0 && window.confetti) {
                confetti({
                    particleCount: 80,
                    spread: 60,
                    origin: { y: 0.7 }
                });
            }
        }

        function resetStreak() {
            streak = 0;
            document.getElementById('streak-display').textContent = streak;
        }

        // Web Speech API Helper
        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Stop current speech
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.rate = 0.85; // Clear speed for A1 students
                utterance.lang = 'en-US';
                window.speechSynthesis.speak(utterance);
            }
        }

        // Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
                btn.classList.add('text-slate-400', 'hover:text-slate-200');
            });

            document.getElementById('tab-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('tab-btn-' + tabId);
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
            activeBtn.classList.remove('text-slate-400', 'hover:text-slate-200');
        }

        // Activity 1: Sentence Converter State & Logic
        const converterData = [
            {
                original: "These are my shoes.",
                correct: "These shoes are mine.",
                words: ["These", "shoes", "are", "mine.", "my", "is", "hers."],
                hint: "Change 'my shoes' -> 'shoes are mine'."
            },
            {
                original: "That is her coat.",
                correct: "That coat is hers.",
                words: ["That", "coat", "is", "hers.", "her", "mine.", "are"],
                hint: "Change 'her coat' -> 'coat is hers'."
            },
            {
                original: "Is this your tie?",
                correct: "Is this tie yours?",
                words: ["Is", "this", "tie", "yours?", "your", "mine?", "are"],
                hint: "Change 'your tie' -> 'tie yours?'."
            },
            {
                original: "Those are our coats.",
                correct: "Those coats are ours.",
                words: ["Those", "coats", "are", "ours.", "our", "theirs.", "is"],
                hint: "Change 'our coats' -> 'coats are ours'."
            },
            {
                original: "They are his shoes.",
                correct: "They are his.",
                words: ["They", "are", "his.", "he", "shoes", "mine.", "them"],
                hint: "Change 'his shoes' -> 'his'."
            },
            {
                original: "This is their house.",
                correct: "This house is theirs.",
                words: ["This", "house", "is", "theirs.", "their", "ours.", "are"],
                hint: "Change 'their house' -> 'house is theirs'."
            }
        ];

        let currentConverterIdx = 0;
        let selectedConverterWords = [];

        function loadConverterQuestion() {
            const current = converterData[currentConverterIdx];
            document.getElementById('converter-prompt').textContent = current.original;
            document.getElementById('converter-counter').textContent = `${currentConverterIdx + 1} / ${converterData.length}`;
            document.getElementById('converter-progress').style.width = `${((currentConverterIdx + 1) / converterData.length) * 100}%`;
            document.getElementById('converter-hint-text').textContent = current.hint;
            document.getElementById('converter-hint-box').classList.add('hidden');
            document.getElementById('converter-feedback').classList.add('hidden');

            selectedConverterWords = [];
            renderConverterTiles();
        }

        function renderConverterTiles() {
            const current = converterData[currentConverterIdx];
            const assembledBox = document.getElementById('converter-assembled');
            const wordBankBox = document.getElementById('converter-wordbank');

            // Render Assembled Tiles
            assembledBox.innerHTML = '';
            if (selectedConverterWords.length === 0) {
                assembledBox.innerHTML = '<span class="text-slate-600 text-xs italic">Select word tiles below...</span>';
            } else {
                selectedConverterWords.forEach((word, idx) => {
                    const tile = document.createElement('button');
                    tile.className = 'px-3 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-sm shadow hover:bg-rose-600 transition-colors';
                    tile.textContent = word;
                    tile.onclick = () => removeConverterWord(idx);
                    assembledBox.appendChild(tile);
                });
            }

            // Render Word Bank
            wordBankBox.innerHTML = '';
            // Shuffle word bank deterministically for variety
            const availableWords = [...current.words];
            availableWords.forEach((word) => {
                const tile = document.createElement('button');
                tile.className = 'px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-semibold text-sm transition-all hover:scale-105 active:scale-95';
                tile.textContent = word;
                tile.onclick = () => addConverterWord(word);
                wordBankBox.appendChild(tile);
            });
        }

        function addConverterWord(word) {
            selectedConverterWords.push(word);
            renderConverterTiles();
            playBeep(350, 'sine', 0.05);
        }

        function removeConverterWord(index) {
            selectedConverterWords.splice(index, 1);
            renderConverterTiles();
            playBeep(280, 'sine', 0.05);
        }

        function resetConverterTiles() {
            selectedConverterWords = [];
            renderConverterTiles();
        }

        function toggleConverterHint() {
            const hintBox = document.getElementById('converter-hint-box');
            hintBox.classList.toggle('hidden');
        }

        function speakCurrentConverterPrompt() {
            speak(converterData[currentConverterIdx].original);
        }

        function checkConverterAnswer() {
            const userSentence = selectedConverterWords.join(' ').trim();
            const correctSentence = converterData[currentConverterIdx].correct.trim();
            const feedback = document.getElementById('converter-feedback');

            feedback.classList.remove('hidden', 'bg-emerald-950/80', 'text-emerald-300', 'bg-rose-950/80', 'text-rose-300', 'border-emerald-800', 'border-rose-800');

            if (userSentence.toLowerCase() === correctSentence.toLowerCase()) {
                feedback.classList.add('bg-emerald-950/80', 'text-emerald-300', 'border', 'border-emerald-800');
                feedback.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 mr-2"></i> Excellent! "${correctSentence}"`;
                playCorrectSound();
                speak(correctSentence);
                addScore(15);

                setTimeout(() => {
                    currentConverterIdx = (currentConverterIdx + 1) % converterData.length;
                    loadConverterQuestion();
                }, 2000);
            } else {
                feedback.classList.add('bg-rose-950/80', 'text-rose-300', 'border', 'border-rose-800');
                feedback.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-400 mr-2"></i> Not quite. Try again!`;
                playIncorrectSound();
                resetStreak();
            }
        }

        // Activity 2: Lost & Found Game State & Logic
        const lostFoundItems = [
            {
                name: "Tie",
                owner: "Greg",
                isPlural: false,
                icon: "fa-solid fa-necktie",
                question: "Whose tie is this?",
                correct: "It's Greg's.",
                options: ["It's Greg's.", "They're Greg's.", "It's Greg.", "They are Gregs."]
            },
            {
                name: "Shoes",
                owner: "Taylor",
                isPlural: true,
                icon: "fa-solid fa-shoe-prints",
                question: "Whose shoes are these?",
                correct: "They're Taylor's.",
                options: ["They're Taylor's.", "It's Taylor's.", "They're Taylor.", "It is Taylors."]
            },
            {
                name: "Coat",
                owner: "Alex",
                isPlural: false,
                icon: "fa-solid fa-vest",
                question: "Whose coat is this?",
                correct: "It's Alex's.",
                options: ["It's Alex's.", "They're Alex's.", "It's Alex.", "They are Alexs."]
            },
            {
                name: "Glasses",
                owner: "Max",
                isPlural: true,
                icon: "fa-solid fa-glasses",
                question: "Whose glasses are these?",
                correct: "They're Max's.",
                options: ["They're Max's.", "It's Max's.", "They're Max.", "It's Max."]
            },
            {
                name: "Hat",
                owner: "Pat",
                isPlural: false,
                icon: "fa-solid fa-hat-cowboy",
                question: "Whose hat is this?",
                correct: "It's Pat's.",
                options: ["It's Pat's.", "They're Pat's.", "It is Pats.", "They are Pat's."]
            }
        ];

        let currentLostIdx = 0;

        function loadLostFoundItem() {
            const item = lostFoundItems[currentLostIdx];
            document.getElementById('lost-item-icon').innerHTML = `<i class="${item.icon}"></i>`;
            document.getElementById('lost-item-title').textContent = item.name;
            document.getElementById('lost-item-grammartype').textContent = item.isPlural ? "Plural Item (are these?)" : "Singular Item (is this?)";
            document.getElementById('lost-owner-badge').textContent = item.owner;
            document.getElementById('lost-question-text').textContent = item.question;

            const optionsBox = document.getElementById('lost-options-container');
            optionsBox.innerHTML = '';
            document.getElementById('lost-feedback-area').classList.add('hidden');
            document.getElementById('lost-next-btn').classList.add('hidden');

            item.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'w-full p-4 rounded-xl bg-slate-900 hover:bg-indigo-900/40 border border-slate-800 hover:border-indigo-500 text-left font-bold text-slate-200 transition-all flex items-center justify-between group';
                btn.innerHTML = `
                    <span>${opt}</span>
                    <i class="fa-solid fa-chevron-right text-slate-600 group-hover:text-indigo-400 group-hover:translate-x-1 transition-all"></i>
                `;
                btn.onclick = () => checkLostAnswer(opt, item.correct);
                optionsBox.appendChild(btn);
            });
        }

        function speakLostItemQuestion() {
            const item = lostFoundItems[currentLostIdx];
            speak(item.question);
        }

        function checkLostAnswer(selected, correct) {
            const feedback = document.getElementById('lost-feedback-area');
            feedback.classList.remove('hidden', 'bg-emerald-950/80', 'text-emerald-300', 'bg-rose-950/80', 'text-rose-300', 'border-emerald-800', 'border-rose-800');

            if (selected === correct) {
                feedback.classList.add('bg-emerald-950/80', 'text-emerald-300', 'border', 'border-emerald-800');
                feedback.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 mr-2"></i> Perfect! ${selected}`;
                playCorrectSound();
                speak(selected);
                addScore(20);
                document.getElementById('lost-next-btn').classList.remove('hidden');
            } else {
                feedback.classList.add('bg-rose-950/80', 'text-rose-300', 'border', 'border-rose-800');
                feedback.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-400 mr-2"></i> Incorrect! Remember: use "It's" for singular and "They're" for plural.`;
                playIncorrectSound();
                resetStreak();
            }
        }

        function nextLostFoundItem() {
            currentLostIdx = (currentLostIdx + 1) % lostFoundItems.length;
            loadLostFoundItem();
        }

        // Activity 3: Sound Sorter Logic
        const sorterQueue = [
            { word: "Jack's", sound: "/s/" },
            { word: "Taylor's", sound: "/z/" },
            { word: "Alex's", sound: "/ɪz/" },
            { word: "Pat's", sound: "/s/" },
            { word: "Greg's", sound: "/z/" },
            { word: "Max's", sound: "/ɪz/" },
            { word: "Bob's", sound: "/z/" },
            { word: "Chris's", sound: "/ɪz/" },
            { word: "Luke's", sound: "/s/" }
        ];

        let sorterIndex = 0;
        let sortedBuckets = { '/s/': [], '/z/': [], '/ɪz/': [] };

        function loadSorterWord() {
            if (sorterIndex >= sorterQueue.length) {
                document.getElementById('sorter-current-card').innerHTML = `<span class="text-2xl font-bold text-emerald-400"><i class="fa-solid fa-trophy mr-2"></i> All Words Sorted!</span>`;
                if (window.confetti) confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                return;
            }

            const current = sorterQueue[sorterIndex];
            document.getElementById('sorter-word-text').textContent = current.word;
            speak(current.word);
        }

        function speakSorterWord() {
            if (sorterIndex < sorterQueue.length) {
                speak(sorterQueue[sorterIndex].word);
            }
        }

        function sortCurrentWordTo(targetSound) {
            if (sorterIndex >= sorterQueue.length) return;

            const current = sorterQueue[sorterIndex];
            if (current.sound === targetSound) {
                playCorrectSound();
                addScore(10);
                sortedBuckets[targetSound].push(current.word);
                renderBuckets();
                sorterIndex++;
                loadSorterWord();
            } else {
                playIncorrectSound();
                resetStreak();
                speak(`No, ${current.word} belongs in sound ${current.sound}`);
            }
        }

        function renderBuckets() {
            const listS = document.getElementById('bucket-s-list');
            const listZ = document.getElementById('bucket-z-list');
            const listIZ = document.getElementById('bucket-iz-list');

            listS.innerHTML = sortedBuckets['/s/'].map(w => `<span class="px-2 py-1 rounded bg-sky-500/20 text-sky-300 font-bold text-xs">${w}</span>`).join('');
            listZ.innerHTML = sortedBuckets['/z/'].map(w => `<span class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-300 font-bold text-xs">${w}</span>`).join('');
            listIZ.innerHTML = sortedBuckets['/ɪz/'].map(w => `<span class="px-2 py-1 rounded bg-purple-500/20 text-purple-300 font-bold text-xs">${w}</span>`).join('');
        }

        function resetSorterGame() {
            sorterIndex = 0;
            sortedBuckets = { '/s/': [], '/z/': [], '/ɪz/': [] };
            renderBuckets();
            loadSorterWord();
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        function handleDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        function handleDrop(e, targetSound) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            sortCurrentWordTo(targetSound);
        }

        // Activity 4: Dialogue Trainer Logic
        const dialogueScenarios = [
            [
                { speaker: "Speaker A", text: "Whose tie is this?", role: "A" },
                { speaker: "Speaker B", text: "It's not mine. Is it yours?", role: "B" },
                { speaker: "Speaker A", text: "No, it's not mine. It's Greg's!", role: "A" },
                { speaker: "Speaker B", text: "Ah, yes! That is his tie.", role: "B" }
            ],
            [
                { speaker: "Speaker A", text: "Whose shoes are these?", role: "A" },
                { speaker: "Speaker B", text: "They're Taylor's shoes.", role: "B" },
                { speaker: "Speaker A", text: "Are you sure they are hers?", role: "A" },
                { speaker: "Speaker B", text: "Yes, they are definitely theirs!", role: "B" }
            ],
            [
                { speaker: "Speaker A", text: "Whose coat is this?", role: "A" },
                { speaker: "Speaker B", text: "It's Alex's coat.", role: "B" },
                { speaker: "Speaker A", text: "Is this coat really hers?", role: "A" },
                { speaker: "Speaker B", text: "Yes, it is hers.", role: "B" }
            ]
        ];

        let currentScenarioIdx = 0;

        function loadDialogueScenario(idx) {
            currentScenarioIdx = parseInt(idx);
            const scenario = dialogueScenarios[currentScenarioIdx];
            const chatBox = document.getElementById('dialogue-chat-box');
            chatBox.innerHTML = '';

            scenario.forEach((line) => {
                const isA = line.role === 'A';
                const bubble = document.createElement('div');
                bubble.className = `flex ${isA ? 'justify-start' : 'justify-end'} items-start space-x-3`;

                bubble.innerHTML = `
                    <div class="max-w-md ${isA ? 'bg-slate-800 border-indigo-500/30 text-slate-200' : 'bg-indigo-600 text-white'} p-4 rounded-2xl border space-y-1 shadow-md">
                        <div class="flex justify-between items-center space-x-4">
                            <span class="text-[10px] uppercase tracking-wider font-extrabold ${isA ? 'text-indigo-400' : 'text-indigo-200'}">${line.speaker}</span>
                            <button onclick="speak('${line.text.replace(/'/g, "\\'")}')" class="text-xs hover:scale-110 transition-transform">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                        </div>
                        <p class="font-semibold text-sm sm:text-base">${line.text}</p>
                    </div>
                `;
                chatBox.appendChild(bubble);
            });
        }

        function playEntireDialogue() {
            const scenario = dialogueScenarios[currentScenarioIdx];
            let delay = 0;

            scenario.forEach((line) => {
                setTimeout(() => {
                    speak(line.text);
                }, delay);
                delay += 2800; // Estimated time per line playback
            });
        }

        // Window Initialization
        window.onload = function() {
            loadConverterQuestion();
            loadLostFoundItem();
            loadSorterWord();
            loadDialogueScenario(0);
        };
    </script>
</body>
