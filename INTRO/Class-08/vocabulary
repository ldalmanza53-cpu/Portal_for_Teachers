                <div onclick="sortCurrentWordTo('/s/')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, '/s/')" class="sound-bucket glass-panel p-6 rounded-2xl border-2 border-sky-500/30 hover:border-sky-500 cursor-pointer transition-all flex flex-col items-center justify-between min-h-[220px] text-center group">
                    <div class="space-y-2">
