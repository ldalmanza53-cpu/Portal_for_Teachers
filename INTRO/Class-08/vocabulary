                <div id="sorter-current-card" class="inline-flex items-center space-x-3 bg-gradient-to-r from-indigo-900/60 to-purple-900/60 border-2 border-indigo-500/50 px-8 py-4 rounded-2xl shadow-xl">
                    <span id="sorter-word-text" class="text-3xl font-black text-white">Jack's</span>
