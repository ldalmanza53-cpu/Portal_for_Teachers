<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Possessive Studio: ESL Interactive Learning</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .pulse-light {
            animation: pulse-glow 2s infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 15px rgba(99, 102, 241, 0.4); }
            50% { box-shadow: 0 0 25px rgba(99, 102, 241, 0.7); }
        }
        .drag-over {
            border-color: #6366f1 !important;
            background-color: rgba(99, 102, 241, 0.15) !important;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Header & Navigation Bar -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Brand / Logo -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg sm:text-xl tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
                        Possessive<span class="text-indigo-400">Studio</span>
                    </h1>
                    <p class="text-[10px] text-slate-400 font-medium tracking-wide uppercase">Beginner A1 ESL Grammar</p>
                </div>
            </div>

            <!-- Stats Bar & Controls -->
            <div class="flex items-center space-x-3 sm:space-x-6">
                <!-- Score Counter -->
                <div class="flex items-center space-x-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/50">
                    <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                    <span id="score-display" class="font-bold text-sm text-slate-200">0 XP</span>
                </div>

                <!-- Streak Counter -->
                <div class="flex items-center space-x-2 bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700/50">
                    <i class="fa-solid fa-fire text-orange-500 text-sm"></i>
                    <span id="streak-display" class="font-bold text-sm text-slate-200">0</span>
                </div>

                <!-- Sound Toggle Button -->
                <button id="sound-toggle" onclick="toggleSound()" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-slate-300 transition-colors" title="Toggle Audio FX">
                    <i id="sound-icon" class="fa-solid fa-volume-high"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Tab Navigation -->
    <nav class="bg-slate-900/90 border-b border-slate-800 sticky top-16 z-40">
        <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
            <div class="flex space-x-1 sm:space-x-2 overflow-x-auto py-2 scrollbar-none" id="tab-nav">
                <button onclick="switchTab('guide')" id="tab-btn-guide" class="tab-btn active px-3 sm:px-4 py-2 rounded-lg font-semibold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center space-x-2 bg-indigo-600 text-white shadow-md shadow-indigo-600/20">
                    <i class="fa-solid fa-book-open"></i>
                    <span>Grammar & Phonetics</span>
                </button>
                <button onclick="switchTab('converter')" id="tab-btn-converter" class="tab-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                    <i class="fa-solid fa-arrows-rotate"></i>
                    <span>Sentence Converter</span>
                </button>
                <button onclick="switchTab('lost-found')" id="tab-btn-lost-found" class="tab-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Lost & Found Desk</span>
                </button>
                <button onclick="switchTab('sorter')" id="tab-btn-sorter" class="tab-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                    <i class="fa-solid fa-filter"></i>
                    <span>Sound Sorter</span>
                </button>
                <button onclick="switchTab('dialogue')" id="tab-btn-dialogue" class="tab-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-xs sm:text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800">
                    <i class="fa-solid fa-comments"></i>
                    <span>Dialogue Trainer</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- TAB 1: GRAMMAR & PHONETICS EXPLORER -->
        <section id="tab-guide" class="tab-content space-y-8">
            <!-- Introduction Header -->
            <div class="glass-panel p-6 rounded-2xl border border-indigo-500/20 bg-gradient-to-r from-slate-900 via-indigo-950/30 to-slate-900">
                <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl flex-shrink-0">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold text-white mb-1">Possessives Chart & Pronunciation Rules</h2>
                        <p class="text-slate-300 text-sm leading-relaxed">
                            Learn how to express ownership in English! Possessive Adjectives go <strong>before nouns</strong> (e.g., <em>my shoes</em>), while Possessive Pronouns stand <strong>alone</strong> (e.g., <em>mine</em>). Possessive names add <strong>'s</strong> with three different ending sounds!
                        </p>
                    </div>
                </div>
            </div>

            <!-- Chart Section -->
            <div class="glass-panel p-6 rounded-2xl space-y-6">
                <h3 class="text-lg font-bold text-indigo-300 flex items-center space-x-2">
                    <i class="fa-solid fa-table"></i>
                    <span>Comparative Possessives Reference Table</span>
                </h3>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-700 text-slate-400 text-xs uppercase tracking-wider">
                                <th class="p-3">Subject</th>
                                <th class="p-3 text-indigo-400">Possessive Adjective (+ Noun)</th>
                                <th class="p-3 text-purple-400">Possessive Pronoun (Standalone)</th>
                                <th class="p-3 text-emerald-400">Possessive Names & Sound</th>
                                <th class="p-3 text-center">Audio</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800 text-sm">
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">I</td>
                                <td class="p-3 text-indigo-300 font-bold">my <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">mine</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Jack's</span> tie <span class="text-xs text-slate-400">(/s/)</span>
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('These are my shoes. These shoes are mine. Jack\'s tie.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">You</td>
                                <td class="p-3 text-indigo-300 font-bold">your <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">yours</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Taylor's</span> shoes <span class="text-xs text-slate-400">(/z/)</span>
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('These are your shoes. These shoes are yours. Taylor\'s shoes.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">He</td>
                                <td class="p-3 text-indigo-300 font-bold">his <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">his</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Alex's</span> coat <span class="text-xs text-slate-400">(/ɪz/)</span>
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('These are his shoes. These shoes are his. Alex\'s coat.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">She</td>
                                <td class="p-3 text-indigo-300 font-bold">her <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">hers</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Greg's</span> hat <span class="text-xs text-slate-400">(/z/)</span>
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('These are her shoes. These shoes are hers. Greg\'s hat.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">We</td>
                                <td class="p-3 text-indigo-300 font-bold">our <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">ours</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Whose tie is this?</span> It's Greg's.
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('These are our shoes. These shoes are ours. Whose tie is this? It\'s Greg\'s.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/40 transition-colors">
                                <td class="p-3 font-semibold text-slate-300">They</td>
                                <td class="p-3 text-indigo-300 font-bold">their <span class="text-slate-400 font-normal">(shoes)</span></td>
                                <td class="p-3 text-purple-300 font-bold">theirs</td>
                                <td class="p-3 font-medium text-slate-200">
                                    <span class="text-emerald-400 font-bold">Whose shoes are these?</span> They're Taylor's.
                                </td>
                                <td class="p-3 text-center">
                                    <button onclick="speak('They are their shoes. These shoes are theirs. Whose shoes are these? They are Taylor\'s.')" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition-colors">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Phonetics Explanation Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Sound /s/ -->
                <div class="glass-panel p-5 rounded-2xl border-t-4 border-sky-500 space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="px-3 py-1 rounded-full bg-sky-500/20 text-sky-400 font-bold text-lg">/s/ Sound</span>
                        <button onclick="speak('Jack\'s tie, Pat\'s coat, Luke\'s cap')" class="text-slate-400 hover:text-sky-400 transition-colors">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                    <p class="text-xs text-slate-300">Pronounce as <strong>/s/</strong> after unvoiced ending consonant sounds (like /k/, /t/, /p/, /f/).</p>
                    <div class="space-y-2 pt-2">
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Jack's tie</span>
                            <button onclick="speak('Jack\'s tie')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Pat's pen</span>
                            <button onclick="speak('Pat\'s pen')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Luke's coat</span>
                            <button onclick="speak('Luke\'s coat')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                    </div>
                </div>

                <!-- Sound /z/ -->
                <div class="glass-panel p-5 rounded-2xl border-t-4 border-emerald-500 space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-lg">/z/ Sound</span>
                        <button onclick="speak('Taylor\'s shoes, Greg\'s hat, Bob\'s bag')" class="text-slate-400 hover:text-emerald-400 transition-colors">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                    <p class="text-xs text-slate-300">Pronounce as <strong>/z/</strong> after voiced ending sounds (vowels, /g/, /b/, /d/, /l/, /m/, /n/, /r/).</p>
                    <div class="space-y-2 pt-2">
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Taylor's shoes</span>
                            <button onclick="speak('Taylor\'s shoes')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Greg's hat</span>
                            <button onclick="speak('Greg\'s hat')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Bob's bag</span>
                            <button onclick="speak('Bob\'s bag')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                    </div>
                </div>

                <!-- Sound /ɪz/ -->
                <div class="glass-panel p-5 rounded-2xl border-t-4 border-purple-500 space-y-3">
                    <div class="flex justify-between items-center">
                        <span class="px-3 py-1 rounded-full bg-purple-500/20 text-purple-400 font-bold text-lg">/ɪz/ Sound</span>
                        <button onclick="speak('Alex\'s coat, Max\'s glasses, Chris\'s watch')" class="text-slate-400 hover:text-purple-400 transition-colors">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                    <p class="text-xs text-slate-300">Adds an extra syllable <strong>/ɪz/</strong> after sibilant sounds (/x/, /s/, /z/, /ʃ/, /tʃ/).</p>
                    <div class="space-y-2 pt-2">
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Alex's coat</span>
                            <button onclick="speak('Alex\'s coat')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Max's glasses</span>
                            <button onclick="speak('Max\'s glasses')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                        <div class="flex items-center justify-between bg-slate-800/60 px-3 py-2 rounded-lg">
                            <span class="font-bold text-slate-200">Chris's watch</span>
                            <button onclick="speak('Chris\'s watch')" class="text-xs text-indigo-400 hover:underline">Listen</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: SENTENCE CONVERTER PRACTICE -->
        <section id="tab-converter" class="tab-content hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-indigo-500/20">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white">Activity 1: Sentence Converter</h2>
                        <p class="text-slate-300 text-sm">Convert sentences with <strong>Possessive Adjectives</strong> into <strong>Possessive Pronouns</strong>.</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xs text-slate-400">Progress:</span>
                        <div class="w-32 bg-slate-800 rounded-full h-2.5 overflow-hidden border border-slate-700">
                            <div id="converter-progress" class="bg-indigo-500 h-2.5 rounded-full w-0 transition-all duration-300"></div>
                        </div>
                        <span id="converter-counter" class="text-xs font-bold text-indigo-400">1 / 6</span>
                    </div>
                </div>
            </div>

            <!-- Card Quiz Interface -->
            <div class="glass-panel p-6 sm:p-8 rounded-2xl max-w-2xl mx-auto space-y-6 text-center">
                <!-- Question Prompt Box -->
                <div class="bg-slate-900/80 p-6 rounded-xl border border-slate-800 relative group">
                    <span class="text-xs font-semibold text-indigo-400 uppercase tracking-widest block mb-1">Original Sentence</span>
                    <div class="flex items-center justify-center space-x-3">
                        <p id="converter-prompt" class="text-2xl sm:text-3xl font-extrabold text-white">These are my shoes.</p>
                        <button onclick="speakCurrentConverterPrompt()" class="text-slate-400 hover:text-indigo-400 transition-colors">
                            <i class="fa-solid fa-volume-high text-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Input / Construction Area -->
                <div class="space-y-4">
                    <p class="text-xs text-slate-400 font-medium">Click the word tiles in order or type your answer:</p>
                    
                    <!-- Constructed sentence display area -->
                    <div id="converter-assembled" class="min-h-[56px] p-3 bg-slate-950/80 rounded-xl border-2 border-dashed border-slate-700 flex flex-wrap items-center justify-center gap-2">
                        <!-- Word tiles drop here -->
                    </div>

                    <!-- Word Bank Options -->
                    <div id="converter-wordbank" class="flex flex-wrap justify-center gap-2 pt-2">
                        <!-- Tiles generated via JS -->
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                    <button onclick="resetConverterTiles()" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition-colors">
                        <i class="fa-solid fa-rotate-left mr-1"></i> Clear Tiles
                    </button>

                    <button onclick="toggleConverterHint()" class="px-4 py-2 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold transition-colors">
                        <i class="fa-regular fa-lightbulb mr-1"></i> Hint
                    </button>

                    <button onclick="checkConverterAnswer()" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 transition-all">
                        Check Answer <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>

                <!-- Hint Text Box -->
                <div id="converter-hint-box" class="hidden text-xs text-amber-300 bg-amber-950/40 p-3 rounded-lg border border-amber-800/50">
                    💡 Hint: <span id="converter-hint-text">Remember that "my shoes" becomes "shoes are mine"!</span>
                </div>

                <!-- Feedback Banner -->
                <div id="converter-feedback" class="hidden p-4 rounded-xl text-center font-bold text-sm"></div>
            </div>
        </section>

        <!-- TAB 3: LOST & FOUND DESK GAME -->
        <section id="tab-lost-found" class="tab-content hidden space-y-6">
            <div class="glass-panel p-6 rounded-2xl border border-indigo-500/20 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-xl font-bold text-white">Activity 2: The Lost & Found Desk</h2>
                    <p class="text-slate-300 text-sm">Practice asking and answering <strong>"Whose is this?"</strong> and <strong>"Whose are these?"</strong></p>
                </div>
                <div class="flex items-center space-x-3 bg-slate-800/80 px-4 py-2 rounded-xl border border-slate-700">
                    <span class="text-xs text-slate-400">Owner Tag:</span>
                    <span id="lost-owner-badge" class="font-extrabold text-emerald-400 text-sm">Greg</span>
                </div>
            </div>

            <!-- Game Board -->
