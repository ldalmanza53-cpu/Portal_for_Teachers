    <script>
        // Data for textbook answer key
        const listeningKey = {
            benEmail: "ben.durant@cup.org",
            caraPhone: "646-555-3092",
            caraEmail: "cruiz99@cambridge.org",
            andreaPhone: "212-555-9143",
            andreaEmail: "aclark12@eval.com",
            akiraPhone: "310-555-6670",
            akiraEmail: "akira.h@net.com"
        };

        const randomNames = ["Maria Ventura", "Lucas Silva", "Hana Sato", "David Chen", "Elena Gomez", "Mateo Rossi"];
        const randomDomains = ["cup.org", "cambridge.org", "eval.com", "net.com"];

        // State
        let userScore = 0;
        let streak = 0;
        let myContacts = [
            { name: "Maria Ventura", phone: "323-555-7392", email: "mventura@cup.org" },
            { name: "Ben Durant", phone: "718-555-8241", email: "ben.durant@cup.org" }
        ];

        // Web Audio API for sound effects
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'correct') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(659.25, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'wrong') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                osc.frequency.setValueAtTime(180, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'click') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.05);
            }
        }

        // Text To Speech
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.85;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        function speakPhone(phoneStr) {
            // Read phone numbers as individual digits with pauses
            const spoken = phoneStr.split('').map(char => {
                if (char === '-') return ' dash ';
                if (char === '0') return ' oh ';
                return char;
            }).join(' ');
            speakText(`It's ${spoken}`);
        }

        function speakEmail(emailStr) {
            const spoken = emailStr
                .replace(/@/g, " at ")
                .replace(/\./g, " dot ")
                .replace(/_/g, " underscore ")
                .replace(/-/g, " dash ");
            speakText(`It's ${spoken}`);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            renderDirectory();
            document.getElementById('customInput').addEventListener('input', updatePhoneticBreakdown);
            updatePhoneticBreakdown();
        });

        // Tab Switching
        function switchTab(tabId) {
            playSound('click');
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('bg-indigo-600', 'text-white', 'shadow');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow');
            activeBtn.classList.remove('text-slate-300');
        }

        /* --- TAB 1: LISTENING SIMULATION --- */
        function playFullAudioSimulation() {
            speakText("Ben Durant's phone number is 718 555 8241 and his email address is ben dot durant at cup dot org. Cara Ruiz's phone number is 646 555 3092 and her email address is cruiz 99 at cambridge dot org. Andrea Clark's phone number is 212 555 9143 and her email address is aclark 12 at eval dot com. Akira Hayashi's phone number is 310 555 6670 and his email address is akira dot h at net dot com.");
        }

        function playIndividualAudio(person) {
            if (person === 'ben') {
                speakText("Ben Durant. Phone: 718 555 8241. Email: ben dot durant at cup dot org.");
            } else if (person === 'cara') {
                speakText("Cara Ruiz. Phone: 646 555 3092. Email: cruiz 99 at cambridge dot org.");
            } else if (person === 'andrea') {
                speakText("Andrea Clark. Phone: 212 555 9143. Email: aclark 12 at eval dot com.");
            } else if (person === 'akira') {
                speakText("Akira Hayashi. Phone: 310 555 6670. Email: akira dot h at net dot com.");
            }
        }

        function checkListeningAnswers() {
            const benE = document.getElementById('ans-ben-email').value.trim().toLowerCase();
            const caraP = document.getElementById('ans-cara-phone').value.trim();
            const caraE = document.getElementById('ans-cara-email').value.trim().toLowerCase();
            const andreaP = document.getElementById('ans-andrea-phone').value.trim();
            const andreaE = document.getElementById('ans-andrea-email').value.trim().toLowerCase();
            const akiraP = document.getElementById('ans-akira-phone').value.trim();
            const akiraE = document.getElementById('ans-akira-email').value.trim().toLowerCase();

            let score = 0;
            if (benE === listeningKey.benEmail) score++;
            if (caraP === listeningKey.caraPhone) score++;
            if (caraE === listeningKey.caraEmail) score++;
            if (andreaP === listeningKey.andreaPhone) score++;
            if (andreaE === listeningKey.andreaEmail) score++;
            if (akiraP === listeningKey.akiraPhone) score++;
            if (akiraE === listeningKey.akiraEmail) score++;

            const feedback = document.getElementById('listeningFeedback');
            feedback.classList.remove('hidden');

            if (score === 7) {
                playSound('correct');
                confetti({ particleCount: 80, spread: 60 });
                userScore += 70;
                streak++;
                updateStats();
                feedback.className = 'p-4 rounded-xl text-center font-bold text-sm bg-emerald-950 text-emerald-300 border border-emerald-600 max-w-xl mx-auto';
                feedback.innerHTML = `<i class="fa-solid fa-trophy text-amber-400 mr-2"></i> Perfect! All contact entries match the textbook audio (+70 pts)`;
            } else {
                playSound('wrong');
                feedback.className = 'p-4 rounded-xl text-center font-bold text-sm bg-amber-950 text-amber-300 border border-amber-600 max-w-xl mx-auto';
                feedback.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-2"></i> You got ${score} out of 7 correct. Check phone hyphenation or email spelling!`;
            }
        }

        function revealListeningAnswers() {
            document.getElementById('ans-ben-email').value = listeningKey.benEmail;
            document.getElementById('ans-cara-phone').value = listeningKey.caraPhone;
            document.getElementById('ans-cara-email').value = listeningKey.caraEmail;
            document.getElementById('ans-andrea-phone').value = listeningKey.andreaPhone;
            document.getElementById('ans-andrea-email').value = listeningKey.andreaEmail;
            document.getElementById('ans-akira-phone').value = listeningKey.akiraPhone;
            document.getElementById('ans-akira-email').value = listeningKey.akiraEmail;
        }

        /* --- TAB 2: PRONUNCIATION TESTER --- */
        function updatePhoneticBreakdown() {
            const val = document.getElementById('customInput').value;
            const spoken = val
                .replace(/@/g, " <strong>at</strong> ")
                .replace(/\./g, " <strong>dot</strong> ")
                .replace(/_/g, " <strong>underscore</strong> ")
                .replace(/-/g, " <strong>dash</strong> ");
            document.getElementById('phoneticBreakdown').innerHTML = `Spoken form: "${spoken}"`;
        }

        function pronounceCustom() {
            const val = document.getElementById('customInput').value;
            speakEmail(val);
        }

        /* --- TAB 3: DIRECTORY CREATOR --- */
        function renderDirectory() {
            const container = document.getElementById('directoryContainer');
            container.innerHTML = '';

            myContacts.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'bg-slate-900 border border-slate-700 p-4 rounded-xl space-y-3 relative group';
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-indigo-900/60 text-indigo-400 font-bold flex items-center justify-center border border-indigo-500/40">
                                ${item.name.charAt(0)}
                            </div>
                            <div>
                                <h4 class="font-bold text-white text-base">${item.name}</h4>
                                <span class="text-xs text-slate-400">Classmate Entry #${index + 1}</span>
                            </div>
                        </div>
                        <button onclick="removeContact(${index})" class="text-slate-500 hover:text-red-400 text-xs">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>

                    <div class="space-y-1 text-xs font-mono">
                        <div class="flex justify-between items-center p-2 bg-slate-950 rounded border border-slate-800">
                            <span class="text-slate-400"><i class="fa-solid fa-phone mr-1"></i> ${item.phone}</span>
                            <button onclick="speakPhone('${item.phone}')" class="text-indigo-400 hover:text-indigo-300"><i class="fa-solid fa-volume-high"></i></button>
                        </div>
                        <div class="flex justify-between items-center p-2 bg-slate-950 rounded border border-slate-800">
                            <span class="text-slate-400"><i class="fa-solid fa-envelope mr-1"></i> ${item.email}</span>
                            <button onclick="speakEmail('${item.email}')" class="text-indigo-400 hover:text-indigo-300"><i class="fa-solid fa-volume-high"></i></button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function addCustomContact() {
            const name = document.getElementById('dirName').value.trim();
            const phone = document.getElementById('dirPhone').value.trim();
            const email = document.getElementById('dirEmail').value.trim();

            if (!name || !phone || !email) {
                alert("Please fill out all contact fields!");
                return;
            }

            myContacts.push({ name, phone, email });
            renderDirectory();
            document.getElementById('dirName').value = '';
            document.getElementById('dirPhone').value = '';
            document.getElementById('dirEmail').value = '';
            playSound('click');
        }

        function addRandomClassmate() {
            const name = randomNames[Math.floor(Math.random() * randomNames.length)];
            const area = Math.floor(200 + Math.random() * 700);
            const mid = Math.floor(100 + Math.random() * 800);
            const phone = `${area}-555-${mid}`;
            const domain = randomDomains[Math.floor(Math.random() * randomDomains.length)];
            const email = `${name.toLowerCase().replace(' ', '.')}@${domain}`;

            myContacts.push({ name, phone, email });
            renderDirectory();
            playSound('click');
        }

        function removeContact(idx) {
            myContacts.splice(idx, 1);
            renderDirectory();
            playSound('click');
        }

        /* --- TAB 4: DIALOGUE SHUFFLE --- */
        function shuffleDialoguePartner() {
            playSound('click');
            const name = randomNames[Math.floor(Math.random() * randomNames.length)];
            const area = Math.floor(200 + Math.random() * 700);
            const mid = Math.floor(100 + Math.random() * 800);
            const phone = `${area}-555-${mid}`;

            document.getElementById('dialogueNameVal').innerText = `"I'm ${name}."`;
            document.getElementById('dialoguePhoneVal').innerText = `"It's ${phone}."`;
        }

        function updateStats() {
            document.getElementById('scoreDisplay').innerText = userScore;
            document.getElementById('streakDisplay').innerText = streak;
        }
    </script>
</body>
</html>
