<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>English Starter: The Verb 'be' Masterclass</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <!-- Google Fonts (Poppins) -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Canvas Confetti Library -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f3f4f6;
      color: #1f2937;
    }
    
    .tab-active {
      background-color: #4f46e5 !important;
      color: #ffffff !important;
      box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);
    }
    
    .card-hover {
      transition: all 0.25s ease-in-out;
    }
    .card-hover:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
    }

    @keyframes pulse-subtle {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }
    .animate-pulse-subtle {
      animation: pulse-subtle 2s infinite ease-in-out;
    }

    /* Print certificate styles */
    @media print {
      body * {
        visibility: hidden;
      }
      #certificate-modal, #certificate-modal * {
        visibility: visible;
      }
      #certificate-modal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: white !important;
        box-shadow: none !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-50">

  <!-- HEADER & NAVIGATION -->
  <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 md:h-20">
        
        <!-- Brand Title -->
        <div class="flex items-center space-x-3">
          <div class="bg-amber-400 text-indigo-900 font-extrabold text-xl p-2.5 rounded-xl shadow">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div>
            <h1 class="font-bold text-lg md:text-xl leading-tight">English Starter</h1>
            <p class="text-xs text-indigo-200 hidden sm:block">The Verb 'be' Interactive Masterclass</p>
          </div>
        </div>

        <!-- Student Profile & XP Score -->
        <div class="flex items-center space-x-3 sm:space-x-5">
          <!-- Student Name Input -->
          <div class="relative hidden md:block">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-indigo-300">
              <i class="fa-solid fa-user-gear"></i>
            </span>
            <input type="text" id="student-name-input" value="Alex Student" placeholder="Your Name" 
              class="pl-9 pr-3 py-1.5 bg-indigo-700/60 text-white placeholder-indigo-300 rounded-lg text-sm border border-indigo-500 focus:outline-none focus:ring-2 focus:ring-amber-400 font-medium w-40" />
          </div>

          <!-- Score Tracker Badge -->
          <div class="bg-indigo-800/80 border border-indigo-400/40 px-3 py-1.5 rounded-full flex items-center space-x-2">
            <i class="fa-solid fa-star text-amber-400 text-base animate-bounce"></i>
            <span id="score-xp" class="font-bold text-amber-300 text-sm md:text-base">0 XP</span>
          </div>

          <!-- Sound Toggle -->
          <button id="sound-toggle-btn" class="bg-indigo-700 hover:bg-indigo-800 text-white p-2.5 rounded-full transition focus:outline-none" title="Toggle Sound">
            <i id="sound-icon" class="fa-solid fa-volume-high text-sm md:text-base"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Tab Bar -->
    <nav class="bg-indigo-700/80 backdrop-blur-md border-t border-indigo-500/30 overflow-x-auto scrollbar-none">
      <div class="max-w-7xl mx-auto px-4 flex space-x-2 py-2 min-w-max">
        <button onclick="switchTab('grammar-tab')" id="nav-grammar-tab" class="tab-button tab-active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition">
          <i class="fa-solid fa-book-open"></i>
          <span>Grammar Focus</span>
        </button>
        <button onclick="switchTab('exercises-tab')" id="nav-exercises-tab" class="tab-button bg-indigo-800/40 text-indigo-100 hover:bg-indigo-600 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition">
          <i class="fa-solid fa-pen-to-square"></i>
          <span>Textbook Exercises</span>
        </button>
        <button onclick="switchTab('classmate-hunt-tab')" id="nav-classmate-hunt-tab" class="tab-button bg-indigo-800/40 text-indigo-100 hover:bg-indigo-600 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span>Classmate Hunt</span>
        </button>
        <button onclick="switchTab('classroom-map-tab')" id="nav-classroom-map-tab" class="tab-button bg-indigo-800/40 text-indigo-100 hover:bg-indigo-600 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Classroom Map</span>
        </button>
        <button onclick="switchTab('quiz-tab')" id="nav-quiz-tab" class="tab-button bg-indigo-800/40 text-indigo-100 hover:bg-indigo-600 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition">
          <i class="fa-solid fa-award"></i>
          <span>Exit & Certificate</span>
        </button>
      </div>
    </nav>
  </header>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

    <!-- TAB 1: GRAMMAR FOCUS -->
    <section id="grammar-tab" class="tab-content block space-y-6">
      
      <!-- Intro Banner -->
      <div class="bg-gradient-to-r from-amber-500 to-orange-500 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <span class="bg-amber-700/40 text-amber-100 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Unit 1 Grammar</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold mt-1">The Verb <span class="underline decoration-wavy decoration-amber-200">be</span></h2>
          <p class="text-amber-100 text-sm mt-1 max-w-xl">Learn how to state identities, locations, and feelings using <b>am</b>, <b>is</b>, and <b>are</b> along with contractions!</p>
        </div>
        
        <!-- Toggle Contractions Control -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-3 rounded-xl flex items-center space-x-3">
          <span class="text-xs font-semibold uppercase text-amber-100">Display Mode:</span>
          <button id="toggle-contraction-btn" onclick="toggleContractions()" class="bg-white text-orange-600 font-bold px-4 py-2 rounded-lg text-sm shadow hover:bg-amber-50 transition flex items-center space-x-2">
            <i class="fa-solid fa-arrows-rotate"></i>
            <span id="contraction-mode-text">Contractions (I'm)</span>
          </button>
        </div>
      </div>

      <!-- Conjugation & Example Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Affirmative Statements Card -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 card-hover flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-indigo-900 text-lg flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-500"></i> Statements
              </h3>
              <span class="bg-indigo-50 text-indigo-700 text-xs px-2.5 py-1 rounded-md font-semibold">Positive</span>
            </div>
            
            <ul class="space-y-3 text-sm">
              <li class="p-2.5 bg-slate-50 rounded-xl flex justify-between items-center border border-slate-100">
                <div>
                  <span class="font-bold text-indigo-600 verb-display">I'm</span>
                  <span class="text-slate-700"> Lena Garza.</span>
                </div>
                <button onclick="speakText('I am Lena Garza')" class="text-indigo-500 hover:text-indigo-700 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
              </li>
              <li class="p-2.5 bg-slate-50 rounded-xl flex justify-between items-center border border-slate-100">
                <div>
                  <span class="font-bold text-indigo-600 verb-display">You're</span>
                  <span class="text-slate-700"> in my class.</span>
                </div>
                <button onclick="speakText('You are in my class')" class="text-indigo-500 hover:text-indigo-700 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
              </li>
              <li class="p-2.5 bg-slate-50 rounded-xl flex justify-between items-center border border-slate-100">
                <div>
                  <span class="font-bold text-indigo-600 verb-display">She's</span>
                  <span class="text-slate-700"> over there.</span>
                  <span class="block text-xs text-slate-400 font-normal">(Andrea is over there)</span>
                </div>
                <button onclick="speakText('She is over there')" class="text-indigo-500 hover:text-indigo-700 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
              </li>
              <li class="p-2.5 bg-slate-50 rounded-xl flex justify-between items-center border border-slate-100">
                <div>
                  <span class="font-bold text-indigo-600 verb-display">He's</span>
                  <span class="text-slate-700"> in our class.</span>
                  <span class="block text-xs text-slate-400 font-normal">(Ben is in our class)</span>
                </div>
                <button onclick="speakText('He is in our class')" class="text-indigo-500 hover:text-indigo-700 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
              </li>
              <li class="p-2.5 bg-slate-50 rounded-xl flex justify-between items-center border border-slate-100">
                <div>
                  <span class="font-bold text-indigo-600 verb-display">It's</span>
                  <span class="text-slate-700"> Garza.</span>
                  <span class="block text-xs text-slate-400 font-normal">(My last name is Garza)</span>
                </div>
                <button onclick="speakText('It is Garza. My last name is Garza')" class="text-indigo-500 hover:text-indigo-700 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
              </li>
            </ul>
          </div>
        </div>

        <!-- Questions & Short Answers Card -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 card-hover flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-indigo-900 text-lg flex items-center gap-2">
                <i class="fa-solid fa-circle-question text-amber-500"></i> Questions & Answers
              </h3>
              <span class="bg-amber-50 text-amber-700 text-xs px-2.5 py-1 rounded-md font-semibold">Short Answers</span>
            </div>

            <ul class="space-y-3 text-sm">
              <li class="p-3 bg-amber-50/50 rounded-xl border border-amber-100">
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-semibold text-slate-800">Are you <span class="text-indigo-600">Andrea Clark</span>?</p>
                    <p class="text-emerald-600 font-medium text-xs mt-1"><i class="fa-solid fa-check mr-1"></i> Yes, I am.</p>
                    <p class="text-rose-600 font-medium text-xs mt-0.5"><i class="fa-solid fa-xmark mr-1"></i> No, I'm not.</p>
                  </div>
                  <button onclick="speakText('Are you Andrea Clark? Yes, I am. No, I am not.')" class="text-amber-600 hover:text-amber-800 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
                </div>
              </li>
              <li class="p-3 bg-amber-50/50 rounded-xl border border-amber-100">
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-semibold text-slate-800">How <span class="text-indigo-600">are</span> you?</p>
                    <p class="text-emerald-600 font-medium text-xs mt-1"><i class="fa-solid fa-comment mr-1"></i> I'm fine, thanks.</p>
                  </div>
                  <button onclick="speakText('How are you? I am fine, thanks.')" class="text-amber-600 hover:text-amber-800 p-1.5"><i class="fa-solid fa-volume-high"></i></button>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contractions Quick Guide Card -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 card-hover flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <h3 class="font-bold text-indigo-900 text-lg flex items-center gap-2">
                <i class="fa-solid fa-link text-indigo-500"></i> Contraction Key
              </h3>
              <span class="bg-emerald-50 text-emerald-700 text-xs px-2.5 py-1 rounded-md font-semibold">Equations</span>
            </div>

            <div class="grid grid-cols-1 gap-2.5 text-sm">
              <div class="p-2.5 bg-indigo-50/60 rounded-xl flex items-center justify-between font-mono font-medium text-indigo-900">
                <span>I'm</span>
                <span class="text-xs font-sans text-slate-400">=</span>
                <span>I am</span>
              </div>
              <div class="p-2.5 bg-indigo-50/60 rounded-xl flex items-center justify-between font-mono font-medium text-indigo-900">
                <span>You're</span>
                <span class="text-xs font-sans text-slate-400">=</span>
                <span>You are</span>
              </div>
              <div class="p-2.5 bg-indigo-50/60 rounded-xl flex items-center justify-between font-mono font-medium text-indigo-900">
                <span>He's</span>
                <span class="text-xs font-sans text-slate-400">=</span>
                <span>He is</span>
              </div>
              <div class="p-2.5 bg-indigo-50/60 rounded-xl flex items-center justify-between font-mono font-medium text-indigo-900">
                <span>She's</span>
                <span class="text-xs font-sans text-slate-400">=</span>
                <span>She is</span>
              </div>
              <div class="p-2.5 bg-indigo-50/60 rounded-xl flex items-center justify-between font-mono font-medium text-indigo-900">
                <span>It's</span>
                <span class="text-xs font-sans text-slate-400">=</span>
                <span>It is</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- TAB 2: TEXTBOOK EXERCISES -->
    <section id="exercises-tab" class="tab-content hidden space-y-8">
      
      <!-- Section Header -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="bg-indigo-100 text-indigo-800 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Interactive Practice</span>
            <h2 class="text-2xl font-bold text-slate-800 mt-2">Textbook Page Exercises</h2>
            <p class="text-slate-600 text-sm">Complete the conversations with correct forms of the verb <i>be</i> and contractions.</p>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="playFullDialogueA()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-xl text-sm transition flex items-center gap-2">
              <i class="fa-solid fa-play"></i> Listen Part A
            </button>
            <button onclick="playFullDialogueB()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2 rounded-xl text-sm transition flex items-center gap-2">
              <i class="fa-solid fa-play"></i> Listen Part B
            </button>
          </div>
        </div>
      </div>

      <!-- PART A EXERCISE -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-6">
        <div class="border-b border-slate-100 pb-4 flex justify-between items-center flex-wrap gap-2">
          <div>
            <h3 class="font-bold text-slate-800 text-lg">Part A: Complete the conversation</h3>
            <p class="text-xs text-slate-500">Choose the correct option in parentheses for each blank.</p>
          </div>
          <div id="part-a-status" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-600">
            0 / 9 Completed
          </div>
        </div>

        <!-- Dialogue List -->
        <div class="space-y-4 max-w-3xl text-sm sm:text-base leading-relaxed">
          
          <!-- Line 1 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-indigo-900 w-20 shrink-0">Ben:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <span>Hello, Christy. How</span>
              <select id="part-a-q1" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 focus:outline-none text-sm">
                <option value="">-- select --</option>
                <option value="are">are</option>
                <option value="is">is</option>
              </select>
              <span>you?</span>
            </div>
          </div>

          <!-- Line 2 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-pink-700 w-20 shrink-0">Christy:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <select id="part-a-q2" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="I'm">I'm</option>
                <option value="It's">It's</option>
              </select>
              <span>fine, thanks.</span>
              <select id="part-a-q3" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="I'm">I'm</option>
                <option value="It's">It's</option>
              </select>
              <span>sorry — what's your name again?</span>
            </div>
          </div>

          <!-- Line 3 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-indigo-900 w-20 shrink-0">Ben:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <select id="part-a-q4" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="Is">Is</option>
                <option value="It's">It's</option>
              </select>
              <span>Ben — Ben Durant.</span>
            </div>
          </div>

          <!-- Line 4 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-pink-700 w-20 shrink-0">Christy:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <span>That's right! Ben, this</span>
              <select id="part-a-q5" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="is">is</option>
                <option value="it's">it's</option>
              </select>
              <span>Joshua Brown.</span>
              <select id="part-a-q6" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="He's">He's</option>
                <option value="She's">She's</option>
              </select>
              <span>in our history class.</span>
            </div>
          </div>

          <!-- Line 5 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-indigo-900 w-20 shrink-0">Ben:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <select id="part-a-q7" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="I'm">I'm</option>
                <option value="It's">It's</option>
              </select>
              <span>nice to meet you.</span>
            </div>
          </div>

          <!-- Line 6 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-emerald-700 w-20 shrink-0">Joshua:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <span>Hi, Ben. I think</span>
              <select id="part-a-q8" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="I'm">I'm</option>
                <option value="you're">you're</option>
              </select>
              <span>in my English class, too.</span>
            </div>
          </div>

          <!-- Line 7 -->
          <div class="flex items-start space-x-3 bg-slate-50 p-3 rounded-xl">
            <span class="font-bold text-indigo-900 w-20 shrink-0">Ben:</span>
            <div class="flex-grow flex items-center flex-wrap gap-2">
              <span>Oh, right! Yes, I</span>
              <select id="part-a-q9" onchange="checkPartAProgress()" class="bg-white border-2 border-slate-300 rounded-lg px-2.5 py-1 font-semibold text-indigo-700 focus:border-indigo-500 text-sm">
                <option value="">-- select --</option>
                <option value="am">am</option>
                <option value="'m">'m</option>
              </select>
              <span>.</span>
            </div>
          </div>

        </div>

        <!-- Buttons -->
        <div class="flex flex-wrap gap-3 pt-2">
          <button onclick="validatePartA()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> Check Part A Answers
          </button>
          <button onclick="revealPartA()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-4 py-2.5 rounded-xl text-sm transition">
            Show Part A Solutions
          </button>
        </div>
      </div>

      <!-- PART B EXERCISE -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-6">
        <div class="border-b border-slate-100 pb-4 flex justify-between items-center flex-wrap gap-2">
