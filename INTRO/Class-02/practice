  <script>
    /* Global App State */
    let totalXP = 0;
    let isSoundMuted = false;
    let showContractions = true;
    let currentTargetPerson = null;
    let selectedClassmateAvatar = null;
    let currentMapQuestionIndex = 0;
    let mapStreak = 0;

    /* Sound Synthesis (Web Audio API) */
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playSound(type) {
      if (isSoundMuted) return;
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        const now = audioCtx.currentTime;

        if (type === 'click') {
          osc.frequency.setValueAtTime(400, now);
          gain.gain.setValueAtTime(0.05, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
          osc.start(now);
          osc.stop(now + 0.05);
        } else if (type === 'correct') {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(523.25, now); // C5
          osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
          osc.start(now);
          osc.stop(now + 0.3);
        } else if (type === 'wrong') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(220, now);
          osc.frequency.setValueAtTime(180, now + 0.1);
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
        } else if (type === 'fanfare') {
          confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(523.25, now);
          osc.frequency.setValueAtTime(659.25, now + 0.15);
          osc.frequency.setValueAtTime(783.99, now + 0.3);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
          osc.start(now);
          osc.stop(now + 0.6);
        }
      } catch (e) {
        console.log("Audio not allowed yet");
      }
    }

    /* Sound Toggle */
    document.getElementById('sound-toggle-btn').addEventListener('click', () => {
      isSoundMuted = !isSoundMuted;
      const icon = document.getElementById('sound-icon');
      if (isSoundMuted) {
        icon.className = 'fa-solid fa-volume-xmark text-slate-400';
      } else {
        icon.className = 'fa-solid fa-volume-high';
        playSound('click');
      }
    });

    /* Text to Speech Synthesis */
    function speakText(text) {
      playSound('click');
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel(); // Stop current speech
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = 0.9;
        utterance.lang = 'en-US';
        window.speechSynthesis.speak(utterance);
      }
    }

    /* Add XP function */
    function addXP(amount) {
      totalXP += amount;
      document.getElementById('score-xp').textContent = totalXP + ' XP';
    }

    /* Tab Switcher */
    function switchTab(tabId) {
      playSound('click');
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-button').forEach(el => {
        el.classList.remove('tab-active');
        el.classList.add('bg-indigo-800/40', 'text-indigo-100');
      });

      document.getElementById(tabId).classList.remove('hidden');
      const activeNavBtn = document.getElementById('nav-' + tabId);
      if (activeNavBtn) {
        activeNavBtn.classList.add('tab-active');
        activeNavBtn.classList.remove('bg-indigo-800/40', 'text-indigo-100');
      }
    }

    /* TAB 1: Grammar Focus Functions */
    function toggleContractions() {
      showContractions = !showContractions;
      playSound('click');
      const btnText = document.getElementById('contraction-mode-text');
      const displays = document.querySelectorAll('.verb-display');

      if (showContractions) {
        btnText.textContent = "Contractions (I'm)";
        displays[0].textContent = "I'm";
        displays[1].textContent = "You're";
        displays[2].textContent = "She's";
        displays[3].textContent = "He's";
        displays[4].textContent = "It's";
      } else {
        btnText.textContent = "Full Form (I am)";
        displays[0].textContent = "I am";
        displays[1].textContent = "You are";
        displays[2].textContent = "She is";
        displays[3].textContent = "He is";
        displays[4].textContent = "It is";
      }
    }


    /* TAB 2: Textbook Exercises Validation Data & Logic */
    const answersPartA = {
      'part-a-q1': 'are',
      'part-a-q2': "I'm",
      'part-a-q3': "I'm",
      'part-a-q4': "It's",
      'part-a-q5': 'is',
      'part-a-q6': "He's",
      'part-a-q7': "It's",
      'part-a-q8': "you're",
      'part-a-q9': 'am'
    };

    function checkPartAProgress() {
      let filled = 0;
      Object.keys(answersPartA).forEach(id => {
        if (document.getElementById(id).value !== "") filled++;
      });
      document.getElementById('part-a-status').textContent = `${filled} / 9 Completed`;
    }

    function validatePartA() {
      let correctCount = 0;
      Object.keys(answersPartA).forEach(id => {
        const el = document.getElementById(id);
        if (el.value === answersPartA[id]) {
          el.className = "bg-emerald-100 border-2 border-emerald-500 rounded-lg px-2.5 py-1 font-semibold text-emerald-800 text-sm";
          correctCount++;
        } else {
          el.className = "bg-rose-100 border-2 border-rose-500 rounded-lg px-2.5 py-1 font-semibold text-rose-800 text-sm";
        }
      });

      if (correctCount === 9) {
        playSound('fanfare');
        addXP(50);
        alert('Perfect! All Part A answers are correct! (+50 XP)');
      } else {
        playSound('wrong');
        alert(`You got ${correctCount} out of 9 correct. Review the highlighted fields!`);
      }
    }

    function revealPartA() {
      playSound('click');
      Object.keys(answersPartA).forEach(id => {
        const el = document.getElementById(id);
        el.value = answersPartA[id];
        el.className = "bg-indigo-100 border-2 border-indigo-400 rounded-lg px-2.5 py-1 font-semibold text-indigo-900 text-sm";
      });
      checkPartAProgress();
    }

    const answersPartB = {
      'part-b-q1': ['Are', 'are'],
      'part-b-q2': ["I'm", "i'm"],
      'part-b-q3': ['is', 'Is'],
      'part-b-q4': ['is', 'Is'],
      'part-b-q5': ['Are', 'are'],
      'part-b-q6': ['am'],
      'part-b-q7': ["I'm", "i'm"],
      'part-b-q8': ["you're", "You're"],
      'part-b-q9': ['am'],
      'part-b-q10': ["It's", "it's"]
    };

    function validatePartB() {
      let correctCount = 0;
      Object.keys(answersPartB).forEach(id => {
        const el = document.getElementById(id);
        const val = el.value.trim();
        if (answersPartB[id].includes(val)) {
          el.className = "w-20 px-2 py-1 border-2 border-emerald-500 bg-emerald-50 rounded-md font-semibold text-emerald-800 text-center text-sm";
          correctCount++;
        } else {
          el.className = "w-20 px-2 py-1 border-2 border-rose-500 bg-rose-50 rounded-md font-semibold text-rose-800 text-center text-sm";
        }
      });

      if (correctCount === 10) {
        playSound('fanfare');
        addXP(50);
        alert('Awesome! All Part B answers are correct! (+50 XP)');
      } else {
        playSound('wrong');
        alert(`You got ${correctCount} out of 10 correct. Try again!`);
      }
    }

    function revealPartB() {
      playSound('click');
      Object.keys(answersPartB).forEach(id => {
        const el = document.getElementById(id);
        el.value = answersPartB[id][0];
        el.className = "w-20 px-2 py-1 border-2 border-indigo-400 bg-indigo-50 rounded-md font-semibold text-indigo-900 text-center text-sm";
      });
    }

    /* Read Whole Dialogues via Audio */
    function playFullDialogueA() {
      const dialogueText = "Ben says: Hello Christy, how are you? Christy says: I am fine, thanks. I am sorry, what is your name again? Ben says: It is Ben, Ben Durant. Christy says: That is right! Ben, this is Joshua Brown. He is in our history class. Ben says: It is nice to meet you. Joshua says: Hi Ben, I think you are in my English class too. Ben says: Oh right! Yes I am.";
      speakText(dialogueText);
    }

    function playFullDialogueB() {
      const dialogueText = "Cara says: Excuse me, are you Alex Lane? James says: No, I am not. My name is James Harris. Alex is over there. Cara says: Oh, sorry. Cara says: Are you Alex Lane? Alex says: Yes, I am. Cara says: Hi, I am Cara Ruiz. Alex says: Oh, you are in my history class, right? Cara says: Yes, I am. Alex says: It is nice to meet you, Cara.";
      speakText(dialogueText);
    }


    /* TAB 3: Classmate Hunt Simulator Logic */
    const classmatesData = [
      { id: 'alex', name: 'Alex Lane', avatar: '🧑‍🎓', gender: 'male', class: 'History Class' },
      { id: 'james', name: 'James Harris', avatar: '👨‍🎓', gender: 'male', class: 'English Class' },
      { id: 'minji', name: 'Min-ji Cho', avatar: '👩‍🎓', gender: 'female', class: 'English Class' },
      { id: 'ben', name: 'Ben Durant', avatar: '🙋‍♂️', gender: 'male', class: 'History Class' },
      { id: 'joshua', name: 'Joshua Brown', avatar: '🏼‍♂️', gender: 'male', class: 'History Class' },
      { id: 'cara', name: 'Cara Ruiz', avatar: '🙋‍♀️', gender: 'female', class: 'History Class' }
    ];

    function renderClassmateAvatars() {
      const grid = document.getElementById('avatar-grid');
      grid.innerHTML = '';

      classmatesData.forEach(person => {
        const card = document.createElement('button');
        card.className = "bg-slate-50 hover:bg-indigo-50 border-2 border-slate-200 hover:border-indigo-400 p-4 rounded-2xl flex flex-col items-center text-center transition card-hover focus:outline-none";
        card.onclick = () => selectClassmateAvatar(person);
        card.innerHTML = `
          <div class="text-4xl mb-2">${person.avatar}</div>
          <p class="font-bold text-slate-800 text-xs sm:text-sm">${person.name}</p>
          <span class="text-[10px] bg-slate-200 text-slate-600 px-2 py-0.5 rounded-full mt-1 font-medium">${person.class}</span>
        `;
        grid.appendChild(card);
      });
    }

    function drawSecretTarget() {
      playSound('click');
      const randomPerson = classmatesData[Math.floor(Math.random() * classmatesData.length)];
      currentTargetPerson = randomPerson;

      document.getElementById('target-name-display').textContent = `Find ${randomPerson.name}!`;
      document.getElementById('ask-target-text').textContent = `"Excuse me. Are you ${randomPerson.name}?"`;
      
      const badge = document.getElementById('hunt-status-badge');
      badge.textContent = "Active Hunt";
      badge.className = "bg-amber-500 text-white text-xs px-3 py-1 rounded-full font-semibold animate-pulse";

      // Reset dialogue
      document.getElementById('dialogue-box').innerHTML = `
        <p class="text-indigo-900 font-semibold text-sm">Target drawn: <b>${randomPerson.name}</b>!</p>
        <p class="text-slate-500 text-xs">Click on any student avatar in the lounge to ask if they are ${randomPerson.name}.</p>
      `;
      document.getElementById('dialogue-options').classList.add('hidden');
    }

    function selectClassmateAvatar(person) {
      playSound('click');
      selectedClassmateAvatar = person;

      document.getElementById('speaking-with-badge').textContent = `Talking to ${person.name}`;
      document.getElementById('dialogue-box').innerHTML = `
        <div class="text-3xl mb-1">${person.avatar}</div>
        <p class="font-bold text-slate-800 text-sm">You approached ${person.name}.</p>
        <p class="text-slate-500 text-xs">Choose a question below to speak!</p>
      `;

      document.getElementById('dialogue-options').classList.remove('hidden');
    }

    function askClassmateTarget() {
      if (!selectedClassmateAvatar) return;

      if (!currentTargetPerson) {
        alert('Please draw a secret target slip first!');
        return;
      }

      const isTargetMatch = (selectedClassmateAvatar.id === currentTargetPerson.id);

      if (isTargetMatch) {
        playSound('fanfare');
        addXP(30);

        const responseText = `Yes, I am! I am ${selectedClassmateAvatar.name}. It is nice to meet you!`;
        document.getElementById('dialogue-box').innerHTML = `
          <div class="text-4xl mb-1">🎉 ${selectedClassmateAvatar.avatar}</div>
          <p class="font-extrabold text-emerald-600 text-base sm:text-lg">"${responseText}"</p>
          <p class="text-xs bg-emerald-100 text-emerald-800 p-2 rounded-lg font-bold mt-2">Mission Accomplished! You found ${currentTargetPerson.name}! (+30 XP)</p>
        `;
        speakText(responseText);

        document.getElementById('hunt-status-badge').textContent = "Completed";
        document.getElementById('hunt-status-badge').className = "bg-emerald-500 text-white text-xs px-3 py-1 rounded-full font-semibold";

      } else {
        playSound('wrong');
        const pronoun = selectedClassmateAvatar.gender === 'female' ? "She's" : "He's";
        const responseText = `No, I'm not. My name is ${selectedClassmateAvatar.name}. ${currentTargetPerson.name}? ${pronoun} over there!`;
        
        document.getElementById('dialogue-box').innerHTML = `
          <div class="text-3xl mb-1">${selectedClassmateAvatar.avatar}</div>
          <p class="font-bold text-slate-800 text-sm sm:text-base">"${responseText}"</p>
          <p class="text-xs text-slate-400 mt-1">Keep looking in the lounge!</p>
        `;
        speakText(responseText);
      }
    }

    function askClassmateHowAreYou() {
      if (!selectedClassmateAvatar) return;
      playSound('click');

      const responseText = `I'm fine, thanks! How are you?`;
      document.getElementById('dialogue-box').innerHTML = `
        <div class="text-3xl mb-1">${selectedClassmateAvatar.avatar}</div>
        <p class="font-bold text-indigo-900 text-sm sm:text-base">"${responseText}"</p>
      `;
      speakText(responseText);
    }


    /* TAB 4: Classroom Map Challenge Questions */
    const mapQuestions = [
      {
        question: "Where is Min-ji Cho?",
        sub: "Look at the English Class room on the map.",
        options: [
          { text: "She's in English class.", correct: true },
          { text: "He's in history class.", correct: false },
          { text: "It's in the hallway.", correct: false }
        ]
      },
      {
        question: "Where is Ben Durant?",
        sub: "Look at the History Class room on the map.",
        options: [
          { text: "She's over there.", correct: false },
          { text: "He's in history class.", correct: true },
          { text: "It's in the courtyard.", correct: false }
        ]
      },
      {
        question: "Where is Alex Lane?",
        sub: "Look at the Courtyard area on the map.",
        options: [
          { text: "He's in the courtyard.", correct: true },
          { text: "She's in English class.", correct: false },
          { text: "It's in history class.", correct: false }
        ]
      },
      {
        question: "Where is the School Bag?",
        sub: "Look at the Hallway area on the map.",
        options: [
          { text: "He's over there.", correct: false },
          { text: "She's in English class.", correct: false },
          { text: "It's in the hallway.", correct: true }
        ]
      }
    ];

    function loadMapQuestion(index) {
      const q = mapQuestions[index];
      document.getElementById('map-q-num').textContent = `Question ${index + 1}/${mapQuestions.length}`;
      document.getElementById('map-question-text').textContent = q.question;
      document.getElementById('map-question-sub').textContent = q.sub;

      const container = document.getElementById('map-options-container');
      container.innerHTML = '';

      q.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-3 rounded-xl border-2 border-slate-200 hover:border-indigo-400 bg-slate-50 hover:bg-indigo-50 font-semibold text-slate-800 text-sm transition focus:outline-none";
        btn.onclick = () => answerMapQuestion(opt, btn);
        btn.textContent = opt.text;
        container.appendChild(btn);
      });

      document.getElementById('map-feedback-box').classList.add('hidden');
    }

    function answerMapQuestion(option, btnElement) {
      const feedbackBox = document.getElementById('map-feedback-box');
      const feedbackMsg = document.getElementById('map-feedback-msg');

      if (option.correct) {
        playSound('correct');
        mapStreak++;
        addXP(20);
        btnElement.className = "w-full text-left p-3 rounded-xl border-2 border-emerald-500 bg-emerald-100 font-bold text-emerald-900 text-sm";
        feedbackMsg.textContent = "✨ Correct! Perfect pronoun choice!";
        feedbackMsg.className = "text-sm font-bold text-emerald-600 mb-2";
      } else {
        playSound('wrong');
        mapStreak = 0;
        btnElement.className = "w-full text-left p-3 rounded-xl border-2 border-rose-500 bg-rose-100 font-bold text-rose-900 text-sm";
        feedbackMsg.textContent = "❌ Incorrect. Remember: He's (male), She's (female), It's (thing/bag).";
        feedbackMsg.className = "text-sm font-bold text-rose-600 mb-2";
      }

      document.getElementById('map-streak-display').textContent = `${mapStreak} 🔥`;
      feedbackBox.classList.remove('hidden');
    }

    function loadNextMapQuestion() {
      currentMapQuestionIndex = (currentMapQuestionIndex + 1) % mapQuestions.length;
      loadMapQuestion(currentMapQuestionIndex);
    }


    /* TAB 5: Exit Assessment & Certificate Generator */
    const quizQuestions = [
      {
        q: "1. Which is correct for asking someone's identity?",
        options: ["Are you Ben?", "Is you Ben?", "Am you Ben?"],
        answer: 0
      },
      {
        q: "2. Complete the greeting: 'How _____ you?' — 'I'm fine, thanks.'",
        options: ["is", "are", "am"],
        answer: 1
      },
      {
        q: "3. Choose the contraction for 'She is over there':",
        options: ["She's over there.", "Her's over there.", "Shes' over there."],
        answer: 0
      },
      {
        q: "4. What is the short response for 'Are you in my history class?'",
        options: ["Yes, I'm.", "Yes, I am.", "Yes, I is."],
        answer: 1
      },
      {
        q: "5. '_____ nice to meet you, Cara.'",
        options: ["He's", "She's", "It's"],
        answer: 2
      }
    ];

    function renderQuiz() {
      const container = document.getElementById('quiz-questions-container');
      container.innerHTML = '';

      quizQuestions.forEach((item, qIdx) => {
        const qBox = document.createElement('div');
        qBox.className = "bg-slate-50 border border-slate-200 p-4 sm:p-5 rounded-2xl space-y-3";
        
        let optionsHTML = item.options.map((opt, oIdx) => `
          <label class="flex items-center space-x-3 bg-white p-3 rounded-xl border border-slate-200 hover:border-indigo-400 cursor-pointer transition">
            <input type="radio" name="quiz-q-${qIdx}" value="${oIdx}" class="w-4 h-4 text-indigo-600 focus:ring-indigo-500" />
            <span class="text-sm font-medium text-slate-800">${opt}</span>
          </label>
        `).join('');

        qBox.innerHTML = `
          <p class="font-bold text-indigo-950 text-sm sm:text-base">${item.q}</p>
          <div class="space-y-2">${optionsHTML}</div>
        `;
        container.appendChild(qBox);
      });
    }

    function submitQuiz() {
      let score = 0;

      quizQuestions.forEach((item, qIdx) => {
        const selected = document.querySelector(`input[name="quiz-q-${qIdx}"]:checked`);
        if (selected && parseInt(selected.value) === item.answer) {
          score++;
        }
      });

      const percentage = Math.round((score / quizQuestions.length) * 100);

      if (score >= 3) {
        playSound('fanfare');
        addXP(100);
        openCertificateModal(percentage);
      } else {
        playSound('wrong');
        alert(`You scored ${percentage}%. Review the Grammar tab and try again to get your certificate!`);
      }
    }

    function openCertificateModal(percentage) {
      const studentName = document.getElementById('student-name-input').value.trim() || 'Alex Student';
      document.getElementById('cert-student-name').textContent = studentName;
      document.getElementById('cert-score-display').textContent = `${percentage}% Mastery Score`;
      
      const now = new Date();
      document.getElementById('cert-date').textContent = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      document.getElementById('certificate-modal').classList.remove('hidden');
    }

    function closeCertificateModal() {
      playSound('click');
      document.getElementById('certificate-modal').classList.add('hidden');
    }

    /* Initialize App on Load */
    window.onload = function() {
      renderClassmateAvatars();
      loadMapQuestion(0);
      renderQuiz();
    };
  </script>
</body>
</html>
