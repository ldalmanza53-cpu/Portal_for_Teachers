<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Word Power - Ways to Celebrate</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f3f5f7;color:#222}
.app{max-width:1100px;margin:auto;padding:22px}
header,section{background:#fff;border-radius:18px;padding:24px;margin-bottom:20px;box-shadow:0 4px 14px rgba(0,0,0,.08)}
.badge{display:inline-block;background:#2878b5;color:#fff;padding:7px 13px;border-radius:18px;font-size:13px;font-weight:bold}
.score{float:right;background:#222;color:#fff;padding:10px 17px;border-radius:22px;font-weight:bold}
h1{margin:12px 0 8px;font-size:32px}
h2{margin-top:0}
.muted{color:#666;line-height:1.5}
.challenge{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.verb-card{border:2px solid #ddd;border-radius:14px;padding:15px;background:#fafafa}
.verb{font-weight:bold;font-size:18px;margin-bottom:10px}
.options{display:flex;flex-wrap:wrap;gap:7px}
.option{border:2px solid #ccc;background:#fff;color:#222;border-radius:9px;padding:8px 10px;cursor:pointer;font:inherit}
.option:hover{border-color:#2878b5}
.option.correct{background:#eaf7ef;border-color:#198754;color:#146c43}
.option.wrong{background:#fff0f0;border-color:#dc3545}
.feedback{min-height:25px;margin-top:14px;font-weight:bold}
.correctText{color:#198754}.wrongText{color:#c62828}
button{border:0;border-radius:10px;padding:11px 17px;background:#222;color:#fff;cursor:pointer;font:inherit}
button:hover{background:#444}
.primary{background:#2878b5}
.match-table{width:100%;border-collapse:collapse;margin-top:15px}
.match-table th,.match-table td{border:1px solid #bbb;padding:10px;text-align:left}
.match-table th{background:#f1f1f1}
.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.choice{background:#fff;color:#222;border:2px solid #ddd;text-align:left;width:100%}
.choice:hover{border-color:#2878b5;background:#eef7ff}
.choice.selected{border-color:#2878b5;background:#eef7ff}
.dialogue{background:#f7f7f7;border-left:5px solid #2878b5;padding:18px;line-height:1.8}
textarea{width:100%;padding:14px;border:1px solid #bbb;border-radius:10px;font:inherit;resize:vertical}
.tip{background:#fff8e6;border:1px solid #e5c76b;padding:15px;border-radius:12px;line-height:1.6}
.reset{background:#777}
@media(max-width:800px){.challenge{grid-template-columns:1fr}.choice-grid{grid-template-columns:1fr}.score{float:none;display:inline-block;margin-top:10px}}
@media(max-width:550px){.app{padding:10px}}
</style>
</head>
<body>
<div class="app">

<header>
  <span class="badge">A2 • WORD POWER</span>
  <span class="score">Score: <span id="score">0</span></span>
  <h1>🎉 Ways to Celebrate</h1>
  <p class="muted">Practice verbs and vocabulary for parties, holidays, birthdays, weddings, and other celebrations.</p>
</header>

<section>
<h2>A. Complete the Word Combinations 🎯</h2>
<p class="muted">
Choose the word or phrase that is naturally paired with each verb.
Some verbs can have more than one correct combination.
</p>

<div class="challenge" id="challenge"></div>
<div id="matchFeedback" class="feedback"></div>
<br>
<button class="primary" id="checkAll">Check My Answers</button>
</section>

<section>
<h2>B. Match More Celebration Expressions 🥳</h2>
<p class="muted">Choose a verb first, then choose the phrase that naturally goes with it.</p>

<table class="match-table">
<thead>
<tr><th>Verb</th><th>Choose a phrase</th></tr>
</thead>
<tbody>
<tr>
<td><b>eat</b></td>
<td id="eatChoices"></td>
</tr>
<tr>
<td><b>give</b></td>
<td id="giveChoices"></td>
</tr>
<tr>
<td><b>go to</b></td>
<td id="gotoChoices"></td>
</tr>
<tr>
<td><b>have a</b></td>
<td id="haveChoices"></td>
</tr>
<tr>
<td><b>play</b></td>
<td id="playChoices"></td>
</tr>
<tr>
<td><b>send</b></td>
<td id="sendChoices"></td>
</tr>
<tr>
<td><b>visit</b></td>
<td id="visitChoices"></td>
</tr>
<tr>
<td><b>watch</b></td>
<td id="watchChoices"></td>
</tr>
<tr>
<td><b>wear</b></td>
<td id="wearChoices"></td>
</tr>
</tbody>
</table>

<div id="extraFeedback" class="feedback"></div>
</section>

<section>
<h2>C. Celebration Vocabulary Challenge 🎈</h2>
<p class="muted">Choose the best answer.</p>
<div id="quiz"></div>
<div id="quizFeedback" class="feedback"></div>
</section>

<section>
<h2>D. Pair Work 🗣️</h2>
<div class="dialogue">
<b>A:</b> Do you do any of these things as part of a cultural or family celebration?<br>
<b>B:</b> Yes. We usually have a party and eat a special meal with our relatives.
</div>

<p class="muted">Choose a question and discuss it with a partner.</p>
<div class="choice-grid" id="pairQuestions"></div>
<br>
<button class="primary" id="newQuestion">New Question</button>
<div id="pairFeedback" class="feedback"></div>
</section>

<section>
<h2>E. Create Your Own Celebration 🎊</h2>
<p class="muted">Write three things you usually do for a celebration.</p>
<textarea id="writing" rows="5" placeholder="Example: We have a party, eat a special meal, and give presents."></textarea>
<br><br>
<button class="primary" id="checkWriting">Check My Answer</button>
<div id="writingFeedback" class="feedback"></div>
</section>

<div class="tip">
<b>💡 Useful vocabulary from the lesson:</b><br>
candy • presents • decorations • picnic • games • cards • relatives • a birthday • a wedding • a party • a beach • candles • flowers • food • a parade • a barbecue • music • fireworks • invitations • a mask • money • close friends • traditional clothes
</div>

<br>
<button class="reset" id="reset">Reset Activity</button>
</div>

<script>
let score=0;
const scoreEl=document.getElementById('score');
function addScore(n=1){score+=n;scoreEl.textContent=score}

/* A. Main verb combinations */
const combinations=[
 {verb:'eat',answers:['candy','sweets','food'],options:['candy','presents','decorations','a mask','sweets','money','food']},
 {verb:'give',answers:['presents','a party','money'],options:['presents','decorations','a wedding','money','a barbecue','a birthday']},
 {verb:'go to',answers:['a wedding','a party','a parade'],options:['a wedding','picnic','a party','music','a parade','fireworks']},
 {verb:'have a',answers:['picnic','birthday','party','barbecue'],options:['picnic','a wedding','a party','meal','barbecue','parade']},
 {verb:'play',answers:['games','music'],options:['games','candles','flowers','music','cards','sweets']},
 {verb:'send',answers:['cards','invitations'],options:['cards','flowers','food','invitations','money','candles']},
 {verb:'visit',answers:['relatives','close friends'],options:['relatives','a birthday','close friends','a mask','a parade','candles']},
 {verb:'watch',answers:['a parade','fireworks'],options:['a parade','fireworks','a party','food','cards','sweets']},
 {verb:'wear',answers:['a mask','traditional clothes'],options:['a mask','money','traditional clothes','candy','flowers','a barbecue']}
];

const challenge=document.getElementById('challenge');
const selections={};

combinations.forEach((item,i)=>{
 const card=document.createElement('div');
 card.className='verb-card';
 card.innerHTML=`<div class="verb">${i+1}. ${item.verb}</div><div class="options"></div>`;
 const opts=card.querySelector('.options');
 item.options.forEach(opt=>{
   const b=document.createElement('button');
   b.className='option';
   b.textContent=opt;
   b.onclick=()=>{
     opts.querySelectorAll('.option').forEach(x=>x.classList.remove('correct','wrong'));
     b.classList.add('correct');
     selections[i]=opt;
     addScore();
     document.getElementById('matchFeedback').textContent=
       `✓ You chose "${opt}" for "${item.verb}". You can change it if you want.`;
     document.getElementById('matchFeedback').className='feedback correctText';
   };
   opts.appendChild(b);
 });
 challenge.appendChild(card);
});

document.getElementById('checkAll').onclick=()=>{
 let correct=0;
 combinations.forEach((item,i)=>{
   if(item.answers.includes(selections[i])) correct++;
 });
 const feedback=document.getElementById('matchFeedback');
 if(correct===combinations.length){
   feedback.textContent='🎉 Excellent! All nine combinations are correct.';
   feedback.className='feedback correctText';
   addScore(5);
 }else{
   feedback.textContent=`You have ${correct} of ${combinations.length} correct. Try the others again.`;
   feedback.className='feedback wrongText';
 }
};

/* B. Extra matching */
const extra={
 eat:['candy','sweets','food'],
 give:['presents','money'],
 goto:['a wedding','a party','a parade'],
 have:['a picnic','a barbecue','a party'],
 play:['games','music'],
 send:['cards','invitations'],
 visit:['relatives','close friends'],
 watch:['a parade','fireworks'],
 wear:['a mask','traditional clothes']
};

const distractors={
 eat:['candles','invitations','money'],
 give:['fireworks','food','a mask'],
 goto:['sweets','candles','money'],
 have:['cards','flowers','music'],
 play:['a wedding','money','flowers'],
 send:['food','fireworks','a barbecue'],
 visit:['candles','sweets','a wedding'],
 watch:['cards','presents','candy'],
 wear:['food','games','invitations']
};

Object.keys(extra).forEach(key=>{
 const box=document.getElementById(key+'Choices');
 const all=[...extra[key],...distractors[key]];
 all.sort(()=>Math.random()-.5);
 all.forEach(opt=>{
   const b=document.createElement('button');
   b.className='option';
   b.textContent=opt;
   b.onclick=()=>{
     box.querySelectorAll('.option').forEach(x=>x.classList.remove('correct','wrong'));
     if(extra[key].includes(opt)){
       b.classList.add('correct');
       document.getElementById('extraFeedback').textContent=
         `✓ Good! "${opt}" goes naturally with "${key==='goto'?'go to':key==='have'?'have a':key}".`;
       document.getElementById('extraFeedback').className='feedback correctText';
       addScore();
     }else{
       b.classList.add('wrong');
       document.getElementById('extraFeedback').textContent='✗ Try another phrase.';
       document.getElementById('extraFeedback').className='feedback wrongText';
     }
   };
   box.appendChild(b);
 });
});

/* C. Quiz */
const quizData=[
 {q:'Which word means sweet food often eaten at celebrations?',a:'candy',o:['candy','invitations','relatives','decorations']},
 {q:'What do you send to invite people to a party?',a:'invitations',o:['candles','invitations','fireworks','music']},
 {q:'Which activity is often connected with a birthday?',a:'have a party',o:['have a party','watch a laptop','wear food','send money']},
 {q:'What might people watch at a celebration in the sky?',a:'fireworks',o:['fireworks','cards','candy','picnic']},
 {q:'What can people wear as part of a cultural celebration?',a:'traditional clothes',o:['traditional clothes','sweets','money','food']},
 {q:'Who might you visit during a family celebration?',a:'relatives',o:['relatives','candles','decorations','music']}
];

let qi=0;
function renderQuiz(){
 const q=quizData[qi];
 document.getElementById('quiz').innerHTML=
 `<div class="dialogue"><b>${q.q}</b></div><br><div class="choice-grid">${
 q.o.map(x=>`<button class="choice" data-answer="${x}">${x}</button>`).join('')
 }</div>`;
 document.querySelectorAll('#quiz .choice').forEach(b=>{
   b.onclick=()=>{
     if(b.dataset.answer===q.a){
       b.classList.add('correct');
       document.getElementById('quizFeedback').textContent='✓ Correct!';
       document.getElementById('quizFeedback').className='feedback correctText';
       addScore();
       setTimeout(()=>{qi=(qi+1)%quizData.length;renderQuiz()},650);
     }else{
       b.classList.add('wrong');
       document.getElementById('quizFeedback').textContent='✗ Try again.';
       document.getElementById('quizFeedback').className='feedback wrongText';
     }
   };
 });
}
renderQuiz();

/* D. Pair work */
const questions=[
'Do you usually have a party for your birthday?',
'Do you give presents to your family?',
'Do you send invitations to parties?',
'Do you visit relatives during holidays?',
'Do you wear traditional clothes for any celebration?',
'Do you watch fireworks?',
'Do you play games at family celebrations?',
'Do you eat special food or sweets at celebrations?',
'Do you go to weddings with your family?',
'Do you have a barbecue with your friends?'
];

function renderQuestions(){
 const box=document.getElementById('pairQuestions');
 box.innerHTML='';
 questions.slice(0,6).forEach(q=>{
   const b=document.createElement('button');
   b.className='choice';
   b.textContent=q;
   b.onclick=()=>{
     document.getElementById('pairFeedback').textContent='🗣️ Ask your partner: "'+q+'"';
     document.getElementById('pairFeedback').className='feedback correctText';
     addScore();
   };
   box.appendChild(b);
 });
}
renderQuestions();

document.getElementById('newQuestion').onclick=()=>{
 const q=questions[Math.floor(Math.random()*questions.length)];
 document.getElementById('pairFeedback').textContent='🗣️ New question: "'+q+'"';
 document.getElementById('pairFeedback').className='feedback correctText';
 addScore();
};

/* E. Writing */
const useful=[
'eat','give','go to','have a','play','send','visit','watch','wear',
'candy','presents','party','wedding','games','cards','relatives',
'fireworks','invitations','traditional clothes','food'
];

document.getElementById('checkWriting').onclick=()=>{
 const text=document.getElementById('writing').value.toLowerCase().trim();
 const used=useful.filter(w=>text.includes(w));
 const feedback=document.getElementById('writingFeedback');

 if(text.length>=25 && used.length>=2){
   feedback.textContent='✓ Great! Your answer uses celebration vocabulary. Try saying it to a partner.';
   feedback.className='feedback correctText';
   addScore(2);
 }else{
   feedback.textContent='Try again. Write at least three things you do at a celebration and use two vocabulary words from the lesson.';
   feedback.className='feedback wrongText';
 }
};

document.getElementById('reset').onclick=()=>location.reload();
</script>
</body>
</html>
