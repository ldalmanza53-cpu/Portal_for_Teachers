<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Job Profile Builder & Career Matcher</title>
  <style>
    :root {
      --primary: #0284c7;
      --primary-dark: #0369a1;
      --accent: #0d9488;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --border: #cbd5e1;
      --success: #16a34a;
      --error: #dc2626;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: var(--bg); color: var(--text); padding: 20px; display: flex; justify-content: center; }
    .container { max-width: 880px; width: 100%; background: var(--card-bg); border-radius: 16px; padding: 28px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); }

    header { text-align: center; margin-bottom: 24px; border-bottom: 2px solid var(--border); padding-bottom: 16px; }
    header h1 { color: var(--primary); font-size: 1.8rem; margin-bottom: 6px; }
    header p { color: #64748b; font-size: 0.95rem; }

    .nav-tabs { display: flex; gap: 10px; margin-bottom: 20px; }
    .tab-btn { flex: 1; padding: 12px; border: 2px solid var(--border); background: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; color: #64748b; }
    .tab-btn.active { border-color: var(--primary); background: #e0f2fe; color: var(--primary); }

    .grammar-tip { background: #f0f9ff; border-left: 4px solid var(--primary); padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.5; color: #0369a1; }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .section-box { background: #fafafa; border: 1px solid var(--border); border-radius: 10px; padding: 18px; margin-bottom: 16px; }
    .section-title { font-weight: bold; font-size: 1.05rem; color: var(--primary-dark); margin-bottom: 12px; }

    .checkbox-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
    .check-label { display: flex; align-items: center; gap: 8px; background: white; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; font-size: 0.9rem; transition: border 0.2s; }
    .check-label:hover { border-color: var(--primary); }
    .check-label input { width: 16px; height: 16px; accent-color: var(--primary); }

    .input-field { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.95rem; outline: none; margin-top: 6px; }
    .input-field:focus { border-color: var(--primary); }

    .recommendation-card { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 16px; margin-bottom: 12px; }
    .recommendation-card h4 { color: var(--success); font-size: 1.1rem; margin-bottom: 4px; }
    .recommendation-card p { font-size: 0.95rem; color: #166534; }

    .dialogue-box { background: #f8fafc; border: 1px dashed var(--border); border-radius: 10px; padding: 16px; margin-top: 14px; font-size: 0.95rem; line-height: 1.7; }
    .speaker { font-weight: bold; color: var(--primary); }

    .controls { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); }
    .btn { background: var(--primary); color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn:hover { background: var(--primary-dark); }
    .btn-sec { background: #64748b; }
    .btn-sec:hover { background: #475569; }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>💼 Personal Job Profile & Career Matcher</h1>
    <p>A2 Discussion Activity: Expressing Job Preferences, Skills & Reasons</p>
  </header>

  <div class="nav-tabs">
    <button class="tab-btn active" onclick="switchTab('tab-profile')">1. Build Profile</button>
    <button class="tab-btn" onclick="switchTab('tab-match')">2. Career Match Engine</button>
    <button class="tab-btn" onclick="switchTab('tab-dialogue')">3. Roleplay Partner Practice</button>
  </div>

  <div class="grammar-tip">
    <strong>Target Structures:</strong><br/>
    • <strong>Are you good at...?</strong> + verb-ing <em>(e.g., communicating with people, solving problems)</em><br/>
    • <strong>Do you mind...?</strong> + verb-ing <em>(e.g., wearing a uniform, traveling frequently)</em><br/>
    • <strong>Recommendations:</strong> <em>[Name] would make a good [job] because...</em> / <em>I could never be a...</em>
  </div>

  <!-- Tab 1: Profile -->
  <div id="tab-profile" class="tab-content active">
    <div class="section-box">
      <div class="section-title">Candidate Details</div>
      <label style="font-size:0.9rem; font-weight:bold;">Your Name:</label>
      <input type="text" id="candidateName" class="input-field" placeholder="Enter your name..." value="Alex" />
    </div>

    <div class="section-box">
      <div class="section-title">1. Do you ... ?</div>
      <div class="checkbox-grid">
        <label class="check-label"><input type="checkbox" id="do_helping" /> Enjoy helping people</label>
        <label class="check-label"><input type="checkbox" id="do_skills" /> Have special skills</label>
        <label class="check-label"><input type="checkbox" id="do_experience" /> Have work experience</label>
        <label class="check-label"><input type="checkbox" id="do_memory" /> Have a good memory</label>
      </div>
    </div>

    <div class="section-box">
      <div class="section-title">2. Are you good at ... ?</div>
      <div class="checkbox-grid">
        <label class="check-label"><input type="checkbox" id="good_comm" /> Communicating with people</label>
        <label class="check-label"><input type="checkbox" id="good_problems" /> Solving problems</label>
        <label class="check-label"><input type="checkbox" id="good_decisions" /> Making decisions quickly</label>
        <label class="check-label"><input type="checkbox" id="good_languages" /> Learning foreign languages</label>
      </div>
    </div>

    <div class="section-box">
      <div class="section-title">3. Do you mind ... ? (Check if you DO NOT mind)</div>
      <div class="checkbox-grid">
        <label class="check-label"><input type="checkbox" id="mind_uniform" /> Wearing a uniform</label>
        <label class="check-label"><input type="checkbox" id="mind_travel" /> Traveling frequently</label>
        <label class="check-label"><input type="checkbox" id="mind_team" /> Working with a team</label>
        <label class="check-label"><input type="checkbox" id="mind_hours" /> Working long hours</label>
      </div>
    </div>
  </div>

  <!-- Tab 2: Match Engine -->
  <div id="tab-match" class="tab-content">
    <div class="section-box">
      <div class="section-title">Suggested Jobs Based on Your Profile</div>
      <div id="recommendationsOutput">
        <p style="color:#64748b; font-size:0.95rem;">Click "Generate Career Match" to analyze your profile.</p>
      </div>
      <button class="btn" style="margin-top:10px;" onclick="generateCareerMatches()">Generate Career Match</button>
    </div>
  </div>

  <!-- Tab 3: Dialogue Practice -->
  <div id="tab-dialogue" class="tab-content">
    <div class="section-box">
      <div class="section-title">Interactive Roleplay Dialogue</div>
      <p style="font-size:0.9rem; color:#64748b; margin-bottom:12px;">Practice reading this dialogue with a classmate using your real answers:</p>
      
      <div class="dialogue-box" id="generatedDialogue">
        <p><span class="speaker">Advisor:</span> Hi <span id="dlgName1">Alex</span>, let's talk about your job profile. Do you enjoy helping people?</p>
        <p><span class="speaker">Candidate:</span> <span id="dlgHelping">Sure, I enjoy helping people a lot!</span></p>
        <p><span class="speaker">Advisor:</span> Great! Are you good at communicating with people?</p>
        <p><span class="speaker">Candidate:</span> <span id="dlgComm">Yes, I am very good at communicating with people.</span></p>
        <p><span class="speaker">Advisor:</span> Do you mind traveling frequently or working long hours?</p>
        <p><span class="speaker">Candidate:</span> <span id="dlgTravel">I don't mind traveling frequently, but I don't like working long hours.</span></p>
        <p><span class="speaker">Advisor:</span> <span id="dlgRec">Based on your profile, you would make a good psychologist because you are good at communicating and helping people!</span></p>
        <p><span class="speaker">Candidate:</span> <span id="dlgReaction">That sounds great! / No way! I could never be a psychologist!</span></p>
      </div>
    </div>
  </div>

  <div class="controls">
    <button class="btn btn-sec" onclick="resetProfile()">Reset Form</button>
    <button class="btn" onclick="switchTab('tab-match'); generateCareerMatches();">See Career Results →</button>
  </div>
</div>

<script>
  function switchTab(tabId) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

    event.target.classList.add('active');
    document.getElementById(tabId).classList.add('active');
  }

  function generateCareerMatches() {
    const name = document.getElementById('candidateName').value.trim() || 'Candidate';
    const doHelping = document.getElementById('do_helping').checked;
    const goodComm = document.getElementById('good_comm').checked;
    const goodProblems = document.getElementById('good_problems').checked;
    const goodDecisions = document.getElementById('good_decisions').checked;
    const goodLangs = document.getElementById('good_languages').checked;
    const mindTravel = document.getElementById('mind_travel').checked;
    const mindUniform = document.getElementById('mind_uniform').checked;

    const output = document.getElementById('recommendationsOutput');
    output.innerHTML = '';

    let recs = [];

    if (doHelping && goodComm) {
      recs.push({
        title: "Psychologist or Counselor",
        reason: `${name} would make a good psychologist because they enjoy helping people and are good at communicating.`
      });
    }

    if (goodLangs && mindTravel) {
      recs.push({
        title: "Flight Attendant or Tour Guide",
        reason: `${name} would be an excellent flight attendant because they enjoy learning foreign languages and don't mind traveling frequently.`
      });
    }

    if (goodProblems && goodDecisions) {
      recs.push({
        title: "Emergency Manager or Software Engineer",
        reason: `${name} would make a great manager because they are good at solving problems and making decisions quickly.`
      });
    }

    if (doHelping && mindUniform) {
      recs.push({
        title: "Nurse or Healthcare Worker",
        reason: `${name} would be a fantastic nurse because they love helping people and don't mind wearing a uniform.`
      });
    }

    if (recs.length === 0) {
      recs.push({
        title: "Customer Support Specialist",
        reason: `${name} would make a good support specialist because they have a versatile background and adapt well to team projects.`
      });
    }

    recs.forEach(r => {
      const card = document.createElement('div');
      card.className = 'recommendation-card';
      card.innerHTML = `
        <h4>Recommended Job: ${r.title}</h4>
        <p><strong>Reason:</strong> ${r.reason}</p>
      `;
      output.appendChild(card);
    });

    updateDialogueText(name, recs[0]);
  }

  function updateDialogueText(name, topRec) {
    document.getElementById('dlgName1').textContent = name;
    
    const doHelping = document.getElementById('do_helping').checked;
    document.getElementById('dlgHelping').textContent = doHelping 
      ? "Sure! I do volunteer work and love helping people."
      : "Not really, I prefer working independently with computers.";

    const goodComm = document.getElementById('good_comm').checked;
    document.getElementById('dlgComm').textContent = goodComm
      ? "Yes, I am very good at communicating with people."
      : "To be honest, I am a bit shy in front of groups.";

    const mindTravel = document.getElementById('mind_travel').checked;
    document.getElementById('dlgTravel').textContent = mindTravel
      ? "I don't mind traveling frequently at all!"
      : "I prefer staying close to home and not traveling too much.";

    if (topRec) {
      document.getElementById('dlgRec').textContent = topRec.reason;
      document.getElementById('dlgReaction').textContent = `That's interesting! I think I would enjoy being a ${topRec.title.split(' ')[0]}.`;
    }
  }

  function resetProfile() {
    document.getElementById('candidateName').value = 'Alex';
    document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
    document.getElementById('recommendationsOutput').innerHTML = '<p style="color:#64748b; font-size:0.95rem;">Click "Generate Career Match" to analyze your profile.</p>';
  }
</script>

</body>
</html>
