<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Word Power - Housework</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f3f5f7;color:#222}
.app{max-width:1100px;margin:auto;padding:22px}
header,section{background:#fff;border-radius:18px;padding:24px;margin-bottom:20px;box-shadow:0 4px 14px rgba(0,0,0,.08)}
.badge{display:inline-block;background:#2878b5;color:#fff;padding:7px 13px;border-radius:18px;font-size:13px;font-weight:bold}
.score{float:right;background:#222;color:#fff;padding:10px 17px;border-radius:22px;font-weight:bold}
h1{margin:12px 0 8px;font-size:32px}
h2{margin-top:0}
.muted{color:#666;line-height:1.5}
.phrase-bank{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}
.word{background:#fff;color:#222;border:2px solid #ccc;border-radius:10px;padding:10px 14px;cursor:pointer;font:inherit}
.word:hover{background:#f5f5f5}
.word.used{opacity:.45;text-decoration:line-through;cursor:default}
verb-table{display:block;overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:700px}
th,td{border:1px solid #bbb;padding:10px}
th{background:#f1f1f1}
td:first-child{font-weight:bold;background:#fafafa}
.drop{min-height:42px;border:2px dashed #ccc;border-radius:8px;padding:7px;cursor:pointer}
.drop.selected{border-color:#2878b5;background:#eef7ff}
.chip{display:inline-block;background:#eef7ff;border:1px solid #9cc8e8;border-radius:18px;padding:6px 10px;margin:3px;font-size:14px}
.feedback{min-height:25px;margin-top:14px;font-weight:bold}
.correct{color:#198754}.wrong{color:#c62828}
button{border:0;border-radius:10px;padding:11px 17px;background:#222;color:#fff;cursor:pointer;font:inherit}
button:hover{background:#444}
.primary{background:#2878b5}
.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.room{border:2px solid #ddd;border-radius:14px;padding:18px;background:#fafafa}
.room h3{margin-top:0}
.request{background:#fff;color:#222;border:2px solid #ddd;text-align:left;width:100%;margin:5px 0}
.request:hover{border-color:#2878b5;background:#eef7ff}
.dialogue{background:#f7f7f7;border-left:5px solid #2878b5;padding:18px;line-height:1.8}
.prompts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.prompt{background:#fff;color:#222;border:2px solid #ddd;text-align:left}
.excuse{background:#fff8e6;border:1px solid #e5c76b;padding:15px;border-radius:12px;margin-top:15px}
textarea{width:100%;padding:14px;border:1px solid #bbb;border-radius:10px;font:inherit;resize:vertical}
.reset{background:#777}
@media(max-width:800px){.room-grid{grid-template-columns:1fr}.prompts{grid-template-columns:1fr}.score{float:none;display:inline-block;margin-top:10px}}
@media(max-width:550px){.app{padding:10px}}
</style>
</head>
<body>
<div class="app">

<header>
  <span class="badge">A2 • WORD POWER</span>
  <span class="score">Score: <span id="score">0</span></span>
  <h1>🧹 Housework</h1>
  <p class="muted">Practice two-part verbs and useful phrases for asking someone to do housework.</p>
</header>

<section>
<h2>A. Two-Part Verb Challenge</h2>
<p class="muted">
Find a phrase that is usually paired with each two-part verb. Click a phrase, then click the correct box.
Some phrases can go with more than one verb.
</p>

<div class="phrase-bank" id="phraseBank"></div>

<div style="overflow-x:auto">
<table>
<thead>
<tr><th>Two-part verb</th><th>Phrase 1</th><th>Phrase 2</th></tr>
</thead>
<tbody id="verbRows"></tbody>
</table>
</div>

<div id="verbFeedback" class="feedback"></div>
<br>
<button class="primary" id="checkVerbs">Check My Answers</button>
</section>

<section>
<h2>B. What Requests Can You Make? 🏠</h2>
<p class="muted">
Choose a room and create useful requests. Use two-part verbs such as
<b>clean up, hang up, pick up, put away, take out, throw out, turn off, turn on</b>.
</p>

<div class="room-grid">
  <div class="room">
    <h3>🍳 The Kitchen</h3>
    <button class="request" data-request="Please clean up the kitchen.">Clean up the kitchen.</button>
    <button class="request" data-request="Please take out the garbage.">Take out the garbage.</button>
    <button class="request" data-request="Please throw out the groceries that are old.">Throw out old groceries.</button>
    <button class="request" data-request="Please turn off the stove.">Turn off the stove.</button>
  </div>

  <div class="room">
    <h3>🛋️ The Living Room</h3>
    <button class="request" data-request="Please pick up the mess.">Pick up the mess.</button>
    <button class="request" data-request="Please turn off the TV.">Turn off the TV.</button>
    <button class="request" data-request="Please put away the magazines.">Put away the magazines.</button>
    <button class="request" data-request="Please clean up the living room.">Clean up the living room.</button>
  </div>

  <div class="room">
    <h3>🛏️ The Bedroom</h3>
    <button class="request" data-request="Please hang up your coat.">Hang up your coat.</button>
    <button class="request" data-request="Please put away your clothes.">Put away your clothes.</button>
    <button class="request" data-request="Please pick up the towels.">Pick up the towels.</button>
    <button class="request" data-request="Please turn on the light.">Turn on the light.</button>
  </div>
</div>

<div id="requestFeedback" class="feedback"></div>
</section>

<section>
<h2>C. Pair Work 🗣️</h2>

<div class="dialogue">
<b>A:</b> Marabel, please pick up the wet towel you left on your bed.<br>
<b>B:</b> Sorry, I can't pick it up right now. I have to put my new clothes away.
</div>

<p class="muted">
Take turns making the requests. Respond by giving an excuse.
</p>

<div class="prompts" id="prompts"></div>

<br>
<button class="primary" id="newPrompt">New Request</button>

<div id="pairFeedback" class="feedback"></div>

<div class="excuse">
<b>Useful excuses:</b><br>
“I’m sorry, I can’t do it right now.”<br>
“I have to finish my homework.”<br>
“I’m busy at the moment.”<br>
“I need to put my things away first.”
</div>
</section>

<section>
<h2>D. Create Your Own Housework Request ✍️</h2>
<p class="muted">Write a request using one of the two-part verbs.</p>

<textarea id="writing" rows="4"
placeholder="Example: Please pick up the clothes and put them away."></textarea>
<br><br>
<button class="primary" id="checkWriting">Check My Sentence</button>
<div id="writingFeedback" class="feedback"></div>
</section>

<button class="reset" id="reset">Reset Activity</button>
</div>

<script>
let score=0;
const scoreEl=document.getElementById('score');
function addScore(n=1){score+=n;scoreEl.textContent=score;}

/* A. TWO-PART VERBS */
const phrases=[
"the garbage","the groceries","the mess","the towels",
"the microwave","the coat","the dishes","your laptop"
];

const verbs=[
{verb:"clean up",answers:["the mess","the groceries"]},
{verb:"hang up",answers:["the coat","the towels"]},
{verb:"pick up",answers:["the towels","the groceries","the mess"]},
{verb:"put away",answers:["the groceries","the towels","the dishes"]},
{verb:"take out",answers:["the garbage","the groceries"]},
{verb:"throw out",answers:["the garbage","the groceries"]},
{verb:"turn off",answers:["the microwave","your laptop"]},
{verb:"turn on",answers:["the microwave","your laptop"]}
];

const bank=document.getElementById('phraseBank');
let selectedPhrase=null;

phrases.forEach(p=>{
 const b=document.createElement('button');
 b.className='word';
 b.textContent=p;
 b.dataset.phrase=p;
 b.onclick=()=>{
   if(b.classList.contains('used'))return;
   document.querySelectorAll('.word').forEach(x=>x.style.outline='');
   b.style.outline='3px solid #2878b5';
   selectedPhrase=p;
   document.getElementById('verbFeedback').textContent='Now click a box next to the verb that matches "'+p+'".';
 };
 bank.appendChild(b);
});

const rows=document.getElementById('verbRows');
verbs.forEach(v=>{
 const tr=document.createElement('tr');
 tr.innerHTML=`<td>${v.verb}</td><td><div class="drop" data-verb="${v.verb}" data-slot="1"></div></td><td><div class="drop" data-verb="${v.verb}" data-slot="2"></div></td>`;
 rows.appendChild(tr);
});

document.querySelectorAll('.drop').forEach(drop=>{
 drop.onclick=()=>{
   if(!selectedPhrase || drop.dataset.locked==='true')return;
   const verb=verbs.find(v=>v.verb===drop.dataset.verb);
   if(verb.answers.includes(selectedPhrase)){
     drop.innerHTML='<span class="chip">'+selectedPhrase+'</span>';
     drop.dataset.locked='true';
     const button=[...document.querySelectorAll('.word')].find(x=>x.dataset.phrase===selectedPhrase);
     button.classList.add('used');
     button.style.outline='';
     document.getElementById('verbFeedback').textContent='✓ Good choice!';
     document.getElementById('verbFeedback').className='feedback correct';
     selectedPhrase=null;
     addScore();
   }else{
     document.getElementById('verbFeedback').textContent='✗ That phrase does not usually go with "'+verb.verb+'". Try another one.';
     document.getElementById('verbFeedback').className='feedback wrong';
   }
 };
});

document.getElementById('checkVerbs').onclick=()=>{
 const filled=document.querySelectorAll('.drop[data-locked="true"]').length;
 const feedback=document.getElementById('verbFeedback');
 if(filled===verbs.length*2){
   feedback.textContent='🎉 Excellent! You completed all the two-part verb combinations.';
   feedback.className='feedback correct';
   addScore(3);
 }else{
   feedback.textContent='You have completed '+filled+' combinations. Try to complete all the boxes.';
   feedback.className='feedback';
 }
};

/* B. REQUESTS */
document.querySelectorAll('.request').forEach(button=>{
 button.onclick=()=>{
   document.getElementById('requestFeedback').textContent='🗣️ Say it aloud: "'+button.dataset.request+'"';
   document.getElementById('requestFeedback').className='feedback correct';
   addScore();
 };
});

/* C. PAIR WORK */
const pairRequests=[
"Please clean up the kitchen.",
"Please take out the garbage.",
"Please pick up the towels.",
"Please put away your clothes.",
"Please hang up your coat.",
"Please turn off the microwave.",
"Please throw out the old groceries.",
"Please pick up the mess.",
"Please turn on the laptop."
];

function renderPrompts(){
 const box=document.getElementById('prompts');
 box.innerHTML='';
 pairRequests.slice(0,6).forEach(req=>{
   const b=document.createElement('button');
   b.className='prompt';
   b.textContent=req;
   b.onclick=()=>{
     document.getElementById('pairFeedback').textContent='🗣️ Partner response: “Sorry, I can’t '+req.replace(/^Please /,'').replace(/\.$/,'')+' right now. I have to finish something first.”';
   };
   box.appendChild(b);
 });
}
renderPrompts();

document.getElementById('newPrompt').onclick=()=>{
 const req=pairRequests[Math.floor(Math.random()*pairRequests.length)];
 document.getElementById('pairFeedback').textContent='🗣️ Make this request to your partner: "'+req+'" Then give an excuse.';
 addScore();
};

/* D. WRITING */
const verbList=['clean up','hang up','pick up','put away','take out','throw out','turn off','turn on'];

document.getElementById('checkWriting').onclick=()=>{
 const text=document.getElementById('writing').value.toLowerCase().trim();
 const used=verbList.filter(v=>text.includes(v));
 const feedback=document.getElementById('writingFeedback');

 if(used.length>0 && text.length>=12){
   feedback.textContent='✓ Great! You used the two-part verb "'+used[0]+'".';
   feedback.className='feedback correct';
   addScore(2);
 }else{
   feedback.textContent='Try again. Write a complete request using a two-part verb such as “pick up” or “put away”.';
   feedback.className='feedback wrong';
 }
};

document.getElementById('reset').onclick=()=>location.reload();
</script>
</body>
</html>
