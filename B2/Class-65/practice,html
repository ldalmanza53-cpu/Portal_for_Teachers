            }).catch(() => {
                // Fallback
                const area = document.createElement('textarea');
                area.value = text;
                document.body.appendChild(area);
                area.select();
                document.execCommand('copy');
                document.body.removeChild(area);
                playSound('success');
                showToast("Email copied to clipboard!");
            });
        }

