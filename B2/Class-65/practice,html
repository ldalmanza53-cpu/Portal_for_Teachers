                options: [
                    {
                        text: "Excuse me, but I waited patiently for an hour and this is the wrong order. I ordered pasta.",
                        polite: 95,
                        effective: 95,
                        feedback: "Outstanding! Begins with 'Excuse me, but...' and states both the delay and the exact issue."
                    },
                    {
                        text: "I'm sorry, but I think there's a mistake. I didn't order chicken.",
                        polite: 90,
                        effective: 85,
                        feedback: "Very polite B1 opener for service staff!"
                    },
                    {
                        text: "This food is awful! Take it back right now!",
                        polite: 25,
                        effective: 60,
                        feedback: "Unnecessarily hostile. Remember to stay polite when complaining to strangers."
                    }
                ]
            },
            4: {
                title: "4. Holding Belongings",
                type: "Friend",
                alexName: "Alex (Friend Out Shopping)",
                alexInitial: "Hey! Can you hold my wallet, keys, jacket, and water bottle in your bag today?",
                alexAudio: "Hey! Can you hold my wallet, keys, jacket, and water bottle in your bag today?",
                options: [
                    {
                        text: "I'm sorry to bring this up, but my bag is already full and it gets really heavy.",
                        polite: 95,
                        effective: 90,
                        feedback: "Spot on! 'I'm sorry to bring this up, but...' addresses annoying habits gracefully."
                    },
                    {
                        text: "I hate to mention this, but you never carry a bag. Could you hold your own items today?",
                        polite: 90,
                        effective: 95,
                        feedback: "Clear and constructive solution provided to a peer."
                    },
                    {
                        text: "Stop asking me that! Carry your own stuff!",
                        polite: 30,
                        effective: 85,
                        feedback: "A bit blunt. Try softening with 'I hate to mention this, but...'."
                    }
                ]
            }
        };

        let currentRoleplayScen = 1;

        function selectRoleplayScenario(id) {
            playSound('click');
            currentRoleplayScen = id;

            for (let i = 1; i <= 4; i++) {
                const btn = document.getElementById(`rp-scen-${i}`);
                if (i === id) {
                    btn.className = 'rp-scen-btn p-4 rounded-2xl border-2 border-brand-500 bg-brand-50/50 dark:bg-brand-950/20 text-left transition relative';
                } else {
                    btn.className = 'rp-scen-btn p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-left transition relative';
                }
            }

            loadRoleplayDialogue();
        }

        function loadRoleplayDialogue() {
            const scen = roleplayScenarios[currentRoleplayScen];
            document.getElementById('roleplay-partner-name').textContent = scen.alexName;

            const chatFeed = document.getElementById('chat-messages');
            chatFeed.innerHTML = `
                <div class="flex items-start space-x-2.5">
                    <div class="w-8 h-8 rounded-full bg-pink-500 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">A</div>
                    <div class="bg-slate-100 dark:bg-slate-700 p-3.5 rounded-2xl rounded-tl-none text-xs text-slate-800 dark:text-slate-100 max-w-[85%] shadow-sm">
                        <p class="font-semibold text-slate-500 text-[10px] mb-1">${scen.alexName}</p>
                        <p>${scen.alexInitial}</p>
                    </div>
                </div>
            `;

            const optionsContainer = document.getElementById('chat-response-options');
            optionsContainer.innerHTML = '';

            scen.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-3 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium transition space-y-1 shadow-sm';
                btn.onclick = () => chooseRoleplayOption(idx);
                btn.innerHTML = `<span class="font-bold text-brand-500">Option ${String.fromCharCode(65 + idx)}:</span> "${opt.text}"`;
                optionsContainer.appendChild(btn);
            });

            // Reset meter
            document.getElementById('meter-polite-bar').style.width = '0%';
            document.getElementById('meter-polite-val').textContent = '--';
            document.getElementById('meter-effective-bar').style.width = '0%';
            document.getElementById('meter-effective-val').textContent = '--';
            document.getElementById('roleplay-feedback-text').textContent = 'Select a response option above to receive instantaneous feedback on tone, grammar, and textbook alignment!';
        }

        function speakPartnerCurrentLine() {
            const scen = roleplayScenarios[currentRoleplayScen];
            speakText(scen.alexAudio);
        }

        function chooseRoleplayOption(idx) {
            const scen = roleplayScenarios[currentRoleplayScen];
            const opt = scen.options[idx];

            const chatFeed = document.getElementById('chat-messages');
            chatFeed.innerHTML += `
                <div class="flex items-start justify-end space-x-2.5">
                    <div class="bg-brand-600 text-white p-3.5 rounded-2xl rounded-tr-none text-xs max-w-[85%] shadow-sm">
                        <p class="font-semibold text-brand-200 text-[10px] mb-1">You (Student)</p>
                        <p>"${opt.text}"</p>
                    </div>
                </div>
            `;

            chatFeed.scrollTop = chatFeed.scrollHeight;

            // Update Meters
            document.getElementById('meter-polite-bar').style.width = `${opt.polite}%`;
            document.getElementById('meter-polite-val').textContent = `${opt.polite}%`;
            document.getElementById('meter-effective-bar').style.width = `${opt.effective}%`;
            document.getElementById('meter-effective-val').textContent = `${opt.effective}%`;

            document.getElementById('roleplay-feedback-text').textContent = opt.feedback;

            if (opt.polite >= 80 && opt.effective >= 80) {
                playSound('success');
                addXP(15);
            } else {
                playSound('error');
            }
        }

        /* Stopwatch Timer Logic */
        let timerSeconds = 60;
        let timerInterval = null;

        function toggleTimer() {
            playSound('click');
            const btn = document.getElementById('timer-toggle-btn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerHTML = '<i class="fa-solid fa-play"></i>';
            } else {
                btn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                timerInterval = setInterval(() => {
                    timerSeconds--;
                    updateTimerDisplay();
                    if (timerSeconds <= 0) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        btn.innerHTML = '<i class="fa-solid fa-play"></i>';
                        playSound('fanfare');
                        showToast("60-Second Fluency Sprint Completed!");
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            playSound('click');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            timerSeconds = 60;
            document.getElementById('timer-toggle-btn').innerHTML = '<i class="fa-solid fa-play"></i>';
            updateTimerDisplay();
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timerSeconds / 60);
            const secs = timerSeconds % 60;
            document.getElementById('timer-display').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        /* ==========================================================================
           7. TAB 5: B1 MASTERY QUIZ & CERTIFICATE LOGIC
           ========================================================================== */
        const quizQuestions = [
            {
                q: "1. Which subject line is most effective for a formal complaint email?",
                options: ["I am really angry about my order", "Damaged product - Order VG25S", "Help me please!", "Wrong stuff sent to my home"],
                correct: 1
            },
            {
                q: "2. When complaining to a STRANGER in public, which sentence starter should you use?",
                options: ["I hate to mention this, but...", "Excuse me, but...", "Listen to me right now...", "I'm sorry to bring this up, but..."],
                correct: 1
            },
            {
                q: "3. When complaining to a FRIEND about a late stay or bad habit, which phrase softens the request?",
                options: ["Excuse me, but...", "Hey, stop doing that!", "I hate to mention this, but...", "Look here..."],
                correct: 2
            },
            {
                q: "4. Why is it crucial to mention receipts, warranty, or credit card bills in a written complaint?",
                options: ["To make the email longer", "To provide legal evidence of your paid purchase", "To ask for personal discounts", "To show off your money"],
                correct: 1
            },
            {
                q: "5. What is the correct order of details in an effective complaint email?",
                options: [
                    "Request solution -> Proof -> Subject line -> Problem",
                    "Subject line -> Product description -> Detailed problem -> Evidence -> Request solution -> Contact details",
                    "Contact details -> Angry comment -> Request solution",
                    "Evidence -> Subject line -> Closing"
                ],
                correct: 1
            },
            {
                q: "6. You waited 1 hour for food and the waiter brings the wrong order. What is the most polite, effective response?",
                options: [
                    "I hate to mention this, but you are a terrible waiter.",
                    "Excuse me, but I've been waiting for an hour and this is the wrong order.",
                    "I'll just eat this anyway, no problem.",
                    "Give me free food right now!"
                ],
                correct: 1
            },
            {
                q: "7. Which phrase is synonymous with 'I hate to mention this, but...' when talking to neighbors?",
                options: ["Get out of my way, but...", "I'm sorry to bring this up, but...", "Excuse me, but...", "Pardon me, sir..."],
                correct: 1
            },
            {
                q: "8. In John Montgomery's email, what action did he explicitly request?",
                options: ["A discount voucher", "A phone call from the president", "A new replacement phone as soon as possible", "A store credit refund"],
                correct: 2
            },
            {
                q: "9. Which phrase represents an effective sign-off for a formal complaint email?",
                options: ["See ya later,", "Sincerely,", "Thanks anyway,", "Bye for now,"],
                correct: 1
            },
            {
                q: "10. What does the expression 'driving you up the wall' mean in Textbook Page T-82?",
                options: ["Making you climb a wall", "Making you very annoyed or irritated", "Driving a car fast", "Painting a house"],
                correct: 1
            }
        ];

        function renderQuiz() {
            const container = document.getElementById('quiz-questions-container');
            container.innerHTML = '';

            quizQuestions.forEach((item, qIdx) => {
                const card = document.createElement('div');
                card.className = 'bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm space-y-3';
                
                let optionsHTML = '';
                item.options.forEach((opt, oIdx) => {
                    optionsHTML += `
                        <label class="flex items-center space-x-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/60 hover:bg-slate-50 dark:hover:bg-slate-700/40 cursor-pointer text-xs font-medium transition">
                            <input type="radio" name="quiz-q-${qIdx}" value="${oIdx}" class="text-brand-600 focus:ring-brand-500">
                            <span>${opt}</span>
                        </label>
                    `;
                });

                card.innerHTML = `
                    <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">${item.q}</h4>
                    <div class="space-y-2 pt-1">${optionsHTML}</div>
                    <div id="quiz-explain-${qIdx}" class="text-xs font-semibold pt-1 hidden"></div>
                `;
                container.appendChild(card);
            });
        }

        function submitQuiz() {
            let score = 0;
            quizQuestions.forEach((item, qIdx) => {
                const selected = document.querySelector(`input[name="quiz-q-${qIdx}"]:checked`);
                const explainEl = document.getElementById(`quiz-explain-${qIdx}`);
                explainEl.classList.remove('hidden');

                if (selected && parseInt(selected.value) === item.correct) {
                    score++;
                    explainEl.className = 'text-xs font-semibold text-emerald-500 pt-1';
                    explainEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> Correct!';
                } else {
                    explainEl.className = 'text-xs font-semibold text-rose-500 pt-1';
                    explainEl.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Incorrect. Correct Answer: ${item.options[item.correct]}`;
                }
            });

            const percent = Math.round((score / quizQuestions.length) * 100);
            const statusCard = document.getElementById('quiz-status-card');

            if (percent >= 80) {
                playSound('fanfare');
                addXP(50);
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });

                statusCard.className = 'p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-xs font-bold text-emerald-600 dark:text-emerald-400 space-y-1';
                statusCard.innerHTML = `
                    <p class="text-sm">🎉 PASSED! Score: ${percent}% (${score}/${quizQuestions.length})</p>
                    <p>Your official CEFR B1 Certificate is now unlocked below!</p>
                `;

                document.getElementById('certificate-wrapper').classList.remove('hidden');
                document.getElementById('cert-date-string').textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            } else {
                playSound('error');
                statusCard.className = 'p-4 bg-rose-500/10 border border-rose-500/30 rounded-xl text-xs font-bold text-rose-600 dark:text-rose-400';
                statusCard.textContent = `Score: ${percent}% (${score}/${quizQuestions.length}). You need 80% to unlock the CEFR B1 Certificate. Please review and try again!`;
            }
        }

        /* Toast Message Helper */
        function showToast(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 px-5 py-3 bg-slate-900 text-white font-bold text-xs rounded-2xl shadow-2xl border border-slate-700 flex items-center space-x-2 animate-bounce';
            toast.innerHTML = `<i class="fa-solid fa-bell text-amber-400"></i><span>${msg}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        /* Initialize App on Load */
        window.onload = function() {
            updateXPUI();
            loadRoleplayDialogue();
            initSortingGame();
            renderQuiz();
            updateEmailPreview();
        };
    </script>
</body>
