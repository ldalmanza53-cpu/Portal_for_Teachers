                feedbackEl.className = 'text-center font-bold text-sm text-rose-500';
                feedbackEl.textContent = `Incorrect! This phrase is best for a ${item.correct.toUpperCase()}.`;
            }

            sortIndex++;
            setTimeout(() => {
                if (sortIndex === sortingData.length && sortScore === sortingData.length) {
                    addXP(25);
