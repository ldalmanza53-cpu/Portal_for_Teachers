            output += `${prod || '[Product/service description missing]'}\n\n`;
            output += `${prob || '[Problem details missing]'}\n\n`;
            output += `${evid || '[Evidence/receipt mention missing]'}\n\n`;
            output += `${req || '[Action requested missing]'}\n\n`;
            output += `Please contact me promptly regarding this issue.\n\nSincerely,\n${cont || '[Contact details missing]'}`;

            document.getElementById('email-live-output').textContent = output;

            // Update real-time validator UI
            const checks = [
