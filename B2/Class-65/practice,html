                        <button onclick="initSortingGame()" class="mt-2 px-4 py-2 bg-brand-600 text-white font-bold text-xs rounded-xl">Play Again</button>
                    </div>
                `;
                return;
            }

            const item = sortingData[sortIndex];
            document.getElementById('sort-step').textContent = `Phrase ${sortIndex + 1} of ${sortingData.length}`;
            document.getElementById('sort-phrase-text').textContent = item.text;
        }

        function submitSortChoice(choice) {
            const item = sortingData[sortIndex];
