<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B1 ESL Learning Studio - Effective Complaints & Social Role-Play</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .dark .glass-panel {
            background: rgba(30, 41, 59, 0.75);
        }
        .email-shadow {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-certificate, #printable-certificate * {
                visibility: visible;
            }
            #printable-certificate {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-300 flex flex-col">

    <!-- TOP HEADER / GAMIFICATION BAR -->
    <header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- App Brand & Title -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">ESL B1 Studio</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 hidden sm:block">Writing Complaints & Polite Social Role-Play</p>
                </div>
            </div>

            <!-- Gamification & Settings Controls -->
            <div class="flex items-center space-x-3 sm:space-x-4">
                <!-- Streak Badge -->
                <div class="flex items-center space-x-1.5 px-3 py-1.5 bg-amber-500/10 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 rounded-full border border-amber-500/20 text-xs sm:text-sm font-semibold" title="Daily Practice Streak">
                    <i class="fa-solid fa-fire text-amber-500 animate-pulse"></i>
                    <span id="streak-counter">1 Day</span>
                </div>

                <!-- XP Badge -->
                <div class="flex items-center space-x-1.5 px-3 py-1.5 bg-emerald-500/10 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-full border border-emerald-500/20 text-xs sm:text-sm font-semibold" title="Total Experience Points">
                    <i class="fa-solid fa-star text-emerald-500"></i>
                    <span id="xp-counter">0 XP</span>
                </div>

                <div class="h-5 w-px bg-slate-300 dark:bg-slate-700"></div>

                <!-- Audio SFX Toggle -->
                <button id="sfx-btn" onclick="toggleSFX()" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" title="Toggle Sound Effects">
                    <i id="sfx-icon" class="fa-solid fa-volume-high"></i>
                </button>

                <!-- Theme Toggle -->
                <button onclick="toggleTheme()" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors" title="Toggle Light/Dark Theme">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS -->
    <nav class="bg-white dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-700 sticky top-16 z-40">
        <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
            <div class="flex overflow-x-auto no-scrollbar space-x-1 sm:space-x-4 py-2">
                <button onclick="switchTab('matching')" id="tab-btn-matching" class="tab-btn px-4 py-2.5 rounded-lg font-medium text-sm whitespace-nowrap transition-all flex items-center space-x-2 bg-brand-600 text-white shadow-md">
                    <i class="fa-solid fa-envelope-open-text"></i>
                    <span>1. Email Matching Arena</span>
                </button>
                <button onclick="switchTab('generator')" id="tab-btn-generator" class="tab-btn px-4 py-2.5 rounded-lg font-medium text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                    <i class="fa-solid fa-pen-nib"></i>
                    <span>2. Email Builder & Review</span>
                </button>
                <button onclick="switchTab('expressions')" id="tab-btn-expressions" class="tab-btn px-4 py-2.5 rounded-lg font-medium text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                    <i class="fa-solid fa-comments"></i>
                    <span>3. Polite Matrix</span>
                </button>
                <button onclick="switchTab('roleplay')" id="tab-btn-roleplay" class="tab-btn px-4 py-2.5 rounded-lg font-medium text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                    <i class="fa-solid fa-masks-theater"></i>
                    <span>4. Role-Play Simulator</span>
                </button>
                <button onclick="switchTab('quiz')" id="tab-btn-quiz" class="tab-btn px-4 py-2.5 rounded-lg font-medium text-sm whitespace-nowrap transition-all flex items-center space-x-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700/50">
                    <i class="fa-solid fa-award"></i>
                    <span>5. Mastery Quiz & CEFR</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- TAB 1: EMAIL MATCHING ARENA -->
        <section id="tab-matching" class="tab-content space-y-6">
            <!-- Learning Objective Header -->
            <div class="glass-panel p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-brand-100 text-brand-800 dark:bg-brand-900/50 dark:text-brand-300 mb-2">
                            Textbook Page Study
                        </span>
                        <h2 class="text-2xl font-bold">Writing an Effective Message of Complaint</h2>
                        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">An effective message of complaint about a purchase follows 6 crucial rules. Read John Montgomery's email below and match each numbered highlight to its corresponding point!</p>
                    </div>
                    <button onclick="speakText('Writing an effective message of complaint. Match the information to the points in the email.')" class="self-start md:self-center px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl text-xs font-semibold transition flex items-center space-x-2">
                        <i class="fa-solid fa-volume-high text-brand-500"></i>
                        <span>Read Objective</span>
                    </button>
                </div>
            </div>

            <!-- Main Interactive Layout: 6 Points Reference & Email Client -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left Column: The 6 Checklist Points (4 Cols) -->
                <div class="lg:col-span-4 space-y-3">
                    <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-5 rounded-2xl shadow-lg">
                        <h3 class="font-bold text-lg mb-3 flex items-center justify-between">
                            <span>The 6 Essential Points</span>
                            <i class="fa-solid fa-list-check text-indigo-400"></i>
                        </h3>
                        <div id="checklist-rules-list" class="space-y-2.5 text-xs">
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">1</span>
                                <p><span class="font-semibold">Contains a clear subject line</span> - State the main problem clearly.</p>
                            </div>
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">2</span>
                                <p><span class="font-semibold">Describes the product or service clearly</span> - Include brand, model, date, etc.</p>
                            </div>
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">3</span>
                                <p><span class="font-semibold">Explains the problem in detail</span> - Describe what is damaged or missing.</p>
                            </div>
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">4</span>
                                <p><span class="font-semibold">Mentions a receipt or evidence</span> - Bills, warranty, post office receipts.</p>
                            </div>
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">5</span>
                                <p><span class="font-semibold">Explains exactly what you want</span> - Refund, exchange, replacement.</p>
                            </div>
                            <div class="p-2.5 bg-white/10 rounded-xl flex items-start space-x-2.5 border border-white/10">
                                <span class="bg-brand-500 text-white font-extrabold w-5 h-5 rounded-full flex items-center justify-center text-xs flex-shrink-0">6</span>
                                <p><span class="font-semibold">Provides contact information</span> - Full name, address, phone number.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Simulated Webmail Client (8 Cols) -->
                <div class="lg:col-span-8">
                    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-xl overflow-hidden">
                        <!-- Browser / Mail UI Header -->
                        <div class="bg-slate-100 dark:bg-slate-700/50 px-4 py-3 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                                <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                                <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                                <span class="text-xs text-slate-500 dark:text-slate-400 font-mono ml-2">https://mail.cup.org/inbox</span>
                            </div>
                            <button onclick="readFullEmail()" class="text-xs bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-300 font-semibold px-3 py-1 rounded-lg transition flex items-center space-x-1">
                                <i class="fa-solid fa-volume-high"></i>
                                <span>Listen to Email</span>
                            </button>
                        </div>

                        <!-- Email Envelope Details -->
                        <div class="p-5 sm:p-6 space-y-4 font-sans text-sm">
                            <div class="grid grid-cols-1 gap-2 border-b border-slate-200 dark:border-slate-700 pb-4 text-xs sm:text-sm">
                                <div><span class="font-semibold text-slate-500">To:</span> customerservice@phonegrp.cup.org</div>
                                <div><span class="font-semibold text-slate-500">From:</span> JM1990@cup.org</div>
                                <div class="flex items-center flex-wrap gap-2 pt-1">
                                    <span class="font-semibold text-slate-500">Subject:</span>
                                    <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-2 py-0.5 rounded font-medium">Damaged product</mark>
                                    <!-- Matching Dropdown 1 -->
                                    <div class="inline-flex items-center space-x-1">
                                        <select id="match-1" class="match-select bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold focus:ring-2 focus:ring-brand-500">
                                            <option value="">Select Point #</option>
                                            <option value="1">Point 1</option>
                                            <option value="2">Point 2</option>
                                            <option value="3">Point 3</option>
                                            <option value="4">Point 4</option>
                                            <option value="5">Point 5</option>
                                            <option value="6">Point 6</option>
                                        </select>
                                        <span id="feedback-1" class="text-xs"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Email Body Paragraphs -->
                            <div class="space-y-4 leading-relaxed text-slate-700 dark:text-slate-300">
                                <p class="font-semibold">Dear Sir or Madam:</p>

                                <p>
                                    Last month, I ordered 
                                    <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-1.5 py-0.5 rounded font-medium">a smartphone, model number VG25S</mark>, 
                                    from your website. 
                                    <!-- Matching Dropdown 2 -->
                                    <select id="match-2" class="match-select bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold inline-block my-1">
                                        <option value="">Select Point #</option>
                                        <option value="1">Point 1</option>
                                        <option value="2">Point 2</option>
                                        <option value="3">Point 3</option>
                                        <option value="4">Point 4</option>
                                        <option value="5">Point 5</option>
                                        <option value="6">Point 6</option>
                                    </select>
                                    <span id="feedback-2" class="text-xs"></span>
                                    When it arrived, I discovered that it was broken. 
                                    <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-1.5 py-0.5 rounded font-medium">The case was damaged, and the display screen was cracked.</mark>
                                    <!-- Matching Dropdown 3 -->
                                    <select id="match-3" class="match-select bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold inline-block my-1">
                                        <option value="">Select Point #</option>
                                        <option value="1">Point 1</option>
                                        <option value="2">Point 2</option>
                                        <option value="3">Point 3</option>
                                        <option value="4">Point 4</option>
                                        <option value="5">Point 5</option>
                                        <option value="6">Point 6</option>
                                    </select>
                                    <span id="feedback-3" class="text-xs"></span>
                                </p>

                                <p>
                                    At my own expense, I returned the phone to your service department over a month ago. I still have not received a replacement, nor has a customer service representative contacted me.
                                </p>

                                <p>
                                    <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-1.5 py-0.5 rounded font-medium">I have my credit card bill to prove I paid for this purchase, a one-year warranty, and a receipt from the post office.</mark>
                                    <!-- Matching Dropdown 4 -->
                                    <select id="match-4" class="match-select bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold inline-block my-1">
                                        <option value="">Select Point #</option>
                                        <option value="1">Point 1</option>
                                        <option value="2">Point 2</option>
                                        <option value="3">Point 3</option>
                                        <option value="4">Point 4</option>
                                        <option value="5">Point 5</option>
                                        <option value="6">Point 6</option>
                                    </select>
                                    <span id="feedback-4" class="text-xs"></span>
                                    Therefore, 
                                    <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-1.5 py-0.5 rounded font-medium">I would like to receive a new phone as soon as possible.</mark>
                                    <!-- Matching Dropdown 5 -->
                                    <select id="match-5" class="match-select bg-slate-100 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold inline-block my-1">
                                        <option value="">Select Point #</option>
                                        <option value="1">Point 1</option>
                                        <option value="2">Point 2</option>
                                        <option value="3">Point 3</option>
                                        <option value="4">Point 4</option>
                                        <option value="5">Point 5</option>
                                        <option value="6">Point 6</option>
                                    </select>
                                    <span id="feedback-5" class="text-xs"></span>
                                </p>

                                <p>
                                    Please call or email me about this matter. I look forward to your reply and hope you will handle this matter promptly.
                                </p>

                                <div class="pt-2 border-t border-slate-100 dark:border-slate-700/50">
                                    <p>Sincerely,</p>
                                    <div class="mt-2 p-3 bg-amber-50 dark:bg-amber-950/30 rounded-xl border border-amber-200 dark:border-amber-800/40 inline-block text-xs">
                                        <mark class="bg-amber-200 dark:bg-amber-900/60 dark:text-amber-200 px-1 rounded font-medium">
                                            John Montgomery<br>
                                            101 Bee Tree Road<br>
                                            Encino, CA 91426<br>
                                            Phone: 310-555-2934
                                        </mark>
                                        <div class="mt-2">
                                            <!-- Matching Dropdown 6 -->
                                            <select id="match-6" class="match-select bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg px-2 py-1 text-xs font-semibold">
                                                <option value="">Select Point #</option>
                                                <option value="1">Point 1</option>
                                                <option value="2">Point 2</option>
                                                <option value="3">Point 3</option>
                                                <option value="4">Point 4</option>
                                                <option value="5">Point 5</option>
                                                <option value="6">Point 6</option>
                                            </select>
                                            <span id="feedback-6" class="text-xs"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Bar -->
                        <div class="bg-slate-50 dark:bg-slate-800 p-4 border-t border-slate-200 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3">
                            <button onclick="resetMatching()" class="px-4 py-2 rounded-xl text-xs font-semibold border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition">
                                <i class="fa-solid fa-rotate-right mr-1"></i> Reset
                            </button>
                            <button onclick="checkMatchingAnswers()" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-500/20 transition flex items-center space-x-2">
                                <i class="fa-solid fa-check"></i>
                                <span>Check Matching Answers</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: COMPLAINT EMAIL GENERATOR & PEER REVIEW -->
        <section id="tab-generator" class="tab-content space-y-6 hidden">
            <div class="glass-panel p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 dark:bg-indigo-900/50 dark:text-indigo-300 mb-2">
                            Section B & C Writing Practice
                        </span>
                        <h2 class="text-2xl font-bold">Interactive Complaint Email Generator</h2>
                        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Select a textbook scenario or create your own. Fill out each section and watch the real-time 6-point validator ensure your email is 100% effective!</p>
                    </div>
                </div>
            </div>

            <!-- Generator Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left Form Column (7 Cols) -->
                <div class="lg:col-span-7 space-y-5 bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <!-- Scenario Selector -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Choose Textbook Situation</label>
                        <select id="gen-scenario-select" onchange="loadScenarioTemplate()" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl p-3 text-sm font-semibold focus:ring-2 focus:ring-brand-500">
                            <option value="custom">✍️ Custom Complaint (Create your own)</option>
                            <option value="tablet">📱 Scenario 1: Tablet came with wrong battery charger (Store refused replacement)</option>
                            <option value="flight">✈️ Scenario 2: Overbooked flight (Airline overbooked & denied boarding)</option>
                        </select>
                    </div>

                    <!-- Email Fields -->
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">1. Subject Line <span class="text-rose-500">*</span></label>
                            <input type="text" id="email-subject" oninput="updateEmailPreview()" placeholder="e.g. Complaint regarding damaged item / Order #8821" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-brand-500">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">2. Product / Service Description <span class="text-rose-500">*</span></label>
                            <input type="text" id="email-product" oninput="updateEmailPreview()" placeholder="e.g. On Oct 12, I purchased a Pro Tab 10 tablet from your Downtown store..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-brand-500">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">3. Detailed Problem Explanation <span class="text-rose-500">*</span></label>
                            <textarea id="email-problem" oninput="updateEmailPreview()" rows="3" placeholder="e.g. When I opened the package at home, I discovered it included a Type-B charger instead of Type-C..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-brand-500"></textarea>
