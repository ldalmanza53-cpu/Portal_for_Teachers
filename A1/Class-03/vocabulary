        { topic: "Where You Live", q: "Where do you live, and do you like your city?", a: "I live in a quiet neighborhood. I like my city because it has nice parks." },
        { topic: "Life Experiences", q: "What is an important change in your life?", a: "Two years ago, I moved to a new city for my job." },
        { topic: "Travel & Future Plans", q: "Where do you want to travel, and what are your plans for the future?", a: "I want to visit Canada. In the future, I want to improve my English." }
      ],
      task2Questions: [
        { title: "Job Role", text: "What is your job in this company?" },
        { title: "Schedule", text: "What time do you start and finish work?" },
