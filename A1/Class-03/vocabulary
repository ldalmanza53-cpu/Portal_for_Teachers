  </main>

  <!-- JavaScript Application Logic -->
  <script>
    /* Global Application State */
    const state = {
      xp: 0,
      completedActivities: {
        greetingsSort: false,
        greetingsMatch: false,
        pluralSort: false,
        interviewSim: false
      },
      badges: {
        firstSteps: false,
        greetingGuru: false,
        phonicsMaster: false,
        interviewPro: false,
        a1Champion: false
      },
      // Module 1 Data
      selectedGreetingIndex: null,
      greetingsItems: [
        { text: "Good morning.", category: "hello" },
        { text: "Bye.", category: "goodbye" },
        { text: "Good night.", category: "goodbye" },
        { text: "Have a good day.", category: "goodbye" },
        { text: "Hey.", category: "hello" },
        { text: "Hi.", category: "hello" },
        { text: "How are you?", category: "hello" },
        { text: "How's it going?", category: "hello" },
        { text: "See you later.", category: "goodbye" },
