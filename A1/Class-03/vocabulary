        { title: "Tenure", text: "How long have you worked here?" },
        { title: "Work Opinion", text: "Do you like working here? Why?" }
      ],
      simStep: 0,
      simSteps: [
        {
          interviewer: "Hello! Welcome to our company interview. To start, what is your name and where do you live?",
          options: [
            { text: "Hello! My name is Alex, and I live in Chicago.", correct: true, feedback: "Great opening answer!" },
            { text: "Good night! I like boxes and phones.", correct: false, feedback: "Remember: Say hello and state your name/city." }
          ]
        },
        {
          interviewer: "Nice to meet you! Can you tell me what you usually do in your free time?",
          options: [
            { text: "In my free time, I like reading books and practicing English.", correct: true, feedback: "Excellent answer!" },
            { text: "Yes, I finish work at 5 PM tomorrow.", correct: false, feedback: "This question asks about hobbies & free time." }
          ]
        },
        {
          interviewer: "Wonderful. Do you have any questions for me about my job at this company?",
          options: [
            { text: "Yes! What is your job in this company, and what time do you start work?", correct: true, feedback: "Perfect candidate question!" },
            { text: "No, see you tomorrow. Bye!", correct: false, feedback: "Try asking a question about their job routine." }
          ]
        }
      ]
    };

    /* Web Speech API Helper */
    function speakText(text) {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 0.88;
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    }

    /* Tab Switching Navigation */
    function switchTab(tabId) {
      document.querySelectorAll('.tab-page').forEach(page => page.classList.add('hidden'));
      document.querySelectorAll('.nav-tab').forEach(btn => {
        btn.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
        btn.classList.add('text-slate-600', 'hover:bg-slate-100');
      });

      document.getElementById(tabId).classList.remove('hidden');
      const activeBtn = document.getElementById('btn-' + tabId);
      activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
      activeBtn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
    }

    function addXp(amount) {
      state.xp += amount;
      checkBadges();
      updateDashboardUI();
    }

    /* MODULE 1 LOGIC */
    function renderGreetingsSort() {
      const bank = document.getElementById('greetingBank');
      bank.innerHTML = '';

      let placedCount = 0;
      state.greetingsItems.forEach((item, index) => {
        if (!item.placed) {
          const chip = document.createElement('div');
          chip.className = `cursor-pointer px-3 py-1.5 rounded-xl font-semibold text-xs transition flex items-center gap-2 shadow-sm border ${
            state.selectedGreetingIndex === index 
              ? 'bg-blue-600 text-white border-blue-600 ring-2 ring-blue-300' 
              : 'bg-white text-slate-800 border-slate-200 hover:border-blue-400'
          }`;
          chip.innerHTML = `<span>${item.text}</span> <button onclick="event.stopPropagation(); speakText('${item.text}')" class="text-xs hover:opacity-80">🔊</button>`;
          chip.onclick = () => {
            state.selectedGreetingIndex = index;
            renderGreetingsSort();
          };
          bank.appendChild(chip);
        } else {
          placedCount++;
        }
      });

      document.getElementById('greetingsSortScore').innerText = `${placedCount} / ${state.greetingsItems.length} Sorted`;

      if (placedCount === state.greetingsItems.length && !state.completedActivities.greetingsSort) {
        state.completedActivities.greetingsSort = true;
        addXp(50);
        confetti({ particleCount: 50, spread: 60 });
      }
    }

    function dropGreeting(targetCategory) {
      if (state.selectedGreetingIndex === null) return;

      const item = state.greetingsItems[state.selectedGreetingIndex];
      item.placed = true;
      item.isCorrect = (item.category === targetCategory);

      if (item.isCorrect) {
        speakText(item.text);
        addXp(5);
      }

      const container = document.getElementById(`${targetCategory}Bucket`);
      const chip = document.createElement('div');
      chip.className = `px-2.5 py-1.5 rounded-lg text-xs font-semibold flex items-center justify-between shadow-sm border ${
        item.isCorrect ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-rose-100 text-rose-800 border-rose-300'
      }`;
      chip.innerHTML = `<span>${item.text}</span> <span>${item.isCorrect ? '✓' : '✗'}</span>`;
      container.appendChild(chip);

      state.selectedGreetingIndex = null;
      renderGreetingsSort();
    }

    function resetGreetingsSort() {
      state.greetingsItems.forEach(i => { delete i.placed; delete i.isCorrect; });
      state.selectedGreetingIndex = null;
      document.getElementById('helloBucket').innerHTML = '';
      document.getElementById('goodbyeBucket').innerHTML = '';
      renderGreetingsSort();
    }

    function renderGreetingsMatching() {
      const container = document.getElementById('matchingContainer');
      container.innerHTML = '';

      state.greetingMatches.forEach((m, idx) => {
        const card = document.createElement('div');
        card.className = 'p-3 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2';
        
        let selectOptions = `<option value="">-- Choose natural response --</option>`;
        m.options.forEach((opt, optIdx) => {
          selectOptions += `<option value="${optIdx}">${opt}</option>`;
        });

        card.innerHTML = `
          <div class="flex items-center gap-2 text-xs font-bold text-slate-800">
            <span>${m.prompt}</span>
            <button onclick="speakText('${m.prompt.replace(/^\d+\.\s*/, '')}')" class="text-blue-600 hover:text-blue-800">🔊</button>
          </div>
          <select id="matchSelect-${idx}" class="text-xs p-2 rounded-lg border border-slate-300 font-medium bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
            ${selectOptions}
          </select>
        `;
        container.appendChild(card);
      });
    }

    function checkGreetingMatches() {
      let correctCount = 0;
      state.greetingMatches.forEach((m, idx) => {
        const select = document.getElementById(`matchSelect-${idx}`);
        if (parseInt(select.value) === m.correct) {
          correctCount++;
          select.className = "text-xs p-2 rounded-lg border-2 border-emerald-500 font-medium bg-emerald-50 text-emerald-900";
        } else {
          select.className = "text-xs p-2 rounded-lg border-2 border-rose-400 font-medium bg-rose-50 text-rose-900";
        }
      });

      const feedback = document.getElementById('matchingFeedback');
      feedback.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'bg-amber-100', 'text-amber-800');

      if (correctCount === state.greetingMatches.length) {
        feedback.classList.add('bg-emerald-100', 'text-emerald-800');
        feedback.innerText = `🎉 Perfect! ${correctCount}/${state.greetingMatches.length} correct responses matched.`;
        if (!state.completedActivities.greetingsMatch) {
          state.completedActivities.greetingsMatch = true;
          addXp(40);
          confetti({ particleCount: 40 });
        }
      } else {
        feedback.classList.add('bg-amber-100', 'text-amber-800');
        feedback.innerText = `You matched ${correctCount}/${state.greetingMatches.length} correctly. Review the red highlighted answers!`;
      }
    }

    /* MODULE 2 LOGIC */
    function renderPluralGame() {
      const pool = document.getElementById('pluralPool');
      pool.innerHTML = '';

      let placed = 0;
      state.pluralItems.forEach((item, index) => {
        if (!item.placed) {
          const chip = document.createElement('div');
          chip.className = `cursor-pointer px-3.5 py-2 rounded-xl font-bold text-xs transition flex items-center gap-2 shadow-sm border ${
            state.selectedPluralIndex === index
              ? 'bg-emerald-600 text-white border-emerald-600 ring-2 ring-emerald-300'
              : 'bg-white text-slate-800 border-slate-200 hover:border-emerald-400'
          }`;
          chip.innerHTML = `<span>${item.singular} → <strong>${item.plural}</strong></span> <button onclick="event.stopPropagation(); speakText('${item.plural}')" class="text-xs hover:opacity-80">🔊</button>`;
          chip.onclick = () => {
            state.selectedPluralIndex = index;
            renderPluralGame();
          };
          pool.appendChild(chip);
        } else {
          placed++;
        }
      });

      document.getElementById('pluralScore').innerText = `Progress: ${placed} / ${state.pluralItems.length}`;

      if (placed === state.pluralItems.length && !state.completedActivities.pluralSort) {
        state.completedActivities.pluralSort = true;
        addXp(60);
        confetti({ particleCount: 60, spread: 70 });
      }
    }

    function dropPluralInBucket(bucketSound) {
      if (state.selectedPluralIndex === null) return;

      const item = state.pluralItems[state.selectedPluralIndex];
      item.placed = true;
      item.isCorrect = (item.sound === bucketSound);

      if (item.isCorrect) {
        speakText(item.plural);
        addXp(10);
      }

      const bucketEl = document.getElementById(`bucket-${bucketSound}`);
      const chip = document.createElement('div');
      chip.className = `p-2 rounded-lg text-xs font-bold flex items-center justify-between border shadow-sm ${
        item.isCorrect ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-rose-100 text-rose-800 border-rose-300'
      }`;
      chip.innerHTML = `<span>${item.plural}</span> <span>${item.isCorrect ? '✓' : '✗ (' + item.sound + ')'}</span>`;
      bucketEl.appendChild(chip);

      state.selectedPluralIndex = null;
      renderPluralGame();
    }

    function resetPluralGame() {
      state.pluralItems.forEach(i => { delete i.placed; delete i.isCorrect; });
      state.selectedPluralIndex = null;
      document.getElementById('bucket-z').innerHTML = '';
      document.getElementById('bucket-s').innerHTML = '';
      document.getElementById('bucket-iz').innerHTML = '';
      renderPluralGame();
    }

    /* MODULE 3 LOGIC */
    function switchInterviewSubTab(sub) {
      ['task1', 'task2', 'sim'].forEach(s => {
        document.getElementById(`interviewTask${s === 'task1' ? '1' : s === 'task2' ? '2' : 'Sim'}`).classList.add('hidden');
        const btn = document.getElementById(`sub-${s}`);
        btn.classList.remove('bg-purple-100', 'text-purple-700');
        btn.classList.add('text-slate-600', 'hover:bg-slate-100');
      });

      const activeBtn = document.getElementById(`sub-${sub}`);
      activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
      activeBtn.classList.add('bg-purple-100', 'text-purple-700');

      if (sub === 'task1') document.getElementById('interviewTask1').classList.remove('hidden');
      if (sub === 'task2') document.getElementById('interviewTask2').classList.remove('hidden');
      if (sub === 'sim') {
        document.getElementById('interviewSim').classList.remove('hidden');
        if (state.simStep === 0 && document.getElementById('chatStream').children.length === 0) {
          startInterviewSim();
        }
      }
    }

    function renderTask1Cards() {
      const grid = document.getElementById('task1CardsGrid');
      grid.innerHTML = '';

      state.task1Cards.forEach((c, i) => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-purple-300 transition';
        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-purple-100 text-purple-700">${c.topic}</span>
              <button onclick="speakText('${c.q.replace(/'/g, "\\'")}')" class="text-xs text-purple-600 hover:text-purple-800"><i class="fa-solid fa-volume-high"></i></button>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-3">"${c.q}"</h4>
            
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 space-y-1">
              <span class="font-bold text-slate-400 block uppercase text-[9px]">Sample A1 Candidate Response:</span>
              <p class="font-medium text-slate-800">"${c.a}"</p>
            </div>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100 flex justify-end">
            <button onclick="speakText('${c.a.replace(/'/g, "\\'")}')" class="text-xs font-semibold text-purple-600 hover:text-purple-800 flex items-center gap-1">
              <i class="fa-solid fa-play"></i> Listen to Answer
            </button>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function renderTask2Questions() {
      const grid = document.getElementById('task2QuestionsGrid');
      grid.innerHTML = '';

      state.task2Questions.forEach((q, i) => {
        const card = document.createElement('div');
        card.className = 'bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between gap-3';
        card.innerHTML = `
          <div class="space-y-1">
            <span class="text-[10px] font-bold text-indigo-600 uppercase bg-indigo-50 px-2 py-0.5 rounded">${q.title}</span>
            <p class="font-bold text-slate-900 text-sm">"${q.text}"</p>
          </div>
          <button onclick="speakText('${q.text.replace(/'/g, "\\'")}')" class="p-2.5 rounded-xl bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition">
            <i class="fa-solid fa-volume-high"></i>
          </button>
        `;
        grid.appendChild(card);
      });
    }

    /* Interactive Interview Simulation Chat */
    function startInterviewSim() {
      state.simStep = 0;
      const stream = document.getElementById('chatStream');
      stream.innerHTML = '';
      advanceSimStep();
    }

    function advanceSimStep() {
      const stream = document.getElementById('chatStream');
      const stepData = state.simSteps[state.simStep];

      if (!stepData) {
        // Interview Complete!
        const finMsg = document.createElement('div');
        finMsg.className = 'p-4 rounded-xl bg-emerald-100 text-emerald-900 text-xs font-bold text-center';
        finMsg.innerText = '🎉 Fantastic job! You completed the A1 Interview Simulation Drill!';
        stream.appendChild(finMsg);
        document.getElementById('chatOptionButtons').innerHTML = '';
        
        if (!state.completedActivities.interviewSim) {
          state.completedActivities.interviewSim = true;
          addXp(75);
          confetti({ particleCount: 75 });
        }
        return;
      }

      // Render Manager Question Message
      const msg = document.createElement('div');
      msg.className = 'flex gap-3 items-start max-w-[85%]';
      msg.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
          AI
        </div>
        <div class="bg-white p-3 rounded-2xl rounded-tl-none border border-slate-200 text-xs text-slate-800 shadow-sm space-y-1">
          <p class="font-medium">${stepData.interviewer}</p>
          <button onclick="speakText('${stepData.interviewer.replace(/'/g, "\\'")}')" class="text-[10px] text-indigo-600 font-semibold hover:underline">🔊 Listen</button>
        </div>
      `;
      stream.appendChild(msg);
      stream.scrollTop = stream.scrollHeight;

      // Speak automatically
      speakText(stepData.interviewer);

      // Render Candidate Options
      const controls = document.getElementById('chatOptionButtons');
      controls.innerHTML = '';

      stepData.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'p-3 rounded-xl border border-slate-200 bg-slate-50 hover:bg-indigo-50 hover:border-indigo-300 text-left text-xs font-semibold text-slate-800 transition flex items-center justify-between';
        btn.innerHTML = `<span>"${opt.text}"</span> <i class="fa-solid fa-chevron-right text-slate-400"></i>`;
        btn.onclick = () => handleSimChoice(opt);
        controls.appendChild(btn);
      });
    }

    function handleSimChoice(option) {
      const stream = document.getElementById('chatStream');

      // Append User Message
      const userMsg = document.createElement('div');
      userMsg.className = 'flex gap-3 items-start justify-end ml-auto max-w-[85%]';
      userMsg.innerHTML = `
        <div class="bg-indigo-600 text-white p-3 rounded-2xl rounded-tr-none text-xs font-medium shadow-sm">
          ${option.text}
        </div>
      `;
      stream.appendChild(userMsg);

      // Speak choice
      speakText(option.text);

      // Feedback Toast in stream
      const fb = document.createElement('div');
      fb.className = `p-2.5 rounded-lg text-xs font-semibold ${option.correct ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-800 border border-rose-200'}`;
      fb.innerText = `${option.correct ? '✓' : '💡'} ${option.feedback}`;
      stream.appendChild(fb);

      stream.scrollTop = stream.scrollHeight;

      if (option.correct) {
        addXp(10);
        state.simStep++;
        setTimeout(advanceSimStep, 1500);
      }
    }

    /* MODULE 4 & GAMIFICATION LOGIC */
    function checkBadges() {
      if (state.xp >= 10 && !state.badges.firstSteps) state.badges.firstSteps = true;
      if (state.completedActivities.greetingsSort && state.completedActivities.greetingsMatch && !state.badges.greetingGuru) state.badges.greetingGuru = true;
      if (state.completedActivities.pluralSort && !state.badges.phonicsMaster) state.badges.phonicsMaster = true;
      if (state.completedActivities.interviewSim && !state.badges.interviewPro) state.badges.interviewPro = true;
      
      const allDone = Object.values(state.completedActivities).every(Boolean);
      if (allDone && !state.badges.a1Champion) state.badges.a1Champion = true;
    }

    function updateDashboardUI() {
      document.getElementById('headerXp').innerText = state.xp;
      document.getElementById('statXp').innerText = state.xp;

      const badgeCount = Object.values(state.badges).filter(Boolean).length;
      document.getElementById('headerBadges').innerText = badgeCount;
      document.getElementById('statBadges').innerText = `${badgeCount}/5`;

      const completedCount = Object.values(state.completedActivities).filter(Boolean).length;
      document.getElementById('statActivities').innerText = `${completedCount}/4`;

      renderBadges();
    }

    function renderBadges() {
      const container = document.getElementById('badgesContainer');
      container.innerHTML = '';

      const badgeDefs = [
        { id: 'firstSteps', title: 'First Steps', desc: 'Earn your first 10 XP', icon: 'fa-shoe-prints', unlocked: state.badges.firstSteps },
        { id: 'greetingGuru', title: 'Greeting Guru', desc: 'Master Hello & Good-bye', icon: 'fa-comments', unlocked: state.badges.greetingGuru },
        { id: 'phonicsMaster', title: 'Phonics Champ', desc: 'Master Plural -s endings', icon: 'fa-volume-high', unlocked: state.badges.phonicsMaster },
        { id: 'interviewPro', title: 'Interview Pro', desc: 'Complete job interview drill', icon: 'fa-briefcase', unlocked: state.badges.interviewPro },
        { id: 'a1Champion', title: 'A1 Champion', desc: 'Complete all 4 activities', icon: 'fa-crown', unlocked: state.badges.a1Champion }
      ];

      badgeDefs.forEach(b => {
        const card = document.createElement('div');
        card.className = `p-4 rounded-2xl border transition flex items-center gap-3 ${
          b.unlocked 
            ? 'bg-gradient-to-r from-amber-50 to-orange-50 border-amber-300 shadow-sm badge-glow' 
            : 'bg-slate-50 border-slate-200 opacity-60 grayscale'
        }`;
        card.innerHTML = `
          <div class="w-12 h-12 rounded-xl ${b.unlocked ? 'bg-amber-500 text-white' : 'bg-slate-200 text-slate-500'} flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid ${b.icon}"></i>
          </div>
          <div>
            <h4 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
              ${b.title} ${b.unlocked ? '<i class="fa-solid fa-circle-check text-amber-600 text-xs"></i>' : ''}
            </h4>
            <p class="text-xs text-slate-500">${b.desc}</p>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function resetAllProgress() {
      state.xp = 0;
      Object.keys(state.completedActivities).forEach(k => state.completedActivities[k] = false);
      Object.keys(state.badges).forEach(k => state.badges[k] = false);

      resetGreetingsSort();
      resetPluralGame();
      updateDashboardUI();
      alert('All progress has been reset successfully.');
    }

    /* Initialize App on Load */
    window.onload = function() {
      renderGreetingsSort();
      renderGreetingsMatching();
      renderPluralGame();
      renderTask1Cards();
      renderTask2Questions();
      updateDashboardUI();
    };
  </script>
</body>
</html>
