<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EnglishStart A1 - Interactive ESL Learning Hub</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Canvas Confetti for Gamification -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f6ff',
              100: '#e0edff',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
            },
            zColor: '#0284c7',
            sColor: '#d97706',
            izColor: '#7c3aed'
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* Custom utility classes & smooth animations */
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(226, 232, 240, 0.8);
    }
    .badge-glow {
      box-shadow: 0 0 15px rgba(234, 179, 8, 0.4);
    }
    .pulse-subtle {
      animation: pulseSubtle 2s infinite;
    }
    @keyframes pulseSubtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.95; transform: scale(1.02); }
    }
    /* Hide scrollbar for clean UI */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="h-full text-slate-800 flex flex-col font-sans antialiased selection:bg-brand-500 selection:text-white">

  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Brand & Logo -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-md">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <div>
            <h1 class="text-lg font-bold text-slate-900 leading-tight">EnglishStart <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">A1 Suite</span></h1>
            <p class="text-xs text-slate-500 hidden sm:block">Interactive Beginner ESL Mastery</p>
          </div>
        </div>

        <!-- Progress Tracker Bar -->
        <div class="flex items-center gap-4">
          <div class="hidden md:flex items-center gap-3 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200 text-xs font-medium">
            <span class="flex items-center gap-1 text-amber-600 font-bold">
              <i class="fa-solid fa-star text-amber-500"></i> <span id="headerXp">0</span> XP
            </span>
            <span class="text-slate-300">|</span>
            <span class="flex items-center gap-1 text-purple-600 font-bold">
              <i class="fa-solid fa-award"></i> <span id="headerBadges">0</span>/5 Badges
            </span>
          </div>

          <!-- Mobile Audio Toggle Helper -->
          <button id="ttsTestBtn" onclick="speakText('Welcome to English Start!')" class="p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition text-sm font-medium flex items-center gap-1.5" title="Test Voice Audio">
            <i class="fa-solid fa-volume-high"></i>
            <span class="hidden sm:inline">Audio Check</span>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex space-x-1 sm:space-x-4 overflow-x-auto no-scrollbar border-t border-slate-100 py-2">
        <button onclick="switchTab('greetingsTab')" id="btn-greetingsTab" class="nav-tab text-xs sm:text-sm font-semibold px-3 py-2 rounded-lg whitespace-nowrap transition flex items-center gap-2 bg-brand-600 text-white shadow-sm">
          <i class="fa-solid fa-comments"></i> 1. Greetings & Farewells
        </button>
        <button onclick="switchTab('pluralsTab')" id="btn-pluralsTab" class="nav-tab text-xs sm:text-sm font-semibold px-3 py-2 rounded-lg whitespace-nowrap transition flex items-center gap-2 text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-volume-down"></i> 2. Plural -s Endings
        </button>
        <button onclick="switchTab('interviewTab')" id="btn-interviewTab" class="nav-tab text-xs sm:text-sm font-semibold px-3 py-2 rounded-lg whitespace-nowrap transition flex items-center gap-2 text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-briefcase"></i> 3. Job Interview Drill
        </button>
        <button onclick="switchTab('progressTab')" id="btn-progressTab" class="nav-tab text-xs sm:text-sm font-semibold px-3 py-2 rounded-lg whitespace-nowrap transition flex items-center gap-2 text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-trophy"></i> 4. Progress & Badges
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

    <!-- MODULE 1: GREETINGS & FAREWELLS -->
    <section id="greetingsTab" class="tab-page space-y-6">
      <!-- Section Header Card -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 translate-x-4 -translate-y-4">
          <i class="fa-solid fa-hand-wave text-9xl"></i>
        </div>
        <div class="relative z-10 max-w-2xl">
          <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider">Module 1 • Vocabulary & Context</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold mt-2">Hello & Good-bye Expressions</h2>
          <p class="text-blue-100 mt-1 text-sm sm:text-base">Master how to start and finish everyday conversations naturally in American English.</p>
        </div>
      </div>

      <!-- Sub-Tabs for Greetings -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Part A: Expression Sorting -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xs">A</span>
                Sort Greetings vs. Farewells
              </h3>
              <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md" id="greetingsSortScore">0 / 12 Sorted</span>
            </div>
            <p class="text-xs text-slate-500 mb-4">Tap an expression, then tap the correct target box below.</p>

            <!-- Expression Bank -->
            <div id="greetingBank" class="flex flex-wrap gap-2 p-3 bg-slate-50 rounded-xl border border-dashed border-slate-300 min-h-[90px] mb-4">
              <!-- Dynamically Populated -->
            </div>

            <!-- Target Buckets -->
            <div class="grid grid-cols-2 gap-3">
              <div onclick="dropGreeting('hello')" class="cursor-pointer border-2 border-sky-200 bg-sky-50/50 hover:bg-sky-50 rounded-xl p-3 min-h-[160px] transition flex flex-col">
                <div class="text-sky-800 font-bold text-sm mb-2 flex items-center justify-between border-b border-sky-200 pb-1.5">
                  <span>👋 Hello (Greetings)</span>
                  <i class="fa-solid fa-sun text-sky-500"></i>
                </div>
                <div id="helloBucket" class="flex flex-col gap-1.5 flex-1"></div>
              </div>

              <div onclick="dropGreeting('goodbye')" class="cursor-pointer border-2 border-rose-200 bg-rose-50/50 hover:bg-rose-50 rounded-xl p-3 min-h-[160px] transition flex flex-col">
                <div class="text-rose-800 font-bold text-sm mb-2 flex items-center justify-between border-b border-rose-200 pb-1.5">
                  <span>🚶 Good-bye (Farewells)</span>
                  <i class="fa-solid fa-moon text-rose-500"></i>
                </div>
                <div id="goodbyeBucket" class="flex flex-col gap-1.5 flex-1"></div>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex justify-end">
            <button onclick="resetGreetingsSort()" class="text-xs font-semibold text-slate-500 hover:text-slate-800 flex items-center gap-1">
              <i class="fa-solid fa-rotate-right"></i> Reset Sorting
            </button>
          </div>
        </div>

        <!-- Part B: Conversation Response Matcher -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-bold text-slate-900 text-lg flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs">B</span>
                Match Statement to Best Response
              </h3>
              <button onclick="checkGreetingMatches()" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold transition">
                Check Answers
              </button>
            </div>
            <p class="text-xs text-slate-500 mb-4">Select the most natural polite response for each greeting or farewell.</p>

            <div class="space-y-3" id="matchingContainer">
              <!-- Dynamically populated matches -->
            </div>
          </div>

          <div id="matchingFeedback" class="mt-4 p-3 rounded-xl text-xs font-semibold text-center hidden">
            <!-- Feedback msg -->
          </div>
        </div>
      </div>

      <!-- Part C: Practice Dialogue Reference & Pronunciation Guide -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <h3 class="font-bold text-slate-900 text-base mb-3 flex items-center gap-2">
          <i class="fa-solid fa-comments text-blue-600"></i> Sample Classroom Dialogue Practice
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <div class="text-xs font-bold text-blue-600 uppercase mb-2">Scenario 1: Informal Student Greeting</div>
            <div class="space-y-2 text-sm">
              <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-slate-100">
                <span><strong>A:</strong> Hi, Sakura. How's it going?</span>
                <button onclick="speakText('Hi, Sakura. How\'s it going?')" class="text-blue-600 hover:text-blue-800"><i class="fa-solid fa-volume-high"></i></button>
              </div>
              <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-slate-100">
                <span><strong>B:</strong> Pretty good, thanks. How are you?</span>
                <button onclick="speakText('Pretty good, thanks. How are you?')" class="text-blue-600 hover:text-blue-800"><i class="fa-solid fa-volume-high"></i></button>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <div class="text-xs font-bold text-emerald-600 uppercase mb-2">Scenario 2: Formal / Morning Greeting</div>
            <div class="space-y-2 text-sm">
              <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-slate-100">
                <span><strong>A:</strong> Good morning, Mr. Davis. Have a good day.</span>
                <button onclick="speakText('Good morning, Mr. Davis. Have a good day.')" class="text-emerald-600 hover:text-emerald-800"><i class="fa-solid fa-volume-high"></i></button>
              </div>
              <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-slate-100">
                <span><strong>B:</strong> Thank you. You, too! See you tomorrow.</span>
                <button onclick="speakText('Thank you. You, too! See you tomorrow.')" class="text-emerald-600 hover:text-emerald-800"><i class="fa-solid fa-volume-high"></i></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 2: PLURAL -S ENDINGS -->
    <section id="pluralsTab" class="tab-page hidden space-y-6">
      <!-- Section Header Card -->
      <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 translate-x-4 -translate-y-4">
          <i class="fa-solid fa-microphone-lines text-9xl"></i>
        </div>
        <div class="relative z-10 max-w-2xl">
          <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider">Module 2 • Phonetics & Plural Nouns</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold mt-2">Plural -s Pronunciation Master</h2>
          <p class="text-emerald-100 mt-1 text-sm sm:text-base">Learn when to pronounce plural "-s" as <strong>/z/</strong>, <strong>/s/</strong>, or the extra syllable <strong>/ɪz/</strong>.</p>
        </div>
      </div>

      <!-- Phonetic Rule Explanations -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-4 rounded-xl border-l-4 border-sky-500 shadow-sm border border-slate-200">
          <div class="flex items-center justify-between mb-1">
            <h4 class="font-bold text-sky-800 text-sm">/z/ Sound (Voiced)</h4>
            <span class="text-xs bg-sky-100 text-sky-700 px-2 py-0.5 rounded font-semibold">Vibration</span>
          </div>
          <p class="text-xs text-slate-600 mb-2">Used after voiced sounds like <em>/l/, /m/, /n/, /v/, vowels</em>. Vocal cords vibrate.</p>
          <div class="flex flex-wrap gap-1">
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">pencils</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">cell phones</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">flash drives</span>
          </div>
        </div>

        <div class="bg-white p-4 rounded-xl border-l-4 border-amber-500 shadow-sm border border-slate-200">
          <div class="flex items-center justify-between mb-1">
            <h4 class="font-bold text-amber-800 text-sm">/s/ Sound (Voiceless)</h4>
            <span class="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded font-semibold">Air Flow</span>
          </div>
          <p class="text-xs text-slate-600 mb-2">Used after unvoiced sounds like <em>/k/, /p/, /t/, /f/</em>. No vocal vibration.</p>
          <div class="flex flex-wrap gap-1">
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">desks</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">backpacks</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">tablets</span>
          </div>
        </div>

        <div class="bg-white p-4 rounded-xl border-l-4 border-purple-500 shadow-sm border border-slate-200">
          <div class="flex items-center justify-between mb-1">
            <h4 class="font-bold text-purple-800 text-sm">/ɪz/ Sound (Sibilants)</h4>
            <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded font-semibold">+1 Syllable</span>
          </div>
          <p class="text-xs text-slate-600 mb-2">Used after <em>/s/, /z/, /ʃ/, /ʧ/, /x/</em>. Adds an extra "is" syllable sound.</p>
          <div class="flex flex-wrap gap-1">
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">boxes</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">purses</span>
            <span class="text-[11px] bg-slate-100 px-2 py-0.5 rounded font-medium">phone cases</span>
          </div>
        </div>
      </div>

      <!-- 3-Bucket Interactive Sorting -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="font-bold text-slate-900 text-lg">Interactive Plural Ending Sorting</h3>
            <p class="text-xs text-slate-500">Tap a noun card, then select its correct pronunciation bucket.</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full" id="pluralScore">
              Progress: 0 / 9
            </span>
            <button onclick="resetPluralGame()" class="text-xs font-semibold text-slate-500 hover:text-slate-800">
              <i class="fa-solid fa-rotate"></i> Reset
            </button>
          </div>
        </div>

        <!-- Plural Word Pool -->
        <div id="pluralPool" class="flex flex-wrap gap-2 p-4 bg-slate-50 rounded-xl border border-dashed border-slate-300 min-h-[90px] mb-6">
          <!-- Dynamically generated word cards -->
        </div>

        <!-- 3 Buckets Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- /z/ Bucket -->
          <div onclick="dropPluralInBucket('z')" class="cursor-pointer border-2 border-sky-300 bg-sky-50/40 hover:bg-sky-50 rounded-xl p-4 min-h-[220px] transition flex flex-col">
            <div class="bg-sky-600 text-white font-extrabold text-center py-2 rounded-lg text-sm mb-3 shadow-sm flex items-center justify-center gap-2">
              <span>Bucket 1: /z/</span>
              <button onclick="event.stopPropagation(); speakText('z')" class="text-xs bg-white/20 hover:bg-white/30 px-2 py-0.5 rounded">🔊</button>
            </div>
            <div id="bucket-z" class="space-y-2 flex-1"></div>
          </div>

          <!-- /s/ Bucket -->
          <div onclick="dropPluralInBucket('s')" class="cursor-pointer border-2 border-amber-300 bg-amber-50/40 hover:bg-amber-50 rounded-xl p-4 min-h-[220px] transition flex flex-col">
            <div class="bg-amber-600 text-white font-extrabold text-center py-2 rounded-lg text-sm mb-3 shadow-sm flex items-center justify-center gap-2">
              <span>Bucket 2: /s/</span>
              <button onclick="event.stopPropagation(); speakText('s')" class="text-xs bg-white/20 hover:bg-white/30 px-2 py-0.5 rounded">🔊</button>
            </div>
            <div id="bucket-s" class="space-y-2 flex-1"></div>
          </div>

          <!-- /iz/ Bucket -->
          <div onclick="dropPluralInBucket('iz')" class="cursor-pointer border-2 border-purple-300 bg-purple-50/40 hover:bg-purple-50 rounded-xl p-4 min-h-[220px] transition flex flex-col">
            <div class="bg-purple-600 text-white font-extrabold text-center py-2 rounded-lg text-sm mb-3 shadow-sm flex items-center justify-center gap-2">
              <span>Bucket 3: /ɪz/</span>
              <button onclick="event.stopPropagation(); speakText('is')" class="text-xs bg-white/20 hover:bg-white/30 px-2 py-0.5 rounded">🔊</button>
            </div>
            <div id="bucket-iz" class="space-y-2 flex-1"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 3: INTERVIEW & CONVERSATION SIMULATOR -->
    <section id="interviewTab" class="tab-page hidden space-y-6">
      <!-- Section Header Card -->
      <div class="bg-gradient-to-r from-purple-700 to-indigo-800 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 translate-x-4 -translate-y-4">
          <i class="fa-solid fa-user-tie text-9xl"></i>
        </div>
        <div class="relative z-10 max-w-2xl">
          <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider">Module 3 • Real World Speaking Drill</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold mt-2">A1 Job Interview Practice</h2>
          <p class="text-purple-100 mt-1 text-sm sm:text-base">Practice answering personal background questions and asking interviewer questions at an A1 beginner level.</p>
        </div>
      </div>

      <!-- Mode Selector -->
      <div class="flex gap-3 border-b border-slate-200 pb-2">
        <button onclick="switchInterviewSubTab('task1')" id="sub-task1" class="px-4 py-2 rounded-xl text-sm font-bold bg-purple-100 text-purple-700 transition flex items-center gap-2">
          <i class="fa-solid fa-circle-question"></i> Task 1: Answering Questions
        </button>
        <button onclick="switchInterviewSubTab('task2')" id="sub-task2" class="px-4 py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          <i class="fa-solid fa-comments"></i> Task 2: Asking the Interviewer
        </button>
        <button onclick="switchInterviewSubTab('sim')" id="sub-sim" class="px-4 py-2 rounded-xl text-sm font-bold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          <i class="fa-solid fa-headset"></i> Interactive Live Simulation
        </button>
      </div>

      <!-- Sub-Tab 1: Task 1 Flashcards (Interviewer -> Candidate) -->
      <div id="interviewTask1" class="space-y-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs text-slate-600 flex items-center justify-between">
          <span><strong>Objective:</strong> Listen to the interviewer's question, flip the prompt card to study the A1 level sample answer, and click audio to practice.</span>
          <span class="text-purple-600 font-bold">A1 Beginner Level</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="task1CardsGrid">
          <!-- Dynamically Populated Cards -->
        </div>
      </div>

      <!-- Sub-Tab 2: Task 2 Builder (Candidate -> Interviewer) -->
      <div id="interviewTask2" class="hidden space-y-4">
        <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs text-slate-600">
          <strong>Task 2 Prompt:</strong> <em>"Now ask me some questions about me and my job at the company."</em> Practicing questions builds real workplace communication confidence.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="task2QuestionsGrid">
          <!-- Dynamically Populated Questions -->
        </div>
      </div>

      <!-- Sub-Tab 3: Interactive Live Roleplay Simulator -->
      <div id="interviewSim" class="hidden bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col min-h-[480px]">
        <!-- Chat Header -->
        <div class="bg-slate-900 text-white p-4 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="relative">
              <div class="w-10 h-10 rounded-full bg-indigo-500 flex items-center justify-center font-bold text-lg text-white">
                <i class="fa-solid fa-user-gear"></i>
              </div>
              <span class="w-3 h-3 bg-emerald-500 border-2 border-slate-900 rounded-full absolute bottom-0 right-0"></span>
            </div>
            <div>
              <h4 class="font-bold text-sm">Mr. Alex Smith</h4>
              <p class="text-xs text-slate-400">Hiring Manager • Global Tech Corp</p>
            </div>
          </div>
          <button onclick="startInterviewSim()" class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-xs font-bold transition flex items-center gap-1.5">
            <i class="fa-solid fa-play"></i> Start / Restart Interview
          </button>
        </div>

