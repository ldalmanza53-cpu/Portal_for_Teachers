        { prompt: "2. Hi. How are you?", options: ["a. Oh, not much.", "b. Thank you. You, too.", "c. Good morning.", "d. Pretty good, thanks."], correct: 3 },
        { prompt: "3. What's up?", options: ["a. Oh, not much.", "b. Thank you. You, too.", "c. Good morning.", "d. Pretty good, thanks."], correct: 0 },
        { prompt: "4. Good morning.", options: ["a. Oh, not much.", "b. Thank you. You, too.", "c. Good morning.", "d. Pretty good, thanks."], correct: 2 }
      ],

      // Module 2 Data
      selectedPluralIndex: null,
      pluralItems: [
        { singular: "phone case", plural: "phone cases", sound: "iz" },
        { singular: "student ID", plural: "student IDs", sound: "z" },
        { singular: "paper clip", plural: "paper clips", sound: "s" },
        { singular: "newspaper", plural: "newspapers", sound: "z" },
        { singular: "purse", plural: "purses", sound: "iz" },
        { singular: "tablet", plural: "tablets", sound: "s" },
        { singular: "television", plural: "televisions", sound: "z" },
        { singular: "ticket", plural: "tickets", sound: "s" },
        { singular: "box", plural: "boxes", sound: "iz" }
      ],

      // Module 3 Data
      task1Cards: [
