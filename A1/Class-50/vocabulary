<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snapshot • Common Health Problems</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        .tab-active { background-color: #2563eb !important; color: #ffffff !important; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35); }
        .symptom-card { transition: all 0.2s ease; }
        .symptom-card:hover { transform: translateY(-2px); }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500 to-red-600 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-notes-medical"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white flex items-center gap-2">
                        Snapshot: Common Health Problems
                        <span class="bg-rose-900/80 text-rose-300 border border-rose-500/40 text-[10px] px-2 py-0.5 rounded-full font-extrabold uppercase">A1-A2 Vocabulary</span>
                    </h1>
                    <p class="text-xs text-slate-400">Health Vocabulary, Past-Year Survey & Role-Play Studio</p>
                </div>
            </div>

            <!-- Timer & Actions -->
            <div class="flex items-center gap-3 bg-slate-900/90 px-4 py-2 rounded-xl border border-slate-700 text-sm">
                <div class="flex items-center gap-2 text-amber-400">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                    <span id="timerDisplay" class="font-mono font-bold text-lg">15:00</span>
                    <button onclick="toggleTimer()" id="timerBtn" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs px-2 py-1 rounded font-bold transition ml-1">Start</button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('snapshot')" id="tab-snapshot" class="nav-tab tab-active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-stethoscope"></i> 1. Health Problems Snapshot
                </button>
                <button onclick="switchTab('survey')" id="tab-survey" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-calendar-check"></i> 2. Past-Year Health Survey
                </button>
                <button onclick="switchTab('roleplay')" id="tab-roleplay" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-user-doctor"></i> 3. Doctor & Patient Studio
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: HEALTH PROBLEMS SNAPSHOT -->
        <section id="sec-snapshot" class="tab-content block space-y-6">
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-700 pb-3">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-book-medical text-rose-400"></i> Common Health Problems (8 Vocabulary Items)
                        </h2>
                        <p class="text-xs text-slate-400">
                            Click any item to listen to pronunciation. Check the boxes for symptoms you have experienced.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span id="checkedCount" class="bg-rose-950 text-rose-300 border border-rose-500/40 text-xs px-3 py-1.5 rounded-xl font-bold">0 / 8 Selected</span>
                    </div>
                </div>

                <!-- 8 Health Problems Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="symptomsGrid">
                    <!-- Javascript populates 8 cards -->
                </div>
            </div>
        </section>

        <!-- TAB 2: PAST-YEAR HEALTH SURVEY -->
        <section id="sec-survey" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-amber-900/60 text-amber-300 border border-amber-500/40 text-xs font-bold rounded-full uppercase">Snapshot Question</span>
                    <h2 class="text-2xl font-bold text-white mt-1">How many times have you been sick in the past year?</h2>
                    <p class="text-sm text-slate-400">Enter how many times you had each health problem in the last 12 months.</p>
                </div>

                <!-- Survey List -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="surveyGrid">
                    <!-- Populated dynamically -->
                </div>

                <!-- Total Sickness Counter Card -->
                <div class="bg-slate-900 border border-slate-700 rounded-2xl p-5 flex flex-col md:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-2xl font-bold">
                            <i class="fa-solid fa-virus-slash"></i>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase">Total Times Sick (Past Year)</span>
                            <p id="totalTimesSick" class="text-3xl font-extrabold text-amber-400">0 times</p>
                        </div>
                    </div>
                    <button onclick="calculateSurveyResult()" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-5 py-3 rounded-xl text-xs transition flex items-center gap-2 shadow-lg">
                        <i class="fa-solid fa-chart-pie"></i> Complete Survey Summary
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 3: DOCTOR & PATIENT ROLE-PLAY STUDIO -->
        <section id="sec-roleplay" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-blue-900/60 text-blue-300 border border-blue-500/40 text-xs font-bold rounded-full uppercase">Pair Work Studio</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Doctor & Patient Consultation</h2>
                    <p class="text-sm text-slate-400">Select a health problem to build a dialogue with voice audio models.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-rose-400 uppercase block mb-1">Select Patient Symptom</label>
                            <select id="roleSymptom" onchange="generateDialogue()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                                <!-- Dynamic Options -->
                            </select>
                        </div>

                        <div>
                            <label class="text-xs font-bold text-amber-400 uppercase block mb-1">Doctor Advice / Remedy</label>
                            <select id="roleAdvice" onchange="generateDialogue()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                                <option value="take some medicine and rest">take some medicine and rest</option>
                                <option value="drink warm tea and stay home">drink warm tea and stay home</option>
                                <option value="get a good night's sleep">get a good night's sleep</option>
                                <option value="see a doctor or specialist">see a doctor or specialist</option>
                            </select>
                        </div>
                    </div>

                    <!-- Audio Dialogue Box -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div>
                                <span class="text-[10px] font-bold text-blue-400 uppercase tracking-widest block">Doctor:</span>
                                <p id="docQuestion" class="text-sm font-bold text-slate-200">"What's the matter?"</p>
                            </div>
                            <div>
                                <span class="text-[10px] font-bold text-rose-400 uppercase tracking-widest block">Patient:</span>
                                <p id="patAnswer" class="text-sm font-bold text-rose-300">"I have a headache."</p>
                            </div>
                            <div>
                                <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest block">Doctor's Advice:</span>
                                <p id="docAdvice" class="text-sm font-bold text-emerald-400">"You should take some medicine and rest."</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 pt-2">
                            <button onclick="speakText(document.getElementById('patAnswer').innerText)" class="bg-rose-700 hover:bg-rose-600 text-white font-bold py-2 rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-volume-high"></i> Patient Voice
                            </button>
                            <button onclick="speakText(document.getElementById('docAdvice').innerText)" class="bg-emerald-700 hover:bg-emerald-600 text-white font-bold py-2 rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-volume-high"></i> Doctor Voice
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Snapshot: Common Health Problems • Interactive ESL Activity (A1-A2)
    </footer>

    <script>
        // Data derived directly from source image 9
        const healthData = [
            { id: 'h1', text: 'a headache', article: 'a', icon: 'fa-brain', defaultAdvice: 'take some medicine' },
            { id: 'h2', text: 'a cough', article: 'a', icon: 'fa-lungs-virus', defaultAdvice: 'drink warm tea' },
            { id: 'h3', text: 'a cold', article: 'a', icon: 'fa-snowflake', defaultAdvice: 'rest at home' },
            { id: 'h4', text: 'the flu', article: 'the', icon: 'fa-thermometer-half', defaultAdvice: 'stay in bed' },
            { id: 'h5', text: 'a stomachache', article: 'a', icon: 'fa-bacteria', defaultAdvice: 'drink hot water' },
            { id: 'h6', text: 'a backache', article: 'a', icon: 'fa-bone', defaultAdvice: 'avoid lifting heavy things' },
            { id: 'h7', text: 'sore muscles', article: '', icon: 'fa-dumbbell', defaultAdvice: 'take a warm bath' },
            { id: 'h8', text: 'insomnia', article: '', icon: 'fa-moon', defaultAdvice: 'avoid coffee before bed' }
        ];

        let checkedState = {};
        let surveyCounts = {};
        let timerSeconds = 900;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderSymptomsGrid();
            renderSurveyGrid();
            populateRoleSymptomSelect();
            generateDialogue();
        });

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Render Symptoms Grid (Tab 1)
        function renderSymptomsGrid() {
            const grid = document.getElementById('symptomsGrid');
            grid.innerHTML = '';

            healthData.forEach(item => {
                const isChecked = !!checkedState[item.id];
                const card = document.createElement('div');
                card.className = `symptom-card p-4 rounded-2xl border flex flex-col justify-between space-y-3 cursor-pointer ${
                    isChecked ? 'bg-rose-950/60 border-rose-500 text-white' : 'bg-slate-900 border-slate-700 text-slate-200'
                }`;

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center text-rose-400 text-lg">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <input type="checkbox" ${isChecked ? 'checked' : ''} onchange="toggleCheck('${item.id}', event)" class="w-5 h-5 accent-rose-500 rounded cursor-pointer">
                    </div>
                    <div>
                        <span class="text-xs text-slate-400 font-semibold block">Symptom</span>
                        <h3 class="font-bold text-sm capitalize flex items-center gap-2">
                            ${item.text}
                        </h3>
                    </div>
                    <button onclick="event.stopPropagation(); speakText('${item.text}')" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 py-1.5 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-volume-high text-rose-400"></i> Listen
                    </button>
                `;

                card.onclick = (e) => {
                    if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'BUTTON' && !e.target.closest('button')) {
                        toggleCheck(item.id);
                    }
                };

                grid.appendChild(card);
            });

            updateCheckedCount();
        }

        function toggleCheck(id, event) {
            if (event) event.stopPropagation();
            checkedState[id] = !checkedState[id];
            renderSymptomsGrid();
        }

        function updateCheckedCount() {
            const count = Object.values(checkedState).filter(Boolean).length;
            document.getElementById('checkedCount').innerText = `${count} / 8 Selected`;
        }

        // Render Survey Grid (Tab 2)
        function renderSurveyGrid() {
            const grid = document.getElementById('surveyGrid');
            grid.innerHTML = '';

            healthData.forEach(item => {
                const val = surveyCounts[item.id] || 0;
                const card = document.createElement('div');
                card.className = 'bg-slate-900 border border-slate-700 p-4 rounded-xl flex items-center justify-between gap-3';
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-slate-800 text-rose-400 flex items-center justify-center">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <span class="text-xs font-bold text-slate-200 capitalize">${item.text}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="updateSurveyCount('${item.id}', -1)" class="w-7 h-7 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-bold text-xs">-</button>
                        <span class="text-xs font-extrabold text-amber-400 w-6 text-center">${val}</span>
                        <button onclick="updateSurveyCount('${item.id}', 1)" class="w-7 h-7 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-bold text-xs">+</button>
                    </div>
                `;
                grid.appendChild(card);
            });

            recalculateTotal();
        }

        function updateSurveyCount(id, delta) {
            const current = surveyCounts[id] || 0;
            const updated = Math.max(0, current + delta);
            surveyCounts[id] = updated;
            renderSurveyGrid();
        }

        function recalculateTotal() {
            const total = Object.values(surveyCounts).reduce((a, b) => a + b, 0);
            document.getElementById('totalTimesSick').innerText = `${total} time${total === 1 ? '' : 's'}`;
        }

        function calculateSurveyResult() {
            const total = Object.values(surveyCounts).reduce((a, b) => a + b, 0);
            confetti({ particleCount: 50, spread: 70 });
            alert(`🎉 Survey Logged! You were sick ${total} time(s) in the past year.`);
        }

        // Role Play Generator (Tab 3)
        function populateRoleSymptomSelect() {
            const select = document.getElementById('roleSymptom');
            select.innerHTML = '';

            healthData.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.innerText = item.text;
                select.appendChild(opt);
            });
        }

        function generateDialogue() {
            const symptomId = document.getElementById('roleSymptom').value;
            const adviceVal = document.getElementById('roleAdvice').value;
            const item = healthData.find(h => h.id === symptomId);

            document.getElementById('docQuestion').innerText = `"What's the matter?"`;
            document.getElementById('patAnswer').innerText = `"I have ${item.text}."`;
            document.getElementById('docAdvice').innerText = `"You should ${adviceVal}."`;
        }

        // Navigation
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
