<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Power • Describing Places</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        .tab-active { background-color: #2563eb !important; color: #ffffff !important; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35); }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-city"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white flex items-center gap-2">
                        Word Power: Describing Places
                        <span class="bg-sky-900/80 text-sky-300 border border-sky-500/40 text-[10px] px-2 py-0.5 rounded-full font-extrabold uppercase">A1-A2 Vocabulary</span>
                    </h1>
                    <p class="text-xs text-slate-400">Adjectives, Antonyms & City Showcase Pair Activity</p>
                </div>
            </div>

            <!-- Timer & Actions -->
            <div class="flex items-center gap-3 bg-slate-900/90 px-4 py-2 rounded-xl border border-slate-700 text-sm">
                <div class="flex items-center gap-2 text-amber-400">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                    <span id="timerDisplay" class="font-mono font-bold text-lg">15:00</span>
                    <button onclick="toggleTimer()" id="timerBtn" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs px-2 py-1 rounded font-bold transition ml-1">Start</button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('matching')" id="tab-matching" class="nav-tab tab-active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-arrows-rotate"></i> 1. Part A: Match Opposites
                </button>
                <button onclick="switchTab('expansion')" id="tab-expansion" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-plus-circle"></i> 2. Part A: Add Pairs (9 & 10)
                </button>
                <button onclick="switchTab('speaking')" id="tab-speaking" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-comments"></i> 3. Part B: Describe Places
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: OPPOSITE MATCHING (PART A) -->
        <section id="sec-matching" class="tab-content block space-y-6">
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-700 pb-3">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-arrow-right-arrow-left text-sky-400"></i> Match Column A with Opposite in Column B
                        </h2>
                        <p class="text-xs text-slate-400">
                            Select the matching opposite adjective from Column B for each word in Column A.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="checkMatches()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-bold text-xs transition flex items-center gap-2 shadow-md">
                            <i class="fa-solid fa-circle-check"></i> Check Answers
                        </button>
                        <button onclick="resetMatches()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 px-3 py-2 rounded-xl font-bold text-xs transition">
                            <i class="fa-solid fa-rotate-right"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- Match Table -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="matchingGrid">
                    <!-- Javascript populates 8 pairs -->
                </div>
            </div>
        </section>

        <!-- TAB 2: PART A EXPANSION (9 & 10) -->
        <section id="sec-expansion" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-sky-900/60 text-sky-300 border border-sky-500/40 text-xs font-bold rounded-full uppercase">Part A Extension</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Add Two More Pairs of Adjectives</h2>
                    <p class="text-sm text-slate-400">Think of two new pairs of opposite words to describe cities or places!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Pair 9 -->
                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-sm font-bold text-amber-400 uppercase">Pair 9</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 block mb-1">Column A (Word 9)</label>
                                <input type="text" placeholder="e.g., hot" id="word9a" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-sky-500">
                            </div>
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 block mb-1">Column B (Opposite i)</label>
                                <input type="text" placeholder="e.g., cold" id="word9b" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-sky-500">
                            </div>
                        </div>
                    </div>

                    <!-- Pair 10 -->
                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-sm font-bold text-amber-400 uppercase">Pair 10</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 block mb-1">Column A (Word 10)</label>
                                <input type="text" placeholder="e.g., modern" id="word10a" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-sky-500">
                            </div>
                            <div>
                                <label class="text-[11px] font-bold text-slate-400 block mb-1">Column B (Opposite j)</label>
                                <input type="text" placeholder="e.g., ancient / old" id="word10b" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-sky-500">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: SPEAKING PRACTICE (PART B) -->
        <section id="sec-speaking" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-indigo-900/60 text-indigo-300 border border-indigo-500/40 text-xs font-bold rounded-full uppercase">Part B: Pair Work</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Describe Two Places You Know</h2>
                    <p class="text-sm text-slate-400">Select adjectives to build a real-world city description and audio model.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-sky-400 uppercase block mb-1">Place Name</label>
                            <input type="text" id="cityName" value="Santorini" oninput="generateCityDescription()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-xs font-bold text-emerald-400 uppercase block mb-1">Positive Feature</label>
                                <select id="adj1" onchange="generateCityDescription()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none">
                                    <option value="beautiful">beautiful</option>
                                    <option value="cheap">cheap</option>
                                    <option value="clean">clean</option>
                                    <option value="interesting">interesting</option>
                                    <option value="quiet">quiet</option>
                                    <option value="relaxing">relaxing</option>
                                    <option value="safe">safe</option>
                                    <option value="spacious">spacious</option>
                                </select>
                            </div>

                            <div>
                                <label class="text-xs font-bold text-rose-400 uppercase block mb-1">Contrast Feature</label>
                                <select id="adj2" onchange="generateCityDescription()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-2.5 text-xs text-white focus:outline-none">
                                    <option value="expensive">expensive</option>
                                    <option value="crowded">crowded</option>
                                    <option value="noisy">noisy</option>
                                    <option value="boring">boring</option>
                                    <option value="polluted">polluted</option>
                                    <option value="stressful">stressful</option>
                                    <option value="dangerous">dangerous</option>
                                    <option value="ugly">ugly</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Audio & Question Box -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest block mb-1">Speaking Model:</span>
                            <p id="citySentence" class="text-lg font-bold text-amber-300">"Santorini is a really beautiful place, but it is expensive."</p>
                        </div>

                        <button onclick="speakText(document.getElementById('citySentence').innerText)" class="w-full bg-sky-600 hover:bg-sky-500 text-white font-bold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Listen to Description
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Word Power: Describing Places • Interactive ESL Activity (A1-A2)
    </footer>

    <script>
        // Matching Dataset derived from source image 8
        const columnAData = [
            { id: 1, word: '1. beautiful', correctOpposite: 'h' },
            { id: 2, word: '2. cheap', correctOpposite: 'd' },
            { id: 3, word: '3. clean', correctOpposite: 'f' },
            { id: 4, word: '4. interesting', correctOpposite: 'a' },
            { id: 5, word: '5. quiet', correctOpposite: 'e' },
            { id: 6, word: '6. relaxing', correctOpposite: 'g' },
            { id: 7, word: '7. safe', correctOpposite: 'c' },
            { id: 8, word: '8. spacious', correctOpposite: 'b' }
        ];

        const columnBOptions = [
            { key: 'a', word: 'a. boring' },
            { key: 'b', word: 'b. crowded' },
            { key: 'c', word: 'c. dangerous' },
            { key: 'd', word: 'd. expensive' },
            { key: 'e', word: 'e. noisy' },
            { key: 'f', word: 'f. polluted' },
            { key: 'g', word: 'g. stressful' },
            { key: 'h', word: 'h. ugly' }
        ];

        let timerSeconds = 900;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderMatchingGrid();
            generateCityDescription();
        });

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Render Matching Grid
        function renderMatchingGrid() {
            const grid = document.getElementById('matchingGrid');
            grid.innerHTML = '';

            columnAData.forEach(item => {
                const card = document.createElement('div');
                card.className = 'bg-slate-900 border border-slate-700 p-3.5 rounded-xl flex items-center justify-between gap-3';
                
                let selectOptions = `<option value="">Select opposite...</option>`;
                columnBOptions.forEach(opt => {
                    selectOptions += `<option value="${opt.key}">${opt.word}</option>`;
                });

                card.innerHTML = `
                    <div class="flex items-center gap-2">
                        <button onclick="speakText('${item.word.split('. ')[1]}')" class="text-sky-400 hover:text-sky-300 text-xs">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <span class="text-xs font-bold text-slate-200">${item.word}</span>
                    </div>
                    <select id="match-select-${item.id}" class="bg-slate-800 border border-slate-600 text-xs text-amber-300 font-bold rounded-lg p-2 focus:outline-none focus:border-sky-500">
                        ${selectOptions}
                    </select>
                `;
                grid.appendChild(card);
            });
        }

        function checkMatches() {
            let correct = 0;
            columnAData.forEach(item => {
                const selectEl = document.getElementById(`match-select-${item.id}`);
                const userVal = selectEl.value;

                if (userVal === item.correctOpposite) {
                    correct++;
                    selectEl.className = "bg-emerald-950 border-2 border-emerald-500 text-xs text-emerald-300 font-bold rounded-lg p-2 focus:outline-none";
                } else {
                    selectEl.className = "bg-rose-950 border-2 border-rose-500 text-xs text-rose-300 font-bold rounded-lg p-2 focus:outline-none";
                }
            });

            if (correct === 8) {
                confetti({ particleCount: 50, spread: 70 });
                alert("🎉 Excellent! All 8 adjective opposite pairs are correct!");
            } else {
                alert(`You got ${correct} out of 8 correct. Review your answers and try again!`);
            }
        }

        function resetMatches() {
            columnAData.forEach(item => {
                const selectEl = document.getElementById(`match-select-${item.id}`);
                selectEl.value = "";
                selectEl.className = "bg-slate-800 border border-slate-600 text-xs text-amber-300 font-bold rounded-lg p-2 focus:outline-none focus:border-sky-500";
            });
        }

        // Speaking Description Generator
        function generateCityDescription() {
            const city = document.getElementById('cityName').value || "This city";
            const a1 = document.getElementById('adj1').value;
            const a2 = document.getElementById('adj2').value;

            document.getElementById('citySentence').innerText = `"${city} is a really ${a1} place, but it is ${a2}."`;
        }

        // Navigation
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
