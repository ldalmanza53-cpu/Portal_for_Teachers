<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sports & Fitness Vocabulary Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        doColor: '#3b82f6',
                        goColor: '#f59e0b',
                        playColor: '#ec4899'
                    }
                }
            }
        }
    </script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        
        .card-flip {
            perspective: 1000px;
        }
        .card-inner {
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        .card-flip.flipped .card-inner {
            transform: rotateY(180deg);
        }
        .card-front, .card-back {
            backface-visibility: hidden;
        }
        .card-back {
            transform: rotateY(180deg);
        }

        .drop-zone {
            min-height: 180px;
            transition: all 0.2s ease;
        }
        .drop-zone.drag-over {
            background-color: rgba(59, 130, 246, 0.15);
            border-style: solid;
            transform: scale(1.02);
        }

        .draggable-item {
            cursor: grab;
            user-select: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .draggable-item:active {
            cursor: grabbing;
            transform: scale(1.05);
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Top Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-person-running"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white">Sports & Fitness Studio</h1>
                    <p class="text-xs text-slate-400">Word Power • Level A1-A2 Beginner</p>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="flex items-center gap-6 bg-slate-900/80 px-4 py-2 rounded-lg border border-slate-700 text-sm">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span class="text-slate-400">Score:</span>
                    <span id="scoreDisplay" class="font-bold text-emerald-400 text-base">0</span>
                </div>
                <div class="h-4 w-px bg-slate-700"></div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-fire text-orange-500"></i>
                    <span class="text-slate-400">Streak:</span>
                    <span id="streakDisplay" class="font-bold text-orange-400 text-base">0</span>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('sorter')" id="tab-sorter" class="nav-tab active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap bg-emerald-600 text-white shadow">
                    <i class="fa-solid fa-layer-group"></i> 1. Do / Go / Play Sorter
                </button>
                <button onclick="switchTab('survey')" id="tab-survey" class="nav-tab px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-list-check"></i> 2. Age Group Survey
                </button>
                <button onclick="switchTab('flashcards')" id="tab-flashcards" class="nav-tab px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-id-card"></i> 3. Audio Flashcards
                </button>
                <button onclick="switchTab('charades')" id="tab-charades" class="nav-tab px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-gamepad"></i> 4. Rapid Quiz Game
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: DO / GO / PLAY SORTER -->
        <section id="sec-sorter" class="tab-content block space-y-6">
            <!-- Grammar Rule Banner -->
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg">
                <h2 class="text-lg font-bold text-emerald-400 mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb"></i> Grammar Rule: Which verb do I use?
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                    <div class="bg-blue-950/50 border border-blue-600/40 p-3 rounded-xl flex gap-3 items-start">
                        <span class="px-2.5 py-1 bg-blue-600 text-white font-bold rounded-lg text-xs">DO</span>
                        <p class="text-blue-200">Used for martial arts, individual exercise, and non-ball activities.</p>
                    </div>
                    <div class="bg-amber-950/50 border border-amber-600/40 p-3 rounded-xl flex gap-3 items-start">
                        <span class="px-2.5 py-1 bg-amber-600 text-white font-bold rounded-lg text-xs">GO</span>
                        <p class="text-amber-200">Used for recreational sports or activities ending in <strong>-ing</strong>.</p>
                    </div>
                    <div class="bg-pink-950/50 border border-pink-600/40 p-3 rounded-xl flex gap-3 items-start">
                        <span class="px-2.5 py-1 bg-pink-600 text-white font-bold rounded-lg text-xs">PLAY</span>
                        <p class="text-pink-200">Used for team sports or competitive games with a <strong>ball</strong>.</p>
                    </div>
                </div>
            </div>

            <!-- Drag & Drop Arena -->
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h3 class="text-xl font-bold text-white">Drag or Tap items into the correct bucket</h3>
                        <p class="text-sm text-slate-400">Match each activity with <strong>do</strong>, <strong>go</strong>, or <strong>play</strong>.</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="checkSorterAnswers()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-semibold text-sm transition flex items-center gap-2 shadow-lg">
                            <i class="fa-solid fa-circle-check"></i> Check Answers
                        </button>
                        <button onclick="resetSorter()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 px-4 py-2 rounded-xl font-semibold text-sm transition flex items-center gap-2">
                            <i class="fa-solid fa-rotate-right"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- Word Pool -->
                <div class="bg-slate-900/90 p-4 rounded-xl border border-dashed border-slate-600 min-h-[90px]">
                    <div class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">Unassigned Activities:</div>
                    <div id="wordPool" class="flex flex-wrap gap-3 min-h-[40px]">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Drop Buckets -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- DO Bucket -->
                    <div class="bg-slate-900 border-2 border-blue-500/50 rounded-xl p-4 flex flex-col">
                        <div class="flex justify-between items-center mb-3 pb-2 border-b border-blue-500/30">
                            <span class="text-blue-400 font-bold text-lg flex items-center gap-2">
                                <i class="fa-solid fa-child-reaching"></i> DO
                            </span>
                            <span id="doCount" class="text-xs px-2 py-0.5 bg-blue-900/80 text-blue-200 rounded-full font-semibold">0 items</span>
                        </div>
                        <div id="bucket-do" ondragover="allowDrop(event)" ondragleave="dragLeave(event)" ondrop="handleDrop(event, 'do')" class="drop-zone flex-grow bg-slate-950/60 rounded-lg p-3 border border-slate-800 flex flex-col gap-2">
                            <!-- Items go here -->
                        </div>
                    </div>

                    <!-- GO Bucket -->
                    <div class="bg-slate-900 border-2 border-amber-500/50 rounded-xl p-4 flex flex-col">
                        <div class="flex justify-between items-center mb-3 pb-2 border-b border-amber-500/30">
                            <span class="text-amber-400 font-bold text-lg flex items-center gap-2">
                                <i class="fa-solid fa-person-running"></i> GO (-ing)
                            </span>
                            <span id="goCount" class="text-xs px-2 py-0.5 bg-amber-900/80 text-amber-200 rounded-full font-semibold">0 items</span>
                        </div>
                        <div id="bucket-go" ondragover="allowDrop(event)" ondragleave="dragLeave(event)" ondrop="handleDrop(event, 'go')" class="drop-zone flex-grow bg-slate-950/60 rounded-lg p-3 border border-slate-800 flex flex-col gap-2">
                            <!-- Items go here -->
                        </div>
                    </div>

                    <!-- PLAY Bucket -->
                    <div class="bg-slate-900 border-2 border-pink-500/50 rounded-xl p-4 flex flex-col">
                        <div class="flex justify-between items-center mb-3 pb-2 border-b border-pink-500/30">
                            <span class="text-pink-400 font-bold text-lg flex items-center gap-2">
                                <i class="fa-solid fa-basketball"></i> PLAY (Ball/Team)
                            </span>
                            <span id="playCount" class="text-xs px-2 py-0.5 bg-pink-900/80 text-pink-200 rounded-full font-semibold">0 items</span>
                        </div>
                        <div id="bucket-play" ondragover="allowDrop(event)" ondragleave="dragLeave(event)" ondrop="handleDrop(event, 'play')" class="drop-zone flex-grow bg-slate-950/60 rounded-lg p-3 border border-slate-800 flex flex-col gap-2">
                            <!-- Items go here -->
                        </div>
                    </div>
                </div>

                <div id="sorterFeedback" class="hidden p-4 rounded-xl text-center font-bold text-sm"></div>
            </div>
        </section>

        <!-- TAB 2: AGE GROUP SURVEY -->
        <section id="sec-survey" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-users text-emerald-400"></i> Age Group Popularity Survey
                    </h2>
                    <p class="text-sm text-slate-400">Which of these activities are popular with the following age groups in your country?</p>
                </div>

                <!-- Matrix Table -->
                <div class="overflow-x-auto rounded-xl border border-slate-700 bg-slate-900">
                    <table class="w-full text-left text-sm text-slate-300">
                        <thead class="bg-slate-800 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
                            <tr>
                                <th class="p-4 font-semibold">Activity</th>
                                <th class="p-4 text-center font-semibold">Children</th>
                                <th class="p-4 text-center font-semibold">Teens</th>
                                <th class="p-4 text-center font-semibold">Young adults</th>
                                <th class="p-4 text-center font-semibold">Middle-aged people</th>
                                <th class="p-4 text-center font-semibold">Older people</th>
                            </tr>
                        </thead>
                        <tbody id="surveyTableBody" class="divide-y divide-slate-800">
                            <!-- JS Populated -->
                        </tbody>
                    </table>
                </div>

                <!-- Sentence Generator & Practice -->
                <div class="bg-slate-900 p-5 rounded-xl border border-slate-700 space-y-4">
                    <div class="flex justify-between items-center flex-wrap gap-2">
                        <h3 class="font-bold text-emerald-400 text-base flex items-center gap-2">
                            <i class="fa-solid fa-comment-dots"></i> Sentence Builder & Speaking Practice
                        </h3>
                        <button onclick="generateSurveySentence()" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs px-3 py-1.5 rounded-lg font-medium text-slate-200 transition">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> Generate Custom Sentence
                        </button>
                    </div>

                    <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 text-lg text-slate-200 flex items-center justify-between gap-4">
                        <p id="surveyGeneratedText" class="italic">"Select checkboxes above and click generate sentence..."</p>
                        <button onclick="speakText(document.getElementById('surveyGeneratedText').innerText)" class="w-10 h-10 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white flex-shrink-0 flex items-center justify-center transition shadow">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: AUDIO FLASHCARDS -->
        <section id="sec-flashcards" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div class="flex justify-between items-center flex-wrap gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-id-card text-emerald-400"></i> Interactive Flashcards
                        </h2>
                        <p class="text-sm text-slate-400">Click a card to flip it over and learn full sentence structures!</p>
                    </div>
                    <div class="text-xs text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-700">
                        <i class="fa-solid fa-circle-info text-blue-400"></i> Click audio icon to listen
                    </div>
                </div>

                <div id="flashcardGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Populated by JS -->
                </div>
            </div>
        </section>

        <!-- TAB 4: RAPID QUIZ GAME -->
        <section id="sec-charades" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6 max-w-2xl mx-auto">
                <div class="text-center space-y-2">
                    <span class="px-3 py-1 bg-emerald-900/60 text-emerald-300 border border-emerald-500/40 text-xs font-bold rounded-full">Rapid Practice</span>
                    <h2 class="text-2xl font-extrabold text-white">Fitness & Sports Challenge</h2>
                    <p class="text-sm text-slate-400">Choose the correct verb collocation or identify the sport!</p>
                </div>

                <div class="bg-slate-900 p-6 rounded-2xl border border-slate-700 space-y-6 text-center">
                    <div class="flex justify-between items-center text-xs text-slate-400 border-b border-slate-800 pb-3">
                        <span>Question <span id="quizNum">1</span> / <span id="quizTotal">10</span></span>
                        <span id="quizTimer" class="font-bold text-amber-400"><i class="fa-solid fa-clock"></i> 15s</span>
                    </div>

                    <div class="py-4">
                        <div id="quizIcon" class="text-5xl mb-3 text-emerald-400">
                            <!-- Icon -->
                        </div>
                        <h3 id="quizQuestion" class="text-xl font-bold text-white mb-2">Which verb goes with "martial arts"?</h3>
                        <p id="quizSubtext" class="text-xs text-slate-400">_____ martial arts</p>
                    </div>

                    <div id="quizOptions" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Options populated by JS -->
                    </div>

                    <div id="quizResult" class="hidden p-3 rounded-xl font-bold text-sm"></div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Word Power Unit 4 • Sports & Fitness Studio • Beginner Level ESL
    </footer>

    <script>
        // Data derived from source material
        const sportsData = [
            { id: 'bike_riding', name: 'bike riding', verb: 'go', fullPhrase: 'go bike riding', icon: 'fa-bicycle', color: 'amber', ipa: '/bAIk ˈraIdIŋ/', example: 'I love to go bike riding on weekends.' },
            { id: 'golf', name: 'golf', verb: 'play', fullPhrase: 'play golf', icon: 'fa-golf-ball-tee', color: 'pink', ipa: '/pleI ɡɑːlf/', example: 'My uncle plays golf every Sunday morning.' },
            { id: 'jogging', name: 'jogging', verb: 'go', fullPhrase: 'go jogging', icon: 'fa-person-running', color: 'amber', ipa: '/ɡoʊ ˈdʒɑːɡIŋ/', example: 'She likes to go jogging in the park.' },
            { id: 'martial_arts', name: 'martial arts', verb: 'do', fullPhrase: 'do martial arts', icon: 'fa-hand-fist', color: 'blue', ipa: '/duː ˈmɑːrʃl ɑːrts/', example: 'Teens often do martial arts after school.' },
            { id: 'pilates', name: 'Pilates', verb: 'do', fullPhrase: 'do Pilates', icon: 'fa-spa', color: 'blue', ipa: '/duː pIˈlɑːtiːz/', example: 'Many adults do Pilates to improve flexibility.' },
            { id: 'soccer', name: 'soccer', verb: 'play', fullPhrase: 'play soccer', icon: 'fa-futbol', color: 'pink', ipa: '/pleI ˈsɑːkər/', example: 'Children play soccer in the yard.' },
            { id: 'swimming', name: 'swimming', verb: 'go', fullPhrase: 'go swimming', icon: 'fa-person-swimming', color: 'amber', ipa: '/ɡoʊ ˈswImIŋ/', example: 'We go swimming during hot summer days.' },
            { id: 'volleyball', name: 'volleyball', verb: 'play', fullPhrase: 'play volleyball', icon: 'fa-volleyball', color: 'pink', ipa: '/pleI ˈvɑːlibɔːl/', example: 'They play volleyball at the beach.' },
            { id: 'yoga', name: 'yoga', verb: 'do', fullPhrase: 'do yoga', icon: 'fa-om', color: 'blue', ipa: '/duː ˈjoʊɡə/', example: 'Older people often do yoga for good health.' }
        ];

        const ageGroups = ['Children', 'Teens', 'Young adults', 'Middle-aged people', 'Older people'];

        // App State
        let currentAssignments = {};
        let userScore = 0;
        let streak = 0;
        let activeTab = 'sorter';

        // Web Audio API Sound Effects
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'correct') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
                osc.frequency.exponentialRampToValueAtTime(659.25, audioCtx.currentTime + 0.15); // E5
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'wrong') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, audioCtx.currentTime); // A3
                osc.frequency.setValueAtTime(180, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } else if (type === 'click') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.05);
            }
        }

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            initSorter();
            initSurveyTable();
            initFlashcards();
            initQuizGame();
        });

        // Tab Switching
        function switchTab(tabId) {
            playSound('click');
            activeTab = tabId;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('bg-emerald-600', 'text-white', 'shadow');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow');
            activeBtn.classList.remove('text-slate-300');
        }

        /* --- TAB 1: SORTER FUNCTIONS --- */
        function initSorter() {
            const wordPool = document.getElementById('wordPool');
            wordPool.innerHTML = '';
            document.getElementById('bucket-do').innerHTML = '';
            document.getElementById('bucket-go').innerHTML = '';
            document.getElementById('bucket-play').innerHTML = '';
            currentAssignments = {};

            // Shuffle sports
            const shuffled = [...sportsData].sort(() => Math.random() - 0.5);

            shuffled.forEach(item => {
                const tag = document.createElement('div');
                tag.id = `draggable-${item.id}`;
                tag.draggable = true;
                tag.ondragstart = (e) => handleDragStart(e, item.id);
                tag.onclick = () => tapAssign(item.id);
                tag.className = `draggable-item bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 px-3 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm`;
                tag.innerHTML = `
                    <i class="fa-solid ${item.icon} text-emerald-400"></i>
                    <span>${item.name}</span>
                `;
                wordPool.appendChild(tag);
            });

            updateBucketCounts();
            document.getElementById('sorterFeedback').className = 'hidden';
        }

        function handleDragStart(e, itemId) {
            e.dataTransfer.setData('text/plain', itemId);
        }

        function allowDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        function dragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        function handleDrop(e, verbCategory) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            const itemId = e.dataTransfer.getData('text/plain');
            assignItemToBucket(itemId, verbCategory);
        }

        function tapAssign(itemId) {
            playSound('click');
            const item = sportsData.find(s => s.id === itemId);
            // Cycle through buckets or ask
            const verbs = ['do', 'go', 'play'];
            const current = currentAssignments[itemId];
            const nextIdx = current ? (verbs.indexOf(current) + 1) % 3 : 0;
            assignItemToBucket(itemId, verbs[nextIdx]);
        }

        function assignItemToBucket(itemId, verbCategory) {
            playSound('click');
            currentAssignments[itemId] = verbCategory;
            const itemElement = document.getElementById(`draggable-${itemId}`);
            const bucket = document.getElementById(`bucket-${verbCategory}`);
            
            if (itemElement && bucket) {
                bucket.appendChild(itemElement);
                updateBucketCounts();
            }
        }

        function updateBucketCounts() {
            ['do', 'go', 'play'].forEach(verb => {
                const count = Object.values(currentAssignments).filter(v => v === verb).length;
                document.getElementById(`${verb}Count`).innerText = `${count} items`;
            });
        }

        function checkSorterAnswers() {
            let correctCount = 0;
            let total = sportsData.length;

            sportsData.forEach(item => {
                const assigned = currentAssignments[item.id];
                const element = document.getElementById(`draggable-${item.id}`);
                
                if (element) {
                    if (assigned === item.verb) {
                        correctCount++;
                        element.classList.remove('border-slate-600', 'border-red-500');
                        element.classList.add('border-emerald-500', 'bg-emerald-950/40');
                    } else if (assigned) {
                        element.classList.remove('border-slate-600', 'border-emerald-500');
                        element.classList.add('border-red-500', 'bg-red-950/40');
                    }
                }
            });

            const feedback = document.getElementById('sorterFeedback');
            feedback.classList.remove('hidden');

            if (correctCount === total) {
                playSound('correct');
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
                userScore += 50;
                streak++;
                updateStats();
                feedback.className = 'p-4 rounded-xl text-center font-bold text-sm bg-emerald-950 text-emerald-300 border border-emerald-600';
                feedback.innerHTML = `<i class="fa-solid fa-trophy mr-2 text-amber-400"></i> Excellent! All ${total} sports correctly sorted! (+50 pts)`;
            } else {
                playSound('wrong');
                feedback.className = 'p-4 rounded-xl text-center font-bold text-sm bg-amber-950 text-amber-300 border border-amber-600';
                feedback.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-2"></i> You got ${correctCount} out of ${total} correct. Red items are in the wrong verb bucket!`;
            }
        }

        function resetSorter() {
            playSound('click');
            initSorter();
        }

        /* --- TAB 2: SURVEY FUNCTIONS --- */
        function initSurveyTable() {
            const tbody = document.getElementById('surveyTableBody');
            tbody.innerHTML = '';

            sportsData.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/50 transition';

                let checkboxesHtml = ageGroups.map((group, idx) => `
                    <td class="p-4 text-center">
                        <input type="checkbox" data-sport="${item.name}" data-verb="${item.verb}" data-age="${group}" class="survey-chk w-4 h-4 text-emerald-600 rounded bg-slate-800 border-slate-600 focus:ring-emerald-500 focus:ring-offset-slate-900 cursor-pointer">
                    </td>
                `).join('');

                tr.innerHTML = `
                    <td class="p-4 font-medium text-white flex items-center gap-3">
                        <i class="fa-solid ${item.icon} text-emerald-400 w-5"></i>
                        <span>${item.name}</span>
                        <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-mono">${item.verb}</span>
                    </td>
                    ${checkboxesHtml}
                `;
                tbody.appendChild(tr);
            });
        }

        function generateSurveySentence() {
            playSound('click');
            const checked = document.querySelectorAll('.survey-chk:checked');
            if (checked.length === 0) {
                document.getElementById('surveyGeneratedText').innerText = "Please check a few boxes in the table first!";
                return;
            }

            // Pick a random checked entry
            const randomPick = checked[Math.floor(Math.random() * checked.length)];
            const sport = randomPick.dataset.sport;
            const verb = randomPick.dataset.verb;
            const age = randomPick.dataset.age;

            const sentence = `In my country, ${age.toLowerCase()} usually ${verb} ${sport}.`;
            document.getElementById('surveyGeneratedText').innerText = `"${sentence}"`;
            speakText(sentence);
        }

        /* --- TAB 3: FLASHCARDS FUNCTIONS --- */
        function initFlashcards() {
            const grid = document.getElementById('flashcardGrid');
            grid.innerHTML = '';

            sportsData.forEach(item => {
                const card = document.createElement('div');
                card.className = 'card-flip h-64 w-full cursor-pointer';
                card.onclick = (e) => {
                    if (!e.target.closest('.no-flip')) {
                        playSound('click');
                        card.classList.toggle('flipped');
                    }
                };

                card.innerHTML = `
                    <div class="card-inner relative w-full h-full shadow-lg rounded-2xl">
                        <!-- FRONT -->
                        <div class="card-front absolute inset-0 bg-slate-800 border border-slate-700 rounded-2xl p-6 flex flex-col justify-between items-center text-center">
                            <div class="w-full flex justify-between text-xs text-slate-400">
                                <span>Card #${item.id}</span>
                                <span class="uppercase font-bold text-emerald-400">${item.verb.toUpperCase()}</span>
                            </div>
                            <div class="space-y-2">
                                <div class="w-16 h-16 rounded-full bg-slate-900 border border-slate-700 mx-auto flex items-center justify-center text-emerald-400 text-2xl shadow-inner">
                                    <i class="fa-solid ${item.icon}"></i>
                                </div>
                                <h3 class="text-xl font-bold text-white capitalize">${item.name}</h3>
                                <p class="text-xs font-mono text-slate-400">${item.ipa}</p>
                            </div>
                            <button onclick="speakText('${item.fullPhrase}')" class="no-flip text-xs text-emerald-400 hover:text-emerald-300 flex items-center gap-1 font-semibold">
                                <i class="fa-solid fa-volume-high"></i> Listen Phrase
                            </button>
                        </div>

                        <!-- BACK -->
                        <div class="card-back absolute inset-0 bg-slate-800 border-2 border-emerald-500/60 rounded-2xl p-6 flex flex-col justify-between text-center">
                            <div class="w-full flex justify-between text-xs text-emerald-400 font-bold">
                                <span>COLLOCATION</span>
                                <i class="fa-solid fa-rotate-left"></i>
                            </div>
                            <div class="space-y-3">
                                <span class="inline-block px-3 py-1 bg-emerald-900/80 text-emerald-200 font-bold text-lg rounded-xl border border-emerald-600">
                                    ${item.fullPhrase}
                                </span>
                                <p class="text-xs text-slate-300 italic px-2 bg-slate-900/60 py-2 rounded-lg border border-slate-800">
                                    "${item.example}"
                                </p>
                            </div>
                            <button onclick="speakText('${item.example.replace(/'/g, "\\'")}')" class="no-flip bg-emerald-600 hover:bg-emerald-500 text-white py-1.5 px-3 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 transition shadow">
                                <i class="fa-solid fa-volume-high"></i> Read Example
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        /* --- TAB 4: RAPID QUIZ GAME --- */
        let currentQuizIndex = 0;
        let quizQuestions = [];

        function initQuizGame() {
            quizQuestions = sportsData.map(item => {
                const wrongVerbs = ['do', 'go', 'play'].filter(v => v !== item.verb);
                const options = [item.verb, wrongVerbs[0], wrongVerbs[1]].sort(() => Math.random() - 0.5);
                return {
                    sport: item.name,
                    icon: item.icon,
                    correctVerb: item.verb,
                    options: options
                };
            }).sort(() => Math.random() - 0.5);

            currentQuizIndex = 0;
            loadQuizQuestion();
        }

        function loadQuizQuestion() {
            if (currentQuizIndex >= quizQuestions.length) {
                // Game Finished
                document.getElementById('quizQuestion').innerText = "Quiz Completed!";
                document.getElementById('quizSubtext').innerText = "Great job practicing verb collocations!";
                document.getElementById('quizOptions').innerHTML = `
                    <button onclick="initQuizGame()" class="col-span-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl shadow-lg transition">
                        Play Again
                    </button>
                `;
                confetti({ particleCount: 100, spread: 70 });
                return;
            }

            const q = quizQuestions[currentQuizIndex];
            document.getElementById('quizNum').innerText = currentQuizIndex + 1;
            document.getElementById('quizTotal').innerText = quizQuestions.length;
            document.getElementById('quizIcon').innerHTML = `<i class="fa-solid ${q.icon}"></i>`;
            document.getElementById('quizQuestion').innerText = `Which verb goes with "${q.sport}"?`;
            document.getElementById('quizSubtext').innerText = `_____ ${q.sport}`;
            document.getElementById('quizResult').className = 'hidden';

            const optsDiv = document.getElementById('quizOptions');
            optsDiv.innerHTML = '';

            q.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'p-3 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-xl font-bold text-white uppercase text-sm transition';
                btn.innerText = opt;
                btn.onclick = () => answerQuiz(opt, q.correctVerb);
                optsDiv.appendChild(btn);
            });
        }

        function answerQuiz(selected, correct) {
            const res = document.getElementById('quizResult');
            res.classList.remove('hidden');

            if (selected === correct) {
                playSound('correct');
                userScore += 10;
                streak++;
                updateStats();
                res.className = 'p-3 rounded-xl font-bold text-sm bg-emerald-950 text-emerald-300 border border-emerald-600';
                res.innerHTML = `<i class="fa-solid fa-circle-check"></i> Correct! You <strong>${correct} ${quizQuestions[currentQuizIndex].sport}</strong>.`;
            } else {
                playSound('wrong');
                streak = 0;
                updateStats();
                res.className = 'p-3 rounded-xl font-bold text-sm bg-red-950 text-red-300 border border-red-600';
                res.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Oops! The correct collocation is <strong>${correct} ${quizQuestions[currentQuizIndex].sport}</strong>.`;
            }

            setTimeout(() => {
                currentQuizIndex++;
                loadQuizQuestion();
            }, 1200);
        }

        function updateStats() {
            document.getElementById('scoreDisplay').innerText = userScore;
            document.getElementById('streakDisplay').innerText = streak;
        }
    </script>
</body>
</html>
