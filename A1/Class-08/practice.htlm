<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questions with DO & Present Tense Verbs</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .tab-active {
            background-color: #0d9488;
            color: #ffffff;
            box-shadow: 0 4px 14px 0 rgba(13, 148, 136, 0.38);
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 pb-12">

    <!-- Header Navigation -->
    <header class="bg-teal-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="bg-white/10 p-2.5 rounded-xl border border-white/20">
                    <i class="fa-solid fa-briefcase text-2xl text-teal-200"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">Job & Verb Master</h1>
                    <p class="text-xs text-teal-100">Questions with DO & Present Tense Action Verbs</p>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <nav class="flex flex-wrap gap-2 bg-teal-800/60 p-1.5 rounded-xl border border-white/10">
                <button onclick="switchTab('exercise')" id="tab-exercise" class="tab-btn tab-active px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all">
                    <i class="fa-solid fa-pen-to-square mr-1.5"></i>Exercise 9 (Mover)
                </button>
                <button onclick="switchTab('speed-dating')" id="tab-speed-dating" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-teal-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-comments mr-1.5"></i>Speed Dating
                </button>
                <button onclick="switchTab('chef-builder')" id="tab-chef-builder" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-teal-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-utensils mr-1.5"></i>Ask the Chef
                </button>
                <button onclick="switchTab('reference')" id="tab-reference" class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-teal-100 hover:bg-white/10 transition-all">
                    <i class="fa-solid fa-book-open mr-1.5"></i>Grammar Focus
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-6xl mx-auto px-4 mt-6">

        <!-- ================= MODE 1: EXERCISE 9 (MOVER DIALOGUE) ================= -->
        <section id="sec-exercise" class="space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-truck-ramp-box text-teal-600"></i> Exercise 9: Questions with DO & Present Tense Verbs
                    </h2>
                    <p class="text-sm text-slate-500 mt-1">Complete the dialogue about Tim the Mover with the correct verbs and auxiliary words.</p>
                </div>
                <div class="bg-teal-50 border border-teal-200 text-teal-900 px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-teal-500"></i> Score: <span id="ex-score" class="text-lg font-bold">0</span> / 10
                </div>
            </div>

            <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="font-bold text-teal-800 text-base flex items-center gap-2">
                        <span class="bg-teal-100 text-teal-800 text-xs px-2.5 py-1 rounded-lg">Part A</span>
                        Tim's Mover Interview
                    </h3>
                    <button onclick="speakText('I am a mover. I help people move their entire lives from their old home to their new home. How do you feel about your job? I really like my job. How do you spend your day? I pack boxes, load items, and unload the truck. Sometimes I drive the truck. That is the easy part.')" class="text-xs text-teal-600 hover:text-teal-800 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-volume-high"></i> Listen to Dialogue
                    </button>
                </div>

                <div class="space-y-4 text-sm bg-slate-50 p-5 rounded-2xl border border-slate-200 leading-relaxed">
                    <div class="flex flex-wrap items-center gap-2">
                        <strong class="text-slate-800 font-bold min-w-[50px]">Tim:</strong>
                        <span>I'm a mover. I</span>
                        <input type="text" id="v_1" onkeyup="checkInput('v_1', 'help')" placeholder="(help)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>people</span>
                        <input type="text" id="v_2" onkeyup="checkInput('v_2', 'move')" placeholder="(move)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>their entire lives from their old home to their new home.</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <strong class="text-teal-700 font-bold min-w-[50px]">Lisa:</strong>
                        <span>How</span>
                        <input type="text" id="v_3" onkeyup="checkInput('v_3', 'do')" placeholder="(do)" class="border rounded px-2.5 py-1 w-20 bg-white text-xs font-semibold border-slate-300">
                        <span>you</span>
                        <input type="text" id="v_4" onkeyup="checkInput('v_4', 'feel')" placeholder="(feel)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>about your job?</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <strong class="text-slate-800 font-bold min-w-[50px]">Tim:</strong>
                        <span>I really</span>
                        <input type="text" id="v_5" onkeyup="checkInput('v_5', 'like')" placeholder="(like)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>my job.</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <strong class="text-teal-700 font-bold min-w-[50px]">Lisa:</strong>
                        <span>How</span>
                        <input type="text" id="v_6" onkeyup="checkInput('v_6', 'do')" placeholder="(do)" class="border rounded px-2.5 py-1 w-20 bg-white text-xs font-semibold border-slate-300">
                        <span>you</span>
                        <input type="text" id="v_7" onkeyup="checkInput('v_7', 'spend')" placeholder="(spend)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>your day?</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <strong class="text-slate-800 font-bold min-w-[50px]">Tim:</strong>
                        <span>I</span>
                        <input type="text" id="v_8" onkeyup="checkInput('v_8', 'pack')" placeholder="(pack)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>boxes,</span>
                        <input type="text" id="v_9" onkeyup="checkInput('v_9', 'load')" placeholder="(load)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>items, and unload the truck. Sometimes I</span>
                        <input type="text" id="v_10" onkeyup="checkInput('v_10', 'drive')" placeholder="(drive)" class="border rounded px-2.5 py-1 w-24 bg-white text-xs font-semibold border-slate-300">
                        <span>the truck. That's the easy part.</span>
                    </div>
                </div>
            </div>
        </section>


        <!-- ================= MODE 2: JOB SPEED DATING SIMULATOR ================= -->
        <section id="sec-speed-dating" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-comments text-teal-600"></i> Job Speed Dating Simulator
                </h2>
                <p class="text-sm text-slate-500 mt-1">Select a job card to practice partner interviews using <strong>Do</strong> questions and action verbs!</p>
            </div>

            <!-- Job Selectors -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <button onclick="selectJob('mover')" id="btn-job-mover" class="job-card-btn p-4 rounded-2xl border-2 border-teal-500 bg-teal-50 text-teal-900 font-bold text-center space-y-2 transition-all">
                    <i class="fa-solid fa-truck-moving text-2xl"></i>
                    <div class="text-xs">Mover</div>
                </button>
                <button onclick="selectJob('chef')" id="btn-job-chef" class="job-card-btn p-4 rounded-2xl border border-slate-200 bg-white text-slate-700 font-bold text-center space-y-2 hover:bg-teal-50/50 transition-all">
                    <i class="fa-solid fa-utensils text-2xl text-amber-600"></i>
                    <div class="text-xs">Chef</div>
                </button>
                <button onclick="selectJob('teacher')" id="btn-job-teacher" class="job-card-btn p-4 rounded-2xl border border-slate-200 bg-white text-slate-700 font-bold text-center space-y-2 hover:bg-teal-50/50 transition-all">
                    <i class="fa-solid fa-chalkboard-user text-2xl text-blue-600"></i>
                    <div class="text-xs">Teacher</div>
                </button>
                <button onclick="selectJob('doctor')" id="btn-job-doctor" class="job-card-btn p-4 rounded-2xl border border-slate-200 bg-white text-slate-700 font-bold text-center space-y-2 hover:bg-teal-50/50 transition-all">
                    <i class="fa-solid fa-user-doctor text-2xl text-emerald-600"></i>
                    <div class="text-xs">Doctor</div>
                </button>
            </div>

            <!-- Roleplay Output -->
            <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 id="role-title" class="font-bold text-teal-800 text-base">Practice Roleplay: Mover</h3>
                    <button id="role-listen-btn" onclick="speakText(document.getElementById('role-script').innerText)" class="text-xs text-teal-600 hover:text-teal-800 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-volume-high"></i> Listen to Roleplay
                    </button>
                </div>

                <div id="role-script" class="space-y-3 text-sm bg-slate-50 p-5 rounded-2xl border border-slate-200 leading-relaxed">
                    <!-- Dynamic script generated by JS -->
                </div>
            </div>
        </section>


        <!-- ================= MODE 3: ASK THE CHEF QUESTION BUILDER ================= -->
        <section id="sec-chef-builder" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-utensils text-teal-600"></i> Exercise 10: "Ask the Chef" Question Creator
                </h2>
                <p class="text-sm text-slate-500 mt-1">Brian's friend is a chef in his restaurant. Build 4 questions Lisa could ask him about his job!</p>
            </div>

            <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm space-y-6">
                <!-- Formula Builder -->
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-teal-50/60 p-4 rounded-2xl border border-teal-100">
                    <div>
                        <label class="block text-xs font-bold text-teal-800 uppercase mb-1">Wh- Word</label>
                        <select id="qb-wh" class="w-full p-2 bg-white border border-teal-200 rounded-xl text-xs font-semibold text-slate-700">
                            <option value="How">How</option>
                            <option value="What">What</option>
                            <option value="What time">What time</option>
                            <option value="Where">Where</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-teal-800 uppercase mb-1">Auxiliary Verb</label>
                        <select id="qb-aux" class="w-full p-2 bg-white border border-teal-200 rounded-xl text-xs font-semibold text-slate-700">
                            <option value="do">do</option>
                            <option value="does">does</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-teal-800 uppercase mb-1">Subject</label>
                        <select id="qb-subj" class="w-full p-2 bg-white border border-teal-200 rounded-xl text-xs font-semibold text-slate-700">
                            <option value="you">you</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-teal-800 uppercase mb-1">Verb / Expression</label>
                        <select id="qb-verb" class="w-full p-2 bg-white border border-teal-200 rounded-xl text-xs font-semibold text-slate-700">
                            <option value="like your job">like your job?</option>
                            <option value="spend your day">spend your day?</option>
                            <option value="start work">start work?</option>
                            <option value="cook in the restaurant">cook in the restaurant?</option>
                        </select>
                    </div>
                </div>

                <div class="text-center">
                    <button onclick="addChefQuestion()" class="bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition-all shadow-md">
                        <i class="fa-solid fa-plus mr-1"></i> Add Question to Exercise List
                    </button>
                </div>

                <!-- Generated Question List -->
                <div class="space-y-3">
                    <h4 class="font-bold text-xs uppercase text-slate-500 tracking-wider">Lisa's Questions for the Chef:</h4>
                    <ol id="chef-q-list" class="space-y-2 text-sm font-semibold text-slate-700">
                        <li class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex justify-between items-center">
                            <span>1. How do you like your job?</span>
                            <button onclick="speakText('How do you like your job?')" class="text-xs text-teal-600"><i class="fa-solid fa-volume-high"></i></button>
                        </li>
                    </ol>
                </div>
            </div>
        </section>


        <!-- ================= MODE 4: GRAMMAR FOCUS REFERENCE ================= -->
        <section id="sec-reference" class="hidden space-y-6">
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-book-open text-teal-600"></i> Grammar Focus Reference
                </h2>
                <p class="text-sm text-slate-500 mt-1">Essential rules for asking about jobs and forming present tense action verb sentences.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Questions with DO Formula -->
                <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold text-teal-800 border-b border-slate-100 pb-2 flex items-center justify-between text-base">
                        <span>1. Questions with DO Formula</span>
                        <i class="fa-solid fa-circle-question"></i>
                    </h3>

                    <div class="p-4 bg-teal-50/60 rounded-xl border border-teal-100 space-y-2 text-xs leading-relaxed">
                        <div class="font-mono bg-white p-2.5 rounded-lg border border-teal-200 text-center font-bold text-teal-900">
                            Question Word + DO + YOU + Base Verb?
                        </div>
                        <p class="mt-2">• <em>How <strong>do</strong> you <strong>feel</strong> about your job?</em></p>
                        <p>• <em>How <strong>do</strong> you <strong>spend</strong> your day?</em></p>
                        <p>• <em>What <strong>do</strong> you <strong>do</strong>?</em></p>
                    </div>
                </div>

                <!-- Present Tense Action Verbs -->
                <div class="glass-card rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold text-teal-800 border-b border-slate-100 pb-2 flex items-center justify-between text-base">
                        <span>2. Action Verb Series</span>
                        <i class="fa-solid fa-list-check"></i>
                    </h3>

                    <div class="p-4 bg-amber-50/60 rounded-xl border border-amber-100 space-y-2 text-xs leading-relaxed">
                        <span class="font-bold text-amber-900 block">Connecting Multiple Actions:</span>
                        <p>When describing a daily routine with multiple verbs, use commas and place <strong>and</strong> before the final verb:</p>
                        <p class="font-semibold text-slate-800 mt-1">"I <strong>pack</strong> boxes, <strong>load</strong> items, and <strong>unload</strong> the truck."</p>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- JavaScript Engine -->
    <script>
        // Tab Navigation
        function switchTab(tabId) {
            ['exercise', 'speed-dating', 'chef-builder', 'reference'].forEach(id => {
                document.getElementById(`sec-${id}`).classList.add('hidden');
                document.getElementById(`tab-${id}`).classList.remove('tab-active');
                document.getElementById(`tab-${id}`).classList.add('text-teal-100');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeTabBtn = document.getElementById(`tab-${tabId}`);
            activeTabBtn.classList.add('tab-active');
            activeTabBtn.classList.remove('text-teal-100');
        }

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-US';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Exercise 9 Scoring Tracker
        let score = 0;
        const checked = new Set();

        function checkInput(id, expected) {
            const el = document.getElementById(id);
            const val = el.value.trim().toLowerCase();
            if (val === expected.toLowerCase()) {
                el.className = "border rounded px-2.5 py-1 w-24 font-semibold text-xs bg-emerald-100 text-emerald-900 border-emerald-500";
                if (!checked.has(id)) {
                    checked.add(id);
                    score++;
                    document.getElementById('ex-score').textContent = score;
                }
            } else if (val !== "") {
                el.className = "border rounded px-2.5 py-1 w-24 font-semibold text-xs bg-rose-100 text-rose-900 border-rose-400";
            }
        }

        // Job Speed Dating Data
        const jobData = {
            mover: {
                title: "Practice Roleplay: Mover",
                script: `
                    <p><strong>Lisa:</strong> What do you do?</p>
                    <p><strong>Tim:</strong> I'm a mover. I help people move their lives to a new home.</p>
                    <p><strong>Lisa:</strong> How do you feel about your job?</p>
                    <p><strong>Tim:</strong> I really like my job!</p>
                    <p><strong>Lisa:</strong> How do you spend your day?</p>
                    <p><strong>Tim:</strong> I pack boxes, load items, and drive the truck.</p>
                `
            },
            chef: {
                title: "Practice Roleplay: Chef",
                script: `
                    <p><strong>Lisa:</strong> What do you do?</p>
                    <p><strong>Chef:</strong> I'm a chef in a restaurant.</p>
                    <p><strong>Lisa:</strong> How do you like your job?</p>
                    <p><strong>Chef:</strong> I love it! It's very exciting.</p>
                    <p><strong>Lisa:</strong> How do you spend your day?</p>
                    <p><strong>Chef:</strong> I order ingredients, prepare dishes, and cook food for people.</p>
                `
            },
            teacher: {
                title: "Practice Roleplay: Teacher",
                script: `
                    <p><strong>Lisa:</strong> What do you do?</p>
                    <p><strong>Teacher:</strong> I'm an English teacher.</p>
                    <p><strong>Lisa:</strong> How do you feel about your job?</p>
                    <p><strong>Teacher:</strong> I really enjoy helping students learn.</p>
                    <p><strong>Lisa:</strong> How do you spend your day?</p>
                    <p><strong>Teacher:</strong> I plan lessons, teach classes, and grade assignments.</p>
                `
            },
            doctor: {
                title: "Practice Roleplay: Doctor",
                script: `
                    <p><strong>Lisa:</strong> What do you do?</p>
                    <p><strong>Doctor:</strong> I'm a doctor at a clinic.</p>
                    <p><strong>Lisa:</strong> How do you like your job?</p>
                    <p><strong>Doctor:</strong> It is hard work, but I love helping sick people.</p>
                    <p><strong>Lisa:</strong> How do you spend your day?</p>
                    <p><strong>Doctor:</strong> I examine patients, write prescriptions, and talk to families.</p>
                `
            }
        };

        function selectJob(jobKey) {
            ['mover', 'chef', 'teacher', 'doctor'].forEach(k => {
                const btn = document.getElementById(`btn-job-${k}`);
                btn.className = "job-card-btn p-4 rounded-2xl border border-slate-200 bg-white text-slate-700 font-bold text-center space-y-2 hover:bg-teal-50/50 transition-all";
            });

            const activeBtn = document.getElementById(`btn-job-${jobKey}`);
            activeBtn.className = "job-card-btn p-4 rounded-2xl border-2 border-teal-500 bg-teal-50 text-teal-900 font-bold text-center space-y-2 transition-all";

            document.getElementById('role-title').textContent = jobData[jobKey].title;
            document.getElementById('role-script').innerHTML = jobData[jobKey].script;
        }

        // Ask the Chef Question Builder
        let questionCount = 1;

        function addChefQuestion() {
            if (questionCount >= 4) {
                alert("You have already added 4 questions!");
                return;
            }

            const wh = document.getElementById('qb-wh').value;
            const aux = document.getElementById('qb-aux').value;
            const subj = document.getElementById('qb-subj').value;
            const verb = document.getElementById('qb-verb').value;

            if (aux === 'does' && subj === 'you') {
                alert("Incorrect grammar: Use 'do' with 'you'!");
                return;
            }

            questionCount++;
            const fullQ = `${wh} ${aux} ${subj} ${verb}`;
            const list = document.getElementById('chef-q-list');

            const li = document.createElement('li');
            li.className = "bg-slate-50 p-3 rounded-xl border border-slate-200 flex justify-between items-center";
            li.innerHTML = `
                <span>${questionCount}. ${fullQ}</span>
                <button onclick="speakText('${fullQ}')" class="text-xs text-teal-600"><i class="fa-solid fa-volume-high"></i></button>
            `;
            list.appendChild(li);
        }

        window.onload = function() {
            selectJob('mover');
        };
    </script>
</body>
</html>
