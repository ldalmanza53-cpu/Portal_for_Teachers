<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yard Sale Bargain Studio & Role-Play Challenge</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        amber: { 450: '#f79e1b' },
                        emerald: { 450: '#10b981' }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Outfit', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card {
            background: rgba(51, 65, 85, 0.4);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
        @keyframes bounce-subtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-4px); }
        }
        .animate-bounce-subtle {
            animation: bounce-subtle 2s infinite ease-in-out;
        }
        .drag-item {
            touch-action: none;
            user-select: none;
        }
    </style>
</head>
<body class="min-h-full flex flex-col bg-slate-950 text-slate-100 antialiased selection:bg-amber-500 selection:text-slate-950">

    <!-- Header -->
    <header class="bg-slate-900/90 border-b border-slate-800 sticky top-0 z-40 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 via-orange-500 to-rose-500 flex items-center justify-center text-slate-950 shadow-lg shadow-amber-500/20 font-black text-xl">
                    <i class="fa-solid fa-store"></i>
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-white leading-none flex items-center gap-2">
                        Yard Sale Studio <span class="text-xs px-2 py-0.5 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-400 font-semibold">ESL Beginner (A1-A2)</span>
                    </h1>
                    <p class="text-xs text-slate-400 font-medium">Interactive Shopping, Prices & Bargaining Practice</p>
                </div>
            </div>

            <!-- Top Actions -->
            <div class="flex items-center space-x-3">
                <button id="audioToggleBtn" onclick="toggleAudio()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold flex items-center transition border border-slate-700">
                    <i id="audioIcon" class="fa-solid fa-volume-high text-amber-400 mr-2"></i>
                    <span id="audioStatusText" class="hidden sm:inline">Audio: ON</span>
                </button>
                <button onclick="openModal('guideModal')" class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold transition flex items-center">
                    <i class="fa-solid fa-circle-info mr-1.5"></i>
                    <span>How to Play</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="bg-slate-900/60 border-b border-slate-800/80 sticky top-16 z-30 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex space-x-2 sm:space-x-4 overflow-x-auto py-2.5 scrollbar-none">
                <button onclick="switchTab('unscramble')" id="nav-unscramble" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-amber-500 text-slate-950 shadow-md">
                    <i class="fa-solid fa-list-ol"></i>
                    <span>1. Dialogue Unscramble</span>
                </button>
                <button onclick="switchTab('grammar')" id="nav-grammar" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-slate-200">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>2. Grammar & Items</span>
                </button>
                <button onclick="switchTab('simulator')" id="nav-simulator" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-slate-200">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>3. Interactive Yard Sale Game</span>
                </button>
                <button onclick="switchTab('roleplay')" id="nav-roleplay" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-slate-200">
                    <i class="fa-solid fa-people-arrows"></i>
                    <span>4. Partner Role-Play Studio</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ==========================================
             TAB 1: DIALOGUE UNSCRAMBLE
             ========================================== -->
        <section id="tab-1-unscramble" class="tab-content space-y-6">
            
            <div class="glass-panel rounded-3xl p-6 border border-slate-800 space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
                            <i class="fa-solid fa-list-ol text-amber-400"></i> Section 1: Yard Sale Dialogue Unscramble
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-400 mt-1">
                            Number the sentences in order (1 to 6) to make two logical shopping conversations from your textbook.
                        </p>
                    </div>

                    <!-- Conversation Toggle Switch -->
                    <div class="flex bg-slate-900 p-1 rounded-2xl border border-slate-800 self-start md:self-auto">
                        <button onclick="switchUnscrambleConv(1)" id="conv-btn-1" class="px-4 py-2 rounded-xl text-xs font-bold transition bg-amber-500 text-slate-950">
                            Conversation 1 (Ring & Earrings)
                        </button>
                        <button onclick="switchUnscrambleConv(2)" id="conv-btn-2" class="px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white">
                            Conversation 2 (MP3 Bargaining)
                        </button>
                    </div>
                </div>

                <!-- Unscramble Task Container -->
                <div id="unscrambleContainer" class="space-y-3">
                    <!-- Sentences injected dynamically by JS -->
                </div>

                <!-- Control Buttons Bar -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-800">
                    <div class="flex items-center space-x-2">
                        <button onclick="checkUnscrambleAnswers()" class="px-5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm transition shadow-lg shadow-amber-500/20 flex items-center gap-2">
                            <i class="fa-solid fa-check-circle"></i> Check Answers
                        </button>
                        <button onclick="resetUnscramble()" class="px-4 py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs sm:text-sm transition border border-slate-700 flex items-center gap-2">
                            <i class="fa-solid fa-rotate-left"></i> Reset Order
                        </button>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button onclick="playFullConversation()" class="px-4 py-2.5 rounded-2xl bg-teal-500/20 hover:bg-teal-500/30 text-teal-300 font-bold text-xs sm:text-sm transition border border-teal-500/30 flex items-center gap-2">
                            <i class="fa-solid fa-circle-play text-teal-400"></i> Listen to Full Conversation
                        </button>
                        <span id="unscrambleScoreBadge" class="hidden px-3.5 py-1.5 rounded-xl font-black text-xs sm:text-sm"></span>
                    </div>
                </div>
            </div>

        </section>

        <!-- ==========================================
             TAB 2: GRAMMAR & ITEM SORTING
             ========================================== -->
        <section id="tab-2-grammar" class="tab-content hidden space-y-6">
            
            <!-- Grammar Cheat Sheet Header -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Singular Rule Card -->
                <div class="glass-panel p-5 rounded-3xl border border-slate-800 space-y-3">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-2xl bg-amber-500/20 text-amber-400 font-black text-lg flex items-center justify-center">1</div>
                        <div>
                            <h3 class="font-extrabold text-base text-white">Singular Items (1 Object)</h3>
                            <p class="text-xs text-slate-400">Use <strong>"is this"</strong> &amp; <strong>"It's"</strong></p>
                        </div>
                    </div>
                    <div class="bg-slate-900/90 p-3.5 rounded-2xl border border-slate-800 text-xs sm:text-sm space-y-2">
                        <p class="text-slate-300"><strong class="text-amber-400">Question:</strong> "How much <strong>is this</strong> ring?"</p>
                        <p class="text-slate-300"><strong class="text-emerald-400">Answer:</strong> "<strong>It's</strong> twelve dollars."</p>
                        <div class="flex gap-2 pt-1 text-[11px] text-slate-400">
                            <span class="px-2 py-0.5 rounded bg-slate-800">ring</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">MP3 player</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">lamp</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">clock</span>
                        </div>
                    </div>
                </div>

                <!-- Plural Rule Card -->
                <div class="glass-panel p-5 rounded-3xl border border-slate-800 space-y-3">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-2xl bg-teal-500/20 text-teal-400 font-black text-lg flex items-center justify-center">2+</div>
                        <div>
                            <h3 class="font-extrabold text-base text-white">Plural Items (Pairs / 2+ Objects)</h3>
                            <p class="text-xs text-slate-400">Use <strong>"are these"</strong> &amp; <strong>"They're"</strong></p>
                        </div>
                    </div>
                    <div class="bg-slate-900/90 p-3.5 rounded-2xl border border-slate-800 text-xs sm:text-sm space-y-2">
                        <p class="text-slate-300"><strong class="text-teal-400">Question:</strong> "How much <strong>are these</strong> earrings?"</p>
                        <p class="text-slate-300"><strong class="text-emerald-400">Answer:</strong> "<strong>They're</strong> twenty dollars."</p>
                        <div class="flex gap-2 pt-1 text-[11px] text-slate-400">
                            <span class="px-2 py-0.5 rounded bg-slate-800">earrings</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">sunglasses</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">flip-flops</span>
                            <span class="px-2 py-0.5 rounded bg-slate-800">shoes</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bargaining & Expressions Helper -->
            <div class="glass-panel p-5 rounded-3xl border border-slate-800 space-y-3">
                <h3 class="font-extrabold text-white text-base flex items-center gap-2">
                    <i class="fa-solid fa-comments text-amber-400"></i> Useful Shopping & Bargaining Expressions
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800">
                        <strong class="text-amber-400 block mb-1">Asking Help / Greeting</strong>
                        <p class="text-slate-300">"Hello. Can I help you?"</p>
                        <p class="text-slate-300">"Yes, how much is this...?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800">
                        <strong class="text-rose-400 block mb-1">Stating it's High</strong>
                        <p class="text-slate-300">"Oh, that's pretty expensive!"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800">
                        <strong class="text-teal-400 block mb-1">Bargaining Offer</strong>
                        <p class="text-slate-300">"Well, how about thirty dollars?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800">
                        <strong class="text-emerald-400 block mb-1">Deciding to Buy / Leave</strong>
                        <p class="text-slate-300">"OK. I'll take it."</p>
                        <p class="text-slate-300">"Thanks. I'll think about it."</p>
                    </div>
                </div>
            </div>

            <!-- Interactive Item Classification Mini-Game -->
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-5">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-800 pb-4">
                    <div>
                        <h3 class="text-lg font-extrabold text-white flex items-center gap-2">
                            <i class="fa-solid fa-cubes-stacked text-teal-400"></i> Item Sorting Challenge
                        </h3>
                        <p class="text-xs text-slate-400">Classify each item into Singular (Is this...?) or Plural (Are these...?). Click an item then click its category bin.</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span id="sortingScore" class="px-3 py-1 rounded-xl bg-slate-800 text-xs font-bold text-amber-400 border border-slate-700">Score: 0 / 10</span>
                        <button onclick="resetSortingGame()" class="px-3 py-1 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-300 transition border border-slate-700">Reset</button>
                    </div>
                </div>

                <!-- Unsorted Items Bank -->
                <div>
                    <span class="text-xs font-extrabold uppercase text-slate-400 tracking-wider mb-2 block">Unsorted Items (Tap an item to select):</span>
                    <div id="unsortedItemsBank" class="flex flex-wrap gap-2 min-h-[56px] p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
                        <!-- Dynamic items -->
                    </div>
                </div>

                <!-- Category Target Drop Boxes -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Singular Box -->
                    <div onclick="classifySelectedItem('singular')" class="glass-card p-5 rounded-2xl border-2 border-dashed border-amber-500/40 hover:border-amber-400 transition cursor-pointer min-h-[160px] flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="font-extrabold text-amber-400 text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-cube"></i> Singular Bucket (How much IS THIS...?)
                                </span>
                                <span class="text-[10px] bg-amber-400/10 text-amber-300 px-2 py-0.5 rounded border border-amber-400/20">It's...</span>
                            </div>
                            <div id="singularBucket" class="flex flex-wrap gap-2"></div>
                        </div>
                        <p class="text-[11px] text-slate-500 text-center mt-4">Click here to place selected item into Singular</p>
                    </div>

                    <!-- Plural Box -->
                    <div onclick="classifySelectedItem('plural')" class="glass-card p-5 rounded-2xl border-2 border-dashed border-teal-500/40 hover:border-teal-400 transition cursor-pointer min-h-[160px] flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="font-extrabold text-teal-400 text-sm flex items-center gap-2">
                                    <i class="fa-solid fa-cubes"></i> Plural Bucket (How much ARE THESE...?)
                                </span>
                                <span class="text-[10px] bg-teal-400/10 text-teal-300 px-2 py-0.5 rounded border border-teal-400/20">They're...</span>
                            </div>
                            <div id="pluralBucket" class="flex flex-wrap gap-2"></div>
                        </div>
                        <p class="text-[11px] text-slate-500 text-center mt-4">Click here to place selected item into Plural</p>
                    </div>
                </div>
            </div>

        </section>

        <!-- ==========================================
             TAB 3: INTERACTIVE YARD SALE GAME
             ========================================== -->
        <section id="tab-3-simulator" class="tab-content hidden space-y-6">
            
            <!-- Game HUD / Wallet Bar -->
            <div class="glass-panel p-4 sm:p-5 rounded-3xl border border-slate-800 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center font-black text-xl">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <span class="text-xs uppercase font-extrabold tracking-wider text-slate-400 block">Buyer's Wallet Cash</span>
                        <div class="flex items-baseline space-x-2">
                            <span id="playerWalletDisplay" class="font-heading text-2xl sm:text-3xl font-black text-emerald-400">$100</span>
                            <span class="text-xs text-slate-400">Starting budget</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="text-right">
                        <span class="text-xs uppercase font-extrabold tracking-wider text-slate-400 block">Items Purchased</span>
                        <span id="inventoryCount" class="font-heading text-lg font-bold text-amber-400">0 / 6 Items</span>
                    </div>
                    <button onclick="resetYardSaleGame()" class="px-3.5 py-2 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition border border-slate-700">
                        Restart Game
                    </button>
                </div>
            </div>

            <!-- Virtual Yard Sale Visual Scene & Items Table -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Left: Yard Sale Table Scene (7 Cols) -->
                <div class="lg:col-span-7 glass-panel p-6 rounded-3xl border border-slate-800 space-y-4 flex flex-col justify-between min-h-[420px] bg-gradient-to-b from-slate-900 via-slate-850 to-slate-950">
                    
                    <!-- Seller NPC Header -->
                    <div class="flex items-center space-x-4 bg-slate-900/80 p-3.5 rounded-2xl border border-slate-800">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-amber-400 to-orange-500 text-slate-950 flex items-center justify-center text-xl font-black shadow-md">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-white text-sm">Mrs. Sarah's Yard Sale</h3>
                            <p id="sellerNpcText" class="text-xs text-amber-300 italic">"Welcome! Click any item on the table to ask about its price!"</p>
                        </div>
                    </div>

                    <!-- Yard Sale Table Interactive Grid -->
                    <div class="my-4">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400 mb-3 block">Items on Display (Click an item to shop):</span>
                        <div id="yardSaleItemsGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <!-- Items injected dynamically by JS -->
                        </div>
                    </div>

                    <!-- Environment Footer -->
                    <div class="text-center pt-2 border-t border-slate-800/80">
                        <span class="text-[11px] text-slate-500 font-semibold"><i class="fa-solid fa-sun text-amber-400 mr-1"></i> Outdoor Yard Sale - Everything Must Go!</span>
                    </div>
                </div>

                <!-- Right: Active Shopping Dialogue Interaction Panel (5 Cols) -->
                <div class="lg:col-span-5 glass-panel p-6 rounded-3xl border border-slate-800 space-y-4 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <h3 class="font-extrabold text-white text-base flex items-center gap-2">
                                <i class="fa-solid fa-comments text-amber-400"></i> Shopping Dialogue
                            </h3>
                            <span id="activeStageStep" class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400">Step 1</span>
                        </div>

                        <!-- Dynamic Dialogue Prompt Container -->
                        <div id="simDialogueStage" class="mt-4 space-y-4">
                            <!-- Injected dynamically by JS depending on step -->
                            <div class="text-center py-12 text-slate-500 space-y-2">
                                <i class="fa-solid fa-hand-pointer text-3xl text-amber-400/60 animate-bounce-subtle"></i>
                                <p class="text-xs">Click any item on the left table to start asking for prices!</p>
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Drawer Summary -->
                    <div class="pt-4 border-t border-slate-800">
                        <span class="text-xs font-bold text-slate-400 block mb-2"><i class="fa-solid fa-bag-shopping text-emerald-400 mr-1.5"></i> My Purchased Items:</span>
                        <div id="playerInventoryList" class="flex flex-wrap gap-1.5 min-h-[36px] p-2 rounded-2xl bg-slate-900 border border-slate-800 text-xs text-slate-400">
                            <span class="italic text-slate-600">No items bought yet.</span>
                        </div>
                    </div>
                </div>

            </div>

        </section>

        <!-- ==========================================
             TAB 4: PARTNER ROLE-PLAY STUDIO
             ========================================== -->
        <section id="tab-4-roleplay" class="tab-content hidden space-y-6">
            
            <div class="glass-panel p-6 rounded-3xl border border-slate-800 space-y-6">
                
                <!-- Studio Header & Scenario Selector -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-extrabold text-white flex items-center gap-2">
                            <i class="fa-solid fa-people-arrows text-amber-400"></i> Section 4: Partner Role-Play Studio
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-400 mt-1">
                            Pair up with a classmate! Student A is the Seller, Student B is the Buyer. Practice aloud!
                        </p>
                    </div>

                    <!-- Practice Scenario Selector -->
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold text-slate-400">Scenario:</span>
                        <select id="roleplayScenarioSelect" onchange="loadRoleplayScenario()" class="bg-slate-900 border border-slate-800 text-slate-200 text-xs rounded-xl p-2 font-bold focus:outline-none focus:border-amber-500">
                            <option value="1">Scenario 1: Asking Price (No Bargaining)</option>
