                ]
            }
        };

        // Items Data for Sorting Game
        const SORTING_ITEMS = [
            { id: "item_1", name: "ring", type: "singular", icon: "fa-ring" },
            { id: "item_2", name: "earrings", type: "plural", icon: "fa-gem" },
            { id: "item_3", name: "MP3 player", type: "singular", icon: "fa-compact-disc" },
            { id: "item_4", name: "sunglasses", type: "plural", icon: "fa-glasses" },
            { id: "item_5", name: "lamp", type: "singular", icon: "fa-lightbulb" },
            { id: "item_6", name: "shoes", type: "plural", icon: "fa-shoe-prints" },
            { id: "item_7", name: "clock", type: "singular", icon: "fa-clock" },
            { id: "item_8", name: "flip-flops", type: "plural", icon: "fa-toilet-paper-slash" },
            { id: "item_9", name: "camera", type: "singular", icon: "fa-camera" },
            { id: "item_10", name: "gloves", type: "plural", icon: "fa-mitten" }
        ];

        // Items for Virtual Yard Sale Game
        const YARD_SALE_ITEMS = [
            { id: "ys_1", name: "Gold Ring", isPlural: false, basePrice: 15, bargainPrice: 10, icon: "fa-ring", color: "from-amber-400 to-yellow-500" },
            { id: "ys_2", name: "Blue Earrings", isPlural: true, basePrice: 25, bargainPrice: 18, icon: "fa-gem", color: "from-sky-400 to-blue-500" },
            { id: "ys_3", name: "Vintage MP3 Player", isPlural: false, basePrice: 45, bargainPrice: 30, icon: "fa-compact-disc", color: "from-rose-400 to-pink-500" },
            { id: "ys_4", name: "Desk Lamp", isPlural: false, basePrice: 30, bargainPrice: 20, icon: "fa-lightbulb", color: "from-orange-400 to-amber-500" },
            { id: "ys_5", name: "Cool Sunglasses", isPlural: true, basePrice: 18, bargainPrice: 12, icon: "fa-glasses", color: "from-teal-400 to-emerald-500" },
            { id: "ys_6", name: "Retro Alarm Clock", isPlural: false, basePrice: 35, bargainPrice: 25, icon: "fa-clock", color: "from-purple-400 to-indigo-500" }
        ];

        // Application State
        let appState = {
            audioEnabled: true,
            activeTab: 'unscramble',
            unscrambleConvId: 1,
            unscrambleCurrentList: [],
            // Sorting state
            sortingSelectedItemId: null,
            sortingItemsState: {},
            // Simulator State
            playerWallet: 100,
            inventory: [],
            activeSelectedItem: null,
            dialogueStep: 1, // 1: Pick Question, 2: Action Choice, 3: Outcome
            // Roleplay State
            roleplayScenario: 1
        };

        /* ==========================================
           2. AUDIO SYNTHESIS & SOUND EFFECTS
           ========================================== */

        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) audioCtx = new AudioContext();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playSound(type) {
            if (!appState.audioEnabled) return;
            try {
                const ctx = getAudioContext();
                if (!ctx) return;

                if (type === 'click') {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.frequency.setValueAtTime(600, ctx.currentTime);
                    gain.gain.setValueAtTime(0.08, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.1);
                } else if (type === 'success') {
                    [523.25, 659.25, 783.99].forEach((freq, i) => {
                        setTimeout(() => {
                            const osc = ctx.createOscillator();
                            const gain = ctx.createGain();
                            osc.frequency.setValueAtTime(freq, ctx.currentTime);
                            gain.gain.setValueAtTime(0.12, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.start();
                            osc.stop(ctx.currentTime + 0.2);
                        }, i * 100);
                    });
                } else if (type === 'cash') {
                    // Cash register chime sound
                    [800, 1200, 1600].forEach((freq, i) => {
                        setTimeout(() => {
                            const osc = ctx.createOscillator();
                            const gain = ctx.createGain();
                            osc.type = 'triangle';
                            osc.frequency.setValueAtTime(freq, ctx.currentTime);
                            gain.gain.setValueAtTime(0.15, ctx.currentTime);
                            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
                            osc.connect(gain);
                            gain.connect(ctx.destination);
                            osc.start();
                            osc.stop(ctx.currentTime + 0.25);
                        }, i * 80);
                    });
                }
            } catch(e) {
                console.warn(e);
            }
        }

        function toggleAudio() {
            appState.audioEnabled = !appState.audioEnabled;
            const icon = document.getElementById('audioIcon');
            const text = document.getElementById('audioStatusText');
            if (appState.audioEnabled) {
                icon.className = 'fa-solid fa-volume-high text-amber-400 mr-2';
                text.innerText = 'Audio: ON';
                playSound('click');
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-slate-500 mr-2';
                text.innerText = 'Audio: OFF';
            }
        }

        function speakText(text) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = 0.95;
            utterance.lang = 'en-US';
            window.speechSynthesis.speak(utterance);
        }

        /* ==========================================
           3. TAB NAVIGATION
           ========================================== */

        function switchTab(tabKey) {
            appState.activeTab = tabKey;
            
            // Hide all tab content
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            
            // Un-highlight nav buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-slate-200';
            });

            // Show target
            document.getElementById(`tab-${tabKey === 'unscramble' ? '1-unscramble' : tabKey === 'grammar' ? '2-grammar' : tabKey === 'simulator' ? '3-simulator' : '4-roleplay'}`).classList.remove('hidden');
            
            // Highlight active button
            const activeBtn = document.getElementById(`nav-${tabKey}`);
            if (activeBtn) {
                activeBtn.className = 'tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold flex items-center space-x-2 transition whitespace-nowrap bg-amber-500 text-slate-950 shadow-md';
            }

            playSound('click');
        }

        /* ==========================================
           4. TAB 1: UNSCRAMBLE CONTROLLER
           ========================================== */

        function initUnscramble(convId) {
            appState.unscrambleConvId = convId;
            const origList = UNSCRAMBLE_DATA[convId].sentences;
            
            // Shuffle sentences for unscramble
            let shuffled = [...origList].sort(() => Math.random() - 0.5);
            // Ensure shuffled isn't equal to original
            if (shuffled.every((val, index) => val.id === origList[index].id)) {
                shuffled.reverse();
            }

            appState.unscrambleCurrentList = shuffled;
            renderUnscrambleList();
            
            // Reset feedback
            const scoreBadge = document.getElementById('unscrambleScoreBadge');
            scoreBadge.classList.add('hidden');
        }

        function switchUnscrambleConv(convId) {
            document.getElementById('conv-btn-1').className = convId === 1 ? 'px-4 py-2 rounded-xl text-xs font-bold transition bg-amber-500 text-slate-950' : 'px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white';
            document.getElementById('conv-btn-2').className = convId === 2 ? 'px-4 py-2 rounded-xl text-xs font-bold transition bg-amber-500 text-slate-950' : 'px-4 py-2 rounded-xl text-xs font-bold transition text-slate-400 hover:text-white';
            initUnscramble(convId);
        }

        function renderUnscrambleList() {
            const container = document.getElementById('unscrambleContainer');
            container.innerHTML = '';

            appState.unscrambleCurrentList.forEach((item, index) => {
                const card = document.createElement('div');
                card.className = 'glass-card p-3.5 sm:p-4 rounded-2xl border border-slate-800 flex items-center justify-between gap-3 transition hover:border-slate-700';

                card.innerHTML = `
                    <div class="flex items-center space-x-3 flex-grow">
                        <!-- Number Tag -->
                        <span class="w-8 h-8 rounded-xl bg-slate-800 text-slate-300 font-black text-xs flex items-center justify-center border border-slate-700 flex-shrink-0">
                            ${index + 1}
                        </span>

                        <!-- Speaker Badge -->
                        <span class="px-2.5 py-1 rounded-lg text-[11px] font-black uppercase flex-shrink-0 ${item.speaker === 'Seller' ? 'bg-teal-500/20 text-teal-300 border border-teal-500/30' : 'bg-amber-500/20 text-amber-300 border border-amber-500/30'}">
                            ${item.speaker}
                        </span>

                        <!-- Sentence Text -->
                        <p class="text-xs sm:text-sm font-semibold text-slate-100 flex-grow">${item.text}</p>
                    </div>

                    <!-- Actions: Audio & Reorder -->
                    <div class="flex items-center space-x-1.5 flex-shrink-0">
                        <button onclick="speakText('${item.text.replace(/'/g, "\\'")}')" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 text-xs transition border border-slate-700" title="Listen Sentence">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <button onclick="moveUnscrambleItem(${index}, -1)" ${index === 0 ? 'disabled class="opacity-30 p-2 rounded-xl bg-slate-800 text-slate-500 text-xs"' : 'class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition border border-slate-700"'} title="Move Up">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                        <button onclick="moveUnscrambleItem(${index}, 1)" ${index === appState.unscrambleCurrentList.length - 1 ? 'disabled class="opacity-30 p-2 rounded-xl bg-slate-800 text-slate-500 text-xs"' : 'class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition border border-slate-700"'} title="Move Down">
                            <i class="fa-solid fa-arrow-down"></i>
                        </button>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        function moveUnscrambleItem(index, direction) {
            const targetIndex = index + direction;
            if (targetIndex < 0 || targetIndex >= appState.unscrambleCurrentList.length) return;

            // Swap
            const temp = appState.unscrambleCurrentList[index];
            appState.unscrambleCurrentList[index] = appState.unscrambleCurrentList[targetIndex];
            appState.unscrambleCurrentList[targetIndex] = temp;

            renderUnscrambleList();
            playSound('click');
        }

        function checkUnscrambleAnswers() {
            let correctCount = 0;
            const total = appState.unscrambleCurrentList.length;

            appState.unscrambleCurrentList.forEach((item, idx) => {
                if (item.correctOrder === idx + 1) {
                    correctCount++;
                }
            });

            const scoreBadge = document.getElementById('unscrambleScoreBadge');
            scoreBadge.classList.remove('hidden');

            if (correctCount === total) {
                scoreBadge.className = 'px-3.5 py-1.5 rounded-xl font-black text-xs sm:text-sm bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
                scoreBadge.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Perfect! 6 / 6 Correct!`;
                playSound('success');
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
            } else {
                scoreBadge.className = 'px-3.5 py-1.5 rounded-xl font-black text-xs sm:text-sm bg-amber-500/20 text-amber-300 border border-amber-500/40';
                scoreBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> ${correctCount} / ${total} Correct. Try reordering!`;
                playSound('click');
            }
        }

        function resetUnscramble() {
            initUnscramble(appState.unscrambleConvId);
            playSound('click');
        }

        function playFullConversation() {
            const origList = UNSCRAMBLE_DATA[appState.unscrambleConvId].sentences;
            let combinedText = origList.map(s => `${s.speaker} says: ${s.text}`).join(". ");
            speakText(combinedText);
        }

        /* ==========================================
           5. TAB 2: ITEM SORTING GAME CONTROLLER
           ========================================== */

        function initSortingGame() {
            appState.sortingSelectedItemId = null;
            appState.sortingItemsState = {};

            SORTING_ITEMS.forEach(item => {
                appState.sortingItemsState[item.id] = { bucket: 'unsorted', type: item.type };
            });

            renderSortingItems();
            updateSortingScore();
        }

        function renderSortingItems() {
            const unsortedBank = document.getElementById('unsortedItemsBank');
            const singularBucket = document.getElementById('singularBucket');
            const pluralBucket = document.getElementById('pluralBucket');

            unsortedBank.innerHTML = '';
            singularBucket.innerHTML = '';
            pluralBucket.innerHTML = '';

            SORTING_ITEMS.forEach(item => {
                const state = appState.sortingItemsState[item.id];
                const itemEl = document.createElement('div');
                
                const isSelected = appState.sortingSelectedItemId === item.id;
                itemEl.className = `px-3 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 cursor-pointer ${
                    isSelected ? 'bg-amber-400 text-slate-950 scale-105 shadow-lg ring-2 ring-amber-300' : 'bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700'
                }`;

                itemEl.innerHTML = `<i class="fa-solid ${item.icon} text-amber-400"></i> <span>${item.name}</span>`;
                itemEl.onclick = (e) => {
                    e.stopPropagation();
                    selectSortingItem(item.id);
                };

                if (state.bucket === 'unsorted') {
                    unsortedBank.appendChild(itemEl);
                } else if (state.bucket === 'singular') {
                    singularBucket.appendChild(itemEl);
                } else if (state.bucket === 'plural') {
                    pluralBucket.appendChild(itemEl);
                }
            });
        }

        function selectSortingItem(itemId) {
            appState.sortingSelectedItemId = appState.sortingSelectedItemId === itemId ? null : itemId;
            renderSortingItems();
            playSound('click');
        }

        function classifySelectedItem(targetBucket) {
            if (!appState.sortingSelectedItemId) return;

            appState.sortingItemsState[appState.sortingSelectedItemId].bucket = targetBucket;
            appState.sortingSelectedItemId = null;

            renderSortingItems();
            updateSortingScore();
            playSound('click');
        }

        function updateSortingScore() {
            let correct = 0;
            let totalSorted = 0;

            SORTING_ITEMS.forEach(item => {
                const state = appState.sortingItemsState[item.id];
                if (state.bucket !== 'unsorted') {
                    totalSorted++;
                    if (state.bucket === state.type) {
                        correct++;
                    }
                }
            });

            document.getElementById('sortingScore').innerText = `Score: ${correct} / 10`;

            if (correct === 10) {
                playSound('success');
                confetti({ particleCount: 70, spread: 50, origin: { y: 0.6 } });
            }
        }

        function resetSortingGame() {
            initSortingGame();
            playSound('click');
        }

        /* ==========================================
           6. TAB 3: VIRTUAL YARD SALE SIMULATOR
           ========================================== */

        function initYardSaleGame() {
            appState.playerWallet = 100;
            appState.inventory = [];
            appState.activeSelectedItem = null;
            appState.dialogueStep = 1;

            updateYardSaleHUD();
            renderYardSaleTable();
            renderDialogueStage();
        }

        function updateYardSaleHUD() {
            document.getElementById('playerWalletDisplay').innerText = `$${appState.playerWallet}`;
            document.getElementById('inventoryCount').innerText = `${appState.inventory.length} / 6 Items`;

            const invList = document.getElementById('playerInventoryList');
            if (appState.inventory.length === 0) {
                invList.innerHTML = '<span class="italic text-slate-600">No items bought yet.</span>';
            } else {
                invList.innerHTML = appState.inventory.map(item => `
                    <span class="px-2.5 py-1 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1 font-semibold">
                        <i class="fa-solid ${item.icon}"></i> ${item.name} ($${item.paidPrice})
                    </span>
                `).join('');
            }
        }

        function renderYardSaleTable() {
            const grid = document.getElementById('yardSaleItemsGrid');
            grid.innerHTML = '';

            YARD_SALE_ITEMS.forEach(item => {
                const isBought = appState.inventory.some(i => i.id === item.id);
                const isSelected = appState.activeSelectedItem && appState.activeSelectedItem.id === item.id;

                const card = document.createElement('div');
                card.className = `p-4 rounded-2xl border transition flex flex-col items-center justify-center text-center gap-2 cursor-pointer ${
                    isBought ? 'bg-slate-900/40 border-slate-800 opacity-40 cursor-not-allowed' :
                    isSelected ? 'bg-amber-500/20 border-amber-400 ring-2 ring-amber-400' :
                    'bg-slate-900 border-slate-800 hover:border-slate-700 hover:bg-slate-850'
                }`;

                card.innerHTML = `
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr ${item.color} text-slate-950 flex items-center justify-center text-xl font-black shadow-md">
                        <i class="fa-solid ${item.icon}"></i>
                    </div>
                    <span class="text-xs font-extrabold text-slate-200">${item.name}</span>
                    <span class="text-[11px] font-black text-amber-400">${isBought ? 'SOLD' : `$${item.basePrice}`}</span>
                `;

                if (!isBought) {
                    card.onclick = () => selectYardSaleItem(item);
                }

                grid.appendChild(card);
            });
        }

        function selectYardSaleItem(item) {
            appState.activeSelectedItem = item;
            appState.dialogueStep = 1;
            
            document.getElementById('sellerNpcText').innerText = `"Ah, you like the ${item.name}? What would you like to ask?"`;
            
            renderYardSaleTable();
            renderDialogueStage();
            playSound('click');
        }

        function renderDialogueStage() {
            const container = document.getElementById('simDialogueStage');
            const stepBadge = document.getElementById('activeStageStep');

            if (!appState.activeSelectedItem) {
                stepBadge.innerText = "Step 1";
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-500 space-y-2">
                        <i class="fa-solid fa-hand-pointer text-3xl text-amber-400/60 animate-bounce-subtle"></i>
                        <p class="text-xs">Click any item on the left table to start asking for prices!</p>
                    </div>
                `;
                return;
            }

            const item = appState.activeSelectedItem;

            if (appState.dialogueStep === 1) {
                stepBadge.innerText = "Step 1: Ask Price";
                container.innerHTML = `
                    <div class="space-y-3">
                        <span class="text-xs font-bold text-slate-300 block">Choose the correct question:</span>
                        
                        <button onclick="handleSimQuestionChoice(true)" class="w-full text-left p-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-amber-500/40 text-xs sm:text-sm font-semibold text-slate-200 transition flex items-center justify-between">
                            <span>"How much <strong>is this</strong> ${item.name}?"</span>
                            <i class="fa-solid fa-circle-chevron-right text-amber-400"></i>
                        </button>

                        <button onclick="handleSimQuestionChoice(false)" class="w-full text-left p-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-amber-500/40 text-xs sm:text-sm font-semibold text-slate-200 transition flex items-center justify-between">
                            <span>"How much <strong>are these</strong> ${item.name}?"</span>
                            <i class="fa-solid fa-circle-chevron-right text-amber-400"></i>
                        </button>
                    </div>
                `;
            } else if (appState.dialogueStep === 2) {
                stepBadge.innerText = "Step 2: Choose Action";
                const sellerReply = item.isPlural ? `They're $${item.basePrice}.` : `It's $${item.basePrice}.`;

                container.innerHTML = `
                    <div class="space-y-4">
                        <div class="p-3.5 rounded-2xl bg-teal-500/10 border border-teal-500/30 text-xs text-teal-200 space-y-1">
                            <strong class="text-teal-400 block"><i class="fa-solid fa-user-tie mr-1"></i> Seller Says:</strong>
                            <p class="text-sm font-bold">"${sellerReply}"</p>
                        </div>

                        <span class="text-xs font-bold text-slate-300 block">What do you want to say?</span>

                        <button onclick="handleSimActionChoice('buy', ${item.basePrice})" class="w-full text-left p-3 rounded-2xl bg-slate-900 hover:bg-emerald-500/10 border border-slate-800 hover:border-emerald-500/40 text-xs font-semibold text-emerald-300 transition flex items-center justify-between">
                            <span>"OK. I'll take it." (Buy for $${item.basePrice})</span>
                            <i class="fa-solid fa-cart-shopping"></i>
                        </button>

                        <button onclick="handleSimActionChoice('bargain', ${item.bargainPrice})" class="w-full text-left p-3 rounded-2xl bg-slate-900 hover:bg-amber-500/10 border border-slate-800 hover:border-amber-500/40 text-xs font-semibold text-amber-300 transition flex items-center justify-between">
                            <span>"Oh, that's pretty expensive. How about $${item.bargainPrice}?"</span>
                            <i class="fa-solid fa-handshake"></i>
                        </button>

                        <button onclick="handleSimActionChoice('leave')" class="w-full text-left p-3 rounded-2xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-slate-400 transition flex items-center justify-between">
                            <span>"Thanks. I'll think about it." (Walk away)</span>
                            <i class="fa-solid fa-person-walking"></i>
                        </button>
                    </div>
                `;
            } else if (appState.dialogueStep === 3) {
                stepBadge.innerText = "Step 3: Final Deal";
                container.innerHTML = `
                    <div class="text-center py-6 space-y-4">
                        <div class="w-14 h-14 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-2xl font-black mx-auto">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <h4 class="font-extrabold text-white text-base">Transaction Completed!</h4>
                        <p class="text-xs text-slate-300">You purchased <strong>${item.name}</strong>!</p>
                        <button onclick="clearSimSelection()" class="px-5 py-2 rounded-2xl bg-amber-500 text-slate-950 font-extrabold text-xs hover:bg-amber-400 transition">
                            Continue Shopping
                        </button>
                    </div>
                `;
            }
        }

        function handleSimQuestionChoice(selectedIsSingular) {
            const item = appState.activeSelectedItem;
            const isGrammarCorrect = (item.isPlural && !selectedIsSingular) || (!item.isPlural && selectedIsSingular);

            if (isGrammarCorrect) {
                playSound('success');
                appState.dialogueStep = 2;
                renderDialogueStage();
                
                const sellerReply = item.isPlural ? `They're $${item.basePrice}.` : `It's $${item.basePrice}.`;
                speakText(sellerReply);
            } else {
                playSound('click');
                const correctGrammarText = item.isPlural ? "are these" : "is this";
                speakText(`Remember, ${item.name} requires '${correctGrammarText}'!`);
                alert(`Grammar Tip: "${item.name}" is ${item.isPlural ? 'plural (use "are these")' : 'singular (use "is this")'}. Try again!`);
            }
        }

        function handleSimActionChoice(action, offerPrice) {
            const item = appState.activeSelectedItem;

            if (action === 'buy') {
                if (appState.playerWallet < offerPrice) {
                    alert("Not enough cash in wallet!");
                    return;
                }
                appState.playerWallet -= offerPrice;
                appState.inventory.push({ ...item, paidPrice: offerPrice });
                
                playSound('cash');
                speakText("Great! Here you go. Thank you!");
                updateYardSaleHUD();
                renderYardSaleTable();
                
                appState.dialogueStep = 3;
                renderDialogueStage();

            } else if (action === 'bargain') {
                // Seller accepts bargain counter-offer
                speakText(`Well, how about $${offerPrice}? Deal!`);
                setTimeout(() => {
                    appState.playerWallet -= offerPrice;
                    appState.inventory.push({ ...item, paidPrice: offerPrice });
                    
                    playSound('cash');
                    updateYardSaleHUD();
                    renderYardSaleTable();
                    
                    appState.dialogueStep = 3;
                    renderDialogueStage();
                }, 800);

            } else if (action === 'leave') {
                speakText("Alright, thanks for stopping by!");
                clearSimSelection();
            }
        }

        function clearSimSelection() {
            appState.activeSelectedItem = null;
            appState.dialogueStep = 1;
            document.getElementById('sellerNpcText').innerText = `"Welcome! Click any item on the table to ask about its price!"`;
            renderYardSaleTable();
            renderDialogueStage();
        }

        function resetYardSaleGame() {
            initYardSaleGame();
            playSound('click');
        }

        /* ==========================================
           7. TAB 4: PARTNER ROLE-PLAY STUDIO
           ========================================== */

        function loadRoleplayScenario() {
            const val = parseInt(document.getElementById('roleplayScenarioSelect').value);
            appState.roleplayScenario = val;
            updateRoleplayScript();
        }

        function updateRoleplayScript() {
            const item = document.getElementById('customItemInput').value || 'ring';
            const price = document.getElementById('customPriceInput').value || '12';
            const isPlural = document.getElementById('customPluralCheck').checked;

            const questionWord = isPlural ? "are these" : "is this";
            const pronounWord = isPlural ? "They're" : "It's";

            const sellerList = document.getElementById('sellerScriptList');
            const buyerList = document.getElementById('buyerScriptList');

            const scenario = appState.roleplayScenario;

            if (scenario === 1) {
                // Scenario 1: Standard Price Inquiry
                sellerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 1</span>
                        <p class="font-bold text-teal-300">"Hello. Can I help you?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 3</span>
                        <p class="font-bold text-teal-300">"${pronounWord} ${price} dollars."</p>
                    </div>
                `;

                buyerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 2</span>
                        <p class="font-bold text-amber-300">"Yes, how much ${questionWord} ${item}?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 4</span>
                        <p class="font-bold text-amber-300">"OK. I'll take it."</p>
                    </div>
                `;

            } else if (scenario === 2) {
                // Scenario 2: Bargaining Deal
                const lowerPrice = Math.max(1, Math.round(price * 0.75));

                sellerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 1</span>
                        <p class="font-bold text-teal-300">"Can I help you?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 3</span>
                        <p class="font-bold text-teal-300">"${pronounWord} ${price} dollars."</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 5</span>
                        <p class="font-bold text-teal-300">"Well, how about ${lowerPrice} dollars?"</p>
                    </div>
                `;

                buyerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 2</span>
                        <p class="font-bold text-amber-300">"Yes, how much ${questionWord} ${item}?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 4</span>
                        <p class="font-bold text-amber-300">"Oh, that's pretty expensive!"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 6</span>
                        <p class="font-bold text-amber-300">"OK. I'll take it!"</p>
                    </div>
                `;

            } else if (scenario === 3) {
                // Scenario 3: Thinking about it
                sellerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 1</span>
                        <p class="font-bold text-teal-300">"Hello. Can I help you?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 3</span>
                        <p class="font-bold text-teal-300">"${pronounWord} ${price} dollars."</p>
                    </div>
                `;

                buyerList.innerHTML = `
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 2</span>
                        <p class="font-bold text-amber-300">"Yes, how much ${questionWord} ${item}?"</p>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 space-y-1">
                        <span class="text-[10px] text-slate-500 uppercase font-black">Line 4</span>
                        <p class="font-bold text-amber-300">"Thanks. I'll think about it."</p>
                    </div>
                `;
            }

            playSound('click');
        }

        function playRoleplayScriptTTS() {
            const item = document.getElementById('customItemInput').value || 'ring';
            const price = document.getElementById('customPriceInput').value || '12';
            const isPlural = document.getElementById('customPluralCheck').checked;
            const questionWord = isPlural ? "are these" : "is this";
            const pronounWord = isPlural ? "They're" : "It's";

            let scriptText = "";
            if (appState.roleplayScenario === 1) {
                scriptText = `Seller says: Hello, Can I help you? Buyer says: Yes, how much ${questionWord} ${item}? Seller says: ${pronounWord} ${price} dollars. Buyer says: OK, I'll take it.`;
            } else if (appState.roleplayScenario === 2) {
                const lowerPrice = Math.max(1, Math.round(price * 0.75));
                scriptText = `Seller says: Can I help you? Buyer says: Yes, how much ${questionWord} ${item}? Seller says: ${pronounWord} ${price} dollars. Buyer says: Oh, that's pretty expensive. Seller says: Well, how about ${lowerPrice} dollars? Buyer says: OK, I'll take it.`;
            } else {
                scriptText = `Seller says: Hello, Can I help you? Buyer says: Yes, how much ${questionWord} ${item}? Seller says: ${pronounWord} ${price} dollars. Buyer says: Thanks, I'll think about it.`;
            }

            speakText(scriptText);
        }

        /* ==========================================
           8. MODAL CONTROLLERS
           ========================================== */

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
            playSound('click');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            playSound('click');
        }

        /* Initial Setup on Page Load */
        window.onload = function() {
            initUnscramble(1);
            initSortingGame();
            initYardSaleGame();
            updateRoleplayScript();
        };
    </script>
</body>
</html>
