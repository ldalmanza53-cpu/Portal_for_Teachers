                    </div>
                `;

                grid.appendChild(card);
            });
        }

        function speakFlashcard(jobId) {
            const job = jobsData.find(j => j.id === jobId);
            if (job) {
                speak(job.title);
                if (!state.cardsRead[jobId]) {
                    state.cardsRead[jobId] = true;
                    addStars(2);
                }
            }
        }

        let riddleQuestions = [];
        let riddleState = { current: 0, score: 0, streak: 0 };

        function startRiddleGame() {
            riddleQuestions = [...jobsData].sort(() => 0.5 - Math.random());
            riddleState = { current: 0, score: 0, streak: 0 };

            document.getElementById('riddle-start-view').classList.add('hidden');
            document.getElementById('riddle-summary-view').classList.add('hidden');
            document.getElementById('riddle-playing-view').classList.remove('hidden');

            renderRiddleQuestion();
        }

        function renderRiddleQuestion() {
            const currentJob = riddleQuestions[riddleState.current];

            document.getElementById('riddle-q-num').innerText = `Question ${riddleState.current + 1} of ${riddleQuestions.length}`;
            document.getElementById('riddle-streak-badge').innerText = `🔥 Streak: ${riddleState.streak}`;
            document.getElementById('riddle-score-badge').innerText = `Score: ${riddleState.score}`;
            document.getElementById('riddle-clue-text').innerText = `"${currentJob.clue}"`;

            // Choices
            const wrongChoices = jobsData.filter(j => j.id !== currentJob.id).sort(() => 0.5 - Math.random()).slice(0, 3);
            const choices = [currentJob, ...wrongChoices].sort(() => 0.5 - Math.random());

            const optionsGrid = document.getElementById('riddle-options-grid');
            optionsGrid.innerHTML = choices.map(choice => `
                <button onclick="handleRiddleAnswer('${choice.id}')" class="bg-slate-50 hover:bg-indigo-50 border-2 border-slate-200 hover:border-indigo-500 p-4 rounded-2xl text-left font-bold text-slate-800 flex items-center gap-3 transition-all active:scale-95 shadow-xs">
                    <span class="text-2xl">${choice.emoji}</span>
                    <span class="text-base capitalize">${choice.title}</span>
                </button>
            `).join('');

            speak(`Riddle clue: ${currentJob.clue}`);
        }

        function speakRiddleClue() {
            speak(riddleQuestions[riddleState.current].clue);
        }

        function handleRiddleAnswer(selectedId) {
            const currentJob = riddleQuestions[riddleState.current];
            if (selectedId === currentJob.id) {
                playSound('correct');
                riddleState.score++;
                riddleState.streak++;
                addStars(5);
                showToast("Correct! +5 Stars!", "success");
            } else {
                playSound('wrong');
                riddleState.streak = 0;
                showToast(`Not quite! That was a ${currentJob.title}.`, "warning");
            }

            riddleState.current++;
            if (riddleState.current < riddleQuestions.length) {
                setTimeout(renderRiddleQuestion, 500);
            } else {
                setTimeout(finishRiddleGame, 500);
            }
        }

        function finishRiddleGame() {
            document.getElementById('riddle-playing-view').classList.add('hidden');
            document.getElementById('riddle-summary-view').classList.remove('hidden');

            const totalStars = riddleState.score * 5;
            document.getElementById('riddle-final-score').innerText = `You scored ${riddleState.score} out of ${riddleQuestions.length}!`;
            document.getElementById('riddle-stars-earned').innerText = totalStars;

            if (riddleState.score >= 8) {
                confetti({ particleCount: 80, spread: 70 });
            }
        }

        let blanksSelections = {};

        function initBlanksGame() {
            const bankContainer = document.getElementById('blanks-word-bank');
            const targetWords = jobsData.map(q => q.title).sort();

            bankContainer.innerHTML = targetWords.map(w => `
                <span onclick="speak('${w}')" class="bg-white border border-indigo-200 text-indigo-700 font-bold px-3 py-1.5 rounded-xl text-xs sm:text-sm shadow-xs cursor-pointer hover:bg-indigo-600 hover:text-white transition-all">
                    ${w} <i class="fa-solid fa-volume-low text-[10px] ml-1"></i>
                </span>
            `).join('');

            const questionsList = document.getElementById('blanks-questions-list');
            questionsList.innerHTML = jobsData.map((q, idx) => `
                <div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-800 flex-1">
                        ${idx + 1}. ${q.blankSentence.replace('________', `<span class="inline-block border-b-2 border-indigo-600 min-w-[120px] text-indigo-600 text-center font-bold px-2">${blanksSelections[q.id] || '_______'}</span>`)}
                    </p>
                    <select onchange="blanksSelections['${q.id}'] = this.value; renderBlanksSentence('${q.id}');" class="bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-xl px-3 py-2 focus:outline-none focus:border-indigo-600 capitalize">
                        <option value="">-- Choose Job --</option>
                        ${targetWords.map(w => `<option value="${w}" ${blanksSelections[q.id] === w ? 'selected' : ''}>${w}</option>`).join('')}
                    </select>
                </div>
            `).join('');
        }

        function renderBlanksSentence(id) {
            initBlanksGame();
        }

        function checkFillBlanks() {
            let correct = 0;
            jobsData.forEach(q => {
                if (blanksSelections[q.id] === q.title) {
                    correct++;
                }
            });

            if (correct === jobsData.length) {
                playSound('correct');
                addStars(20);
                showToast("Perfect score! All 12 sentences correct! +20 Stars!", "success");
                confetti({ particleCount: 90, spread: 70 });
            } else {
                playSound('wrong');
                showToast(`You got ${correct} of ${jobsData.length} correct. Keep trying!`, "warning");
            }
        }

        function initSpeakingLab() {
            onSpeakingIndustryChange('Office Work');
        }

        function onSpeakingIndustryChange(industry) {
            const select = document.getElementById('speaking-job-select');
            const filteredJobs = jobsData.filter(j => j.category === industry);

            select.innerHTML = filteredJobs.map(j => `
                <option value="${j.id}">${j.emoji} ${j.title.toUpperCase()}</option>
            `).join('');

            if (filteredJobs.length > 0) {
                loadSpeakingJob(filteredJobs[0].id);
            }
        }

        function loadSpeakingJob(jobId) {
            state.activeSpeakingJobId = jobId;
            const job = jobsData.find(j => j.id === jobId);
            if (!job) return;

            const indefArticle = ['a','e','i','o','u'].includes(job.title[0]) ? 'an' : 'a';

            document.getElementById('speaking-question-text').innerText = `"Which industry do you want to work in?"`;
            document.getElementById('speaking-answer-text').innerText = `"I want to work in ${job.category} as ${indefArticle} ${job.title}."`;
            document.getElementById('speaking-reason-text').innerText = `"I want to be ${indefArticle} ${job.title} because ${job.reason}"`;
        }

        function speakCurrentQuestion() {
            speak("Which industry do you want to work in?");
        }

        function speakCurrentAnswer() {
            const job = jobsData.find(j => j.id === state.activeSpeakingJobId);
            if (job) {
                const indefArticle = ['a','e','i','o','u'].includes(job.title[0]) ? 'an' : 'a';
                speak(`I want to work in ${job.category} as ${indefArticle} ${job.title}.`);
            }
        }

        function speakCurrentReason() {
            const job = jobsData.find(j => j.id === state.activeSpeakingJobId);
            if (job) {
                const indefArticle = ['a','e','i','o','u'].includes(job.title[0]) ? 'an' : 'a';
                speak(`I want to be ${indefArticle} ${job.title} because ${job.reason}`);
            }
        }

        function switchTab(tabKey) {
            playSound('click');
            state.activeTab = tabKey;

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all";
            });
            document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

            const activeBtn = document.getElementById(`tab-${tabKey}`);
            if (activeBtn) {
                activeBtn.className = "tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap bg-indigo-600 text-white shadow-xs transition-all";
            }

            const activeContent = document.getElementById(`content-${tabKey}`);
            if (activeContent) {
                activeContent.classList.remove('hidden');
            }

            if (tabKey === 'wordmap') initWordMap();
            if (tabKey === 'flashcards') initFlashcards();
            if (tabKey === 'riddles') startRiddleGame();
            if (tabKey === 'blanks') initBlanksGame();
            if (tabKey === 'speaking') initSpeakingLab();
        }

        window.onload = function() {
            initWordMap();
            updateOverallProgress();
        };
    </script>
</body>
</html>
