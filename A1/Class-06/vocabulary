<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jobs & Industries - ESL Mind Map Explorer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Lexend', 'sans-serif'],
                    },
                    colors: {
                        office: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            200: '#bbf7d0',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        food: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            200: '#fed7aa',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        },
                        travel: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                        },
                        entertainment: {
                            50: '#faf5ff',
                            100: '#f3e8ff',
                            200: '#e9d5ff',
                            500: '#a855f7',
                            600: '#9333ea',
                            700: '#7e22ce',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .drop-target-active {
            border-color: #6366f1 !important;
            background-color: #e0e7ff !important;
            transform: scale(1.01);
        }
        .card-selected {
            ring: 4px;
            ring-color: #6366f1;
            transform: translateY(-2px);
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex flex-col md:flex-row items-center justify-between gap-3">
                
                <!-- Title & Badge -->
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 via-teal-500 to-indigo-600 text-white flex items-center justify-center text-2xl shadow-md shadow-emerald-100 font-bold">
                        🗺️
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Jobs & Industry Mind Map</h1>
                            <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-semibold">ESL Beginner</span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">Categorize 12 Job Titles into 4 Key Industries</p>
                    </div>
                </div>

                <!-- Controls & Gamification Bar -->
                <div class="flex items-center flex-wrap gap-3 sm:gap-4 justify-center md:justify-end w-full md:w-auto">
                    
                    <!-- Stars Counter -->
                    <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-800 px-3 py-1.5 rounded-xl shadow-xs">
                        <i class="fa-solid fa-star text-amber-500 text-lg"></i>
                        <span id="star-count" class="font-extrabold text-base">0</span>
                        <span class="text-xs text-amber-700 font-medium hidden sm:inline">Stars</span>
                    </div>

                    <!-- Progress Bar -->
                    <div class="flex flex-col min-w-[120px] sm:min-w-[140px]">
                        <div class="flex justify-between items-center text-xs text-slate-500 font-medium mb-1">
                            <span>Progress</span>
                            <span id="progress-text">0%</span>
                        </div>
                        <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden">
                            <div id="progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full w-0 transition-all duration-500"></div>
                        </div>
                    </div>

                    <!-- Audio Speed Selector -->
                    <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs">
                        <span class="text-slate-500 px-2 font-medium hidden sm:inline"><i class="fa-solid fa-gauge-high"></i> Audio:</span>
                        <button id="speed-slow-btn" onclick="setSpeed(0.75)" class="px-2.5 py-1 rounded-lg font-medium transition-all text-slate-600 hover:text-slate-900">
                            🐢 Slow
                        </button>
                        <button id="speed-normal-btn" onclick="setSpeed(1.0)" class="px-2.5 py-1 rounded-lg font-medium bg-white text-indigo-600 shadow-xs transition-all">
                            🐇 Normal
                        </button>
                    </div>

                </div>
            </div>

            <!-- Navigation Tabs -->
            <nav class="flex items-center justify-start sm:justify-center gap-1 sm:gap-2 mt-3 pt-2 border-t border-slate-100 overflow-x-auto custom-scrollbar">
                <button onclick="switchTab('wordmap')" id="tab-wordmap" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap bg-indigo-600 text-white shadow-xs transition-all">
                    <i class="fa-solid fa-sitemap"></i>
                    <span>Word Map Game</span>
                </button>
                <button onclick="switchTab('flashcards')" id="tab-flashcards" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>Audio Flashcards (12)</span>
                </button>
                <button onclick="switchTab('riddles')" id="tab-riddles" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-circle-question"></i>
                    <span>"Who Am I?" Riddles</span>
                </button>
                <button onclick="switchTab('blanks')" id="tab-blanks" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Fill in Blanks</span>
                </button>
                <button onclick="switchTab('speaking')" id="tab-speaking" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-comments"></i>
                    <span>Speaking Lab</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <section id="content-wordmap" class="tab-content block space-y-6">
            
            <!-- Instructions & Toolbar -->
            <div class="bg-white border border-slate-200 rounded-3xl p-5 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="space-y-1 text-center md:text-left">
                    <div class="flex items-center justify-center md:justify-start gap-2">
                        <h2 class="text-lg font-extrabold text-slate-900">Complete the Word Map</h2>
                        <span class="text-xs bg-indigo-100 text-indigo-800 font-bold px-2.5 py-0.5 rounded-full">Interactive Drag or Tap</span>
                    </div>
                    <p class="text-xs text-slate-500">Drag each job title into its correct industry box below, or tap a job then tap an industry target!</p>
                </div>

                <div class="flex items-center gap-2 flex-wrap justify-center">
                    <button onclick="giveWordMapHint()" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-xs transition-all active:scale-95">
                        <i class="fa-solid fa-lightbulb"></i> Give Hint
                    </button>
                    <button onclick="checkWordMapAnswers()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-xs transition-all active:scale-95">
                        <i class="fa-solid fa-check-circle"></i> Check Answers
                    </button>
                    <button onclick="resetWordMap()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 transition-all">
                        <i class="fa-solid fa-rotate-right"></i> Reset Map
                    </button>
                </div>
            </div>

            <!-- Unassigned Jobs Pool -->
            <div class="bg-indigo-50/60 border-2 border-dashed border-indigo-200 rounded-3xl p-4 space-y-2">
                <div class="flex items-center justify-between px-1">
                    <span class="text-xs font-bold text-indigo-900 uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-briefcase"></i> Job Pool (<span id="pool-count">12</span> remaining)
                    </span>
                    <span id="tap-mode-indicator" class="text-[11px] font-semibold text-indigo-600 hidden md:inline">Tip: You can also tap a card to select it!</span>
                </div>
                <div id="job-pool" class="flex flex-wrap gap-2.5 min-h-[70px] p-2 bg-white rounded-2xl border border-indigo-100 shadow-inner items-center justify-center md:justify-start">
                    <!-- Cards dynamically rendered -->
                </div>
            </div>

            <!-- Industry Word Map Grid (4 Quadrants surrounding Central Node) -->
            <div class="relative">
                <!-- Center Node for Desktop -->
                <div class="hidden lg:flex absolute inset-0 m-auto w-24 h-24 rounded-full bg-gradient-to-tr from-emerald-500 via-teal-500 to-indigo-600 text-white font-extrabold text-lg items-center justify-center shadow-lg border-4 border-white z-20 pointer-events-none tracking-widest uppercase">
                    JOBS
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    
                    <!-- 1. Office Work -->
                    <div id="target-office" class="industry-box bg-office-50 border-2 border-office-200 rounded-3xl p-5 shadow-xs flex flex-col space-y-3 transition-all min-h-[220px]" data-category="Office Work">
                        <div class="flex items-center justify-between border-b border-office-200 pb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-2xl">🏢</span>
                                <div>
                                    <h3 class="text-base font-extrabold text-office-900 uppercase tracking-wide">Office Work</h3>
                                    <p class="text-[11px] font-medium text-office-700">Business, administration & tech</p>
                                </div>
                            </div>
                            <span class="text-xs font-extrabold text-office-700 bg-white px-2.5 py-1 rounded-full border border-office-200 shadow-2xs box-counter">0 / 3</span>
                        </div>
                        <div class="drop-zone flex-1 flex flex-wrap gap-2.5 p-2 rounded-2xl border-2 border-dashed border-office-200/80 bg-white/60 min-h-[110px] items-center content-start">
                            <!-- Dropped items -->
                        </div>
                    </div>

                    <!-- 2. Food Service -->
                    <div id="target-food" class="industry-box bg-food-50 border-2 border-food-200 rounded-3xl p-5 shadow-xs flex flex-col space-y-3 transition-all min-h-[220px]" data-category="Food Service">
                        <div class="flex items-center justify-between border-b border-food-200 pb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-2xl">🍔</span>
                                <div>
                                    <h3 class="text-base font-extrabold text-food-900 uppercase tracking-wide">Food Service</h3>
                                    <p class="text-[11px] font-medium text-food-700">Restaurants, cafes & dining</p>
                                </div>
                            </div>
                            <span class="text-xs font-extrabold text-food-700 bg-white px-2.5 py-1 rounded-full border border-food-200 shadow-2xs box-counter">0 / 3</span>
                        </div>
                        <div class="drop-zone flex-1 flex flex-wrap gap-2.5 p-2 rounded-2xl border-2 border-dashed border-food-200/80 bg-white/60 min-h-[110px] items-center content-start">
                            <!-- Dropped items -->
                        </div>
                    </div>

                    <!-- 3. Travel Industry -->
                    <div id="target-travel" class="industry-box bg-travel-50 border-2 border-travel-200 rounded-3xl p-5 shadow-xs flex flex-col space-y-3 transition-all min-h-[220px]" data-category="Travel Industry">
                        <div class="flex items-center justify-between border-b border-travel-200 pb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-2xl">✈️</span>
                                <div>
                                    <h3 class="text-base font-extrabold text-travel-900 uppercase tracking-wide">Travel Industry</h3>
                                    <p class="text-[11px] font-medium text-travel-700">Airplanes, tourism & guiding</p>
                                </div>
                            </div>
                            <span class="text-xs font-extrabold text-travel-700 bg-white px-2.5 py-1 rounded-full border border-travel-200 shadow-2xs box-counter">0 / 3</span>
                        </div>
                        <div class="drop-zone flex-1 flex flex-wrap gap-2.5 p-2 rounded-2xl border-2 border-dashed border-travel-200/80 bg-white/60 min-h-[110px] items-center content-start">
                            <!-- Dropped items -->
                        </div>
                    </div>

                    <!-- 4. Entertainment Business -->
                    <div id="target-entertainment" class="industry-box bg-entertainment-50 border-2 border-entertainment-200 rounded-3xl p-5 shadow-xs flex flex-col space-y-3 transition-all min-h-[220px]" data-category="Entertainment Business">
                        <div class="flex items-center justify-between border-b border-entertainment-200 pb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-2xl">🎭</span>
                                <div>
                                    <h3 class="text-base font-extrabold text-entertainment-900 uppercase tracking-wide">Entertainment Business</h3>
                                    <p class="text-[11px] font-medium text-entertainment-700">Music, dance & stage performance</p>
                                </div>
                            </div>
                            <span class="text-xs font-extrabold text-entertainment-700 bg-white px-2.5 py-1 rounded-full border border-entertainment-200 shadow-2xs box-counter">0 / 3</span>
                        </div>
                        <div class="drop-zone flex-1 flex flex-wrap gap-2.5 p-2 rounded-2xl border-2 border-dashed border-entertainment-200/80 bg-white/60 min-h-[110px] items-center content-start">
                            <!-- Dropped items -->
                        </div>
                    </div>

                </div>
            </div>

        </section>

        <section id="content-flashcards" class="tab-content hidden space-y-6">
            
            <!-- Category Filter Header -->
            <div class="bg-white border border-slate-200 rounded-3xl p-4 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-filter text-indigo-500"></i>
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Filter Flashcards:</span>
                </div>
                <div id="flashcard-category-pills" class="flex flex-wrap gap-1.5 justify-center">
                    <!-- Dynamic category filter buttons -->
                </div>
            </div>

            <!-- Flashcards Grid -->
            <div id="flashcards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                <!-- Rendered by JS -->
            </div>

        </section>

        <section id="content-riddles" class="tab-content hidden space-y-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs max-w-3xl mx-auto space-y-6">
                
                <!-- Start Screen -->
                <div id="riddle-start-view" class="text-center py-8 space-y-4 max-w-md mx-auto">
                    <div class="w-20 h-20 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center text-4xl mx-auto shadow-inner">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                    <h2 class="text-2xl font-extrabold text-slate-900">"Who Am I?" Riddle Game</h2>
                    <p class="text-slate-500 text-xs sm:text-sm">Read or listen to the clues and guess the correct job title. Earn stars for every streak!</p>
                    <button onclick="startRiddleGame()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-3.5 rounded-2xl shadow-md transition-all active:scale-95 text-base">
                        Start Riddles 🚀
                    </button>
                </div>

                <!-- Playing Screen -->
                <div id="riddle-playing-view" class="hidden space-y-6">
                    <div class="flex items-center justify-between text-xs sm:text-sm border-b border-slate-100 pb-3">
                        <span id="riddle-q-num" class="font-bold text-slate-500">Question 1 of 12</span>
                        <div class="flex items-center gap-3">
                            <span id="riddle-streak-badge" class="font-bold text-amber-500 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-xl">🔥 Streak: 0</span>
                            <span id="riddle-score-badge" class="font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-2.5 py-1 rounded-xl">Score: 0</span>
                        </div>
                    </div>

                    <!-- Clue Card -->
                    <div class="bg-slate-50 border-2 border-indigo-100 rounded-2xl p-6 text-center space-y-3 relative">
                        <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide bg-indigo-100 px-3 py-1 rounded-full">Riddle Clue</span>
                        <p id="riddle-clue-text" class="text-lg sm:text-xl font-extrabold text-slate-800 leading-snug">
                            "I sit in an airplane cockpit and fly passengers through the sky safely. Who am I?"
                        </p>
                        <button onclick="speakRiddleClue()" class="inline-flex items-center gap-1.5 text-xs text-indigo-600 hover:text-indigo-800 font-semibold bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs">
                            <i class="fa-solid fa-volume-high"></i> Listen to Riddle
                        </button>
                    </div>

                    <!-- Multiple Choice Options -->
                    <div id="riddle-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <!-- Summary Screen -->
                <div id="riddle-summary-view" class="hidden text-center py-8 space-y-4 max-w-md mx-auto">
                    <div class="text-6xl">🏆</div>
                    <h2 class="text-2xl font-extrabold text-slate-900">Riddle Challenge Finished!</h2>
                    <p id="riddle-final-score" class="text-slate-600 font-medium">You scored 12 / 12!</p>
                    <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl text-amber-800 font-bold text-sm">
                        +<span id="riddle-stars-earned">60</span> Stars Earned!
                    </div>
                    <button onclick="startRiddleGame()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-3 rounded-2xl shadow-md transition-all">
                        Play Again 🔄
                    </button>
                </div>

            </div>
        </section>

        <section id="content-blanks" class="tab-content hidden space-y-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs max-w-3xl mx-auto space-y-6">
                <div class="text-center max-w-lg mx-auto">
                    <h2 class="text-2xl font-bold text-slate-900">Fill in the Blanks 📝</h2>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">Select the best job title from the word bank to complete each sentence.</p>
                </div>

                <!-- Word Bank -->
                <div class="bg-indigo-50 border border-indigo-100 p-4 rounded-2xl space-y-2">
                    <span class="text-xs font-bold text-indigo-700 uppercase tracking-wide block text-center">Word Bank (Click word to pronounce)</span>
                    <div id="blanks-word-bank" class="flex flex-wrap justify-center gap-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Sentence List -->
                <div id="blanks-questions-list" class="space-y-3.5">
                    <!-- Populated by JS -->
                </div>

                <div class="text-center pt-2">
                    <button onclick="checkFillBlanks()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-3.5 rounded-2xl shadow-md transition-all active:scale-95 text-base">
                        <i class="fa-solid fa-check mr-2"></i> Check My Answers
                    </button>
                </div>
            </div>
        </section>

        <section id="content-speaking" class="tab-content hidden space-y-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs max-w-3xl mx-auto space-y-6">
                <div class="text-center max-w-lg mx-auto">
                    <span class="bg-teal-100 text-teal-800 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wide">Pair Work Speaking Practice</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Career Conversation Lab 💬</h2>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">Practice asking and answering career questions with native audio modeling.</p>
                </div>

                <!-- Target Job Selector -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">1. Choose Industry:</label>
                        <select id="speaking-industry-select" onchange="onSpeakingIndustryChange(this.value)" class="w-full bg-slate-50 border border-slate-300 rounded-2xl p-3 text-sm font-bold text-slate-800 focus:outline-none focus:border-indigo-500">
                            <option value="Office Work">🏢 Office Work</option>
                            <option value="Food Service">🍔 Food Service</option>
                            <option value="Travel Industry">✈️ Travel Industry</option>
                            <option value="Entertainment Business">🎭 Entertainment Business</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1">2. Choose Job Title:</label>
                        <select id="speaking-job-select" onchange="loadSpeakingJob(this.value)" class="w-full bg-slate-50 border border-slate-300 rounded-2xl p-3 text-sm font-bold text-slate-800 focus:outline-none focus:border-indigo-500 capitalize">
                            <!-- Populated dynamically -->
                        </select>
                    </div>
                </div>

                <!-- Conversation Cards -->
                <div class="space-y-4">
                    
                    <!-- Question Prompt -->
                    <div class="bg-slate-50 border-2 border-indigo-100 p-5 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                        <div class="space-y-1">
                            <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide">Partner A (Question):</span>
                            <p id="speaking-question-text" class="text-lg font-bold text-slate-900">"Which industry do you want to work in?"</p>
                        </div>
