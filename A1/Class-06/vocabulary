        function renderWordMap() {
            const pool = document.getElementById('job-pool');
            pool.innerHTML = '';

            // Reset box counters
            const categoryCounts = { 'Office Work': 0, 'Food Service': 0, 'Travel Industry': 0, 'Entertainment Business': 0 };

            // Render targets drop zones
            document.querySelectorAll('.industry-box').forEach(box => {
                const cat = box.getAttribute('data-category');
                const dropZone = box.querySelector('.drop-zone');
                dropZone.innerHTML = '';
            });

            let unplacedCount = 0;

            jobsData.forEach(job => {
                const placedCat = state.wordMapPlacements[job.id];

                const cardEl = document.createElement('div');
                cardEl.id = `card-${job.id}`;
                cardEl.draggable = true;
                
                const isSelected = state.selectedJobIdForTap === job.id;

                cardEl.className = `px-3 py-2 rounded-xl text-xs sm:text-sm font-extrabold flex items-center gap-2 cursor-grab active:cursor-grabbing border-2 transition-all shadow-xs select-none ${
                    isSelected ? 'ring-4 ring-indigo-500 scale-105 border-indigo-600 bg-indigo-50' :
                    placedCat ? 'bg-white border-slate-300 text-slate-800' :
                    'bg-slate-50 hover:bg-indigo-50 border-slate-200 text-slate-800'
                }`;

                cardEl.innerHTML = `
                    <span>${job.emoji}</span>
                    <span class="capitalize">${job.title}</span>
                    <button onclick="event.stopPropagation(); speak('${job.title}');" class="text-slate-400 hover:text-indigo-600 ml-1 p-0.5">
                        <i class="fa-solid fa-volume-high text-[11px]"></i>
                    </button>
                `;

                // Drag & Tap Event Handlers
                cardEl.ondragstart = (e) => {
                    e.dataTransfer.setData('text/plain', job.id);
                    state.selectedJobIdForTap = job.id;
                };

                cardEl.onclick = () => {
                    playSound('click');
                    if (state.selectedJobIdForTap === job.id) {
                        state.selectedJobIdForTap = null;
                    } else {
                        state.selectedJobIdForTap = job.id;
                        speak(job.title);
                        showToast(`Selected "${job.title}". Tap an industry box to place!`);
                    }
                    renderWordMap();
                };

                if (!placedCat) {
                    unplacedCount++;
                    pool.appendChild(cardEl);
                } else {
                    categoryCounts[placedCat]++;
                    const targetBox = Array.from(document.querySelectorAll('.industry-box')).find(b => b.getAttribute('data-category') === placedCat);
                    if (targetBox) {
                        targetBox.querySelector('.drop-zone').appendChild(cardEl);
                    }
                }
            });

            document.getElementById('pool-count').innerText = unplacedCount;

            // Update box header counters
            document.querySelectorAll('.industry-box').forEach(box => {
                const cat = box.getAttribute('data-category');
                const counter = box.querySelector('.box-counter');
                counter.innerText = `${categoryCounts[cat]} / 3`;
            });

            updateOverallProgress();
        }

        function setupDropZones() {
            document.querySelectorAll('.industry-box').forEach(box => {
                const cat = box.getAttribute('data-category');

                box.ondragover = (e) => {
                    e.preventDefault();
                    box.classList.add('drop-target-active');
                };

                box.ondragleave = () => {
                    box.classList.remove('drop-target-active');
                };

                box.ondrop = (e) => {
                    e.preventDefault();
                    box.classList.remove('drop-target-active');
                    const jobId = e.dataTransfer.getData('text/plain') || state.selectedJobIdForTap;
                    if (jobId) {
                        placeJobInCategory(jobId, cat);
                    }
                };

                box.onclick = () => {
                    if (state.selectedJobIdForTap) {
                        placeJobInCategory(state.selectedJobIdForTap, cat);
                    }
                };
            });
        }

