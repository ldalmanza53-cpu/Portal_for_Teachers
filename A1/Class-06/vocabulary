            let correctCount = 0;
            jobsData.forEach(job => {
                const isCorrect = state.wordMapPlacements[job.id] === job.category;
                const cardEl = document.getElementById(`card-${job.id}`);
                if (isCorrect) {
                    correctCount++;
                    if (cardEl) {
                        cardEl.classList.add('border-emerald-500', 'bg-emerald-50');
                    }
                } else {
                    if (cardEl) {
                        cardEl.classList.add('border-rose-500', 'bg-rose-50', 'animate-shake');
                    }
                }
            });

            if (correctCount === jobsData.length) {
                playSound('correct');
                addStars(20);
                confetti({ particleCount: 100, spread: 80 });
                showToast("Perfect! Word Map completed perfectly! +20 Stars!", "success");
            } else {
                playSound('wrong');
                showToast(`You got ${correctCount} of 12 correct. Incorrect placements highlighted in red!`, "warning");
            }
        }

