<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Good Neighborhood • Interactive Vocabulary Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Sortable JS for Drag-and-Drop Ranking -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        .tab-active { background-color: #059669 !important; color: #ffffff !important; box-shadow: 0 4px 14px 0 rgba(5, 150, 105, 0.35); }
        .rank-item { cursor: grab; transition: all 0.2s ease; }
        .rank-item:active { cursor: grabbing; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-city"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white flex items-center gap-2">
                        A Good Neighborhood
                        <span class="bg-emerald-900/80 text-emerald-300 border border-emerald-500/40 text-[10px] px-2 py-0.5 rounded-full font-extrabold uppercase">Beginner A1-A2</span>
                    </h1>
                    <p class="text-xs text-slate-400">Interactive Vocabulary & Ranking Activity</p>
                </div>
            </div>

            <!-- Stats & Timer -->
            <div class="flex items-center gap-4 bg-slate-900/90 px-4 py-2 rounded-xl border border-slate-700 text-sm">
                <div class="flex items-center gap-2 text-amber-400">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                    <span id="timerDisplay" class="font-mono font-bold text-lg">10:00</span>
                    <button onclick="toggleTimer()" id="timerBtn" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs px-2 py-1 rounded font-bold transition ml-1">Start</button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('ranker')" id="tab-ranker" class="nav-tab tab-active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-list-ol"></i> 1. Ranking & Speaking Tool
                </button>
                <button onclick="switchTab('builder')" id="tab-builder" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-comment-dots"></i> 2. Sentence Scaffold Builder
                </button>
                <button onclick="switchTab('plan')" id="tab-plan" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-chalkboard-user"></i> 3. Lesson Plan & Roles
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: RANKING & SPEAKING TOOL -->
        <section id="sec-ranker" class="tab-content block space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Interactive Drag & Drop List (2/3 width) -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-700 pb-3">
                            <div>
                                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                                    <i class="fa-solid fa-arrow-down-short-wide text-emerald-400"></i>
                                    What do you look for in a neighborhood?
                                </h2>
                                <p class="text-xs text-slate-400">Drag or use arrows to rank from 1 to 6 (1 = most important)</p>
                            </div>
                            <button onclick="resetRankings()" class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded-lg font-bold text-slate-300 transition">
                                <i class="fa-solid fa-rotate-right"></i> Reset Order
                            </button>
                        </div>

                        <!-- Drag and Drop List -->
                        <div id="rankingList" class="space-y-3">
                            <!-- Populated dynamically by JavaScript -->
                        </div>

                        <div class="pt-2 text-right">
                            <button onclick="confirmRankings()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition flex items-center gap-2 text-sm ml-auto">
                                <i class="fa-solid fa-circle-check"></i> Lock In My Priorities
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Side Panel: Roleplay Prompts & Client Profile (1/3 width) -->
                <div class="space-y-6">
                    <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl space-y-4">
                        <h3 class="text-sm font-bold text-white flex items-center gap-2 border-b border-slate-700 pb-3">
                            <i class="fa-solid fa-comments text-amber-400"></i> Pair Interview Scaffold
                        </h3>

                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 space-y-2">
                            <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest">Role A: Real Estate Agent</span>
                            <p class="text-xs text-slate-200 italic">"What do you look for in a neighborhood?"</p>
                            <p class="text-xs text-slate-200 italic">"What is number 1 for you?"</p>
                            <button onclick="speakText('What do you look for in a neighborhood? What is number 1 for you?')" class="text-[11px] text-teal-400 hover:underline flex items-center gap-1 font-bold pt-1">
                                <i class="fa-solid fa-volume-high"></i> Listen to Question
                            </button>
                        </div>

                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 space-y-2">
                            <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest">Role B: Client / Buyer</span>
                            <p class="text-xs text-slate-200 italic">"For me, number 1 is <strong id="topChoicePreview" class="text-amber-400">[Select #1]</strong>."</p>
                            <p class="text-xs text-slate-200 italic">"I look for <strong id="secondChoicePreview" class="text-amber-400">[Select #2]</strong> because..."</p>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- TAB 2: SENTENCE SCAFFOLD BUILDER -->
        <section id="sec-builder" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-teal-900/60 text-teal-300 border border-teal-500/40 text-xs font-bold rounded-full uppercase">Speaking Scaffold</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Interactive Sentence Maker</h2>
                    <p class="text-sm text-slate-400">Select options below to construct correct A1 English sentences about your neighborhood preferences.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <!-- Step 1: Feature -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-emerald-400 uppercase">1. Choose Feature</label>
                        <select id="builderFeature" onchange="updateSentence()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="shopping malls">shopping malls</option>
                            <option value="supermarkets">supermarkets</option>
                            <option value="restaurants and coffee shops">restaurants and coffee shops</option>
                            <option value="parks">parks</option>
                            <option value="good neighbors">good neighbors</option>
                            <option value="public transportation">public transportation</option>
                        </select>
                    </div>

                    <!-- Step 2: Priority -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-amber-400 uppercase">2. Priority Level</label>
                        <select id="builderPriority" onchange="updateSentence()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="the most important thing">the most important feature (#1)</option>
                            <option value="very important">very important to me</option>
                            <option value="nice to have">nice to have</option>
                            <option value="not important">not very important</option>
                        </select>
                    </div>

                    <!-- Step 3: Reason -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-indigo-400 uppercase">3. Reason</label>
                        <select id="builderReason" onchange="updateSentence()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="I need food every day">I need food every day</option>
                            <option value="I don't have a car">I don't have a car</option>
                            <option value="I like quiet and safe places">I like quiet and safe places</option>
                            <option value="I love walking with my dog">I love walking with my dog</option>
                            <option value="I enjoy eating out with friends">I enjoy eating out with friends</option>
                        </select>
                    </div>
                </div>

                <!-- Generated Output -->
                <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 text-center space-y-4">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Your Full Sentence:</span>
                    <p id="generatedSentence" class="text-xl font-bold text-emerald-400 leading-relaxed">
                        "In my neighborhood, shopping malls are the most important feature because I need food every day."
                    </p>
                    <button onclick="speakText(document.getElementById('generatedSentence').innerText)" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2 rounded-xl transition">
                        <i class="fa-solid fa-volume-high"></i> Listen & Repeat
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 3: LESSON PLAN & ROLES -->
        <section id="sec-plan" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-amber-900/60 text-amber-300 border border-amber-500/40 text-xs font-bold rounded-full uppercase">Teacher's Guide</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Classroom Lesson Plan (A1 Level)</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-base font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-bullseye"></i> Vocabulary Items (6 Key Features)
                        </h3>
                        <ul class="text-xs text-slate-300 space-y-2">
                            <li class="flex items-center gap-2"><i class="fa-solid fa-bag-shopping text-emerald-400"></i> Shopping malls</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-emerald-400"></i> Supermarkets</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-utensils text-emerald-400"></i> Restaurants and coffee shops</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-tree text-emerald-400"></i> Parks</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-users text-emerald-400"></i> Good neighbors</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-bus text-emerald-400"></i> Public transportation</li>
                        </ul>
                    </div>

                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-base font-bold text-teal-400 flex items-center gap-2">
                            <i class="fa-solid fa-comments"></i> Key Speaking Questions
                        </h3>
                        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs text-slate-200 space-y-2">
                            <p>• <strong>"What do you look for in a neighborhood?"</strong></p>
                            <p>• <strong>"What is number 1 for you?"</strong></p>
                            <p>• <strong>"Is [public transportation] important to you?"</strong></p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        A Good Neighborhood • Interactive Beginner ESL Activity
    </footer>

    <script>
        // Initial Vocabulary Data from prompt
        const initialFeatures = [
            { id: 'malls', text: 'shopping malls', icon: 'fa-bag-shopping', defaultRank: 1 },
            { id: 'supermarkets', text: 'supermarkets', icon: 'fa-cart-shopping', defaultRank: 2 },
            { id: 'restaurants', text: 'restaurants and coffee shops', icon: 'fa-utensils', defaultRank: 3 },
            { id: 'parks', text: 'parks', icon: 'fa-tree', defaultRank: 4 },
            { id: 'neighbors', text: 'good neighbors', icon: 'fa-users', defaultRank: 5 },
            { id: 'transit', text: 'public transportation', icon: 'fa-bus', defaultRank: 6 }
        ];

        let currentOrder = [...initialFeatures];
        let timerSeconds = 600;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderRankingList();
            initSortable();
            updateSentence();
        });

        // Speech API
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Render Ranking List
        function renderRankingList() {
            const list = document.getElementById('rankingList');
            list.innerHTML = '';

            currentOrder.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = 'rank-item bg-slate-900 p-4 rounded-xl border border-slate-700 flex items-center justify-between gap-4 shadow-sm';
                row.setAttribute('data-id', item.id);

                row.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-emerald-900/80 text-emerald-300 border border-emerald-500/40 font-extrabold text-sm flex items-center justify-center">
                            ${index + 1}
                        </span>
                        <div class="w-9 h-9 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-emerald-400 text-lg">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
                        <span class="text-sm font-bold text-white capitalize">${item.text}</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <button onclick="moveItem(${index}, -1)" class="w-7 h-7 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-chevron-up"></i>
                        </button>
                        <button onclick="moveItem(${index}, 1)" class="w-7 h-7 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <button onclick="speakText('${item.text}')" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-emerald-400 flex items-center justify-center text-xs ml-1">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                `;
                list.appendChild(row);
            });

            // Update Side Panel Previews
            if (currentOrder.length > 0) {
                document.getElementById('topChoicePreview').innerText = currentOrder[0].text;
                document.getElementById('secondChoicePreview').innerText = currentOrder[1].text;
            }
        }

        // Initialize Drag and Drop
        function initSortable() {
            const list = document.getElementById('rankingList');
            new Sortable(list, {
                animation: 150,
                onEnd: function () {
                    const newOrderIds = Array.from(list.children).map(el => el.getAttribute('data-id'));
                    currentOrder = newOrderIds.map(id => initialFeatures.find(f => f.id === id));
                    renderRankingList();
                }
            });
        }

        function moveItem(index, delta) {
            const target = index + delta;
            if (target >= 0 && target < currentOrder.length) {
                const temp = currentOrder[index];
                currentOrder[index] = currentOrder[target];
                currentOrder[target] = temp;
                renderRankingList();
            }
        }

        function resetRankings() {
            currentOrder = [...initialFeatures];
            renderRankingList();
        }

        function confirmRankings() {
            confetti({ particleCount: 50, spread: 60 });
            speakText(`My number 1 feature is ${currentOrder[0].text}.`);
        }

        // Sentence Builder
        function updateSentence() {
            const feat = document.getElementById('builderFeature').value;
            const prio = document.getElementById('builderPriority').value;
            const reas = document.getElementById('builderReason').value;

            const text = `In my ideal neighborhood, ${feat} are ${prio} because ${reas}.`;
            document.getElementById('generatedSentence').innerText = `"${text}"`;
        }

        // Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
