                    <circle cx="35" cy="42" r="7" fill="#2563eb"/>
                    <polygon points="35,52 26,75 44,75" fill="#3b82f6" rx="2"/>
                    <circle cx="33" cy="62" r="2" fill="#ffffff" opacity="0.6"/>

                    <!-- Right Earring -->
                    <path d="M65,20 Q65,30 65,35" stroke="#64748b" stroke-width="2" fill="none"/>
                    <circle cx="65" cy="42" r="7" fill="#2563eb"/>
                    <polygon points="65,52 56,75 74,75" fill="#3b82f6" rx="2"/>
                    <circle cx="63" cy="62" r="2" fill="#ffffff" opacity="0.6"/>
                </svg>`
            },
            {
                id: 7,
                number: "7.",
                article: "",
                material: "rubber",
                item: "flip-flops",
                fullPhrase: "rubber flip-flops",
                phonetic: "/ˈrʌb.ər/",
                plural: true,
                questionA: "What are flip-flops made of?",
                answerB: "They are rubber flip-flops.",
                svg: `<svg viewBox="0 0 100 100" class="w-full h-full">
                    <!-- Left Flip flop -->
                    <ellipse cx="36" cy="55" rx="14" ry="32" fill="#facc15" transform="rotate(-10 36 55)"/>
                    <path d="M30,35 L35,50 L42,36" fill="none" stroke="#ef4444" stroke-width="4" stroke-linecap="round"/>
                    
                    <!-- Right Flip flop -->
                    <ellipse cx="64" cy="55" rx="14" ry="32" fill="#facc15" transform="rotate(10 64 55)"/>
                    <path d="M58,36 L65,50 L70,35" fill="none" stroke="#ef4444" stroke-width="4" stroke-linecap="round"/>
                </svg>`
            },
            {
                id: 8,
                number: "8.",
                article: "",
                material: "wool",
                item: "socks",
                fullPhrase: "wool socks",
                phonetic: "/wʊl/",
                plural: true,
                questionA: "What are those socks made of?",
                answerB: "They are wool socks.",
                svg: `<svg viewBox="0 0 100 100" class="w-full h-full">
                    <!-- Sock 1 -->
                    <path d="M25,20 L42,20 L42,50 Q42,65 58,65 Q65,65 65,75 Q65,82 52,82 Q30,82 25,55 Z" fill="#475569"/>
                    <path d="M25,20 L42,20 L42,28 L25,28 Z" fill="#94a3b8"/>
                    <path d="M52,82 Q65,82 65,75 Q65,65 58,65 Z" fill="#94a3b8"/>

                    <!-- Sock 2 -->
                    <path d="M45,15 L62,15 L62,45 Q62,60 78,60 Q85,60 85,70 Q85,77 72,77 Q50,77 45,50 Z" fill="#334155"/>
                    <path d="M45,15 L62,15 L62,23 L45,23 Z" fill="#cbd5e1"/>
                </svg>`
            }
        ];

        // Unique material words list
        const MATERIAL_WORDS = ["cotton", "gold", "leather", "plastic", "rubber", "silk", "silver", "wool"];

        // Application State
        let soundEnabled = true;
        let globalScore = 0;
        let selectedMaterialTag = null; // For click-to-fill selection
        let worksheetUserAnswers = {}; // { itemID: "silk" }
        let currentFlashcardIdx = 0;
        let quizState = {
            currentQuestion: 0,
            score: 0,
            streak: 0,
            questions: []
        };
        let activeSpeakingIdx = 0;

        // Web Audio API Synthesizer
        let audioCtx = null;

        function getAudioContext() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) {
                    audioCtx = new AudioContext();
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playTone(freq, type = 'sine', duration = 0.15, gainVal = 0.1) {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                if (!ctx) return;

                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = type;
                osc.frequency.setValueAtTime(freq, ctx.currentTime);

                gain.gain.setValueAtTime(gainVal, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {
                console.warn("Audio playback not supported or blocked", e);
            }
        }

        function playCorrectSound() {
            if (!soundEnabled) return;
            const ctx = getAudioContext();
            if (!ctx) return;
            const now = ctx.currentTime;
            
            // Happy arpeggio
            [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                setTimeout(() => playTone(freq, 'triangle', 0.2, 0.15), idx * 80);
            });
        }

        function playIncorrectSound() {
            if (!soundEnabled) return;
            playTone(220, 'sawtooth', 0.25, 0.15);
            setTimeout(() => playTone(180, 'sawtooth', 0.3, 0.15), 150);
        }

        function playFanfareSound() {
            if (!soundEnabled) return;
            const notes = [440, 554.37, 659.25, 880];
            notes.forEach((f, i) => {
                setTimeout(() => playTone(f, 'triangle', 0.3, 0.2), i * 120);
            });
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('soundIcon');
            const text = document.getElementById('soundText');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high text-indigo-600 mr-2';
                text.innerText = 'Sound: ON';
                playTone(600, 'sine', 0.1);
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-slate-400 mr-2';
                text.innerText = 'Sound: OFF';
            }
        }

        // Web Speech API Pronunciation
        function speakText(text) {
            if (!('speechSynthesis' in window)) {
                alert("Text-to-speech is not supported in this browser.");
                return;
            }
            window.speechSynthesis.cancel(); // Stop ongoing speech
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = 0.9; // Slightly slower for language learners
            utterance.lang = 'en-US';
            window.speechSynthesis.speak(utterance);
        }

        function switchTab(tabId) {
            playTone(500, 'sine', 0.05);
            // Hide all sections
            document.querySelectorAll('.tab-section').forEach(sec => sec.classList.add('hidden'));
            
            // Reset tab button states
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-4 py-2 rounded-xl text-sm font-extrabold flex items-center whitespace-nowrap transition text-slate-600 hover:bg-slate-200/70';
            });

            // Show selected section
            const activeSection = document.getElementById(`section-${tabId}`);
            if (activeSection) activeSection.classList.remove('hidden');

            // Highlight active tab button
            const activeBtn = document.getElementById(`tab-${tabId}`);
            if (activeBtn) {
                activeBtn.className = 'tab-btn active-tab px-4 py-2 rounded-xl text-sm font-extrabold flex items-center whitespace-nowrap transition bg-indigo-600 text-white shadow-sm';
            }

            // Lazy initialization for modes if needed
            if (tabId === 'quiz' && quizState.questions.length === 0) {
                initQuiz();
            }
        }

        function initWorksheet() {
            renderWordBank();
            renderWorksheetCards();
        }

        function renderWordBank() {
            const container = document.getElementById('wordBankContainer');
            container.innerHTML = '';

            MATERIAL_WORDS.forEach(word => {
                const isSelected = selectedMaterialTag === word;
                const btn = document.createElement('button');
                btn.className = `px-4 py-2 rounded-xl font-extrabold text-sm border-2 transition transform active:scale-95 flex items-center space-x-2 ${
                    isSelected 
                    ? 'bg-amber-400 border-amber-500 text-slate-900 shadow-md ring-2 ring-amber-300' 
                    : 'bg-white border-amber-200 text-slate-800 hover:bg-amber-100/70 shadow-sm'
                }`;
                btn.draggable = true;
                btn.setAttribute('data-word', word);
                btn.innerHTML = `
                    <span>${word}</span>
                    <i class="fa-solid fa-volume-low text-xs text-amber-700/60 hover:text-amber-900" onclick="event.stopPropagation(); speakText('${word}');"></i>
                `;

                // Click to select mode
                btn.onclick = () => {
                    playTone(400, 'sine', 0.05);
                    selectedMaterialTag = selectedMaterialTag === word ? null : word;
                    renderWordBank();
                };

                // Drag support
                btn.ondragstart = (e) => {
                    e.dataTransfer.setData('text/plain', word);
                };

                container.appendChild(btn);
            });
        }

        function renderWorksheetCards() {
            const grid = document.getElementById('worksheetGrid');
            grid.innerHTML = '';

            VOCAB_DATA.forEach(item => {
                const userChoice = worksheetUserAnswers[item.id] || '';

                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border-2 border-slate-200 p-4 shadow-sm flex flex-col items-center justify-between hover:border-slate-300 transition relative';
                
                // Card header number & audio speaker
                card.innerHTML = `
                    <div class="w-full flex justify-between items-center mb-2">
                        <span class="font-extrabold text-slate-400 text-sm">${item.number}</span>
                        <button onclick="speakText('${item.fullPhrase}')" class="text-slate-400 hover:text-indigo-600 transition" title="Listen to phrase">
                            <i class="fa-solid fa-volume-high text-sm"></i>
                        </button>
                    </div>

                    <!-- SVG Illustration -->
                    <div class="w-28 h-28 my-2 flex items-center justify-center p-1 bg-slate-50 rounded-xl border border-slate-100">
                        ${item.svg}
                    </div>

                    <!-- Input Blank Line -->
                    <div class="w-full mt-3 pt-3 border-t border-slate-100 text-center">
                        <div class="inline-flex items-center flex-wrap justify-center font-extrabold text-slate-800 text-base gap-1.5">
                            ${item.article ? `<span>${item.article}</span>` : ''}
                            
                            <!-- Drop Zone / Target Slot -->
                            <div id="dropzone-${item.id}" 
                                 onclick="handleDropzoneClick(${item.id})"
                                 ondragover="handleDragOver(event)"
                                 ondragleave="handleDragLeave(event)"
                                 ondrop="handleDrop(event, ${item.id})"
                                 class="min-w-[85px] h-9 px-3 border-b-2 border-dashed border-indigo-400 bg-indigo-50/50 rounded-lg flex items-center justify-center cursor-pointer text-indigo-700 font-extrabold transition hover:bg-indigo-100/60">
                                ${userChoice ? `<span class="bg-indigo-600 text-white px-2.5 py-0.5 rounded-md text-sm shadow-sm">${userChoice}</span>` : '<span class="text-slate-400 text-xs font-normal">blank</span>'}
                            </div>

                            <span>${item.item}</span>
                        </div>
                    </div>

                    <!-- Feedback message container -->
                    <div id="feedback-${item.id}" class="w-full text-center mt-2 text-xs font-bold hidden"></div>
                `;

                grid.appendChild(card);
            });
        }

        function handleDropzoneClick(itemId) {
            if (selectedMaterialTag) {
                playTone(550, 'sine', 0.08);
                worksheetUserAnswers[itemId] = selectedMaterialTag;
                selectedMaterialTag = null; // reset selection after placement
                renderWordBank();
                renderWorksheetCards();
            } else if (worksheetUserAnswers[itemId]) {
                // Clear blank on tap
                delete worksheetUserAnswers[itemId];
                renderWorksheetCards();
            }
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        function handleDragLeave(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        function handleDrop(e, itemId) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            const word = e.dataTransfer.getData('text/plain');
            if (MATERIAL_WORDS.includes(word)) {
                playTone(550, 'sine', 0.08);
                worksheetUserAnswers[itemId] = word;
                renderWorksheetCards();
            }
        }

        function checkWorksheetAnswers() {
            let correctCount = 0;

            VOCAB_DATA.forEach(item => {
                const userChoice = worksheetUserAnswers[item.id];
                const feedbackDiv = document.getElementById(`feedback-${item.id}`);
                const dropzone = document.getElementById(`dropzone-${item.id}`);

                if (!feedbackDiv || !dropzone) return;

                feedbackDiv.classList.remove('hidden');

                if (userChoice === item.material) {
                    correctCount++;
                    feedbackDiv.className = 'w-full text-center mt-2 text-xs font-bold text-emerald-600 bg-emerald-50 py-1 rounded-md border border-emerald-200';
                    feedbackDiv.innerHTML = '<i class="fa-solid fa-check mr-1"></i> Correct!';
                    dropzone.className = 'min-w-[85px] h-9 px-3 border-2 border-emerald-500 bg-emerald-100 rounded-lg flex items-center justify-center font-extrabold text-emerald-800';
                } else {
                    feedbackDiv.className = 'w-full text-center mt-2 text-xs font-bold text-rose-600 bg-rose-50 py-1 rounded-md border border-rose-200';
                    feedbackDiv.innerHTML = `<i class="fa-solid fa-xmark mr-1"></i> Answer: <strong>${item.material}</strong>`;
                    dropzone.className = 'min-w-[85px] h-9 px-3 border-2 border-rose-400 bg-rose-100 rounded-lg flex items-center justify-center font-extrabold text-rose-800';
                }
            });

            if (correctCount === VOCAB_DATA.length) {
                playFanfareSound();
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
                updateScore(100);
            } else if (correctCount > 0) {
                playCorrectSound();
                updateScore(correctCount * 10);
            } else {
                playIncorrectSound();
            }
        }

        function resetWorksheet() {
            playTone(300, 'sine', 0.1);
            worksheetUserAnswers = {};
            selectedMaterialTag = null;
            renderWordBank();
            renderWorksheetCards();
        }

        function updateFlashcardUI() {
            const item = VOCAB_DATA[currentFlashcardIdx];
            
            document.getElementById('cardProgressText').innerText = `${currentFlashcardIdx + 1} / ${VOCAB_DATA.length}`;
            document.getElementById('cardCategoryBadge').innerText = item.plural ? "CLOTHING / PLURAL" : "CLOTHING / ACCESSORY";
            document.getElementById('cardFrontSvgContainer').innerHTML = item.svg;
            document.getElementById('cardFrontItemTitle').innerText = item.article ? `${item.article} ${item.item}` : item.item;

            document.getElementById('cardBackMaterialWord').innerText = item.material.toUpperCase();
            document.getElementById('cardBackPhonetic').innerText = item.phonetic;
            document.getElementById('cardBackSentence').innerText = `"${item.fullPhrase}"`;

            // Reset card flip to front when switching cards
            document.getElementById('flashcardInner').classList.remove('is-flipped');
        }

        function flipCurrentCard() {
            playTone(450, 'sine', 0.05);
            const inner = document.getElementById('flashcardInner');
            inner.classList.toggle('is-flipped');
        }

        function nextCard() {
            playTone(500, 'sine', 0.05);
            currentFlashcardIdx = (currentFlashcardIdx + 1) % VOCAB_DATA.length;
            updateFlashcardUI();
        }

        function prevCard() {
            playTone(500, 'sine', 0.05);
            currentFlashcardIdx = (currentFlashcardIdx - 1 + VOCAB_DATA.length) % VOCAB_DATA.length;
            updateFlashcardUI();
        }

        function speakCurrentCardWord() {
            const item = VOCAB_DATA[currentFlashcardIdx];
            speakText(item.material);
        }

        function speakCurrentCardSentence() {
            const item = VOCAB_DATA[currentFlashcardIdx];
            speakText(item.fullPhrase);
        }

        function initQuiz() {
            quizState.score = 0;
            quizState.streak = 0;
            quizState.currentQuestion = 0;
            
            // Generate shuffled questions based on vocabulary
            const shuffleList = [...VOCAB_DATA].sort(() => Math.random() - 0.5);
            quizState.questions = shuffleList.map(item => {
                // Generate 3 wrong distractors from other materials
                const distractors = MATERIAL_WORDS.filter(m => m !== item.material).sort(() => Math.random() - 0.5).slice(0, 3);
                const options = [item.material, ...distractors].sort(() => Math.random() - 0.5);
                return {
                    itemData: item,
                    correctAnswer: item.material,
                    options: options
                };
            });

            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            const overlay = document.getElementById('quizFeedbackOverlay');
            const nextBtnContainer = document.getElementById('quizNextBtnContainer');
            overlay.classList.add('hidden');
            nextBtnContainer.classList.add('hidden');

            const qData = quizState.questions[quizState.currentQuestion];
            if (!qData) {
                showQuizResults();
                return;
            }

            document.getElementById('quizQuestionCount').innerText = `Question ${quizState.currentQuestion + 1} of ${quizState.questions.length}`;
            document.getElementById('quizStreakText').innerText = `🔥 ${quizState.streak}`;
            document.getElementById('quizScoreText').innerText = `${quizState.score} pts`;

            document.getElementById('quizSvgBox').innerHTML = qData.itemData.svg;
            
            const itemText = qData.itemData.article ? `${qData.itemData.article} ${qData.itemData.item}` : qData.itemData.item;
            document.getElementById('quizQuestionText').innerText = `What material is ${itemText} made of?`;

            const optionsGrid = document.getElementById('quizOptionsGrid');
            optionsGrid.innerHTML = '';

            qData.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = 'quiz-opt-btn p-4 bg-slate-100 hover:bg-indigo-50 hover:border-indigo-300 border-2 border-slate-200 rounded-xl font-extrabold text-slate-800 text-lg transition transform active:scale-98 capitalize text-center';
                btn.innerText = opt;
                btn.onclick = () => handleQuizAnswer(opt, btn);
                optionsGrid.appendChild(btn);
            });
        }

        function handleQuizAnswer(selectedOption, clickedBtn) {
            const qData = quizState.questions[quizState.currentQuestion];
            const isCorrect = selectedOption === qData.correctAnswer;
            
            // Disable option buttons
            document.querySelectorAll('.quiz-opt-btn').forEach(btn => btn.disabled = true);

            const overlay = document.getElementById('quizFeedbackOverlay');
            overlay.classList.remove('hidden');

            if (isCorrect) {
                playCorrectSound();
                quizState.streak++;
                const pointsEarned = 15 + (quizState.streak * 5);
                quizState.score += pointsEarned;
                updateScore(pointsEarned);

                clickedBtn.className = 'quiz-opt-btn p-4 bg-emerald-500 text-white border-2 border-emerald-600 rounded-xl font-extrabold text-lg capitalize text-center';
                overlay.className = 'my-4 p-4 rounded-xl text-center font-extrabold text-lg bg-emerald-100 text-emerald-800 border border-emerald-300';
                overlay.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-2"></i> Excellent! +${pointsEarned} pts`;
            } else {
                playIncorrectSound();
                quizState.streak = 0;
                clickedBtn.className = 'quiz-opt-btn p-4 bg-rose-500 text-white border-2 border-rose-600 rounded-xl font-extrabold text-lg capitalize text-center';
                
                // Highlight correct option
                document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
                    if (btn.innerText.trim().toLowerCase() === qData.correctAnswer) {
                        btn.className = 'quiz-opt-btn p-4 bg-emerald-100 text-emerald-800 border-2 border-emerald-500 rounded-xl font-extrabold text-lg capitalize text-center';
                    }
                });

                overlay.className = 'my-4 p-4 rounded-xl text-center font-extrabold text-lg bg-rose-100 text-rose-800 border border-rose-300';
                overlay.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-600 mr-2"></i> Oops! It's made of <strong>${qData.correctAnswer}</strong>.`;
            }

            document.getElementById('quizNextBtnContainer').classList.remove('hidden');
        }

        function nextQuizQuestion() {
            quizState.currentQuestion++;
            if (quizState.currentQuestion < quizState.questions.length) {
                renderQuizQuestion();
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            playFanfareSound();
            confetti({ particleCount: 120, spread: 80, origin: { y: 0.5 } });

            const card = document.getElementById('quizCardContainer');
            card.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-20 h-20 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto text-4xl mb-4 shadow-inner">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <h3 class="text-2xl font-black text-slate-800">Quiz Completed!</h3>
                    <p class="text-slate-600 text-sm mt-1">You earned a total score of:</p>
                    <div class="text-4xl font-black text-indigo-600 my-4">${quizState.score} Points</div>
                    
                    <button onclick="initQuiz();" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold rounded-xl shadow-md transition">
                        <i class="fa-solid fa-rotate-right mr-2"></i> Play Again
                    </button>
                </div>
            `;
        }

        function initSpeakingPartner() {
            const selector = document.getElementById('speakingItemSelector');
            selector.innerHTML = '';

            VOCAB_DATA.forEach((item, idx) => {
                const btn = document.createElement('button');
                const isActive = activeSpeakingIdx === idx;
                btn.className = `px-3.5 py-2 rounded-xl text-xs font-extrabold transition flex items-center space-x-1.5 ${
                    isActive 
                    ? 'bg-indigo-600 text-white shadow-sm' 
                    : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
                }`;
                btn.innerHTML = `<span>${item.number} ${item.item}</span>`;
                btn.onclick = () => {
                    playTone(400, 'sine', 0.05);
                    activeSpeakingIdx = idx;
                    initSpeakingPartner();
                };
                selector.appendChild(btn);
            });

            const current = VOCAB_DATA[activeSpeakingIdx];
            document.getElementById('speakerTextA').innerText = `"${current.questionA}"`;
            document.getElementById('speakerTextB').innerText = `"${current.answerB}"`;
            document.getElementById('speakingSvgPreview').innerHTML = current.svg;
        }

        // Global Score Manager
        function updateScore(pts) {
            globalScore += pts;
            document.getElementById('globalScoreDisplay').innerText = `Score: ${globalScore}`;
        }

        window.onload = function() {
            initWorksheet();
            updateFlashcardUI();
            initSpeakingPartner();
        };
    </script>
