<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fashion & Materials: What's It Made Of?</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Fredoka', 'cursive'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        accent: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .draggable-item {
            touch-action: none;
            user-select: none;
        }
        @keyframes pulse-subtle {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .animate-pulse-subtle {
            animation: pulse-subtle 2s infinite ease-in-out;
        }
        @keyframes bounce-short {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }
        .animate-bounce-short {
            animation: bounce-short 1s infinite;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col selection:bg-indigo-100 selection:text-indigo-700">

    <!-- Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-gradient-to-tr from-indigo-600 to-violet-500 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-indigo-200 transform -rotate-3">
                        <i class="fa-solid fa-shirt text-2xl"></i>
                    </div>
                    <div>
                        <span class="inline-block px-2.5 py-0.5 text-xs font-bold bg-indigo-100 text-indigo-700 rounded-full mb-0.5">A1-A2 Beginner ESL</span>
                        <h1 class="text-xl sm:text-2xl font-bold font-display text-slate-900 tracking-tight">Fashion & Materials</h1>
                    </div>
                </div>

                <!-- Global Audio Settings & Score Badge -->
                <div class="flex items-center space-x-3 sm:space-x-4">
                    <div class="hidden sm:flex items-center bg-slate-100 px-3 py-1.5 rounded-xl text-sm font-medium text-slate-600">
                        <i class="fa-solid fa-gauge-high mr-2 text-indigo-500"></i>
                        <span class="mr-2">Speech:</span>
                        <select id="tts-speed" class="bg-transparent font-semibold text-indigo-700 focus:outline-none cursor-pointer">
                            <option value="0.75">Slow (0.75x)</option>
                            <option value="1.0" selected>Normal (1.0x)</option>
                            <option value="1.2">Fast (1.2x)</option>
                        </select>
                    </div>

                    <button id="toggle-audio-btn" onclick="toggleMute()" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition" title="Toggle Sound FX">
                        <i id="audio-icon" class="fa-solid fa-volume-high text-lg"></i>
                    </button>

                    <div class="bg-amber-50 border border-amber-200 text-amber-800 px-3 py-1.5 rounded-xl flex items-center space-x-2 font-bold shadow-sm">
                        <i class="fa-solid fa-star text-amber-500 text-base"></i>
                        <span id="global-score">Score: 0/100</span>
                    </div>
                </div>
            </div>

            <!-- Main Navigation Tabs -->
            <nav class="flex space-x-1 sm:space-x-4 overflow-x-auto custom-scrollbar py-2 border-t border-slate-100">
                <button onclick="switchTab('word-power')" id="tab-btn-word-power" class="tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-100">
                    <i class="fa-solid fa-scissors mr-2.5 text-base"></i>
                    <span>🧵 1. Word Power</span>
                    <span id="badge-word-power" class="ml-2 bg-indigo-500 text-white text-xs px-2 py-0.5 rounded-full hidden">0/8</span>
                </button>

                <button onclick="switchTab('grammar')" id="tab-btn-grammar" class="tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 text-slate-600 hover:bg-slate-100">
                    <i class="fa-solid fa-scale-balanced mr-2.5 text-base text-violet-500"></i>
                    <span>⚖️ 2. Comparatives</span>
                    <span id="badge-grammar" class="ml-2 bg-violet-100 text-violet-700 text-xs px-2 py-0.5 rounded-full hidden">0/6</span>
                </button>

                <button onclick="switchTab('roleplay')" id="tab-btn-roleplay" class="tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 text-slate-600 hover:bg-slate-100">
                    <i class="fa-solid fa-comments mr-2.5 text-base text-emerald-500"></i>
                    <span>🛍️ 3. Boutique Speaking</span>
                </button>

                <button onclick="switchTab('scavenger')" id="tab-btn-scavenger" class="tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 text-slate-600 hover:bg-slate-100">
                    <i class="fa-solid fa-magnifying-glass mr-2.5 text-base text-amber-500"></i>
                    <span>🔍 4. Scavenger Hunt</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

        <!-- TAB 1: WORD POWER (MATERIALS) -->
        <section id="tab-word-power" class="tab-content space-y-6">
            <!-- Instruction Banner -->
            <div class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 opacity-15 text-9xl pointer-events-none">
                    <i class="fa-solid fa-tags"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
                    <div class="flex items-center space-x-2 text-indigo-100 font-semibold text-xs tracking-wider uppercase mb-2">
                        <i class="fa-solid fa-lightbulb"></i>
                        <span>Vocabulary Building</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold font-display mb-2">What are these things made of?</h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Match each clothing item or accessory with its correct material. Click a word from the Word Bank, then click the correct picture slot!
                    </p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <button onclick="speakText('What are these things made of? Label each item with words from the list.')" class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs font-semibold transition">
                            <i class="fa-solid fa-volume-high mr-2"></i> Listen Instructions
                        </button>
                        <button onclick="resetWordPower()" class="inline-flex items-center px-3.5 py-1.5 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white text-xs font-semibold transition">
                            <i class="fa-solid fa-rotate-left mr-2"></i> Reset Activity
                        </button>
                    </div>
                </div>
            </div>

            <!-- Word Bank Card -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center">
                        <i class="fa-solid fa-box-archive mr-2 text-indigo-500"></i> Word Bank (Materials)
                    </h3>
                    <span class="text-xs text-slate-400">Click a word to select, then click an image slot</span>
                </div>
                <div id="word-bank-container" class="flex flex-wrap gap-2 sm:gap-3">
                    <!-- Word pills rendered via JS -->
                </div>
            </div>

            <!-- 8 Interactive Item Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" id="materials-grid">
                <!-- Item 1: Silk tie -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="1" data-answer="silk">
                    <button onclick="speakText('A silk tie')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-indigo-50/50 rounded-2xl p-2">
                        <!-- Silk Tie SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M42 15L58 15L54 30L46 30L42 15Z" fill="#1E3A8A"/>
                            <path d="M46 30L54 30L62 70L50 88L38 70L46 30Z" fill="#2563EB"/>
                            <path d="M46 30L50 88L38 70L46 30Z" fill="#1D4ED8"/>
                            <path d="M42 15L58 15L56 22L44 22L42 15Z" fill="#3B82F6"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #1</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">1. a</span>
                            <div onclick="selectSlot(1)" id="slot-1" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">tie</span>
                        </div>
                    </div>
                    <div id="feedback-1" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 2: Gold bracelet -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="2" data-answer="gold">
                    <button onclick="speakText('A gold bracelet')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-amber-50/50 rounded-2xl p-2">
                        <!-- Gold Bracelet SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <ellipse cx="50" cy="50" rx="32" ry="20" stroke="#D97706" stroke-width="10" fill="none"/>
                            <ellipse cx="50" cy="50" rx="32" ry="20" stroke="#F59E0B" stroke-width="6" fill="none"/>
                            <circle cx="28" cy="42" r="3" fill="#FEF3C7"/>
                            <circle cx="72" cy="58" r="3" fill="#FEF3C7"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #2</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">2. a</span>
                            <div onclick="selectSlot(2)" id="slot-2" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">bracelet</span>
                        </div>
                    </div>
                    <div id="feedback-2" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 3: Silver ring -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="3" data-answer="silver">
                    <button onclick="speakText('A silver ring')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-slate-100/60 rounded-2xl p-2">
                        <!-- Silver Ring SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="50" cy="50" r="24" stroke="#94A3B8" stroke-width="8" fill="none"/>
                            <circle cx="50" cy="50" r="24" stroke="#CBD5E1" stroke-width="4" fill="none"/>
                            <path d="M42 28L50 20L58 28" stroke="#E2E8F0" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #3</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">3. a</span>
                            <div onclick="selectSlot(3)" id="slot-3" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">ring</span>
                        </div>
                    </div>
                    <div id="feedback-3" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 4: Cotton shirt -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="4" data-answer="cotton">
                    <button onclick="speakText('A cotton shirt')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-sky-50/50 rounded-2xl p-2">
                        <!-- Cotton Shirt SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M30 25L42 32L50 26L58 32L70 25L82 40L72 46L72 80L28 80L28 46L18 40L30 25Z" fill="#38BDF8"/>
                            <path d="M42 32L50 48L58 32L50 26L42 32Z" fill="#0284C7"/>
                            <circle cx="50" cy="56" r="1.5" fill="white"/>
                            <circle cx="50" cy="66" r="1.5" fill="white"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #4</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">4. a</span>
                            <div onclick="selectSlot(4)" id="slot-4" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">shirt</span>
                        </div>
                    </div>
                    <div id="feedback-4" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 5: Leather belt -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="5" data-answer="leather">
                    <button onclick="speakText('A leather belt')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-amber-900/5 rounded-2xl p-2">
                        <!-- Leather Belt SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15 45C15 45 35 35 60 40C80 44 85 60 70 70C55 80 25 70 25 70" stroke="#78350F" stroke-width="12" stroke-linecap="round" fill="none"/>
                            <rect x="18" y="38" width="16" height="18" rx="2" fill="#CBD5E1" stroke="#64748B" stroke-width="2"/>
                            <rect x="22" y="42" width="8" height="10" fill="#78350F"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #5</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">5. a</span>
                            <div onclick="selectSlot(5)" id="slot-5" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">belt</span>
                        </div>
                    </div>
                    <div id="feedback-5" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 6: Plastic earrings -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="6" data-answer="plastic">
                    <button onclick="speakText('Plastic earrings')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-blue-50/50 rounded-2xl p-2">
                        <!-- Plastic Earrings SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <!-- Hook 1 -->
                            <path d="M38 25C38 20 42 18 44 22L44 35" stroke="#94A3B8" stroke-width="2" fill="none"/>
                            <ellipse cx="44" cy="55" rx="10" ry="16" fill="#2563EB"/>
                            <!-- Hook 2 -->
                            <path d="M58 25C58 20 62 18 64 22L64 35" stroke="#94A3B8" stroke-width="2" fill="none"/>
                            <ellipse cx="64" cy="55" rx="10" ry="16" fill="#3B82F6"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #6</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">6.</span>
                            <div onclick="selectSlot(6)" id="slot-6" class="drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center">
                                <span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>
                            </div>
                            <span class="text-sm font-bold text-slate-800">earrings</span>
                        </div>
                    </div>
                    <div id="feedback-6" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 7: Rubber flip-flops -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="7" data-answer="rubber">
                    <button onclick="speakText('Rubber flip flops')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
                    </button>
                    <div class="w-28 h-28 my-2 flex items-center justify-center bg-yellow-50/50 rounded-2xl p-2">
                        <!-- Rubber Flip Flops SVG -->
                        <svg class="w-20 h-20 drop-shadow-sm" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <ellipse cx="38" cy="55" rx="12" ry="25" fill="#FACC15" transform="rotate(-10 38 55)"/>
                            <ellipse cx="62" cy="55" rx="12" ry="25" fill="#FACC15" transform="rotate(10 62 55)"/>
                            <path d="M30 48L37 58L44 48" stroke="#EF4444" stroke-width="3" fill="none"/>
                            <path d="M54 48L61 58L68 48" stroke="#EF4444" stroke-width="3" fill="none"/>
                        </svg>
                    </div>
                    <div class="w-full mt-2">
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wide">Item #7</span>
                        <div class="flex items-center justify-center space-x-1.5 mt-1">
                            <span class="text-sm font-semibold text-slate-700">7.</span>
