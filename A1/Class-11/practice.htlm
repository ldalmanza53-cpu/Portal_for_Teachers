                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                        <div class="lg:col-span-4 bg-slate-50 rounded-2xl p-4 flex flex-col items-center text-center">
                            <div class="flex space-x-4 mb-2">
                                <div class="text-center">
                                    <div class="w-16 h-16 bg-slate-300 rounded-xl flex items-center justify-center text-2xl">👔</div>
                                    <span class="text-xs font-semibold text-slate-600">Grey</span>
                                </div>
                                <div class="text-center">
                                    <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">👕</div>
                                    <span class="text-xs font-semibold text-slate-600">Brown/Orange</span>
                                </div>
                            </div>
                            <span class="text-xs text-slate-500">Adjectives: <strong class="text-slate-700">pretty</strong>, <strong class="text-slate-700">attractive</strong></span>
                        </div>

