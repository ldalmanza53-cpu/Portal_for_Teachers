                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider flex items-center">
                                        <i class="fa-solid fa-circle-user mr-1.5 text-indigo-500"></i> Student A (Asks Question)
                                    </span>
                                    <button onclick="speakText(document.getElementById('rp-line-a').innerText)" class="w-7 h-7 rounded-lg bg-white text-indigo-600 border border-slate-200 hover:bg-indigo-50 flex items-center justify-center transition" title="Listen A">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </div>
                                <p id="rp-line-a" class="text-sm font-semibold text-slate-800">Which of these jackets do you like more?</p>
                            </div>

                            <!-- Student B Bubble -->
                            <div class="bg-emerald-50/60 p-4 rounded-2xl border border-emerald-200/80 relative">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider flex items-center">
                                        <i class="fa-solid fa-circle-user mr-1.5 text-emerald-600"></i> Student B (Gives Opinion)
                                    </span>
                                    <button onclick="speakText(document.getElementById('rp-line-b').innerText)" class="w-7 h-7 rounded-lg bg-white text-emerald-600 border border-emerald-200 hover:bg-emerald-100 flex items-center justify-center transition" title="Listen B">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </div>
                                <p id="rp-line-b" class="text-sm font-semibold text-slate-800">I prefer the leather one. The design is nicer and it looks more expensive than the wool one.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Custom Sentence Builder for Beginners -->
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-3">
                        <div class="text-xs font-bold text-slate-600 uppercase tracking-wide flex items-center">
                            <i class="fa-solid fa-wand-magic-sparkles mr-2 text-emerald-500"></i> Build Your Own Opinion Frame
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                            <span>I prefer the</span>
                            <select id="builder-item" class="bg-white border border-slate-300 rounded-lg px-2 py-1 font-bold text-indigo-600 focus:outline-none">
                                <option value="leather jacket">leather jacket</option>
                                <option value="wool sweater">wool sweater</option>
                                <option value="silver ring">silver ring</option>
                                <option value="silk tie">silk tie</option>
                            </select>
                            <span>because the</span>
                            <select id="builder-aspect" class="bg-white border border-slate-300 rounded-lg px-2 py-1 font-bold text-emerald-600 focus:outline-none">
                                <option value="material">material</option>
                                <option value="color">color</option>
                                <option value="design">design</option>
                                <option value="style">style</option>
                            </select>
                            <span>is</span>
                            <select id="builder-adj" class="bg-white border border-slate-300 rounded-lg px-2 py-1 font-bold text-violet-600 focus:outline-none">
                                <option value="nicer">nicer</option>
                                <option value="prettier">prettier</option>
                                <option value="more attractive">more attractive</option>
                                <option value="better">better</option>
                            </select>
                        </div>
                        <div class="pt-2 flex justify-end">
                            <button onclick="speakCustomSentence()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs transition flex items-center space-x-1.5">
                                <i class="fa-solid fa-volume-high"></i>
                                <span>Speak Custom Opinion</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 4: CLASSROOM SCAVENGER HUNT -->
        <section id="tab-scavenger" class="tab-content hidden space-y-6">
            <!-- Game Header Banner -->
            <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
                <div class="max-w-2xl space-y-2 relative z-10">
                    <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider text-amber-100">Interactive Game</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold font-display">Material Scavenger Hunt!</h2>
                    <p class="text-amber-100 text-sm">
                        Find items around the virtual classroom that are made of target materials before time runs out!
                    </p>
                </div>
            </div>

            <!-- Game Arena Card -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-6">
                <!-- Game Dashboard -->
                <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100">
                    <div>
                        <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Target Material</div>
                        <div id="hunt-target-material" class="text-2xl font-black text-amber-600 uppercase font-display tracking-wide">
                            ???
                        </div>
                    </div>

                    <div class="flex items-center space-x-6">
                        <div class="text-center">
                            <div class="text-xs text-slate-400 font-bold uppercase">Time Left</div>
                            <div id="hunt-timer" class="text-2xl font-black text-slate-800 font-display">30s</div>
                        </div>
                        <div class="text-center">
                            <div class="text-xs text-slate-400 font-bold uppercase">Found</div>
                            <div id="hunt-found-count" class="text-2xl font-black text-emerald-600 font-display">0/5</div>
                        </div>
                        <button id="start-hunt-btn" onclick="startScavengerHunt()" class="px-6 py-3 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-extrabold text-sm shadow-md shadow-amber-200 transition flex items-center space-x-2">
                            <i class="fa-solid fa-play"></i>
                            <span>Start Challenge</span>
                        </button>
                    </div>
                </div>

                <!-- Virtual Classroom Item Grid -->
                <div id="hunt-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                    <!-- JS renders clickable classroom items -->
                </div>
            </div>

            <!-- Classroom Real-Life Mission Prompts -->
            <div class="bg-slate-900 rounded-3xl p-6 text-white shadow-xl space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-slate-900 font-bold flex items-center justify-center text-lg">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-base font-display text-white">Classroom Physical Scavenger Hunt</h3>
                            <p class="text-xs text-slate-400">Point to or name real things around your classroom!</p>
                        </div>
                    </div>
                    <button onclick="generateRandomMission()" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-shuffle"></i>
                        <span>New Mission</span>
                    </button>
                </div>

                <div id="real-mission-card" class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center justify-between">
                    <div class="space-y-1">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Active Mission</span>
                        <p id="real-mission-text" class="text-sm font-semibold text-slate-200">
                            "Find something made of <strong class="text-amber-300">PLASTIC</strong> in your classroom or bag!"
                        </p>
                    </div>
                    <button onclick="speakText(document.getElementById('real-mission-text').innerText)" class="w-10 h-10 rounded-xl bg-amber-500 text-slate-900 font-bold flex items-center justify-center hover:bg-amber-400 transition" title="Listen Mission">
                        <i class="fa-solid fa-volume-high"></i>
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- Feedback Modal / Toast Notification -->
    <div id="toast-modal" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toast-body" class="bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center space-x-3 border border-slate-700">
            <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
            <span id="toast-text" class="text-sm font-bold">Great job! That's correct.</span>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Global Application State
        const state = {
            activeTab: 'word-power',
            selectedMaterial: null,
            isMuted: false,
            score: 0,
            wordPowerMatches: {},
            grammarCompleted: false,
            huntActive: false,
            huntTimer: null,
            huntTimeLeft: 30,
            huntFound: 0,
            currentTargetMaterial: ''
        };

        // Word Bank options
        const materialsList = ['cotton', 'gold', 'leather', 'plastic', 'rubber', 'silk', 'silver', 'wool'];

        // Roleplay Topics Data
        const roleplayTopics = [
            {
                title: "Leather vs. Wool Jacket",
                lineA: "Which of these jackets do you like more?",
                lineB: "I prefer the leather one. The design is nicer and it looks more expensive than the wool one."
            },
            {
                title: "Grey vs. Orange Sweater",
                lineA: "These sweaters are nice. Which one do you prefer?",
                lineB: "I like the grey one better. The color is prettier and it's more attractive than the orange one."
            },
            {
                title: "Silver vs. Gold Rings",
                lineA: "Which rings do you like better?",
                lineB: "I like the silver ones more. They're smaller than the gold ones, and they're cheaper."
            },
            {
                title: "Cotton vs. Silk Shirt",
                lineA: "Which shirt do you like more?",
                lineB: "I prefer the cotton one because it's softer and more comfortable than the silk shirt."
            }
        ];

        // Scavenger Hunt Classroom Objects
        const classroomObjects = [
            { id: 'item-1', name: 'Water Bottle', material: 'plastic', icon: '🥤' },
            { id: 'item-2', name: 'Warm Scarf', material: 'wool', icon: '🧣' },
            { id: 'item-3', name: 'Golden Watch', material: 'gold', icon: '⌚' },
            { id: 'item-4', name: 'Leather Boots', material: 'leather', icon: '👢' },
            { id: 'item-5', name: 'Eraser', material: 'rubber', icon: '🧽' },
            { id: 'item-6', name: 'Silver Keys', material: 'silver', icon: '🔑' },
            { id: 'item-7', name: 'Cotton T-Shirt', material: 'cotton', icon: '👕' },
            { id: 'item-8', name: 'Silk Ribbon', material: 'silk', icon: '🎗️' },
            { id: 'item-9', name: 'Plastic Ruler', material: 'plastic', icon: '📏' },
            { id: 'item-10', name: 'Leather Backpack', material: 'leather', icon: '🎒' }
        ];

        // Web Audio API Synthesizer for sound FX
        let audioCtx = null;
        function playFX(type) {
            if (state.isMuted) return;
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(400, now);
                    gain.gain.setValueAtTime(0.05, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (type === 'correct') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.setValueAtTime(180, now + 0.1);
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                    osc.start(now);
                    osc.stop(now + 0.25);
                } else if (type === 'win') {
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.frequency.setValueAtTime(freq, now + idx * 0.1);
                        g.gain.setValueAtTime(0.08, now + idx * 0.1);
                        g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.2);
                        o.start(now + idx * 0.1);
                        o.stop(now + idx * 0.1 + 0.2);
                    });
                }
            } catch (e) {
                console.log("Audio FX suppressed", e);
            }
        }

        // Speech Synthesis Helper
        function speakText(text) {
            if (!('speechSynthesis' in window)) {
                showToast("Speech synthesis not supported in browser", "wrong");
                return;
            }
            window.speechSynthesis.cancel(); // Stop current
            const utterance = new SpeechSynthesisUtterance(text);
            const speed = parseFloat(document.getElementById('tts-speed').value) || 1.0;
            utterance.rate = speed;
            utterance.lang = 'en-US';
            window.speechSynthesis.speak(utterance);
        }

        function toggleMute() {
            state.isMuted = !state.isMuted;
            const icon = document.getElementById('audio-icon');
            if (state.isMuted) {
                icon.className = 'fa-solid fa-volume-xmark text-lg text-rose-500';
                showToast("Sound FX Muted", "info");
            } else {
                icon.className = 'fa-solid fa-volume-high text-lg text-slate-600';
                showToast("Sound FX Unmuted", "correct");
                playFX('click');
            }
        }

        // Tab Switcher
        function switchTab(tabId) {
            playFX('click');
            state.activeTab = tabId;

            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 text-slate-600 hover:bg-slate-100";
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-btn-${tabId}`);
            activeBtn.className = "tab-btn inline-flex items-center px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-100";
        }

        // Render Word Bank Items
        function renderWordBank() {
            const container = document.getElementById('word-bank-container');
            container.innerHTML = '';
            materialsList.forEach(mat => {
                const isUsed = Object.values(state.wordPowerMatches).includes(mat);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `px-3.5 py-2 rounded-xl text-xs font-extrabold uppercase tracking-wider transition flex items-center space-x-1.5 ${
                    isUsed ? 'bg-slate-100 text-slate-400 cursor-not-allowed opacity-50' : 
                    state.selectedMaterial === mat ? 'bg-indigo-600 text-white shadow-md shadow-indigo-200 ring-2 ring-indigo-400' :
                    'bg-slate-100 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600'
                }`;
                btn.innerHTML = `<span>${mat}</span> <i class="fa-solid fa-volume-high ml-1 text-[10px] opacity-70" onclick="event.stopPropagation(); speakText('${mat}')"></i>`;
                if (!isUsed) {
                    btn.onclick = () => selectMaterial(mat);
                }
                container.appendChild(btn);
            });
        }

        function selectMaterial(mat) {
            playFX('click');
            if (state.selectedMaterial === mat) {
                state.selectedMaterial = null;
            } else {
                state.selectedMaterial = mat;
            }
            renderWordBank();
        }

        function selectSlot(slotId) {
            if (!state.selectedMaterial) {
                showToast("Click a material from the Word Bank first!", "wrong");
                return;
            }
            playFX('click');
            state.wordPowerMatches[slotId] = state.selectedMaterial;
            
            const slotEl = document.getElementById(`slot-${slotId}`);
            slotEl.innerHTML = `<span class="text-indigo-700 uppercase font-black tracking-wide">${state.selectedMaterial}</span>`;
            slotEl.classList.remove('border-dashed', 'border-slate-300', 'bg-slate-50');
            slotEl.classList.add('border-solid', 'border-indigo-400', 'bg-indigo-50/80');

            state.selectedMaterial = null;
            renderWordBank();
        }

        function checkWordPowerAnswers() {
            let correctCount = 0;
            const total = 8;

            for (let i = 1; i <= total; i++) {
                const card = document.querySelector(`.material-card[data-id="${i}"]`);
                const answer = card.dataset.answer;
                const userMatch = state.wordPowerMatches[i];
                const feedbackEl = document.getElementById(`feedback-${i}`);

                feedbackEl.classList.remove('hidden', 'text-emerald-600', 'text-rose-600');

                if (userMatch === answer) {
                    correctCount++;
                    card.classList.remove('border-slate-200', 'border-rose-300');
                    card.classList.add('border-emerald-400', 'bg-emerald-50/20');
                    feedbackEl.classList.add('text-emerald-600');
                    feedbackEl.innerHTML = `<i class="fa-solid fa-check mr-1"></i> Correct!`;
                } else {
                    card.classList.remove('border-slate-200', 'border-emerald-400');
                    card.classList.add('border-rose-300', 'bg-rose-50/20');
                    feedbackEl.classList.add('text-rose-600');
                    feedbackEl.innerHTML = `<i class="fa-solid fa-xmark mr-1"></i> ${userMatch ? 'Try again' : 'Missing'}`;
                }
            }

            if (correctCount === total) {
                playFX('win');
                updateScore(40);
                showToast("Perfect! All 8 materials correctly labeled!", "correct");
                document.getElementById('badge-word-power').innerText = "8/8";
                document.getElementById('badge-word-power').classList.remove('hidden');
            } else {
                playFX('wrong');
                showToast(`You got ${correctCount}/${total} correct. Keep trying!`, "wrong");
            }
        }

        function resetWordPower() {
            playFX('click');
            state.wordPowerMatches = {};
            state.selectedMaterial = null;
            for (let i = 1; i <= 8; i++) {
                const slotEl = document.getElementById(`slot-${i}`);
                slotEl.innerHTML = `<span class="placeholder-text text-slate-400 font-normal text-xs">select material</span>`;
                slotEl.className = "drop-slot min-w-[100px] px-3 py-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-slate-700 font-bold text-sm cursor-pointer hover:bg-indigo-50 transition flex items-center justify-center";
                
                const card = document.querySelector(`.material-card[data-id="${i}"]`);
                card.className = "material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group";
                
                const feedbackEl = document.getElementById(`feedback-${i}`);
                feedbackEl.classList.add('hidden');
            }
            renderWordBank();
        }

        // Grammar Validation Logic
        const grammarAnswers = {
            'g-c1-1': ['nicer'],
            'g-c1-2': ['more expensive'],
            'g-c2-1': ['prettier'],
            'g-c2-2': ['more attractive'],
            'g-c3-1': ['smaller'],
            'g-c3-2': ['cheaper']
        };

        function checkGrammarAnswers() {
            let correct = 0;
            let total = 6;

            Object.keys(grammarAnswers).forEach(id => {
                const input = document.getElementById(id);
                const userVal = input.value.trim().toLowerCase();
                const validVals = grammarAnswers[id];

                input.classList.remove('border-emerald-500', 'border-rose-400', 'bg-emerald-50', 'bg-rose-50');

                if (validVals.includes(userVal)) {
                    correct++;
                    input.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-700');
                } else {
                    input.classList.add('border-rose-400', 'bg-rose-50', 'text-rose-700');
                }
            });

            if (correct === total) {
                playFX('win');
                updateScore(40);
                showToast("Grammar Master! All comparatives correct!", "correct");
                document.getElementById('badge-grammar').innerText = "6/6";
                document.getElementById('badge-grammar').classList.remove('hidden');
            } else {
                playFX('wrong');
                showToast(`You got ${correct}/${total} correct. Check spelling!`, "wrong");
            }
        }

        function playConversation(convNum) {
            if (convNum === 1) {
                const a1 = document.getElementById('g-c1-1').value || 'nicer';
                const a2 = document.getElementById('g-c1-2').value || 'more expensive';
                speakText(`Speaker A: Which of these jackets do you like more? Speaker B: I prefer the leather one. The design is ${a1}, and it looks ${a2} than the wool one.`);
            } else if (convNum === 2) {
                const a1 = document.getElementById('g-c2-1').value || 'prettier';
                const a2 = document.getElementById('g-c2-2').value || 'more attractive';
                speakText(`Speaker A: These sweaters are nice. Which one do you prefer? Speaker B: I like the grey one better. The color is ${a1}. It's ${a2} than the brown and orange one.`);
            } else if (convNum === 3) {
                const a1 = document.getElementById('g-c3-1').value || 'smaller';
                const a2 = document.getElementById('g-c3-2').value || 'cheaper';
                speakText(`Speaker A: Which rings do you like better? Speaker B: I like the silver ones more. They're ${a1} than the gold ones. And they're ${a2}.`);
            }
        }

        // Roleplay Topic Switcher
        function loadRoleplayTopic(index) {
            playFX('click');
            const data = roleplayTopics[index];
            document.getElementById('rp-title').innerText = data.title;
            document.getElementById('rp-line-a').innerText = data.lineA;
            document.getElementById('rp-line-b').innerText = data.lineB;

            document.querySelectorAll('.rp-topic-btn').forEach((btn, idx) => {
                if (idx === index) {
                    btn.className = "rp-topic-btn w-full text-left p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-50/50 flex items-center justify-between transition";
                } else {
                    btn.className = "rp-topic-btn w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-emerald-300 bg-white flex items-center justify-between transition";
                }
            });
        }

        function playFullRoleplay() {
            const lineA = document.getElementById('rp-line-a').innerText;
            const lineB = document.getElementById('rp-line-b').innerText;
            speakText(`Student A asks: ${lineA}`);
            setTimeout(() => {
                speakText(`Student B answers: ${lineB}`);
            }, 3500);
        }

        function speakCustomSentence() {
            const item = document.getElementById('builder-item').value;
            const aspect = document.getElementById('builder-aspect').value;
            const adj = document.getElementById('builder-adj').value;
            const sentence = `I prefer the ${item} because the ${aspect} is ${adj}.`;
            speakText(sentence);
            showToast("Speaking custom opinion...", "info");
        }

        // Tab 4: Scavenger Hunt Logic
        function renderHuntGrid() {
            const grid = document.getElementById('hunt-grid');
            grid.innerHTML = '';
            classroomObjects.forEach(obj => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = "hunt-item-btn bg-slate-50 border-2 border-slate-200 hover:border-amber-400 rounded-2xl p-4 flex flex-col items-center justify-center transition transform hover:-translate-y-1 shadow-sm";
                btn.innerHTML = `
                    <span class="text-4xl mb-2">${obj.icon}</span>
                    <span class="text-xs font-bold text-slate-700">${obj.name}</span>
                `;
                btn.onclick = () => handleHuntItemClick(obj);
                grid.appendChild(btn);
            });
        }

        function startScavengerHunt() {
            playFX('click');
            state.huntActive = true;
            state.huntTimeLeft = 30;
            state.huntFound = 0;

            const targetMaterials = ['plastic', 'wool', 'gold', 'leather', 'rubber', 'silver', 'cotton', 'silk'];
            state.currentTargetMaterial = targetMaterials[Math.floor(Math.random() * targetMaterials.length)];

            document.getElementById('hunt-target-material').innerText = state.currentTargetMaterial;
            document.getElementById('hunt-found-count').innerText = `0/5`;
            document.getElementById('hunt-timer').innerText = `30s`;
            document.getElementById('start-hunt-btn').disabled = true;
            document.getElementById('start-hunt-btn').classList.add('opacity-50');

            speakText(`Find items made of ${state.currentTargetMaterial}!`);

            if (state.huntTimer) clearInterval(state.huntTimer);
            state.huntTimer = setInterval(() => {
                state.huntTimeLeft--;
                document.getElementById('hunt-timer').innerText = `${state.huntTimeLeft}s`;

                if (state.huntTimeLeft <= 0) {
                    endScavengerHunt(false);
                }
            }, 1000);
        }

        function handleHuntItemClick(obj) {
            if (!state.huntActive) {
                showToast("Click 'Start Challenge' to begin!", "info");
                return;
            }

            if (obj.material === state.currentTargetMaterial) {
                playFX('correct');
                state.huntFound++;
                document.getElementById('hunt-found-count').innerText = `${state.huntFound}/5`;
                showToast(`Correct! ${obj.name} is made of ${obj.material}!`, "correct");

                if (state.huntFound >= 5) {
                    endScavengerHunt(true);
                } else {
                    // pick new target
                    const targetMaterials = ['plastic', 'wool', 'gold', 'leather', 'rubber', 'silver', 'cotton', 'silk'];
                    state.currentTargetMaterial = targetMaterials[Math.floor(Math.random() * targetMaterials.length)];
                    document.getElementById('hunt-target-material').innerText = state.currentTargetMaterial;
                    speakText(`Next! Find items made of ${state.currentTargetMaterial}!`);
                }
            } else {
                playFX('wrong');
                showToast(`Nope! ${obj.name} is made of ${obj.material}, not ${state.currentTargetMaterial}.`, "wrong");
            }
        }

        function endScavengerHunt(isWin) {
            clearInterval(state.huntTimer);
            state.huntActive = false;
            document.getElementById('start-hunt-btn').disabled = false;
            document.getElementById('start-hunt-btn').classList.remove('opacity-50');

            if (isWin) {
                playFX('win');
                updateScore(20);
                showToast("Scavenger Hunt Victory! You found all 5 items!", "correct");
            } else {
                playFX('wrong');
                showToast("Time's up! Try again to beat the clock!", "wrong");
            }
        }

        const realMissions = [
            "Find something made of PLASTIC in your backpack!",
            "Point to something made of LEATHER in the classroom!",
            "Name three objects made of COTTON around you!",
            "Find something made of RUBBER on your desk!",
            "Look for an item made of SILVER or GOLD!"
        ];

        function generateRandomMission() {
            playFX('click');
            const randomMission = realMissions[Math.floor(Math.random() * realMissions.length)];
            document.getElementById('real-mission-text').innerText = `"${randomMission}"`;
            speakText(randomMission);
        }

        // Global Score & Toast Helpers
        function updateScore(pts) {
            state.score = Math.min(100, state.score + pts);
            document.getElementById('global-score').innerText = `Score: ${state.score}/100`;
        }

        function showToast(msg, type = 'info') {
            const toast = document.getElementById('toast-modal');
            const icon = document.getElementById('toast-icon');
            const text = document.getElementById('toast-text');

            text.innerText = msg;

            if (type === 'correct') {
                icon.className = 'fa-solid fa-circle-check text-emerald-400 text-lg';
            } else if (type === 'wrong') {
                icon.className = 'fa-solid fa-circle-xmark text-rose-400 text-lg';
            } else {
                icon.className = 'fa-solid fa-circle-info text-sky-400 text-lg';
            }

            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 3000);
        }

        // Initialize App on Page Load
        window.addEventListener('load', () => {
            renderWordBank();
            renderHuntGrid();
        });
    </script>
</body>
</html>
