        <!-- TAB 2: COMPARATIVE GRAMMAR -->
        <section id="tab-grammar" class="tab-content hidden space-y-6">
            <!-- Grammar Scaffolding Cheat-Sheet Card -->
            <div class="bg-gradient-to-r from-violet-600 to-indigo-600 rounded-3xl p-6 text-white shadow-xl">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="space-y-2">
                        <span class="px-3 py-1 bg-white/20 rounded-full text-xs font-semibold uppercase tracking-wider text-violet-100">Grammar Focus</span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold font-display">Comparative Adjectives</h2>
                        <p class="text-violet-100 text-sm max-w-xl">
                            Use comparatives to compare two items (e.g. leather vs. wool, grey vs. orange).
                        </p>
                    </div>
                    <button onclick="speakText('Short adjectives add -er: nicer, smaller, cheaper. Adjectives ending in -y change to -ier: prettier. Long adjectives use more: more expensive, more attractive.')" class="self-start md:self-center px-4 py-2.5 rounded-xl bg-white text-violet-700 font-bold text-xs shadow-md hover:bg-violet-50 transition flex items-center">
                        <i class="fa-solid fa-volume-high mr-2"></i> Listen Rules
                    </button>
                </div>

                <!-- Grammar Rules Table Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20">
                        <div class="text-xs font-bold text-violet-200 uppercase tracking-wide mb-1">Short Adjectives (+er)</div>
                        <div class="text-sm font-bold text-white">nice &rarr; <span class="text-amber-300">nicer</span></div>
                        <div class="text-sm font-bold text-white">small &rarr; <span class="text-amber-300">smaller</span></div>
                        <div class="text-sm font-bold text-white">cheap &rarr; <span class="text-amber-300">cheaper</span></div>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20">
                        <div class="text-xs font-bold text-violet-200 uppercase tracking-wide mb-1">-y Adjectives (-ier)</div>
                        <div class="text-sm font-bold text-white">pretty &rarr; <span class="text-amber-300">prettier</span></div>
                        <div class="text-xs text-violet-200 mt-2">Change -y to -i and add -er</div>
                    </div>
                    <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20">
                        <div class="text-xs font-bold text-violet-200 uppercase tracking-wide mb-1">Long Adjectives (more + adj)</div>
                        <div class="text-sm font-bold text-white">expensive &rarr; <span class="text-amber-300">more expensive</span></div>
                        <div class="text-sm font-bold text-white">attractive &rarr; <span class="text-amber-300">more attractive</span></div>
                    </div>
                </div>
            </div>

            <!-- Dialogue Conversations from Textbook Page -->
            <div class="space-y-6">
                <!-- Conversation 1 -->
                <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm hover:border-violet-200 transition">
