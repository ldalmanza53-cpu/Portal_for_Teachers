                    <div id="feedback-7" class="mt-2 text-xs font-bold hidden"></div>
                </div>

                <!-- Item 8: Wool socks -->
                <div class="material-card bg-white rounded-2xl border-2 border-slate-200 p-4 flex flex-col items-center text-center transition hover:border-indigo-300 hover:shadow-md relative group" data-id="8" data-answer="wool">
                    <button onclick="speakText('Wool socks')" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-slate-100 hover:bg-indigo-100 text-slate-500 hover:text-indigo-600 flex items-center justify-center transition" title="Listen">
                        <i class="fa-solid fa-volume-high text-xs"></i>
