<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Places Around the World & Natural Features • ESL Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Outfit', sans-serif; }
        .tab-active { background-color: #0284c7 !important; color: #ffffff !important; font-weight: 700; box-shadow: 0 4px 14px 0 rgba(2, 132, 199, 0.4); }
        .map-pin { transition: transform 0.2s ease, filter 0.2s ease; cursor: pointer; }
        .map-pin:hover { transform: scale(1.25); filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.8)); }
        .map-pin-selected circle { fill: #0284c7 !important; stroke: #ffffff !important; stroke-width: 3px !important; }
        .map-pin-correct circle { fill: #10b981 !important; stroke: #ffffff !important; }
        .map-pin-incorrect circle { fill: #f43f5e !important; stroke: #ffffff !important; }
        @keyframes pulseRing {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .pulse-ring { animation: pulseRing 2s infinite ease-in-out; transform-origin: center; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-sky-500 selection:text-white">

    <!-- Header Navbar -->
    <header class="bg-slate-800/90 border-b border-slate-700 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 via-teal-500 to-emerald-500 flex items-center justify-center text-white text-xl shadow-md">
                    <i class="fa-solid fa-earth-americas"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-base md:text-lg text-white leading-tight">Places Around the World</h1>
                    <p class="text-[11px] text-slate-400">Natural Features & Geography • ESL Level A1–A2</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="bg-slate-900 border border-slate-700 px-3 py-1.5 rounded-xl text-xs flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span>Score: <strong id="globalScore" class="text-sky-400">0 / 12</strong></span>
                </div>
                <button onclick="toggleAudioHelp()" id="audioToggleBtn" title="Audio Toggle" class="p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sky-400 text-xs transition">
                    <i class="fa-solid fa-volume-high" id="audioToggleIcon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="bg-slate-800/50 border-b border-slate-700/60 sticky top-[61px] z-40 backdrop-blur-sm">
        <div class="max-w-6xl mx-auto px-4 flex gap-2 py-2.5 overflow-x-auto">
            <button onclick="switchTab('tabSectionA')" id="btnTabSectionA" class="tab-active px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-map-location-dot"></i> Section A: Interactive Map Matching
            </button>
            <button onclick="switchTab('tabSectionB')" id="btnTabSectionB" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-compass"></i> Section B: Prepositions & Grammar Explorer
            </button>
            <button onclick="switchTab('tabSectionC')" id="btnTabSectionC" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-plane-departure"></i> Section C: Dream Geography Tour
            </button>
        </div>
    </div>

    <!-- Main Container -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 md:p-6 space-y-6">

        <!-- SECTION A: INTERACTIVE MAP MATCHING EXERCISE -->
        <section id="tabSectionA" class="space-y-6">
            
            <div class="bg-slate-800 p-4 md:p-5 rounded-2xl border border-slate-700 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-base md:text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-map-pin text-sky-400"></i> Match the Words to the Map
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Click a letter pin on the landscape map or select the corresponding letter (a–l) next to each vocabulary word!</p>
                </div>
                <div class="flex gap-2 w-full md:w-auto">
                    <button onclick="resetMapMatching()" class="flex-1 md:flex-none px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                    <button onclick="checkMapMatching()" class="flex-1 md:flex-none px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-xl text-xs font-bold transition shadow-lg flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-circle-check"></i> Check Answers
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                
                <!-- SVG Landscape Map Display -->
                <div class="lg:col-span-7 bg-slate-800/90 p-4 rounded-2xl border border-slate-700 space-y-3 relative overflow-hidden">
                    <div class="flex justify-between items-center text-xs">
                        <span class="font-bold text-amber-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-image"></i> Natural Landscape Map
                        </span>
                        <span id="pinActiveHint" class="text-[11px] text-sky-300 font-medium italic">Click any letter pin (a–l)</span>
                    </div>

                    <div class="w-full relative rounded-xl overflow-hidden border border-slate-700 bg-slate-950 shadow-2xl">
                        <svg viewBox="0 0 800 520" class="w-full h-auto block select-none" id="geographySvgMap">
                            <defs>
                                <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#38bdf8"/>
                                    <stop offset="60%" stop-color="#bae6fd"/>
                                    <stop offset="100%" stop-color="#e0f2fe"/>
                                </linearGradient>
                                <linearGradient id="snowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#ffffff"/>
                                    <stop offset="100%" stop-color="#cbd5e1"/>
                                </linearGradient>
                                <linearGradient id="desertGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#fef08a"/>
                                    <stop offset="100%" stop-color="#eab308"/>
                                </linearGradient>
                                <linearGradient id="waterGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#38bdf8"/>
                                    <stop offset="100%" stop-color="#0284c7"/>
                                </linearGradient>
                            </defs>

                            <!-- Sky Background -->
                            <rect width="800" height="520" fill="url(#skyGrad)"/>
                            <!-- Sun & Clouds -->
                            <circle cx="720" cy="60" r="35" fill="#fef08a" opacity="0.9"/>
                            <path d="M 120 50 Q 140 30 170 40 Q 190 20 220 40 Q 240 50 230 70 Z" fill="#ffffff" opacity="0.8"/>
                            <path d="M 450 60 Q 470 45 490 55 Q 510 40 530 60 Z" fill="#ffffff" opacity="0.75"/>

                            <!-- Mountain Range (a) -->
                            <polygon points="120,240 240,60 360,240" fill="#64748b"/>
                            <polygon points="240,60 200,120 230,110 240,125 255,110 280,120" fill="url(#snowGrad)"/>
                            <polygon points="20,260 140,110 240,260" fill="#475569"/>

                            <!-- Green Hills (b) -->
                            <path d="M 180,260 Q 280,180 380,260 Z" fill="#22c55e"/>
                            <path d="M 320,260 Q 420,190 500,260 Z" fill="#16a34a"/>

                            <!-- Valley (d) & Desert Area (e) -->
                            <path d="M 380,260 L 800,260 L 800,400 L 0,400 Z" fill="#84cc16"/>
                            <!-- Desert Patch (e) -->
                            <path d="M 460,230 Q 600,220 780,240 L 780,330 Q 550,340 450,290 Z" fill="url(#desertGrad)"/>
                            <!-- Cacti in Desert -->
                            <path d="M 540,260 L 540,285 M 535,270 L 545,270 M 535,270 L 535,265 M 545,270 L 545,265" stroke="#15803d" stroke-width="3" stroke-linecap="round"/>
                            <path d="M 610,250 L 610,280 M 605,262 L 615,262 M 605,262 L 605,257 M 615,262 L 615,257" stroke="#15803d" stroke-width="3" stroke-linecap="round"/>

                            <!-- Forest (f) -->
                            <g fill="#14532d">
                                <!-- Trees cluster -->
                                <polygon points="680,310 665,340 695,340"/>
                                <polygon points="710,290 695,320 725,320"/>
                                <polygon points="740,300 725,335 755,335"/>
                                <polygon points="770,285 750,325 790,325"/>
                                <polygon points="695,330 680,360 710,360"/>
                                <polygon points="735,325 720,355 750,355"/>
                            </g>

                            <!-- High Cliff plateau -->
                            <path d="M 0,260 L 380,260 L 380,380 L 0,380 Z" fill="#65a30d"/>
                            <path d="M 0,380 L 380,380 L 380,440 L 0,440 Z" fill="#78350f"/> <!-- Cliff wall -->

                            <!-- River (c) originating from Mountain -->
                            <path d="M 230,170 Q 210,210 250,230 T 210,280 T 150,330 T 200,380" fill="none" stroke="url(#waterGrad)" stroke-width="14" stroke-linecap="round"/>

                            <!-- Waterfall (g) spilling off Cliff wall -->
                            <path d="M 200,375 L 200,450" stroke="#7dd3fc" stroke-width="18" opacity="0.95"/>
                            <path d="M 195,375 L 195,450" stroke="#ffffff" stroke-width="6" opacity="0.8"/>

                            <!-- Lake (h) on right meadow -->
                            <ellipse cx="560" cy="360" rx="75" ry="35" fill="url(#waterGrad)" stroke="#38bdf8" stroke-width="3"/>

                            <!-- Lower Meadow & Beach (i) & Ocean (j) -->
                            <path d="M 0,430 L 800,430 L 800,520 L 0,520 Z" fill="#22c55e"/>
                            <path d="M 400,440 Q 600,430 800,460 L 800,520 L 400,520 Z" fill="#fef08a"/> <!-- Sand beach -->
                            <path d="M 0,450 L 800,475 L 800,520 L 0,520 Z" fill="url(#waterGrad)"/> <!-- Ocean -->

                            <!-- Island (l) in Ocean -->
                            <ellipse cx="640" cy="490" rx="90" ry="25" fill="#fef08a"/>
                            <ellipse cx="640" cy="488" rx="80" ry="20" fill="#84cc16"/>

                            <!-- Volcano (k) on Island -->
                            <polygon points="590,490 630,430 670,490" fill="#451a03"/>
                            <polygon points="615,445 630,430 645,445" fill="#ef4444"/> <!-- Crater glow -->
                            <!-- Smoke from Volcano -->
                            <circle cx="630" cy="415" r="12" fill="#64748b" opacity="0.7"/>
                            <circle cx="642" cy="395" r="16" fill="#475569" opacity="0.6"/>

                            <!-- PINS (a - l) HOTSPOTS -->
                            <g id="svgPinsGroup">
                                <!-- Pin a: Mountain -->
                                <g class="map-pin" id="pin-a" onclick="selectMapPin('a')">
                                    <circle cx="240" cy="90" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="240" y="95" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">a</text>
                                </g>

                                <!-- Pin b: Hill -->
                                <g class="map-pin" id="pin-b" onclick="selectMapPin('b')">
                                    <circle cx="330" cy="210" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="330" y="215" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">b</text>
                                </g>

                                <!-- Pin c: River -->
                                <g class="map-pin" id="pin-c" onclick="selectMapPin('c')">
                                    <circle cx="225" cy="270" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="225" y="275" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">c</text>
                                </g>

                                <!-- Pin d: Valley -->
                                <g class="map-pin" id="pin-d" onclick="selectMapPin('d')">
                                    <circle cx="420" cy="250" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="420" y="255" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">d</text>
                                </g>

                                <!-- Pin e: Desert -->
                                <g class="map-pin" id="pin-e" onclick="selectMapPin('e')">
                                    <circle cx="630" cy="255" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="630" y="260" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">e</text>
                                </g>

                                <!-- Pin f: Forest -->
                                <g class="map-pin" id="pin-f" onclick="selectMapPin('f')">
                                    <circle cx="735" cy="305" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="735" y="310" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">f</text>
                                </g>

                                <!-- Pin g: Waterfall -->
                                <g class="map-pin" id="pin-g" onclick="selectMapPin('g')">
                                    <circle cx="200" cy="415" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="200" y="420" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">g</text>
                                </g>

                                <!-- Pin h: Lake -->
                                <g class="map-pin" id="pin-h" onclick="selectMapPin('h')">
                                    <circle cx="560" cy="360" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="560" y="365" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">h</text>
                                </g>

                                <!-- Pin i: Beach -->
                                <g class="map-pin" id="pin-i" onclick="selectMapPin('i')">
                                    <circle cx="760" cy="450" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="760" y="455" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">i</text>
                                </g>

                                <!-- Pin j: Ocean -->
                                <g class="map-pin" id="pin-j" onclick="selectMapPin('j')">
                                    <circle cx="380" cy="490" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="380" y="495" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">j</text>
                                </g>

                                <!-- Pin k: Volcano -->
                                <g class="map-pin" id="pin-k" onclick="selectMapPin('k')">
                                    <circle cx="630" cy="445" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="630" y="450" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">k</text>
                                </g>

                                <!-- Pin l: Island -->
                                <g class="map-pin" id="pin-l" onclick="selectMapPin('l')">
                                    <circle cx="710" cy="490" r="16" fill="#0284c7" stroke="#ffffff" stroke-width="2"/>
                                    <text x="710" y="495" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">l</text>
                                </g>
                            </g>
                        </svg>
                    </div>
                </div>

                <!-- Vocabulary Matching Form -->
                <div class="lg:col-span-5 bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                        <h3 class="font-bold text-sm text-white flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-amber-400"></i> Vocabulary Items (1–12)
                        </h3>
                        <span class="text-[10px] text-slate-400 font-mono">Select Letter (a–l)</span>
                    </div>

                    <div id="matchingListContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5 max-h-[460px] overflow-y-auto pr-1">
                        <!-- Dynamic 12 Matching Input Cards render here -->
                    </div>
                </div>

            </div>

            <!-- Feedback Notification Banner -->
            <div id="matchingFeedbackBanner" class="hidden bg-slate-800 p-4 rounded-2xl border border-slate-700 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div id="bannerIcon" class="w-10 h-10 rounded-xl flex items-center justify-center text-xl"></div>
                    <div>
                        <h4 id="bannerTitle" class="font-bold text-sm text-white">Result</h4>
                        <p id="bannerText" class="text-xs text-slate-300">Feedback text...</p>
                    </div>
                </div>
                <button onclick="dismissMatchingBanner()" class="text-slate-400 hover:text-white px-2 py-1 text-xs">Dismiss</button>
            </div>

        </section>

        <!-- SECTION B: PREPOSITIONS & GRAMMAR EXPLORER -->
        <section id="tabSectionB" class="hidden space-y-6">
            
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-2">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-compass text-amber-400"></i> Section B: Prepositions of Place ("There is / There are")
                </h2>
                <p class="text-xs text-slate-400">Practice describing where natural features are located on the map using <strong>next to, on, between, near, in</strong>.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Interactive Sentence Practice Questions -->
                <div class="lg:col-span-7 space-y-4" id="prepositionQuizContainer">
                    <!-- Dynamic Questions -->
                </div>

                <!-- Reference Helper Sidebar -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-4">
                        <h3 class="text-xs font-bold text-sky-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Grammar Quick Guide
                        </h3>

                        <div class="space-y-3 text-xs">
                            <div class="p-3 bg-slate-900 rounded-xl border border-slate-700">
                                <span class="font-bold text-amber-300">There is + Singular Feature</span>
                                <p class="text-slate-400 mt-0.5">"There is a <strong>volcano</strong> on the island."</p>
                            </div>
                            <div class="p-3 bg-slate-900 rounded-xl border border-slate-700">
                                <span class="font-bold text-emerald-300">There are + Plural Features</span>
                                <p class="text-slate-400 mt-0.5">"There are green <strong>hills</strong> near the river."</p>
                            </div>
                            <div class="p-3 bg-slate-900 rounded-xl border border-slate-700 space-y-1.5">
                                <span class="font-bold text-sky-300">Target Prepositions:</span>
                                <ul class="list-disc list-inside text-slate-300 space-y-1">
                                    <li><strong class="text-white">on:</strong> directly on top ("on the island")</li>
                                    <li><strong class="text-white">next to:</strong> right beside ("next to the ocean")</li>
                                    <li><strong class="text-white">between:</strong> in the middle of two things</li>
                                    <li><strong class="text-white">near:</strong> close in distance</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </section>

        <!-- SECTION C: DREAM GEOGRAPHY TOUR & SURVEY -->
        <section id="tabSectionC" class="hidden space-y-6">
            
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-2">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-plane-departure text-emerald-400"></i> Section C: Dream Geography Tour & Survey
                </h2>
                <p class="text-xs text-slate-400">Select your favorite natural places and create your custom geography presentation script with Text-to-Speech!</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Interactive Survey Form -->
                <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-5">
                    
                    <div class="space-y-3">
                        <label class="text-xs font-bold text-amber-400 uppercase tracking-wider block">
                            1. Pick your TOP 3 favorite geography features:
                        </label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="tourPicksGrid">
                            <!-- Dynamic 12 pickable badges -->
                        </div>
                    </div>

                    <div class="space-y-3 pt-2 border-t border-slate-700">
                        <label class="text-xs font-bold text-sky-400 uppercase tracking-wider block">
                            2. Are there any natural features near your hometown?
                        </label>
                        <select id="surveyHometownFeature" onchange="updateTourScript()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-sky-500">
                            <option value="mountains">Yes, there are high mountains.</option>
                            <option value="a river">Yes, there is a long river.</option>
                            <option value="a beach">Yes, there is a beautiful beach.</option>
                            <option value="a lake">Yes, there is a calm lake.</option>
                            <option value="a forest">Yes, there is a dense forest.</option>
                        </select>
                    </div>

                    <div class="space-y-3 pt-2 border-t border-slate-700">
                        <label class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">
                            3. Which place do you want to visit on vacation?
                        </label>
                        <select id="surveyVacationPlace" onchange="updateTourScript()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-sky-500">
                            <option value="a tropical island with a volcano">A tropical island with a volcano</option>
                            <option value="a mountain with a tall waterfall">A mountain with a tall waterfall</option>
                            <option value="a quiet desert under the stars">A quiet desert under the stars</option>
                            <option value="a green forest next to a river">A green forest next to a river</option>
                        </select>
                    </div>

                </div>

                <!-- Generated Tour Speech Script -->
                <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-6">
                    <div class="space-y-4">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-bullhorn"></i> Personalized Geography Monologue
                            </span>
                            <span class="text-[10px] font-mono text-slate-500">A1-A2 Speaking Target</span>
                        </div>

                        <div class="bg-slate-900 p-5 rounded-xl border border-slate-800 space-y-3">
                            <p id="generatedTourScript" class="text-sm font-medium text-sky-200 leading-relaxed italic">
                                Loading script...
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <button onclick="speakTourScript()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl font-bold text-xs transition flex items-center justify-center gap-2 shadow-lg">
                            <i class="fa-solid fa-circle-play text-base"></i> Read Presentation Aloud
                        </button>
                    </div>
                </div>

            </div>

        </section>

    </main>

    <!-- App Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Places Around the World Studio • ESL Vocabulary & Geography Activity
    </footer>

    <!-- JavaScript Logic Block -->
    <script>
        // Target Vocabulary Data (12 textbook items)
        const targetGeographyItems = [
            { id: 1, word: 'beach', correctLetter: 'i', emoji: '🏖️', phonetic: '/biːtʃ/' },
            { id: 2, word: 'desert', correctLetter: 'e', emoji: '🌵', phonetic: '/ˈdez.ɚt/' },
            { id: 3, word: 'forest', correctLetter: 'f', emoji: '🌲', phonetic: '/ˈfɔːr.ɪst/' },
            { id: 4, word: 'hill', correctLetter: 'b', emoji: '⛰️', phonetic: '/hɪl/' },
            { id: 5, word: 'island', correctLetter: 'l', emoji: '🏝️', phonetic: '/ˈaɪ.lənd/' },
            { id: 6, word: 'lake', correctLetter: 'h', emoji: '🌊', phonetic: '/leɪk/' },
            { id: 7, word: 'mountain', correctLetter: 'a', emoji: '🏔️', phonetic: '/ˈmaʊn.tən/' },
            { id: 8, word: 'ocean', correctLetter: 'j', emoji: '🌊', phonetic: '/ˈoʊ.ʃən/' },
            { id: 9, word: 'river', correctLetter: 'c', emoji: '🏞️', phonetic: '/ˈrɪv.ɚ/' },
            { id: 10, word: 'valley', correctLetter: 'd', emoji: '🏞️', phonetic: '/ˈvæl.i/' },
            { id: 11, word: 'volcano', correctLetter: 'k', emoji: '🌋', phonetic: '/vɑːlˈkeɪ.noʊ/' },
            { id: 12, word: 'waterfall', correctLetter: 'g', emoji: '🌊', phonetic: '/ˈwɑː.t̬ɚ.fɑːl/' }
        ];

        // State variables
        let userAssignments = {}; // { wordId: letter }
        let soundEnabled = true;
        let selectedMapPin = null;

        let surveyPicks = ['mountain', 'beach', 'waterfall'];

        const prepositionQuizData = [
            {
                id: 1,
                sentence: "There is a snow-capped _____ (a) at the top of the map.",
                options: ["mountain", "lake", "desert"],
                answer: "mountain"
            },
            {
                id: 2,
                sentence: "There is a smoking volcano _____ the island.",
                options: ["under", "on", "between"],
                answer: "on"
            },
            {
                id: 3,
                sentence: "The green valley (d) is _____ the hills and the desert.",
                options: ["between", "on", "under"],
                answer: "between"
            },
            {
                id: 4,
                sentence: "There is a tall waterfall (g) flowing into the _____.",
                options: ["river", "forest", "volcano"],
                answer: "river"
            },
            {
                id: 5,
                sentence: "The sandy beach (i) is _____ to the ocean.",
                options: ["next", "in", "between"],
                answer: "next"
            }
        ];

        // Web Speech TTS Helper
        function speakWord(text, rate = 0.9) {
            if (!soundEnabled) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = rate;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Toggle Audio
        function toggleAudioHelp() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('audioToggleIcon');
            const btn = document.getElementById('audioToggleBtn');
            
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high';
                btn.className = 'p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sky-400 text-xs transition';
                speakWord('Audio enabled');
            } else {
                icon.className = 'fa-solid fa-volume-xmark';
                btn.className = 'p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-rose-400 text-xs transition';
            }
        }

        // Navigation Tabs Switcher
        function switchTab(tabId) {
            ['tabSectionA', 'tabSectionB', 'tabSectionC'].forEach(t => {
                document.getElementById(t).classList.add('hidden');
                const btn = document.getElementById(`btn${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (btn) btn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap';
            });

            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = document.getElementById(`btn${tabId.charAt(0).toUpperCase() + tabId.slice(1)}`);
            if (activeBtn) activeBtn.className = 'tab-active px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 whitespace-nowrap';
        }

        function renderMatchingList() {
            const container = document.getElementById('matchingListContainer');
            container.innerHTML = '';

            const availableLetters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l'];

            targetGeographyItems.forEach(item => {
                const card = document.createElement('div');
                card.className = "p-2.5 bg-slate-900 border border-slate-700 rounded-xl flex items-center justify-between gap-2 shadow-sm";

                const currentLetter = userAssignments[item.id] || '';

                let optionsHtml = `<option value="">--</option>`;
                availableLetters.forEach(l => {
                    optionsHtml += `<option value="${l}" ${currentLetter === l ? 'selected' : ''}>${l}</option>`;
                });

                card.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-xs text-amber-400 w-5">${item.id}.</span>
                        <span class="text-base">${item.emoji}</span>
                        <span class="font-bold text-xs text-white capitalize">${item.word}</span>
                        <button onclick="speakWord('${item.word}')" class="text-slate-400 hover:text-sky-300 px-1">
                            <i class="fa-solid fa-volume-high text-[10px]"></i>
                        </button>
                    </div>

                    <select onchange="assignLetter(${item.id}, this.value)" class="bg-slate-800 border border-slate-600 rounded-lg px-2 py-1 text-xs font-bold text-sky-300 focus:outline-none focus:border-sky-400">
                        ${optionsHtml}
                    </select>
                `;
                container.appendChild(card);
            });

            updateSvgPinVisuals();
        }

        function assignLetter(wordId, letter) {
            if (letter) {
                userAssignments[wordId] = letter;
                const wordObj = targetGeographyItems.find(w => w.id === wordId);
                if (wordObj) speakWord(`${wordObj.word}, letter ${letter}`);
            } else {
                delete userAssignments[wordId];
            }
            renderMatchingList();
        }

        function selectMapPin(letter) {
            selectedMapPin = letter;
            speakWord(`Letter ${letter}`);
            document.getElementById('pinActiveHint').innerText = `Selected Pin: [${letter}] - Pick a word!`;

            // Highlight corresponding Pin in SVG
            updateSvgPinVisuals();
        }

        function updateSvgPinVisuals() {
            const allPins = document.querySelectorAll('.map-pin');
            allPins.forEach(pin => {
                const pId = pin.id.replace('pin-', '');
                pin.classList.remove('map-pin-selected');
                if (pId === selectedMapPin) {
                    pin.classList.add('map-pin-selected');
                }
            });
        }

        function resetMapMatching() {
            userAssignments = {};
            selectedMapPin = null;
            document.getElementById('pinActiveHint').innerText = `Click any letter pin (a–l)`;
            renderMatchingList();
            dismissMatchingBanner();
        }

        function checkMapMatching() {
            let correctCount = 0;
            const total = targetGeographyItems.length;

            targetGeographyItems.forEach(item => {
                const assigned = userAssignments[item.id];
                if (assigned && assigned.toLowerCase() === item.correctLetter) {
                    correctCount++;
                }
            });

            document.getElementById('globalScore').innerText = `${correctCount} / ${total}`;

            if (correctCount === total) {
                showMatchingBanner('success', 'Perfect Score! 🎉', 'Amazing! You correctly matched all 12 geography words to the map!');
                confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
                speakWord('Awesome job! All geography words are correct!');
            } else {
                showMatchingBanner('info', 'Check Progress', `You matched ${correctCount} out of 12 correctly. Keep trying!`);
            }
        }

        function showMatchingBanner(type, title, text) {
            const banner = document.getElementById('matchingFeedbackBanner');
            const icon = document.getElementById('bannerIcon');
            const titleEl = document.getElementById('bannerTitle');
            const textEl = document.getElementById('bannerText');

            banner.classList.remove('hidden');

            if (type === 'success') {
                icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center text-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
                icon.innerHTML = '<i class="fa-solid fa-trophy"></i>';
            } else {
                icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center text-xl bg-sky-500/20 text-sky-400 border border-sky-500/40';
                icon.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            titleEl.innerText = title;
            textEl.innerText = text;
        }

        function dismissMatchingBanner() {
            document.getElementById('matchingFeedbackBanner').classList.add('hidden');
        }

        function renderPrepositionQuiz() {
            const container = document.getElementById('prepositionQuizContainer');
            container.innerHTML = '';

            prepositionQuizData.forEach((q, idx) => {
                const qCard = document.createElement('div');
                qCard.className = "bg-slate-800 p-4 rounded-2xl border border-slate-700 space-y-3";

                let optionsHtml = q.options.map(opt => `
                    <button onclick="checkQuizAnswer(${q.id}, '${opt}', this)" class="px-3 py-1.5 bg-slate-900 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-slate-200 rounded-xl transition">
                        ${opt}
                    </button>
                `).join('');

                qCard.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-slate-900 text-amber-400 font-bold text-xs flex items-center justify-center">${idx + 1}</span>
                        <p class="text-xs font-medium text-white">${q.sentence}</p>
                    </div>
                    <div class="flex flex-wrap gap-2 pl-8" id="quizOpts-${q.id}">
                        ${optionsHtml}
                    </div>
                    <p id="quizMsg-${q.id}" class="text-[11px] font-bold pl-8 min-h-[16px]"></p>
                `;
                container.appendChild(qCard);
            });
        }

        function checkQuizAnswer(qId, selectedOpt, btn) {
            const qObj = prepositionQuizData.find(q => q.id === qId);
            const msgEl = document.getElementById(`quizMsg-${qId}`);
            
            if (selectedOpt === qObj.answer) {
                msgEl.className = 'text-[11px] font-bold pl-8 text-emerald-400';
                msgEl.innerText = '✨ Correct!';
                speakWord(`Correct! ${selectedOpt}`);
            } else {
                msgEl.className = 'text-[11px] font-bold pl-8 text-rose-400';
                msgEl.innerText = '❌ Try again!';
                speakWord('Try again');
            }
        }

        function renderTourSurvey() {
            const grid = document.getElementById('tourPicksGrid');
            grid.innerHTML = '';

            targetGeographyItems.forEach(item => {
                const isSelected = surveyPicks.includes(item.word);
                const btn = document.createElement('button');
                btn.onclick = () => toggleTourPick(item.word);

                let btnStyle = isSelected ? 'bg-emerald-950 border-emerald-500 text-emerald-300' : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700';

                btn.className = `p-2 rounded-xl border ${btnStyle} text-xs font-semibold flex items-center justify-between transition`;
                btn.innerHTML = `
                    <span>${item.emoji} ${item.word}</span>
                    <i class="fa-solid ${isSelected ? 'fa-check text-emerald-400' : 'fa-plus text-slate-700'}"></i>
                `;
                grid.appendChild(btn);
            });

            updateTourScript();
        }

        function toggleTourPick(word) {
            const idx = surveyPicks.indexOf(word);
            if (idx > -1) {
                if (surveyPicks.length > 1) surveyPicks.splice(idx, 1);
            } else {
                if (surveyPicks.length < 4) surveyPicks.push(word);
            }
            renderTourSurvey();
        }

        function updateTourScript() {
            const hometown = document.getElementById('surveyHometownFeature').value;
            const vacation = document.getElementById('surveyVacationPlace').value;

            const picksStr = surveyPicks.join(', ');
            const script = `"Welcome to my Geography Tour! My favorite natural features are the ${picksStr}. Near my hometown, ${hometown}. On my next vacation, I want to visit ${vacation}!"`;

            document.getElementById('generatedTourScript').innerText = script;
        }

        function speakTourScript() {
            const text = document.getElementById('generatedTourScript').innerText;
            speakWord(text.replace(/"/g, ''), 0.85);
        }

        // Window Initializer
        window.addEventListener('DOMContentLoaded', () => {
            renderMatchingList();
            renderPrepositionQuiz();
            renderTourSurvey();
        });
    </script>
</body>
</html>
