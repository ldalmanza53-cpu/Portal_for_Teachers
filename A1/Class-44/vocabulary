<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Past Tense Verb Lab • A1 Vocabulary</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        .tab-active { background-color: #2563eb !important; color: #ffffff !important; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35); }
        .verb-input:focus { border-color: #3b82f6; outline: none; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3); }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white flex items-center gap-2">
                        Past Tense Verb Lab
                        <span class="bg-emerald-900/80 text-emerald-300 border border-emerald-500/40 text-[10px] px-2 py-0.5 rounded-full font-extrabold uppercase">A1 Grammar</span>
                    </h1>
                    <p class="text-xs text-slate-400">Regular & Irregular Verb Forms • Pair Practice Studio</p>
                </div>
            </div>

            <!-- Timer & Actions -->
            <div class="flex items-center gap-3 bg-slate-900/90 px-4 py-2 rounded-xl border border-slate-700 text-sm">
                <div class="flex items-center gap-2 text-amber-400">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                    <span id="timerDisplay" class="font-mono font-bold text-lg">15:00</span>
                    <button onclick="toggleTimer()" id="timerBtn" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs px-2 py-1 rounded font-bold transition ml-1">Start</button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('chart')" id="tab-chart" class="nav-tab tab-active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-table"></i> 1. Verb Chart Completion
                </button>
                <button onclick="switchTab('sort')" id="tab-sort" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-filter"></i> 2. Regular vs. Irregular
                </button>
                <button onclick="switchTab('speaking')" id="tab-speaking" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-comments"></i> 3. Pair Speaking & Story
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: VERB CHART COMPLETION -->
        <section id="sec-chart" class="tab-content block space-y-6">
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-700 pb-3">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square text-emerald-400"></i> Complete the Past Tense Chart
                        </h2>
                        <p class="text-xs text-slate-400">
                            Type the correct past tense form for each verb. Press Enter or click "Check Answers".
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="checkChartAnswers()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-bold text-xs transition flex items-center gap-2 shadow-md">
                            <i class="fa-solid fa-circle-check"></i> Check Answers
                        </button>
                        <button onclick="revealAnswers()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 px-3 py-2 rounded-xl font-bold text-xs transition">
                            <i class="fa-solid fa-eye"></i> Reveal
                        </button>
                    </div>
                </div>

                <!-- 2-Column Verb Chart -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="chartContainer">
                    <!-- Column 1 -->
                    <div class="bg-slate-900 rounded-xl p-4 border border-slate-700 space-y-3">
                        <div class="grid grid-cols-2 text-xs font-bold text-emerald-400 uppercase tracking-widest border-b border-slate-800 pb-2">
                            <span>Present</span>
                            <span>Past Tense</span>
                        </div>
                        <div id="col1-verbs" class="space-y-2.5"></div>
                    </div>

                    <!-- Column 2 -->
                    <div class="bg-slate-900 rounded-xl p-4 border border-slate-700 space-y-3">
                        <div class="grid grid-cols-2 text-xs font-bold text-emerald-400 uppercase tracking-widest border-b border-slate-800 pb-2">
                            <span>Present</span>
                            <span>Past Tense</span>
                        </div>
                        <div id="col2-verbs" class="space-y-2.5"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: REGULAR VS IRREGULAR SORTING -->
        <section id="sec-sort" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-emerald-900/60 text-emerald-300 border border-emerald-500/40 text-xs font-bold rounded-full uppercase">Grammar Categorization</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Regular vs. Irregular Verbs</h2>
                    <p class="text-sm text-slate-400">Classify each verb based on how its past tense form is constructed.</p>
                </div>

                <!-- Unsorted Chips -->
                <div class="bg-slate-900 p-4 rounded-xl border border-slate-700 space-y-2">
                    <span class="text-xs font-bold text-slate-400 uppercase">Available Verbs (Click to categorize):</span>
                    <div id="sortBank" class="flex flex-wrap gap-2 pt-1"></div>
                </div>

                <!-- 2 Category Buckets -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Regular Bucket -->
                    <div class="bg-slate-900 p-5 rounded-2xl border-2 border-dashed border-emerald-500/40 space-y-3 min-h-[220px]" onclick="assignCurrentToBucket('regular')">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <h3 class="font-bold text-emerald-400 text-base flex items-center gap-2">
                                <i class="fa-solid fa-square-check"></i> Regular Verbs (-ed / -d / -ied)
                            </h3>
                            <span id="regCount" class="text-xs bg-slate-800 px-2.5 py-1 rounded-full text-slate-300 font-bold">0</span>
                        </div>
                        <div id="regularBucket" class="flex flex-wrap gap-2 pt-2"></div>
                    </div>

                    <!-- Irregular Bucket -->
                    <div class="bg-slate-900 p-5 rounded-2xl border-2 border-dashed border-purple-500/40 space-y-3 min-h-[220px]" onclick="assignCurrentToBucket('irregular')">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <h3 class="font-bold text-purple-400 text-base flex items-center gap-2">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Irregular Verbs (Vowel Change / Unique)
                            </h3>
                            <span id="irregCount" class="text-xs bg-slate-800 px-2.5 py-1 rounded-full text-slate-300 font-bold">0</span>
                        </div>
                        <div id="irregularBucket" class="flex flex-wrap gap-2 pt-2"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: PAIR SPEAKING & STORY BUILDER -->
        <section id="sec-speaking" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-blue-900/60 text-blue-300 border border-blue-500/40 text-xs font-bold rounded-full uppercase">Pair Work Studio</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Yesterday's Story Builder</h2>
                    <p class="text-sm text-slate-400">Combine past verbs to tell your partner what happened yesterday!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-emerald-400 uppercase block mb-1">Select Verb</label>
                            <select id="storyVerb" onchange="generateStoryPrompt()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                                <!-- Populated dynamically -->
                            </select>
                        </div>

                        <div>
                            <label class="text-xs font-bold text-blue-400 uppercase block mb-1">Action Context / Phrase</label>
                            <input type="text" id="storyContext" value="at 8:00 AM" oninput="generateStoryPrompt()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                        </div>
                    </div>

                    <!-- Audio & Question Box -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest block mb-1">Question Prompt:</span>
                            <p id="storyQuestion" class="text-lg font-bold text-amber-300">"Did you call yesterday?"</p>
                        </div>

                        <div>
                            <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">Affirmative Past Answer:</span>
                            <p id="storyAnswer" class="text-lg font-bold text-emerald-400">"Yes, I called at 8:00 AM."</p>
                        </div>

                        <button onclick="speakText(document.getElementById('storyAnswer').innerText)" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Listen to Answer
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Past Tense Verb Lab • Interactive ESL Activity (A1)
    </footer>

    <script>
        // Verb Dataset matching prompt image
        const verbsList = [
            { id: 'v1', present: 'call', past: 'called', type: 'regular', col: 1, prefilled: true },
            { id: 'v2', present: 'cost', past: 'cost', type: 'irregular', col: 1, prefilled: true },
            { id: 'v3', present: 'do', past: 'did', type: 'irregular', col: 1 },
            { id: 'v4', present: 'find', past: 'found', type: 'irregular', col: 1 },
            { id: 'v5', present: 'get', past: 'got', type: 'irregular', col: 1 },
            { id: 'v6', present: 'go', past: 'went', type: 'irregular', col: 1 },
            { id: 'v7', present: 'have', past: 'had', type: 'irregular', col: 1 },
            { id: 'v8', present: 'leave', past: 'left', type: 'irregular', col: 1 },

            { id: 'v9', present: 'lock', past: 'locked', type: 'regular', col: 2 },
            { id: 'v10', present: 'open', past: 'opened', type: 'regular', col: 2 },
            { id: 'v11', present: 'pay', past: 'paid', type: 'irregular', col: 2 },
            { id: 'v12', present: 'put', past: 'put', type: 'irregular', col: 2 },
            { id: 'v13', present: 'remember', past: 'remembered', type: 'regular', col: 2 },
            { id: 'v14', present: 'see', past: 'saw', type: 'irregular', col: 2 },
            { id: 'v15', present: 'take', past: 'took', type: 'irregular', col: 2 },
            { id: 'v16', present: 'try', past: 'tried', type: 'regular', col: 2 }
        ];

        let selectedSortVerb = null;
        let sortState = { regular: [], irregular: [] };
        let timerSeconds = 900;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderChart();
            renderSortBank();
            populateStorySelect();
        });

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Render Chart
        function renderChart() {
            const col1 = document.getElementById('col1-verbs');
            const col2 = document.getElementById('col2-verbs');

            col1.innerHTML = '';
            col2.innerHTML = '';

            verbsList.forEach(v => {
                const targetCol = v.col === 1 ? col1 : col2;
                const row = document.createElement('div');
                row.className = 'grid grid-cols-2 items-center gap-2 bg-slate-800/80 p-2 rounded-lg border border-slate-700/60';

                if (v.prefilled) {
                    row.innerHTML = `
                        <span class="text-xs font-bold text-slate-300 flex items-center gap-2">
                            <i class="fa-solid fa-play text-[10px] text-emerald-400"></i> ${v.present}
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-extrabold text-emerald-400 bg-emerald-950/60 border border-emerald-500/40 px-3 py-1.5 rounded-lg italic">${v.past}</span>
                            <button onclick="speakText('${v.present} ... ${v.past}')" class="text-slate-400 hover:text-white text-xs"><i class="fa-solid fa-volume-high"></i></button>
                        </div>
                    `;
                } else {
                    row.innerHTML = `
                        <span class="text-xs font-bold text-slate-300 flex items-center gap-2">
                            <i class="fa-solid fa-play text-[10px] text-slate-500"></i> ${v.present}
                        </span>
                        <div class="flex items-center gap-1.5">
                            <input type="text" id="input-${v.id}" placeholder="..." class="verb-input bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-white font-bold w-full uppercase placeholder:normal-case">
                            <button onclick="speakText('${v.present}')" class="text-slate-500 hover:text-white text-xs px-1"><i class="fa-solid fa-volume-high"></i></button>
                        </div>
                    `;
                }
                targetCol.appendChild(row);
            });
        }

        function checkChartAnswers() {
            let correct = 0;
            let totalInteractive = verbsList.filter(v => !v.prefilled).length;

            verbsList.filter(v => !v.prefilled).forEach(v => {
                const input = document.getElementById(`input-${v.id}`);
                const userVal = input.value.trim().toLowerCase();

                if (userVal === v.past) {
                    correct++;
                    input.className = "verb-input bg-emerald-950/80 border-2 border-emerald-500 rounded-lg px-2.5 py-1 text-xs text-emerald-200 font-bold w-full uppercase";
                } else {
                    input.className = "verb-input bg-rose-950/80 border-2 border-rose-500 rounded-lg px-2.5 py-1 text-xs text-rose-200 font-bold w-full uppercase";
                }
            });

            if (correct === totalInteractive) {
                confetti({ particleCount: 50, spread: 70 });
                alert("🎉 Perfect! All past tense forms are correct!");
            } else {
                alert(`You got ${correct} out of ${totalInteractive} correct. Keep practicing!`);
            }
        }

        function revealAnswers() {
            verbsList.filter(v => !v.prefilled).forEach(v => {
                const input = document.getElementById(`input-${v.id}`);
                input.value = v.past;
                input.className = "verb-input bg-emerald-950/80 border-2 border-emerald-500 rounded-lg px-2.5 py-1 text-xs text-emerald-200 font-bold w-full uppercase";
            });
        }

        // Sorting Activity
        function renderSortBank() {
            const container = document.getElementById('sortBank');
            container.innerHTML = '';

            const unassigned = verbsList.filter(v => !sortState.regular.includes(v.id) && !sortState.irregular.includes(v.id));

            if (unassigned.length === 0) {
                container.innerHTML = `<span class="text-xs text-emerald-400 font-bold"><i class="fa-solid fa-check-double"></i> All verbs categorized!</span>`;
                return;
            }

            unassigned.forEach(v => {
                const isSelected = selectedSortVerb && selectedSortVerb.id === v.id;
                const chip = document.createElement('button');
                chip.className = `px-3 py-1.5 rounded-xl border text-xs font-bold transition flex items-center gap-1.5 ${
                    isSelected ? 'bg-amber-500 text-slate-900 border-amber-300 scale-105 shadow-md' : 'bg-slate-800 border-slate-700 text-slate-200 hover:border-slate-500'
                }`;
                chip.innerHTML = `<i class="fa-solid fa-font text-amber-400"></i> ${v.present} (${v.past})`;
                chip.onclick = () => {
                    selectedSortVerb = v;
                    renderSortBank();
                    speakText(`${v.present}, ${v.past}`);
                };
                container.appendChild(chip);
            });
        }

        function assignCurrentToBucket(type) {
            if (!selectedSortVerb) {
                alert("Click a verb from the available list above first!");
                return;
            }

            if (selectedSortVerb.type !== type) {
                alert(`Incorrect! "${selectedSortVerb.present} → ${selectedSortVerb.past}" is not a ${type} verb.`);
                return;
            }

            sortState[type].push(selectedSortVerb.id);
            selectedSortVerb = null;
            renderSortBank();
            renderBuckets();
        }

        function renderBuckets() {
            const regContainer = document.getElementById('regularBucket');
            const irregContainer = document.getElementById('irregularBucket');

            regContainer.innerHTML = '';
            irregContainer.innerHTML = '';

            sortState.regular.forEach(id => {
                const v = verbsList.find(item => item.id === id);
                regContainer.innerHTML += `
                    <span class="bg-emerald-950/80 border border-emerald-500/50 text-emerald-200 px-3 py-1 rounded-lg text-xs font-bold flex items-center gap-1">
                        ${v.present} → <strong>${v.past}</strong>
                    </span>
                `;
            });

            sortState.irregular.forEach(id => {
                const v = verbsList.find(item => item.id === id);
                irregContainer.innerHTML += `
                    <span class="bg-purple-950/80 border border-purple-500/50 text-purple-200 px-3 py-1 rounded-lg text-xs font-bold flex items-center gap-1">
                        ${v.present} → <strong>${v.past}</strong>
                    </span>
                `;
            });

            document.getElementById('regCount').innerText = sortState.regular.length;
            document.getElementById('irregCount').innerText = sortState.irregular.length;
        }

        // Speaking Generator
        function populateStorySelect() {
            const select = document.getElementById('storyVerb');
            select.innerHTML = '';

            verbsList.forEach(v => {
                const opt = document.createElement('option');
                opt.value = v.id;
                opt.innerText = `${v.present} (past: ${v.past})`;
                select.appendChild(opt);
            });

            generateStoryPrompt();
        }

        function generateStoryPrompt() {
            const verbId = document.getElementById('storyVerb').value;
            const context = document.getElementById('storyContext').value || "yesterday";
            const v = verbsList.find(item => item.id === verbId);

            document.getElementById('storyQuestion').innerText = `"Did you ${v.present} ${context}?"`;
            document.getElementById('storyAnswer').innerText = `"Yes, I ${v.past} ${context}."`;
        }

        // Navigation
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
