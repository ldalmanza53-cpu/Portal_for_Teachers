    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: INTERACTIVE MAP BUILDER -->
        <section id="sec-builder" class="tab-content block space-y-6">
            
            <!-- Selection Palette & Rule Card -->
