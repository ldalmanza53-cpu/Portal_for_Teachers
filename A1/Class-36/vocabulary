                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-700 pb-3">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-store text-blue-400"></i> Place Selector Palette
                        </h2>
                        <p class="text-xs text-slate-400">
                            Choose items to add to empty slots. <strong class="text-amber-400">Rule:</strong> Plural words (cafés, drugstores, gas stations) must be placed 2+ times!
                        </p>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
