                                <div id="slot-my-4" onclick="handleSlotClick('my', 4)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-blue-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
