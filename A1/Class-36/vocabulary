                            <!-- Column 3: Second Avenue -->
                            <div class="space-y-3">
                                <span class="text-[10px] font-bold text-slate-400 block text-center uppercase">Second Avenue</span>
                                <div id="slot-my-5" onclick="handleSlotClick('my', 5)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-blue-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Empty Slot 5</span>
                                </div>
                                <div id="slot-my-6" onclick="handleSlotClick('my', 6)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-blue-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Empty Slot 6</span>
                                </div>
                                <div class="bg-purple-800/40 p-3 rounded-lg border border-purple-400/40 text-center font-bold text-xs text-purple-200">
                                    <i class="fa-solid fa-book text-cyan-400 block text-base mb-1"></i> Library
                                </div>
                            </div>
                        </div>
