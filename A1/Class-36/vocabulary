                </div>

                <!-- MY PARTNER'S MAP -->
                <div class="bg-slate-800 rounded-2xl p-5 border border-indigo-500/40 shadow-xl space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-700 pb-2">
                        <h3 class="text-lg font-bold text-indigo-400 flex items-center gap-2">
                            <i class="fa-solid fa-user-group"></i> My Partner's Map
                        </h3>
                        <span class="text-[11px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded font-bold">Fill during pair interview</span>
                    </div>

                    <!-- Map Board Graphic -->
                    <div class="bg-indigo-900/20 p-4 rounded-xl border border-indigo-500/30 relative space-y-3 min-h-[380px]">
                        <!-- Street Labels -->
                        <div class="text-[11px] font-extrabold uppercase tracking-widest text-indigo-300 text-center py-1 bg-indigo-950/60 rounded border border-indigo-500/30">
                            Center Street
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            <!-- Column 1: First Avenue -->
                            <div class="space-y-3">
                                <span class="text-[10px] font-bold text-slate-400 block text-center uppercase">First Avenue</span>
                                <div class="bg-purple-800/40 p-3 rounded-lg border border-purple-400/40 text-center font-bold text-xs text-purple-200">
                                    <i class="fa-solid fa-cart-shopping text-emerald-400 block text-base mb-1"></i> Grocery Store
                                </div>
                                <div id="slot-partner-1" onclick="handleSlotClick('partner', 1)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
