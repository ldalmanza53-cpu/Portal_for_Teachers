                                </div>
                                <div id="slot-partner-2" onclick="handleSlotClick('partner', 2)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Partner Slot 2</span>
                                </div>
                                <div class="bg-purple-800/40 p-3 rounded-lg border border-purple-400/40 text-center font-bold text-xs text-purple-200">
                                    <i class="fa-solid fa-envelope text-amber-400 block text-base mb-1"></i> Post Office
                                </div>
                            </div>

                            <!-- Column 2: Center Block -->
                            <div class="space-y-3">
                                <span class="text-[10px] font-bold text-slate-400 block text-center uppercase">Center Block</span>
                                <div class="bg-emerald-900/40 p-3 rounded-lg border border-emerald-500/40 text-center font-bold text-xs text-emerald-300">
                                    <i class="fa-solid fa-tree block text-base mb-1"></i> Park
                                </div>
                                <div id="slot-partner-3" onclick="handleSlotClick('partner', 3)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Partner Slot 3</span>
                                </div>
                                <div id="slot-partner-4" onclick="handleSlotClick('partner', 4)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Partner Slot 4</span>
                                </div>
                            </div>

                            <!-- Column 3: Second Avenue -->
                            <div class="space-y-3">
                                <span class="text-[10px] font-bold text-slate-400 block text-center uppercase">Second Avenue</span>
                                <div id="slot-partner-5" onclick="handleSlotClick('partner', 5)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Partner Slot 5</span>
                                </div>
                                <div id="slot-partner-6" onclick="handleSlotClick('partner', 6)" class="map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-indigo-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center">
                                    <span class="text-[10px] text-slate-500 font-bold">+ Partner Slot 6</span>
                                </div>
                                <div class="bg-purple-800/40 p-3 rounded-lg border border-purple-400/40 text-center font-bold text-xs text-purple-200">
                                    <i class="fa-solid fa-book text-cyan-400 block text-base mb-1"></i> Library
