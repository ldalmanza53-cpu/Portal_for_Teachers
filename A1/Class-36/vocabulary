        <!-- TAB 2: PAIR INTERVIEW QUESTION SCAFFOLD -->
        <section id="sec-interview" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-blue-900/60 text-blue-300 border border-blue-500/40 text-xs font-bold rounded-full uppercase">Speaking Assistant</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Pair Question & Answer Generator</h2>
                    <p class="text-sm text-slate-400">Use this tool to ask your partner where items are located on their map!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <!-- Step 1: Choose Place -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-blue-400 uppercase">1. Select Target Place</label>
                        <select id="scaffoldPlace" onchange="generateScaffold()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-blue-500">
                            <option value="a bank|singular">a bank</option>
                            <option value="a bookstore|singular">a bookstore</option>
                            <option value="cafés|plural">cafés</option>
                            <option value="drugstores|plural">drugstores</option>
                            <option value="gas stations|plural">gas stations</option>
                            <option value="a gym|singular">a gym</option>
                            <option value="a theater|singular">a theater</option>
                        </select>
                    </div>

                    <!-- Step 2: Choose Location -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-amber-400 uppercase">2. Select Street / Area</label>
                        <select id="scaffoldLocation" onchange="generateScaffold()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-blue-500">
                            <option value="on First Avenue">on First Avenue</option>
                            <option value="on Second Avenue">on Second Avenue</option>
                            <option value="on Center Street">on Center Street</option>
                            <option value="next to the park">next to the park</option>
                            <option value="across from the library">across from the library</option>
                        </select>
                    </div>

                    <!-- Step 3: Choose Plural Count -->
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-indigo-400 uppercase">3. Quantity (If Plural)</label>
                        <select id="scaffoldCount" onchange="generateScaffold()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-blue-500">
                            <option value="one">one</option>
                            <option value="two">two</option>
                            <option value="three">three</option>
                        </select>
                    </div>
                </div>

                <!-- Outputs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-3">
                        <span class="text-xs font-bold text-blue-400 uppercase tracking-widest">Question To Ask Partner:</span>
                        <p id="generatedQuestion" class="text-lg font-bold text-white">"Is there a bank on First Avenue?"</p>
                        <button onclick="speakText(document.getElementById('generatedQuestion').innerText)" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3 py-2 rounded-xl transition">
                            <i class="fa-solid fa-volume-high"></i> Listen
                        </button>
                    </div>

                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 space-y-3">
                        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Partner Answer Options:</span>
                        <div id="generatedAnswer" class="text-sm font-bold text-slate-200 space-y-1">
                            <p class="text-emerald-400">Yes: "Yes, there is a bank on First Avenue."</p>
                            <p class="text-rose-400">No: "No, there isn't a bank on First Avenue."</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 3: INSTRUCTIONS & RULES -->
        <section id="sec-guide" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-amber-900/60 text-amber-300 border border-amber-500/40 text-xs font-bold rounded-full uppercase">Activity Guidelines</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Classroom Lesson Rules</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-base font-bold text-amber-400 flex items-center gap-2">
                            <i class="fa-solid fa-list-check"></i> Primary Vocabulary List
                        </h3>
                        <ul class="text-xs text-slate-300 space-y-2">
                            <li class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-blue-400"></i> a bank (singular)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-book text-blue-400"></i> a bookstore (singular)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-mug-hot text-amber-400"></i> cafés (plural - place 2+)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-pills text-amber-400"></i> drugstores (plural - place 2+)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-gas-pump text-amber-400"></i> gas stations (plural - place 2+)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-dumbbell text-blue-400"></i> a gym (singular)</li>
                            <li class="flex items-center gap-2"><i class="fa-solid fa-masks-theater text-blue-400"></i> a theater (singular)</li>
                        </ul>
                    </div>

                    <div class="bg-slate-900 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-base font-bold text-blue-400 flex items-center gap-2">
                            <i class="fa-solid fa-circle-info"></i> Grammar Key: There is / There are
                        </h3>
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs space-y-2 text-slate-300">
                            <p>• Use <strong>"There is a..."</strong> for singular places (a bank, a gym, a theater).</p>
                            <p>• Use <strong>"There are [two/three]..."</strong> for plural places (cafés, drugstores, gas stations).</p>
                            <p>• <strong>Plural Rule:</strong> Any plural word added must appear 2 or more times on the map!</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Neighborhood Map Creator • Interactive ESL Activity (A1)
    </footer>

    <script>
        // Vocabulary Dataset
        const placesPalette = [
            { id: 'bank', name: 'a bank', type: 'singular', icon: 'fa-building-columns', color: 'text-blue-400' },
            { id: 'bookstore', name: 'a bookstore', type: 'singular', icon: 'fa-book-open', color: 'text-emerald-400' },
            { id: 'cafes', name: 'cafés', type: 'plural', icon: 'fa-mug-hot', color: 'text-amber-400' },
            { id: 'drugstores', name: 'drugstores', type: 'plural', icon: 'fa-pills', color: 'text-rose-400' },
            { id: 'gas_stations', name: 'gas stations', type: 'plural', icon: 'fa-gas-pump', color: 'text-orange-400' },
            { id: 'gym', name: 'a gym', type: 'singular', icon: 'fa-dumbbell', color: 'text-purple-400' },
            { id: 'theater', name: 'a theater', type: 'singular', icon: 'fa-masks-theater', color: 'text-cyan-400' }
        ];

        // State
        let selectedPlace = null;
        let myMapData = {};
        let partnerMapData = {};
        let timerSeconds = 900;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderPalette();
            generateScaffold();
        });

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Render Palette Chips
        function renderPalette() {
            const container = document.getElementById('paletteContainer');
            container.innerHTML = '';

            placesPalette.forEach(item => {
                const isSelected = selectedPlace && selectedPlace.id === item.id;
                const chip = document.createElement('div');
                chip.className = `place-chip px-3 py-2 rounded-xl border text-xs font-bold flex items-center gap-2 ${
                    isSelected ? 'bg-blue-600 text-white border-blue-400 shadow-md scale-105' : 'bg-slate-900 border-slate-700 text-slate-300 hover:border-slate-500'
                }`;
                chip.innerHTML = `<i class="fa-solid ${item.icon} ${isSelected ? 'text-white' : item.color}"></i> ${item.name} <span class="text-[9px] opacity-60">(${item.type})</span>`;
                chip.onclick = () => {
                    selectedPlace = item;
                    renderPalette();
                    speakText(item.name);
                };
                container.appendChild(chip);
            });
        }

        // Slot Click Handler
        function handleSlotClick(mapType, slotId) {
            if (!selectedPlace) {
                alert("Please select a place from the palette above first!");
                return;
            }

            const targetMap = mapType === 'my' ? myMapData : partnerMapData;
            targetMap[slotId] = { ...selectedPlace };

            renderSlot(mapType, slotId, selectedPlace);
            updatePlacedCount();

            // Plural rule checker & audio feedback
            speakText(`Placed ${selectedPlace.name}`);
        }

        function renderSlot(mapType, slotId, item) {
            const el = document.getElementById(`slot-${mapType}-${slotId}`);
            el.className = "map-slot bg-slate-800 border-2 border-solid border-blue-500 p-2 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center relative shadow-md";
            el.innerHTML = `
                <i class="fa-solid ${item.icon} ${item.color} text-lg mb-1"></i>
                <span class="text-xs font-bold text-white leading-tight capitalize">${item.name}</span>
                <button onclick="event.stopPropagation(); removeSlot('${mapType}', ${slotId})" class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-rose-600 text-white rounded-full text-[10px] flex items-center justify-center font-bold">✕</button>
            `;
        }

        function removeSlot(mapType, slotId) {
            const targetMap = mapType === 'my' ? myMapData : partnerMapData;
            delete targetMap[slotId];

            const el = document.getElementById(`slot-${mapType}-${slotId}`);
            el.className = `map-slot bg-slate-900/90 border-2 border-dashed border-slate-600 hover:border-${mapType === 'my' ? 'blue' : 'indigo'}-400 p-3 rounded-lg text-center cursor-pointer min-h-[70px] flex flex-col items-center justify-center`;
            el.innerHTML = `<span class="text-[10px] text-slate-500 font-bold">+ ${mapType === 'my' ? 'Empty' : 'Partner'} Slot ${slotId}</span>`;

            updatePlacedCount();
        }

        function updatePlacedCount() {
            const count = Object.keys(myMapData).length;
            document.getElementById('placesPlacedCount').innerText = `Places Placed: ${count} / 5`;

            if (count === 5) {
                confetti({ particleCount: 40, spread: 60 });
            }
        }

        function resetAllMaps() {
            myMapData = {};
            partnerMapData = {};
            selectedPlace = null;
            renderPalette();

            for (let i = 1; i <= 6; i++) {
                removeSlot('my', i);
                removeSlot('partner', i);
            }
        }

        // Question Scaffold Generator
        function generateScaffold() {
            const placeVal = document.getElementById('scaffoldPlace').value.split('|');
            const placeText = placeVal[0];
            const isPlural = placeVal[1] === 'plural';
            const location = document.getElementById('scaffoldLocation').value;
            const countText = document.getElementById('scaffoldCount').value;

            const questionEl = document.getElementById('generatedQuestion');
            const answerEl = document.getElementById('generatedAnswer');

            if (isPlural) {
                questionEl.innerText = `"Are there any ${placeText} ${location}?"`;
                answerEl.innerHTML = `
                    <p class="text-emerald-400">Yes: "Yes, there are ${countText} ${placeText} ${location}."</p>
                    <p class="text-rose-400">No: "No, there aren't any ${placeText} ${location}."</p>
                `;
            } else {
                questionEl.innerText = `"Is there ${placeText} ${location}?"`;
                answerEl.innerHTML = `
                    <p class="text-emerald-400">Yes: "Yes, there is ${placeText} ${location}."</p>
                    <p class="text-rose-400">No: "No, there isn't ${placeText} ${location}."</p>
                `;
            }
        }

        // Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
