<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yard Sale Shopping & Bargaining Studio</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Nunito & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Nunito', 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Subtle pulse for active speaking line */
        @keyframes active-speaking {
            0%, 100% { border-color: #0d9488; background-color: #f0fdfa; }
            50% { border-color: #0d9488; background-color: #ccfbf1; }
        }
        .speaking-highlight {
            animation: active-speaking 1.2s infinite ease-in-out;
        }

        /* Drag over effect */
        .drag-over-slot {
            border-color: #0284c7 !important;
            background-color: #e0f2fe !important;
            transform: scale(1.01);
        }

        .gradient-header {
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 50%, #1e293b 100%);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-50">

    <!-- Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('unscramble')">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 to-teal-600 flex items-center justify-center text-white shadow-md shadow-amber-200">
                    <i class="fa-solid fa-store text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-slate-800 tracking-tight leading-none">Yard Sale Studio</h1>
                    <span class="text-xs font-bold text-teal-600 tracking-wider uppercase">Shopping & Bargaining • Lesson 6</span>
                </div>
            </div>

            <!-- Controls: Sound Toggle, Wallet & Score -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <button id="soundToggleBtn" onclick="toggleSound()" class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-bold flex items-center transition">
                    <i id="soundIcon" class="fa-solid fa-volume-high text-teal-600 mr-1.5 sm:mr-2"></i>
                    <span id="soundText" class="hidden sm:inline">Sound: ON</span>
                </button>

                <div class="flex items-center bg-emerald-50 border border-emerald-200 px-2.5 py-1.5 rounded-xl text-emerald-800 text-xs sm:text-sm font-black">
                    <i class="fa-solid fa-wallet text-emerald-600 mr-1.5"></i>
                    <span id="globalWalletDisplay">$100</span>
                </div>

                <div class="flex items-center bg-amber-50 border border-amber-200 px-2.5 py-1.5 rounded-xl text-amber-800 text-xs sm:text-sm font-black">
                    <i class="fa-solid fa-star text-amber-500 mr-1.5"></i>
                    <span id="globalScoreDisplay">0 pts</span>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-100 border-t border-slate-200/80 px-4">
            <div class="max-w-7xl mx-auto flex space-x-2 sm:space-x-3 overflow-x-auto py-2 no-scrollbar">
                <button id="tab-unscramble" onclick="switchTab('unscramble')" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-black flex items-center whitespace-nowrap transition bg-teal-600 text-white shadow-sm">
                    <i class="fa-solid fa-arrow-down-short-wide mr-2"></i> 1. Dialogue Order
                </button>
                <button id="tab-simulator" onclick="switchTab('simulator')" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-black flex items-center whitespace-nowrap transition text-slate-600 hover:bg-slate-200">
                    <i class="fa-solid fa-cart-shopping mr-2"></i> 2. Yard Sale Game
                </button>
                <button id="tab-roleplay" onclick="switchTab('roleplay')" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-black flex items-center whitespace-nowrap transition text-slate-600 hover:bg-slate-200">
                    <i class="fa-solid fa-users mr-2"></i> 3. Role-Play Studio
                </button>
                <button id="tab-grammar" onclick="switchTab('grammar')" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-black flex items-center whitespace-nowrap transition text-slate-600 hover:bg-slate-200">
                    <i class="fa-solid fa-book-open mr-2"></i> 4. Grammar & Quiz
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- SECTION 1: DIALOGUE ORDER CHALLENGE -->
        <section id="section-unscramble" class="tab-section block space-y-6">
            <!-- Instruction Card -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <div class="inline-flex items-center space-x-2 bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-extrabold mb-2">
                        <i class="fa-solid fa-layer-group mr-1"></i> PAIR WORK EXERCISE 6A
                    </div>
                    <h2 class="text-2xl font-black text-slate-800">Unscramble the Yard Sale Conversations</h2>
                    <p class="text-slate-600 text-sm mt-1">
                        Arrange the mixed lines into correct order (1 to 6). Tap the up/down arrows or listen to sentences for guidance!
                    </p>
                </div>
                <div class="flex items-center space-x-2 shrink-0">
                    <button onclick="checkUnscrambleAnswers()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-sm rounded-xl shadow-md shadow-emerald-200 transition transform active:scale-95 flex items-center">
                        <i class="fa-solid fa-circle-check mr-2"></i> Check Answers
                    </button>
                    <button onclick="resetUnscramble()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm rounded-xl transition flex items-center">
                        <i class="fa-solid fa-rotate-left mr-1.5"></i> Reset
                    </button>
                </div>
            </div>

            <!-- Conversations Container -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Conversation 1 Box -->
                <div class="bg-white rounded-2xl border-2 border-slate-200 p-5 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center space-x-2">
                            <span class="w-8 h-8 rounded-xl bg-teal-100 text-teal-800 font-black flex items-center justify-center text-sm">1</span>
                            <h3 class="font-extrabold text-slate-800 text-lg">Conversation 1 (Ring & Earrings)</h3>
                        </div>
                        <span id="conv1StatusBadge" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-500">Unverified</span>
                    </div>

                    <div id="conv1List" class="space-y-2.5">
                        <!-- Rendered by JS -->
                    </div>
                </div>

                <!-- Conversation 2 Box -->
                <div class="bg-white rounded-2xl border-2 border-slate-200 p-5 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center space-x-2">
                            <span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-800 font-black flex items-center justify-center text-sm">2</span>
                            <h3 class="font-extrabold text-slate-800 text-lg">Conversation 2 (MP3 Player Bargaining)</h3>
                        </div>
                        <span id="conv2StatusBadge" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-500">Unverified</span>
                    </div>

                    <div id="conv2List" class="space-y-2.5">
                        <!-- Rendered by JS -->
                    </div>
                </div>

            </div>
        </section>

        <!-- SECTION 2: VIRTUAL YARD SALE GAME SIMULATOR -->
        <section id="section-simulator" class="tab-section hidden space-y-6">
            
            <!-- Yard Sale Banner Header -->
            <div class="gradient-header rounded-3xl p-6 text-white shadow-md relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="relative z-10 space-y-2 text-center md:text-left">
                    <span class="bg-amber-400 text-slate-900 text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">Interactive Game</span>
                    <h2 class="text-3xl font-black tracking-tight">The Outdoor Yard Sale Stall</h2>
                    <p class="text-teal-100 text-sm max-w-xl">
                        Select items on the stall, use correct grammar ("How much is this..." vs "How much are these..."), and practice bargaining with the seller!
                    </p>
                </div>
                <!-- Interactive Wallet Bag Display -->
                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-4 text-center shrink-0 w-full md:w-auto">
                    <div class="text-xs font-extrabold uppercase tracking-wider text-amber-300 mb-1">My Shopping Bag</div>
                    <div id="shoppingBagCount" class="text-2xl font-black text-white">0 Items Bought</div>
                    <div id="shoppingBagItems" class="flex flex-wrap justify-center gap-1.5 mt-2 max-w-xs">
                        <span class="text-xs text-teal-200 italic">No items purchased yet</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Stall Table View (8 Cols) -->
                <div class="lg:col-span-7 space-y-4">
                    <div class="bg-amber-50 rounded-2xl border-2 border-amber-200 p-4 flex items-center justify-between">
                        <div class="text-sm font-extrabold text-amber-900 flex items-center">
                            <i class="fa-solid fa-hand-pointer mr-2 text-amber-600"></i> Tap an item on the sale table:
                        </div>
                        <span class="text-xs font-bold text-amber-700 bg-amber-200/60 px-2.5 py-1 rounded-lg">8 Items on Sale</span>
                    </div>

                    <!-- Items Grid -->
                    <div id="stallItemsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <!-- Dynamically injected items -->
                    </div>
                </div>

                <!-- Interactive Dialogue Stage (5 Cols) -->
                <div class="lg:col-span-5 bg-white rounded-2xl border-2 border-slate-200 p-5 shadow-sm flex flex-col justify-between min-h-[460px]">
                    
                    <!-- NPC Seller & Dialog Header -->
                    <div>
                        <div class="flex items-center space-x-3 pb-4 border-b border-slate-100">
                            <div class="w-12 h-12 rounded-2xl bg-teal-500 text-white flex items-center justify-center text-xl shadow-md shrink-0">
                                👩‍🌾
                            </div>
                            <div>
                                <h3 id="sellerName" class="font-extrabold text-slate-800 text-base leading-tight">Mrs. Clara (Yard Sale Seller)</h3>
                                <p id="sellerStatusText" class="text-xs text-teal-600 font-bold">"Welcome! Feel free to look around."</p>
                            </div>
                        </div>

                        <!-- Current Selected Item Box -->
                        <div id="selectedItemPreviewBox" class="my-4 p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center space-x-3">
                            <div id="simItemSvg" class="w-14 h-14 bg-white rounded-lg p-1 border border-slate-200 shrink-0 flex items-center justify-center">
                                <i class="fa-solid fa-basket-shopping text-slate-300 text-2xl"></i>
                            </div>
                            <div>
                                <h4 id="simItemTitle" class="font-black text-slate-800 text-sm">No Item Selected</h4>
                                <p id="simItemGrammarType" class="text-xs font-bold text-slate-400">Tap an item on the left table to start!</p>
                            </div>
                        </div>

                        <!-- Dialogue Step Log / Speech Bubble -->
                        <div id="simSpeechBubble" class="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-slate-800 text-sm font-semibold space-y-2 relative">
                            <p id="simSpeechText" class="font-extrabold text-teal-900">"Hello! What would you like to ask about?"</p>
                        </div>
                    </div>

                    <!-- Interactive Action Options -->
                    <div id="simActionOptionsContainer" class="mt-4 space-y-2">
                        <p class="text-xs font-extrabold text-slate-400 uppercase tracking-wider">Your Response (Buyer):</p>
                        
                        <!-- Step Options dynamic buttons injected here -->
                        <div id="simOptionsButtons" class="space-y-2">
                            <div class="p-4 text-center bg-slate-100 rounded-xl text-xs text-slate-500 font-bold">
                                Select an item from the stall to open dialogue options!
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <!-- SECTION 3: PARTNER ROLE-PLAY STUDIO -->
        <section id="section-roleplay" class="tab-section hidden space-y-6">
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <span class="bg-sky-100 text-sky-800 text-xs font-extrabold px-3 py-1 rounded-full uppercase">Classroom Pair Practice</span>
                    <h2 class="text-2xl font-black text-slate-800 mt-2">Partner Role-Play Studio</h2>
                    <p class="text-slate-600 text-sm mt-1">Practice talking with a partner or practice listening to native speech line by line.</p>
                </div>

                <!-- Scene Selector -->
                <div class="flex items-center space-x-2">
                    <label class="text-xs font-bold text-slate-500 uppercase">Select Scene:</label>
                    <select id="roleplaySceneSelect" onchange="loadRoleplayScene(this.value)" class="bg-slate-100 border border-slate-300 font-extrabold text-slate-800 text-sm rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-teal-500">
                        <option value="scene1">Scene 1: Ring & Earrings ($12 / $20)</option>
                        <option value="scene2">Scene 2: MP3 Player Bargaining ($40 -> $30)</option>
                        <option value="scene3">Scene 3: Lamp & Flip-Flops ($15 / $10)</option>
                    </select>
                </div>
            </div>

            <!-- Role Play Interactive Runner -->
            <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm space-y-6">
                
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center space-x-3">
                        <button onclick="playFullRoleplayAudio()" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white font-black text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center">
                            <i class="fa-solid fa-circle-play mr-2"></i> Play Entire Dialogue
                        </button>
                        <button onclick="stopAudio()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
                            <i class="fa-solid fa-stop mr-1"></i> Stop
                        </button>
                    </div>

                    <div class="text-xs font-bold text-slate-400">
                        Target Language Focus: <span class="text-teal-700 font-black">How much is / How much are</span>
                    </div>
                </div>

                <!-- Line-by-line Script Cards -->
                <div id="roleplayScriptContainer" class="space-y-4">
                    <!-- Script items rendered via JS -->
                </div>

            </div>
        </section>

        <!-- SECTION 4: GRAMMAR REFERENCE & QUICK QUIZ -->
        <section id="section-grammar" class="tab-section hidden space-y-6">
            
            <!-- Grammar Reference Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- Singular Rule Card -->
                <div class="bg-white rounded-2xl border-2 border-teal-200 p-5 shadow-sm space-y-3">
                    <div class="flex items-center space-x-2 text-teal-700 font-black text-lg border-b border-teal-100 pb-2">
                        <i class="fa-solid fa-cube"></i>
                        <h3>1. Singular Items (1 Thing)</h3>
                    </div>
                    <p class="text-xs text-slate-600">Use <strong>is this / It's</strong> for 1 item (ring, MP3 player, shirt, belt, lamp):</p>
                    <div class="bg-teal-50 p-3 rounded-xl border border-teal-100 text-xs sm:text-sm font-bold text-teal-900 space-y-1">
                        <div>❓ <em>"How much <strong>is this</strong> ring?"</em></div>
                        <div>💬 <em>"<strong>It's</strong> twelve dollars."</em></div>
                    </div>
                </div>

                <!-- Plural Rule Card -->
                <div class="bg-white rounded-2xl border-2 border-amber-200 p-5 shadow-sm space-y-3">
                    <div class="flex items-center space-x-2 text-amber-700 font-black text-lg border-b border-amber-100 pb-2">
                        <i class="fa-solid fa-cubes"></i>
                        <h3>2. Plural Items (2+ Things)</h3>
                    </div>
                    <p class="text-xs text-slate-600">Use <strong>are these / They're</strong> for plural/pair items (earrings, socks, flip-flops):</p>
                    <div class="bg-amber-50 p-3 rounded-xl border border-amber-100 text-xs sm:text-sm font-bold text-amber-900 space-y-1">
                        <div>❓ <em>"How much <strong>are these</strong> earrings?"</em></div>
                        <div>💬 <em>"<strong>They're</strong> twenty dollars."</em></div>
                    </div>
                </div>

            </div>

            <!-- Bargaining Tactics Box -->
            <div class="bg-gradient-to-r from-slate-800 to-teal-900 text-white rounded-2xl p-5 shadow-sm space-y-3">
                <h3 class="font-black text-lg text-amber-300 flex items-center">
                    <i class="fa-solid fa-comments-dollar mr-2"></i> Useful Yard Sale Bargaining Expressions
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs sm:text-sm font-bold">
                    <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                        <span class="text-amber-300 block mb-1">Expressing Price Concern:</span>
                        "Oh, that's pretty expensive."
                    </div>
                    <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                        <span class="text-amber-300 block mb-1">Suggesting Lower Price:</span>
                        "Well, how about thirty dollars?"
                    </div>
                    <div class="bg-white/10 p-3 rounded-xl border border-white/10">
                        <span class="text-amber-300 block mb-1">Making Decision:</span>
                        "OK. I'll take it." / "I'll think about it."
                    </div>
                </div>
            </div>

            <!-- Quick Pop Quiz -->
            <div class="bg-white rounded-2xl border-2 border-slate-200 p-6 shadow-sm space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <div>
                        <span class="bg-purple-100 text-purple-700 text-xs font-black px-2.5 py-1 rounded-full uppercase">Check Knowledge</span>
                        <h3 class="text-xl font-black text-slate-800 mt-1">Rapid Grammar Quiz</h3>
                    </div>
                    <span id="quizProgressText" class="text-xs font-extrabold text-slate-400">Question 1 of 5</span>
                </div>

                <div id="quizCardBox" class="space-y-4 py-2">
                    <!-- Quiz question content injected by JS -->
                </div>
            </div>

        </section>

    </main>

    <script>
        /* ==========================================
           1. DATA MODELS & STATE
           ========================================== */
        
        // Textbook Conversation 1 data
        const RAW_CONV_1 = [
            { id: 1, text: "Hello. Can I help you?", speaker: "Seller", role: "seller", order: 1 },
