                { speaker: "Buyer", role: "buyer", text: "Yes, how much is this MP3 player?", focus: "Singular Question" },
                { speaker: "Seller", role: "seller", text: "It's forty dollars.", focus: "Singular Answer" },
                { speaker: "Buyer", role: "buyer", text: "Oh, that's pretty expensive.", focus: "Bargaining Concern" },
                { speaker: "Seller", role: "seller", text: "Well, how about thirty dollars?", focus: "Counter-offer" },
                { speaker: "Buyer", role: "buyer", text: "OK. I'll take it.", focus: "Decision (Buy)" }
            ],
            scene3: [
                { speaker: "Seller", role: "seller", text: "Hello! Welcome to our yard sale.", focus: "Greeting" },
                { speaker: "Buyer", role: "buyer", text: "Hi! How much is this vintage lamp?", focus: "Singular Question" },
                { speaker: "Seller", role: "seller", text: "It's fifteen dollars.", focus: "Singular Answer" },
                { speaker: "Buyer", role: "buyer", text: "And how much are these rubber flip-flops?", focus: "Plural Question" },
                { speaker: "Seller", role: "seller", text: "They're ten dollars.", focus: "Plural Answer" },
                { speaker: "Buyer", role: "buyer", text: "Great! I'll take the flip-flops.", focus: "Decision" }
            ]
        };

        function loadRoleplayScene(sceneKey) {
            const script = ROLEPLAY_SCENES[sceneKey] || ROLEPLAY_SCENES.scene1;
            const container = document.getElementById('roleplayScriptContainer');
            container.innerHTML = '';

            script.forEach((line, idx) => {
                const isSeller = line.role === 'seller';
                const card = document.createElement('div');
                card.id = `rpLine-${idx}`;
                card.className = `p-4 rounded-2xl border-2 transition flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${
                    isSeller ? 'bg-teal-50/70 border-teal-200' : 'bg-sky-50/70 border-sky-200'
                }`;

                card.innerHTML = `
                    <div class="flex items-start space-x-3">
                        <span class="w-7 h-7 rounded-lg text-xs font-black flex items-center justify-center shrink-0 ${
                            isSeller ? 'bg-teal-600 text-white' : 'bg-sky-600 text-white'
                        }">${idx + 1}</span>
                        <div>
                            <div class="flex items-center space-x-2 mb-1">
                                <span class="text-xs font-black uppercase ${isSeller ? 'text-teal-800' : 'text-sky-800'}">${line.speaker}</span>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white border border-slate-200 text-slate-600">${line.focus}</span>
                            </div>
                            <p class="text-sm sm:text-base font-black text-slate-800">"${line.text}"</p>
                        </div>
                    </div>

                    <button onclick="playRoleplayLine(${idx}, '${line.text.replace(/'/g, "\\'")}')" class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:border-teal-400 text-slate-700 hover:text-teal-700 font-extrabold text-xs shrink-0 transition flex items-center space-x-1.5 self-end sm:self-auto shadow-sm">
                        <i class="fa-solid fa-volume-high text-teal-600"></i>
                        <span>Listen</span>
                    </button>
                `;

                container.appendChild(card);
            });
        }

        function playRoleplayLine(lineIdx, text) {
            document.querySelectorAll('[id^="rpLine-"]').forEach(el => el.classList.remove('speaking-highlight'));
            const card = document.getElementById(`rpLine-${lineIdx}`);
            if (card) card.classList.add('speaking-highlight');

            speakText(text);
        }

        function playFullRoleplayAudio() {
            const sceneKey = document.getElementById('roleplaySceneSelect').value;
            const script = ROLEPLAY_SCENES[sceneKey] || ROLEPLAY_SCENES.scene1;
            
            let delay = 0;
            script.forEach((line, idx) => {
                setTimeout(() => {
                    playRoleplayLine(idx, line.text);
                }, delay);
                delay += 2500; // time spacing between lines
            });
        }

        /* ==========================================
           5. SECTION 4: GRAMMAR POP QUIZ LOGIC
           ========================================== */

        function renderQuizQuestion() {
            const container = document.getElementById('quizCardBox');
            const q = QUIZ_QUESTIONS[state.quizIndex];

            document.getElementById('quizProgressText').innerText = `Question ${state.quizIndex + 1} of ${QUIZ_QUESTIONS.length}`;

            container.innerHTML = `
                <div class="space-y-4">
                    <h4 class="text-base sm:text-lg font-black text-slate-800">${q.q}</h4>
                    <div id="quizOptionsGrid" class="grid grid-cols-1 gap-2.5">
                        ${q.options.map((opt, i) => `
                            <button onclick="handleQuizAnswer(${i})" class="quiz-opt-btn p-3.5 rounded-xl border-2 border-slate-200 hover:border-indigo-400 bg-slate-50 hover:bg-indigo-50 font-extrabold text-slate-800 text-xs sm:text-sm text-left transition flex items-center justify-between">
                                <span>${opt}</span>
                                <i class="fa-regular fa-circle text-slate-400"></i>
                            </button>
                        `).join('')}
                    </div>
                    <div id="quizFeedbackBox" class="hidden p-4 rounded-xl text-xs sm:text-sm font-bold"></div>
                </div>
            `;
        }

        function handleQuizAnswer(selectedIndex) {
            const q = QUIZ_QUESTIONS[state.quizIndex];
            const isCorrect = selectedIndex === q.correct;
            const feedbackBox = document.getElementById('quizFeedbackBox');

            document.querySelectorAll('.quiz-opt-btn').forEach(btn => btn.disabled = true);

            feedbackBox.classList.remove('hidden');

            if (isCorrect) {
                playCorrectSound();
                addScore(20);
                feedbackBox.className = 'p-4 rounded-xl text-xs sm:text-sm font-bold bg-emerald-100 text-emerald-900 border border-emerald-300';
                feedbackBox.innerHTML = `✅ <strong>Correct!</strong> ${q.explanation}`;
            } else {
                playIncorrectSound();
                feedbackBox.className = 'p-4 rounded-xl text-xs sm:text-sm font-bold bg-rose-100 text-rose-900 border border-rose-300';
                feedbackBox.innerHTML = `❌ <strong>Not quite!</strong> ${q.explanation}`;
            }

            setTimeout(() => {
                state.quizIndex = (state.quizIndex + 1) % QUIZ_QUESTIONS.length;
                renderQuizQuestion();
            }, 3000);
        }

        window.onload = function() {
            initUnscramble();
            renderSimulatorStall();
            loadRoleplayScene('scene1');
        };
    </script>
</body>
</html>
