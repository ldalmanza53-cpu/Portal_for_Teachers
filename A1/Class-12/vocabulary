            { id: 3, text: "It's twelve dollars.", speaker: "Seller", role: "seller", order: 3 },
            { id: 4, text: "And how much are these earrings?", speaker: "Buyer", role: "buyer", order: 4 },
            { id: 5, text: "They're twenty dollars.", speaker: "Seller", role: "seller", order: 5 },
            { id: 6, text: "Thanks. I'll think about it.", speaker: "Buyer", role: "buyer", order: 6 }
        ];

        // Textbook Conversation 2 data
        const RAW_CONV_2 = [
            { id: 1, text: "Can I help you?", speaker: "Seller", role: "seller", order: 1 },
