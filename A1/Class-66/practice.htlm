                                <input type="text" id="dlg-a2" placeholder="(try)" class="p-1.5 px-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 font-semibold focus:ring-2 focus:ring-indigo-500 text-xs w-48">
