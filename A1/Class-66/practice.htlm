                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Part B • Dialogue Completion</span>
                        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100">Future Plans with "Be Going To"</h3>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="app.future.checkDialogue()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition flex items-center space-x-1.5 shadow-sm">
                            <i class="fa-solid fa-check"></i>
                            <span>Check Conversation</span>
                        </button>
                        <button onclick="app.future.autoSolveDialogue()" class="px-3 py-2 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-medium transition">
                            Auto-Fill
