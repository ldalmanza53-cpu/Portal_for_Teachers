                            <span class="font-bold text-slate-700 dark:text-slate-300 min-w-[80px]">Sam:</span>
                            <div class="flex-grow flex flex-wrap items-center gap-1.5">
                                <span>No, he</span>
                                <input type="text" id="dlg-a3_1" placeholder="(not / work)" class="p-1.5 px-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 font-semibold focus:ring-2 focus:ring-indigo-500 text-xs w-44">
                                <span>there. He</span>
                                <input type="text" id="dlg-a3_2" placeholder="(get)" class="p-1.5 px-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 font-semibold focus:ring-2 focus:ring-indigo-500 text-xs w-44">
