        <!-- TAB 4: PRACTICE ARCADE -->
        <section id="tab-arcade" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-700 shadow-sm max-w-4xl mx-auto space-y-6">
                <!-- Arcade Header Bar -->
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <div>
                        <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 uppercase tracking-wider">
                            🕹️ Rapid-Fire Speed Arcade
                        </span>
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mt-1">Grammar & Sentence Scramble Arcade</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Test future tenses and indirect messages against the clock!</p>
                    </div>

                    <!-- Counters -->
                    <div class="flex items-center space-x-4 bg-slate-50 dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 w-full sm:w-auto justify-around">
                        <div class="text-center">
                            <span class="text-[10px] text-slate-400 font-bold block uppercase">TIME</span>
                            <span id="arcade-timer" class="text-xl font-black text-rose-600 dark:text-rose-400">45s</span>
                        </div>
                        <div class="w-px h-8 bg-slate-200 dark:bg-slate-700"></div>
                        <div class="text-center">
                            <span class="text-[10px] text-slate-400 font-bold block uppercase">COMBO</span>
                            <span id="arcade-combo" class="text-xl font-black text-amber-500">x1 🔥</span>
                        </div>
                        <div class="w-px h-8 bg-slate-200 dark:bg-slate-700"></div>
                        <div class="text-center">
                            <span class="text-[10px] text-slate-400 font-bold block uppercase">SCORE</span>
                            <span id="arcade-score" class="text-xl font-black text-indigo-600 dark:text-indigo-400">0</span>
                        </div>
                    </div>
                </div>

                <!-- Start Screen -->
                <div id="arcade-start-screen" class="text-center py-8 space-y-6">
                    <div class="w-20 h-20 bg-indigo-100 dark:bg-indigo-950/60 rounded-full flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-4xl mx-auto shadow-inner">
                        <i class="fa-solid fa-gamepad"></i>
                    </div>

                    <div class="max-w-md mx-auto space-y-2">
                        <h3 class="text-2xl font-extrabold text-slate-800 dark:text-slate-100">Ready for Speed Grammar?</h3>
                        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
                            Assemble scrambled sentences and solve rapid grammar questions before time runs out. Earn +5 seconds bonus for consecutive correct answers!
                        </p>
                    </div>

                    <div class="inline-flex items-center space-x-2 bg-slate-100 dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300">
                        <i class="fa-solid fa-crown text-amber-400"></i>
                        <span>High Score: <strong id="arcade-high-score-val">0</strong> pts</span>
                    </div>

                    <div>
                        <button onclick="app.arcade.startGame()" class="px-8 py-3.5 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-700 hover:to-pink-700 text-white rounded-xl font-bold shadow-lg shadow-indigo-500/25 transition transform hover:-translate-y-0.5 text-base">
                            <i class="fa-solid fa-play mr-2"></i> Start Arcade Challenge
                        </button>
                    </div>
                </div>

                <!-- Gameplay Screen -->
                <div id="arcade-game-screen" class="hidden space-y-6">
                    <!-- Progress Bar -->
                    <div class="w-full bg-slate-100 dark:bg-slate-700 h-2.5 rounded-full overflow-hidden">
                        <div id="arcade-timer-bar" class="bg-rose-500 h-full w-full transition-all duration-200"></div>
                    </div>

                    <!-- Challenge Type Banner -->
                    <div class="flex items-center justify-between">
                        <span id="arcade-category-pill" class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300">
                            Sentence Scramble Challenge
                        </span>
                        <span class="text-xs text-slate-400 font-semibold" id="arcade-prompt-hint">Tap tokens in order</span>
                    </div>

                    <!-- Question / Sentence Prompt -->
                    <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 text-center font-semibold text-sm text-slate-800 dark:text-slate-100" id="arcade-question-prompt">
                        Prompt Question Text
                    </div>

                    <!-- Drop Zone for Scramble Mode -->
                    <div id="arcade-scramble-wrapper" class="space-y-3">
                        <div id="arcade-drop-zone" class="min-h-[64px] p-3 rounded-xl border-2 border-dashed border-indigo-300 dark:border-indigo-700 bg-indigo-50/40 dark:bg-indigo-950/20 flex flex-wrap items-center gap-2">
                            <span class="text-xs text-slate-400 italic">Tap tokens below...</span>
                        </div>
                        <div id="arcade-token-pool" class="min-h-[56px] p-3 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-wrap items-center gap-2">
                            <!-- Tokens -->
                        </div>
                    </div>

                    <!-- Multiple Choice Options for Quiz Mode -->
                    <div id="arcade-quiz-options" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Options -->
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-between pt-2">
                        <button onclick="app.arcade.skipCurrent()" class="px-3 py-1.5 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-xs font-medium transition">
                            <i class="fa-solid fa-forward mr-1"></i> Skip (-5s)
                        </button>

                        <div id="arcade-scramble-actions" class="flex items-center space-x-2">
                            <button onclick="app.arcade.clearTokens()" class="px-3 py-1.5 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-xs font-medium transition">
                                Clear
                            </button>
                            <button onclick="app.arcade.submitScramble()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition shadow-xs flex items-center space-x-1">
                                <i class="fa-solid fa-check"></i>
                                <span>Submit</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Game Over Screen -->
                <div id="arcade-end-screen" class="hidden text-center py-8 space-y-6">
                    <div class="w-20 h-20 bg-amber-100 dark:bg-amber-950/60 rounded-full flex items-center justify-center text-amber-500 text-4xl mx-auto shadow-inner">
                        <i class="fa-solid fa-trophy"></i>
                    </div>

                    <div class="space-y-1">
                        <h3 class="text-3xl font-extrabold text-slate-800 dark:text-slate-100">Time's Up!</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Great effort practicing Interchange Unit 10 Grammar!</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto bg-slate-50 dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div>
                            <span class="text-[10px] text-slate-400 font-bold block uppercase">FINAL SCORE</span>
                            <span id="arcade-res-score" class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400">0</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-400 font-bold block uppercase">MAX COMBO</span>
                            <span id="arcade-res-combo" class="text-2xl font-extrabold text-amber-500">x1</span>
                        </div>
                    </div>

                    <div>
                        <button onclick="app.arcade.startGame()" class="px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-xl font-bold shadow-lg shadow-indigo-500/25 transition transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Play Again
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-6 mt-12 transition-colors">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 dark:text-slate-400 space-y-2">
            <p>ESL Master Suite • Interchange 10 Grammar Plus (SB-198)</p>
            <p>Future Tenses (Present Continuous & Be Going To) & Indirect Messages (Tell & Ask)</p>
        </div>
    </footer>

    <!-- JAVASCRIPT ENGINE -->
    <script>
        const soundFx = {
            ctx: null,
            init() {
                if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            },
            playCorrect() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1);
                osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.35);
            },
            playWrong() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(130, now + 0.2);
                gain.gain.setValueAtTime(0.12, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.25);
            },
            playClick() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                gain.gain.setValueAtTime(0.04, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.05);
            }
        };

        const appState = {
            score: 0,
            streak: 0,
            soundEnabled: true,
            darkMode: false,
            activeTab: 'matrix'
        };

        const app = {
            init() {
                this.loadProgress();
                this.applyTheme();
                this.matrix.init();
                this.future.init();
                this.indirect.init();
                this.simulator.init();
                this.arcade.init();
            },

            loadProgress() {
                const saved = localStorage.getItem('esl_interchange10_save');
                if (saved) {
                    try {
                        const parsed = JSON.parse(saved);
                        appState.score = parsed.score || 0;
                        appState.streak = parsed.streak || 0;
                        appState.soundEnabled = parsed.soundEnabled ?? true;
                        appState.darkMode = parsed.darkMode ?? false;
                    } catch(e) { console.error("Storage error", e); }
                }
                this.updateHeaderStats();
            },

            saveProgress() {
                const data = {
                    score: appState.score,
                    streak: appState.streak,
                    soundEnabled: appState.soundEnabled,
                    darkMode: appState.darkMode
                };
                localStorage.setItem('esl_interchange10_save', JSON.stringify(data));
                this.updateHeaderStats();
            },

            updateHeaderStats() {
                document.getElementById('global-score').textContent = appState.score;
                document.getElementById('global-streak').textContent = appState.streak;
                const soundIcon = document.getElementById('icon-sound');
                if (appState.soundEnabled) {
                    soundIcon.className = 'fa-solid fa-volume-high text-indigo-600 dark:text-indigo-400';
                } else {
                    soundIcon.className = 'fa-solid fa-volume-xmark text-slate-400';
                }
            },

            toggleSound() {
                appState.soundEnabled = !appState.soundEnabled;
                this.saveProgress();
                if (appState.soundEnabled) soundFx.playClick();
            },

            toggleTheme() {
                appState.darkMode = !appState.darkMode;
                this.applyTheme();
                this.saveProgress();
            },

            applyTheme() {
                const html = document.documentElement;
                const themeIcon = document.getElementById('icon-theme');
                if (appState.darkMode) {
                    html.classList.add('dark');
                    html.classList.remove('light');
                    themeIcon.className = 'fa-solid fa-sun text-amber-400';
                } else {
                    html.classList.remove('dark');
                    html.classList.add('light');
                    themeIcon.className = 'fa-solid fa-moon text-slate-600';
                }
            },

            switchTab(tabKey) {
                soundFx.playClick();
                appState.activeTab = tabKey;
                document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
                const target = document.getElementById(`tab-${tabKey}`);
                if (target) target.classList.remove('hidden');

                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.className = 'tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800';
                });
                const activeBtn = document.getElementById(`tab-btn-${tabKey}`);
                if (activeBtn) {
                    activeBtn.className = 'tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 font-semibold shadow-xs';
                }
            },

            speakText(text) {
                if (!appState.soundEnabled) return;
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.rate = 0.9;
                utterance.lang = 'en-US';
                window.speechSynthesis.speak(utterance);
            },

            matrix: {
                mode: 'future',
                init() {
                    this.updateSandbox();
                },
                setSandboxMode(m) {
                    soundFx.playClick();
                    this.mode = m;
                    const fBtn = document.getElementById('sandbox-btn-future');
                    const iBtn = document.getElementById('sandbox-btn-indirect');
                    const fCtrl = document.getElementById('sandbox-future-controls');
                    const iCtrl = document.getElementById('sandbox-indirect-controls');

                    if (m === 'future') {
                        fBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white";
                        iBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300";
                        fCtrl.classList.remove('hidden');
                        iCtrl.classList.add('hidden');
                    } else {
                        iBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white";
                        fBtn.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300";
                        iCtrl.classList.remove('hidden');
                        fCtrl.classList.add('hidden');
                    }
                    this.updateSandbox();
                },
                updateSandbox() {
                    const out = document.getElementById('sandbox-output-text');
                    const val = document.getElementById('sandbox-validation-box');

                    if (this.mode === 'future') {
                        const subj = document.getElementById('sf-subject').value;
                        const aux = document.getElementById('sf-aux').value;
                        const verb = document.getElementById('sf-verb').value;
                        const time = document.getElementById('sf-time').value;

                        let sent = `${subj} ${aux} ${verb} ${time}.`;
                        out.textContent = sent;

                        // Agreement check
                        let agree = true;
                        if (subj === 'I' && aux !== 'am') agree = false;
                        if ((subj === 'We' || subj === 'They') && aux !== 'are') agree = false;
                        if (subj === 'Sam' && aux !== 'is') agree = false;

                        if (agree) {
                            val.className = "p-3 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300";
                            val.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Grammar Validated: Correct subject-verb agreement!`;
                        } else {
                            val.className = "p-3 rounded-lg text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-300";
                            val.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> Agreement Error: Use 'I am', 'Sam is', 'We/They are'.`;
                        }
                    } else {
                        const opener = document.getElementById('si-opener').value;
                        const verb = document.getElementById('si-verb').value;
                        const person = document.getElementById('si-person').value;
                        const conn = document.getElementById('si-connector').value;
                        const clause = document.getElementById('si-clause').value;

                        let punct = (opener === 'Please') ? '.' : '?';
                        let sent = `${opener} ${verb} ${person} ${conn} ${clause}${punct}`;
                        out.textContent = sent;

                        if (verb === 'tell' && conn === 'that') {
                            val.className = "p-3 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300";
                            val.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Valid Indirect Statement: 'tell + person + that + clause'`;
                        } else if (verb === 'ask' && (conn === 'to' || conn === 'not to')) {
                            val.className = "p-3 rounded-lg text-xs font-semibold bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-200 border border-purple-300";
                            val.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Valid Indirect Request: 'ask + person + (not) to + base verb'`;
                        } else {
                            val.className = "p-3 rounded-lg text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-300";
                            val.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> Rule Mismatch: Use 'tell + that' for statements and 'ask + (not) to' for requests.`;
                        }
                    }
                }
            },

            future: {
                partAItems: [
                    {
                        id: 1,
                        text: "Why are you wearing shorts? It's cold outside!",
                        highlight: "are wearing",
                        correct: "P",
                        timePhrase: "None (happening right now)",
                        explanation: "This describes an action occurring at the present moment ('cold outside right now')."
                    },
                    {
                        id: 2,
                        text: "Are you coming to the party on Friday night?",
                        highlight: "Are you coming",
                        correct: "F",
                        timePhrase: "on Friday night",
                        explanation: "The time expression 'on Friday night' indicates a scheduled future arrangement."
                    },
                    {
                        id: 3,
                        text: "What are you doing this weekend?",
                        highlight: "are you doing",
                        correct: "F",
                        timePhrase: "this weekend",
                        explanation: "Inquires about future weekend plans using a future time expression."
                    },
                    {
                        id: 4,
                        text: "Listen! Who is talking at the front door?",
                        highlight: "is talking",
                        correct: "P",
                        timePhrase: "Listen! (right now)",
                        explanation: "'Listen!' signals an action in progress right now."
                    },
                    {
                        id: 5,
                        text: "We are watching the new superhero movie tonight.",
                        highlight: "are watching",
                        correct: "F",
                        timePhrase: "tonight",
                        explanation: "'Tonight' specifies a planned future event."
                    }
                ],

                userASelections: {},

                dialogueAnswers: {
                    'dlg-q1': ["are you going to do"],
                    'dlg-a1': ["am going to take", "'m going to take"],
                    'dlg-q2': ["are you going to live"],
                    'dlg-a2': ["am going to try", "'m going to try"],
                    'dlg-q3': ["is sam going to work"],
                    'dlg-a3_1': ["is not going to work", "isn't going to work"],
                    'dlg-a3_2': ["is going to get", "'s going to get"],
                    'dlg-q4': ["is he going to spend"],
                    'dlg-a4': ["is going to save", "'s going to save"]
                },

                init() {
                    this.renderPartA();
                },

                renderPartA() {
                    const container = document.getElementById('partA-container');
                    container.innerHTML = this.partAItems.map(item => {
                        const userSel = this.userASelections[item.id];
                        const isCorrect = userSel === item.correct;

                        return `
                        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 space-y-3">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div class="flex items-start space-x-3">
                                    <span class="w-6 h-6 rounded-lg bg-amber-500 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">${item.id}</span>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">${item.text.replace(item.highlight, `<u class="decoration-amber-500 decoration-2 font-bold">${item.highlight}</u>`)}</p>
                                        <p class="text-[11px] text-amber-600 dark:text-amber-400 font-bold mt-1">Time Marker: ${item.timePhrase}</p>
                                    </div>
                                </div>

                                <div class="flex items-center space-x-2 shrink-0">
                                    <button onclick="app.future.selectPartA(${item.id}, 'P')" class="px-3 py-1.5 rounded-lg text-xs font-bold border transition ${userSel === 'P' ? (isCorrect ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-rose-600 text-white border-rose-600') : 'border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100'}">
                                        P (Present)
                                    </button>
                                    <button onclick="app.future.selectPartA(${item.id}, 'F')" class="px-3 py-1.5 rounded-lg text-xs font-bold border transition ${userSel === 'F' ? (isCorrect ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-rose-600 text-white border-rose-600') : 'border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100'}">
                                        F (Future)
                                    </button>
                                    <button onclick="app.speakText('${item.text.replace(/'/g, "\\'")}')" class="text-slate-400 hover:text-amber-500 text-xs ml-1"><i class="fa-solid fa-volume-high"></i></button>
                                </div>
                            </div>

                            ${userSel ? `
                                <div class="p-2.5 rounded-lg text-xs font-medium ${isCorrect ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200' : 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200'}">
                                    ${isCorrect ? '✓ Correct! ' : '✗ Incorrect. '}${item.explanation}
                                </div>
                            ` : ''}
                        </div>
                    `;
                    }).join('');

                    const solvedCount = Object.keys(this.userASelections).filter(k => this.userASelections[k] === this.partAItems.find(i=>i.id==k).correct).length;
                    document.getElementById('partA-score').textContent = `${solvedCount} / 5 Correct`;
                },

                selectPartA(id, val) {
                    const item = this.partAItems.find(i => i.id === id);
                    if (val === item.correct) {
                        soundFx.playCorrect();
                        appState.score += 15;
                        appState.streak += 1;
                    } else {
                        soundFx.playWrong();
                    }
                    this.userASelections[id] = val;
                    app.saveProgress();
                    this.renderPartA();
                },

                checkDialogue() {
                    let correctCount = 0;
                    let total = Object.keys(this.dialogueAnswers).length;

                    Object.keys(this.dialogueAnswers).forEach(fieldId => {
                        const input = document.getElementById(fieldId);
                        if (!input) return;
                        const val = input.value.trim().toLowerCase().replace(/\s+/g, ' ');
                        const accepted = this.dialogueAnswers[fieldId];

                        if (accepted.includes(val)) {
                            correctCount++;
                            input.className = "p-1.5 px-3 rounded-lg border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 font-bold text-xs w-48";
                        } else {
                            input.className = "p-1.5 px-3 rounded-lg border-2 border-rose-500 bg-rose-50 dark:bg-rose-950/40 text-rose-900 dark:text-rose-200 font-bold text-xs w-48";
                        }
                    });

                    const fb = document.getElementById('dialogue-feedback');
                    fb.classList.remove('hidden');

                    if (correctCount === total) {
                        soundFx.playCorrect();
                        fb.className = "p-4 rounded-xl text-xs font-semibold leading-relaxed bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300";
                        fb.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Perfect! All ${total} conversation blanks completed accurately with 'be going to'!`;
                        appState.score += 50;
                        app.saveProgress();
                    } else {
                        soundFx.playWrong();
                        fb.className = "p-4 rounded-xl text-xs font-semibold leading-relaxed bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-300";
                        fb.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i> You got ${correctCount} of ${total} blanks correct. Review red boxes and verify am/is/are + going to + verb.`;
                    }
                },

                autoSolveDialogue() {
                    soundFx.playClick();
                    Object.keys(this.dialogueAnswers).forEach(fieldId => {
                        const input = document.getElementById(fieldId);
                        if (input) {
                            input.value = this.dialogueAnswers[fieldId][0];
                            input.className = "p-1.5 px-3 rounded-lg border-2 border-indigo-500 bg-indigo-50 dark:bg-indigo-950/40 font-bold text-xs w-48";
                        }
                    });
                },

                playConversation(num) {
                    let script = "";
                    if (num === 1) {
                        script = "Tony: What are you going to do this summer? Maria: I am going to take a French course in Paris. Tony: Wow! Are you going to live with a host family? Maria: Yes, and I am going to try to speak French every day!";
                    } else {
                        script = "Alex: Is Sam going to work at his uncle's shop this summer? Sam: No, he isn't going to work there. He is going to get a full-time internship. Alex: Great! How is he going to spend his earnings? Sam: He is going to save money for college tuition.";
                    }
                    app.speakText(script);
                }
            },

            indirect: {
                exercises: [
                    {
                        id: 1,
                        speaker: "Patrick",
                        type: "statement",
                        typeLabel: "Statement (Tell + that)",
                        direct: "We don't have class tomorrow.",
                        solutionTokens: ["Please", "tell", "Patrick", "that", "we", "don't have", "class", "tomorrow."],
                        targetSentence: "Please tell Patrick that we don't have class tomorrow."
                    },
                    {
                        id: 2,
                        speaker: "Ana",
                        type: "request",
                        typeLabel: "Request (Ask + to)",
                        direct: "Can you lend me your dictionary?",
                        solutionTokens: ["Could", "you", "ask", "Ana", "to", "lend me", "her dictionary?"],
                        targetSentence: "Could you ask Ana to lend me her dictionary?"
                    },
                    {
                        id: 3,
                        speaker: "Alex",
                        type: "negative_request",
                        typeLabel: "Negative Request (Ask + not to)",
                        direct: "Don't bring extra luggage on the trip.",
                        solutionTokens: ["Please", "ask", "Alex", "not to", "bring", "extra luggage", "on the trip."],
                        targetSentence: "Please ask Alex not to bring extra luggage on the trip."
                    },
                    {
                        id: 4,
                        speaker: "Sarah",
                        type: "statement",
                        typeLabel: "Statement (Tell + that)",
                        direct: "The deadline for the assignment is 5:00 PM.",
                        solutionTokens: ["Would", "you", "tell", "Sarah", "that", "the deadline", "for the assignment", "is 5:00 PM?"],
                        targetSentence: "Would you tell Sarah that the deadline for the assignment is 5:00 PM?"
                    },
                    {
                        id: 5,
                        speaker: "Mr. Davis",
                        type: "negative_request",
                        typeLabel: "Negative Request (Ask + not to)",
                        direct: "Don't forget to submit your lab reports.",
                        solutionTokens: ["Could", "you", "ask", "Mr. Davis", "not to", "forget to submit", "our lab reports?"],
                        targetSentence: "Could you ask Mr. Davis not to forget to submit our lab reports?"
                    }
                ],

                userSelections: {},
                solvedMap: {},

                init() {
                    this.exercises.forEach(ex => {
                        this.userSelections[ex.id] = [];
                        this.solvedMap[ex.id] = false;
                    });
                    this.renderCards();
                    this.updateProgress();
                },

                renderCards() {
                    const container = document.getElementById('indirect-cards-container');
                    container.innerHTML = this.exercises.map(ex => {
                        const isSolved = this.solvedMap[ex.id];
                        const selected = this.userSelections[ex.id] || [];

                        const remainingTokens = ex.solutionTokens.filter((tok, idx) => {
                            const usedInSelected = selected.filter(t => t === tok).length;
                            const occurrencesInSolution = ex.solutionTokens.slice(0, idx + 1).filter(t => t === tok).length;
                            return occurrencesInSolution > usedInSelected;
                        });

                        const badgeColor = ex.type === 'statement'
                            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-300'
                            : ex.type === 'negative_request'
                            ? 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border-rose-300'
                            : 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 border-purple-300';

                        return `
                        <div id="indirect-card-${ex.id}" class="bg-white dark:bg-slate-800 rounded-2xl p-5 sm:p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-700/60 pb-3">
                                <div class="flex items-center space-x-3">
                                    <span class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-extrabold text-sm shrink-0">${ex.id}</span>
                                    <div>
                                        <h4 class="font-bold text-sm text-slate-800 dark:text-slate-100">${ex.speaker}'s Direct Message: "${ex.direct}"</h4>
                                    </div>
                                </div>
                                <span class="text-xs font-extrabold px-2.5 py-1 rounded-md border ${badgeColor} self-start sm:self-auto">
                                    ${ex.typeLabel}
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Constructed Indirect Message:</label>
                                <div class="min-h-[56px] p-3 rounded-xl border-2 border-dashed ${isSolved ? 'border-emerald-500 bg-emerald-50/50 dark:bg-emerald-950/20' : 'border-indigo-200 dark:border-indigo-800/60 bg-indigo-50/30 dark:bg-indigo-950/10'} flex flex-wrap items-center gap-2">
                                    ${selected.length === 0
                                        ? `<span class="text-xs text-slate-400 italic">Tap token pills below to assemble sentence...</span>`
                                        : selected.map((tok, i) => `
                                            <button onclick="app.indirect.removeToken(${ex.id}, ${i})" class="token-item px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-semibold text-xs sm:text-sm shadow-xs hover:bg-indigo-700 transition flex items-center space-x-1.5">
                                                <span>${tok}</span>
                                                <i class="fa-solid fa-xmark text-[10px] opacity-70"></i>
                                            </button>
                                        `).join('')
                                    }
                                </div>
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Word Tokens:</label>
                                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-wrap items-center gap-2 min-h-[52px]">
                                    ${remainingTokens.map(tok => `
                                        <button onclick="app.indirect.addToken(${ex.id}, '${tok.replace(/'/g, "\\'")}')" class="token-item px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 text-slate-800 dark:text-slate-100 rounded-lg font-medium text-xs sm:text-sm shadow-xs transition">
                                            ${tok}
                                        </button>
                                    `).join('')}
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
                                <div id="indirect-feedback-${ex.id}" class="text-xs font-bold min-h-[20px] flex items-center space-x-1.5">
                                    ${isSolved ? `<span class="text-emerald-600 dark:text-emerald-400"><i class="fa-solid fa-circle-check"></i> Solved!</span>` : ''}
                                </div>

                                <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
                                    <button onclick="app.indirect.resetItem(${ex.id})" class="px-3 py-1.5 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-medium">Clear</button>
                                    <button onclick="app.indirect.showSolution(${ex.id})" class="px-3 py-1.5 bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 rounded-lg text-xs font-bold">Solution</button>
                                    <button onclick="app.indirect.checkItem(${ex.id})" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold flex items-center space-x-1">
                                        <i class="fa-solid fa-check"></i><span>Check</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    }).join('');
                },

                addToken(id, tokenStr) {
                    soundFx.playClick();
                    if (this.solvedMap[id]) return;
                    this.userSelections[id].push(tokenStr);
                    this.renderCards();
                },

                removeToken(id, index) {
                    soundFx.playClick();
                    if (this.solvedMap[id]) return;
                    this.userSelections[id].splice(index, 1);
                    this.renderCards();
                },

                checkItem(id) {
                    const ex = this.exercises.find(e => e.id === id);
                    const userStr = (this.userSelections[id] || []).join(' ');
                    const fb = document.getElementById(`indirect-feedback-${id}`);

                    if (userStr === ex.targetSentence) {
                        this.solvedMap[id] = true;
                        soundFx.playCorrect();
                        app.speakText(ex.targetSentence);
                        if (fb) {
                            fb.className = "text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center space-x-1.5";
                            fb.innerHTML = `<i class="fa-solid fa-circle-check"></i> Correct Solution!`;
                        }
                        appState.score += 25;
                        appState.streak += 1;
                        app.saveProgress();
                    } else {
                        soundFx.playWrong();
                        if (fb) {
                            fb.className = "text-xs font-bold text-rose-600 dark:text-rose-400 flex items-center space-x-1.5";
                            fb.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Incorrect. Ensure connector (${ex.type === 'statement' ? 'that' : ex.type === 'negative_request' ? 'not to' : 'to'}) is used.`;
                        }
                    }
                    this.renderCards();
                    this.updateProgress();
                },

                showSolution(id) {
                    const ex = this.exercises.find(e => e.id === id);
                    this.userSelections[id] = [...ex.solutionTokens];
                    this.solvedMap[id] = true;
                    soundFx.playClick();
                    this.renderCards();
                    this.updateProgress();
                },

                resetItem(id) {
                    this.userSelections[id] = [];
                    this.solvedMap[id] = false;
                    soundFx.playClick();
                    this.renderCards();
                    this.updateProgress();
                },

                checkAll() {
                    this.exercises.forEach(ex => {
                        const userStr = (this.userSelections[ex.id] || []).join(' ');
                        if (userStr === ex.targetSentence) {
                            this.solvedMap[ex.id] = true;
                        }
                    });
                    soundFx.playCorrect();
                    this.renderCards();
                    this.updateProgress();
                },

                resetAll() {
                    soundFx.playClick();
                    this.exercises.forEach(ex => {
                        this.userSelections[ex.id] = [];
                        this.solvedMap[ex.id] = false;
                    });
                    this.renderCards();
                    this.updateProgress();
                },

                updateProgress() {
                    const count = Object.values(this.solvedMap).filter(Boolean).length;
                    document.getElementById('indirect-progress-text').textContent = `${count} of 5 Solved`;
                    const pct = (count / 5) * 100;
                    document.getElementById('indirect-progress-bar').style.width = `${pct}%`;
                }
            },

            simulator: {
                scenarios: [
                    {
                        id: 0,
                        targetPerson: "Patrick",
                        role: "Classmate",
                        type: "statement",
                        directMessage: "We don't have class tomorrow.",
                        actionPrompt: "Forward message to Patrick's study group.",
                        options: [
                            { text: "Please tell Patrick that we don't have class tomorrow.", correct: true, reason: "Correct! Uses 'tell + person + that + statement'." },
                            { text: "Please ask Patrick to we don't have class tomorrow.", correct: false, reason: "Incorrect. ASK + to is for action requests, not statements." },
                            { text: "Would you tell Patrick to not have class tomorrow?", correct: false, reason: "Incorrect. 'We don't have class' is information, not a request." }
                        ]
                    },
                    {
                        id: 1,
                        targetPerson: "Ana",
                        role: "Library Partner",
                        type: "request",
                        directMessage: "Can you lend me your dictionary?",
                        actionPrompt: "Forward dictionary request to Ana.",
                        options: [
                            { text: "Could you ask Ana to lend me her dictionary?", correct: true, reason: "Correct! Uses 'ask + person + to + base verb'." },
                            { text: "Could you tell Ana that lend me her dictionary?", correct: false, reason: "Incorrect. TELL + that requires a subject and clause." },
                            { text: "Please ask Ana that lend me her dictionary?", correct: false, reason: "Incorrect. Use 'ask + to' for requests." }
                        ]
                    },
                    {
                        id: 2,
                        targetPerson: "Alex",
                        role: "Travel Partner",
                        type: "negative_request",
                        directMessage: "Don't bring extra luggage on the trip.",
                        actionPrompt: "Forward luggage reminder to Alex.",
                        options: [
                            { text: "Please ask Alex not to bring extra luggage on the trip.", correct: true, reason: "Correct! Uses 'ask + person + not to + base verb' for negative requests." },
                            { text: "Please tell Alex that don't bring extra luggage on the trip.", correct: false, reason: "Incorrect. Cannot put imperative 'don't bring' directly after 'that'." },
                            { text: "Could you ask Alex to don't bring extra luggage?", correct: false, reason: "Incorrect. Negative infinitives use 'not to', not 'to don't'." }
                        ]
                    },
                    {
                        id: 3,
                        targetPerson: "Sarah",
                        role: "Project Leader",
                        type: "statement",
                        directMessage: "The deadline for the assignment is 5:00 PM.",
                        actionPrompt: "Forward deadline info to Sarah.",
                        options: [
                            { text: "Would you tell Sarah that the deadline for the assignment is 5:00 PM?", correct: true, reason: "Correct! Uses 'tell + person + that + clause'." },
                            { text: "Would you ask Sarah to the deadline is 5:00 PM?", correct: false, reason: "Incorrect. Cannot use 'ask + to' with a statement clause." }
                        ]
                    },
                    {
                        id: 4,
                        targetPerson: "Mr. Davis",
                        role: "Lab Instructor",
                        type: "negative_request",
                        directMessage: "Don't forget to submit your lab reports.",
                        actionPrompt: "Forward lab reminder from Mr. Davis.",
                        options: [
                            { text: "Could you ask Mr. Davis not to forget to submit our lab reports?", correct: true, reason: "Correct! Uses negative infinitive 'ask + person + not to + base verb'." },
                            { text: "Could you tell Mr. Davis that not forget to submit lab reports?", correct: false, reason: "Incorrect. Missing subject in the 'that' clause." }
                        ]
                    }
                ],

                currentIndex: 0,
                completedMap: {},

                init() {
                    this.renderList();
                    this.loadScenario(0);
                },

                renderList() {
                    const listEl = document.getElementById('simulator-scenario-list');
                    listEl.innerHTML = this.scenarios.map((sc, i) => {
                        const isDone = this.completedMap[i];
                        const isActive = i === this.currentIndex;

                        return `
                        <button onclick="app.simulator.loadScenario(${i})" class="w-full text-left p-3.5 rounded-xl border transition flex items-center justify-between ${isActive ? 'border-indigo-500 bg-indigo-50 dark:bg-indigo-950/40 shadow-xs' : 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-slate-300'}">
                            <div class="flex items-center space-x-3 truncate">
                                <div class="w-8 h-8 rounded-full ${sc.type === 'statement' ? 'bg-emerald-500' : sc.type === 'negative_request' ? 'bg-rose-500' : 'bg-purple-600'} text-white flex items-center justify-center font-bold text-xs shrink-0">
                                    ${sc.targetPerson[0]}
                                </div>
                                <div class="truncate">
                                    <h4 class="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100 truncate">${sc.targetPerson}</h4>
                                    <p class="text-[10px] text-slate-400 truncate">${sc.directMessage}</p>
                                </div>
                            </div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded ${isDone ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-500 dark:bg-slate-800'}">
                                ${isDone ? 'Done ✓' : sc.type === 'statement' ? 'Tell' : 'Ask'}
                            </span>
                        </button>
                    `;
                    }).join('');
                },

                loadScenario(idx) {
                    soundFx.playClick();
                    this.currentIndex = idx;
                    const sc = this.scenarios[idx];

                    document.getElementById('sim-avatar').textContent = sc.targetPerson[0];
                    document.getElementById('sim-contact-name').textContent = sc.targetPerson;
                    document.getElementById('sim-contact-role').textContent = sc.role;
                    document.getElementById('sim-type-badge').textContent = sc.type === 'statement' ? 'Statement' : sc.type === 'negative_request' ? 'Neg. Request' : 'Request';

                    document.getElementById('sim-sender-label').textContent = `${sc.targetPerson}'s Message:`;
                    document.getElementById('sim-direct-message-text').textContent = `"${sc.directMessage}"`;
                    document.getElementById('sim-action-prompt').textContent = sc.actionPrompt;

                    document.getElementById('sim-response-bubble').classList.add('hidden');
                    document.getElementById('sim-explanation-banner').classList.add('hidden');

                    const optsEl = document.getElementById('sim-options-container');
                    optsEl.innerHTML = sc.options.map((opt, optIdx) => `
                        <button onclick="app.simulator.chooseOption(${optIdx})" class="w-full text-left p-3 rounded-xl border border-slate-700 bg-slate-800 hover:bg-slate-700 hover:border-indigo-500 text-xs text-slate-100 font-medium transition flex items-start space-x-2">
                            <span class="font-bold text-indigo-400 text-xs">${String.fromCharCode(65 + optIdx)}.</span>
                            <span>${opt.text}</span>
                        </button>
                    `).join('');

                    this.renderList();
                },

                chooseOption(optIdx) {
                    const sc = this.scenarios[this.currentIndex];
                    const opt = sc.options[optIdx];

                    const bubble = document.getElementById('sim-response-bubble');
                    const textEl = document.getElementById('sim-user-message-text');
                    const expEl = document.getElementById('sim-explanation-banner');

                    bubble.classList.remove('hidden');
                    textEl.textContent = opt.text;

                    expEl.classList.remove('hidden');

                    if (opt.correct) {
                        soundFx.playCorrect();
                        app.speakText(opt.text);
                        this.completedMap[this.currentIndex] = true;

                        document.getElementById('sim-user-bubble-bg').className = "bg-emerald-600 text-white p-3.5 rounded-2xl rounded-tr-none text-sm shadow-xs";
                        expEl.className = "mt-3 p-3 rounded-xl text-xs font-semibold leading-relaxed bg-emerald-950/80 text-emerald-200 border border-emerald-700";
                        expEl.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> ${opt.reason}`;

                        appState.score += 20;
                        appState.streak += 1;
                        app.saveProgress();
                    } else {
                        soundFx.playWrong();
                        document.getElementById('sim-user-bubble-bg').className = "bg-rose-600 text-white p-3.5 rounded-2xl rounded-tr-none text-sm shadow-xs";
                        expEl.className = "mt-3 p-3 rounded-xl text-xs font-semibold leading-relaxed bg-rose-950/80 text-rose-200 border border-rose-700";
                        expEl.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> ${opt.reason}`;
                    }

                    const doneCount = Object.values(this.completedMap).filter(Boolean).length;
                    document.getElementById('simulator-score').textContent = `${doneCount} / ${this.scenarios.length}`;
                    this.renderList();
                }
            },

            arcade: {
                pool: [
                    {
                        kind: 'scramble',
                        cat: 'Indirect Message',
                        tokens: ["Please", "tell", "Patrick", "that", "we", "don't have", "class", "tomorrow."],
                        target: "Please tell Patrick that we don't have class tomorrow.",
                        prompt: "Construct indirect statement for Patrick:"
                    },
                    {
                        kind: 'scramble',
                        cat: 'Indirect Request',
                        tokens: ["Could", "you", "ask", "Ana", "to", "lend me", "her dictionary?"],
                        target: "Could you ask Ana to lend me her dictionary?",
                        prompt: "Construct indirect request for Ana:"
                    },
                    {
                        kind: 'scramble',
                        cat: 'Negative Request',
                        tokens: ["Please", "ask", "Alex", "not to", "bring", "extra luggage", "on the trip."],
                        target: "Please ask Alex not to bring extra luggage on the trip.",
                        prompt: "Construct negative indirect request for Alex:"
                    },
                    {
                        kind: 'quiz',
                        cat: 'Future Tenses',
                        prompt: "'We are watching the new movie tonight.' - What does 'are watching' express here?",
                        options: [
                            { text: "Action happening right now", correct: false },
                            { text: "Scheduled future arrangement", correct: true },
                            { text: "Past completed habit", correct: false },
                            { text: "General scientific fact", correct: false }
                        ]
                    },
                    {
                        kind: 'quiz',
                        cat: 'Indirect Messages',
                        prompt: "Which connector is required after 'ASK' when making a negative request?",
                        options: [
                            { text: "not to", correct: true },
                            { text: "to not", correct: false },
                            { text: "that no", correct: false },
                            { text: "don't to", correct: false }
                        ]
                    }
                ],

                timer: 45,
                timerInterval: null,
                score: 0,
                combo: 1,
                maxCombo: 1,
                currentPuzzle: null,
                selectedTokens: [],

                init() {
                    const savedHigh = localStorage.getItem('esl_arcade_high_score') || 0;
                    document.getElementById('arcade-high-score-val').textContent = savedHigh;
                },

                startGame() {
                    soundFx.playClick();
                    this.timer = 45;
                    this.score = 0;
                    this.combo = 1;
                    this.maxCombo = 1;

                    document.getElementById('arcade-start-screen').classList.add('hidden');
                    document.getElementById('arcade-end-screen').classList.add('hidden');
                    document.getElementById('arcade-game-screen').classList.remove('hidden');

                    this.loadNextPuzzle();
                    this.startTimer();
                },

                startTimer() {
                    clearInterval(this.timerInterval);
                    this.timerInterval = setInterval(() => {
                        this.timer--;
                        document.getElementById('arcade-timer').textContent = `${this.timer}s`;
                        const pct = (this.timer / 45) * 100;
                        document.getElementById('arcade-timer-bar').style.width = `${Math.max(0, pct)}%`;

                        if (this.timer <= 0) {
                            this.endGame();
                        }
                    }, 1000);
                },

                loadNextPuzzle() {
                    const randIdx = Math.floor(Math.random() * this.pool.length);
                    this.currentPuzzle = this.pool[randIdx];
                    this.selectedTokens = [];

                    document.getElementById('arcade-category-pill').textContent = this.currentPuzzle.cat;
                    document.getElementById('arcade-question-prompt').textContent = this.currentPuzzle.prompt;
                    document.getElementById('arcade-combo').textContent = `x${this.combo} 🔥`;
                    document.getElementById('arcade-score').textContent = this.score;

                    const scrambleWrap = document.getElementById('arcade-scramble-wrapper');
                    const scrambleActions = document.getElementById('arcade-scramble-actions');
                    const quizOptions = document.getElementById('arcade-quiz-options');

                    if (this.currentPuzzle.kind === 'scramble') {
                        scrambleWrap.classList.remove('hidden');
                        scrambleActions.classList.remove('hidden');
                        quizOptions.classList.add('hidden');
                        document.getElementById('arcade-prompt-hint').textContent = "Tap tokens in correct order";
                        this.renderTokens();
                    } else {
                        scrambleWrap.classList.add('hidden');
                        scrambleActions.classList.add('hidden');
                        quizOptions.classList.remove('hidden');
                        document.getElementById('arcade-prompt-hint').textContent = "Select correct grammar answer";

                        quizOptions.innerHTML = this.currentPuzzle.options.map((opt, i) => `
                            <button onclick="app.arcade.answerQuiz(${opt.correct})" class="p-3 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 rounded-xl text-xs font-bold text-left text-slate-800 dark:text-slate-100 transition">
                                ${String.fromCharCode(65 + i)}. ${opt.text}
                            </button>
                        `).join('');
                    }
                },

                renderTokens() {
                    const dropZone = document.getElementById('arcade-drop-zone');
                    const poolZone = document.getElementById('arcade-token-pool');

                    if (this.selectedTokens.length === 0) {
                        dropZone.innerHTML = `<span class="text-xs text-slate-400 italic">Tap tokens below...</span>`;
                    } else {
                        dropZone.innerHTML = this.selectedTokens.map((tok, i) => `
                            <button onclick="app.arcade.removeToken(${i})" class="token-item px-3 py-1.5 bg-indigo-600 text-white rounded-lg font-bold text-xs shadow-xs flex items-center space-x-1">
                                <span>${tok}</span>
                                <i class="fa-solid fa-xmark text-[10px] opacity-70"></i>
                            </button>
                        `).join('');
                    }

                    const remaining = [...this.currentPuzzle.tokens];
                    this.selectedTokens.forEach(st => {
                        const idx = remaining.indexOf(st);
                        if (idx !== -1) remaining.splice(idx, 1);
                    });

                    const shuffled = [...remaining].sort(() => Math.random() - 0.5);

                    poolZone.innerHTML = shuffled.map(tok => `
                        <button onclick="app.arcade.addToken('${tok.replace(/'/g, "\\'")}')" class="token-item px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-indigo-500 text-slate-800 dark:text-slate-100 rounded-lg font-medium text-xs shadow-xs transition">
                            ${tok}
                        </button>
                    `).join('');
                },

                addToken(tokStr) {
                    soundFx.playClick();
                    this.selectedTokens.push(tokStr);
                    this.renderTokens();
                },

                removeToken(idx) {
                    soundFx.playClick();
                    this.selectedTokens.splice(idx, 1);
                    this.renderTokens();
                },

                clearTokens() {
                    soundFx.playClick();
                    this.selectedTokens = [];
                    this.renderTokens();
                },

                skipCurrent() {
                    soundFx.playWrong();
                    this.timer = Math.max(0, this.timer - 5);
                    this.combo = 1;
                    this.loadNextPuzzle();
                },

                submitScramble() {
                    const assembled = this.selectedTokens.join(' ');
                    if (assembled === this.currentPuzzle.target) {
                        this.handleSuccess();
                    } else {
                        this.handleFailure();
                    }
                },

                answerQuiz(isCorrect) {
                    if (isCorrect) {
                        this.handleSuccess();
                    } else {
                        this.handleFailure();
                    }
                },

                handleSuccess() {
                    soundFx.playCorrect();
                    this.score += 50 * this.combo;
                    this.timer = Math.min(45, this.timer + 5);
                    this.combo++;
                    if (this.combo > this.maxCombo) this.maxCombo = this.combo;

                    appState.score += 30;
                    app.saveProgress();

                    this.loadNextPuzzle();
                },

                handleFailure() {
                    soundFx.playWrong();
                    this.combo = 1;
                    document.getElementById('arcade-combo').textContent = `x${this.combo} 🔥`;
                },

                endGame() {
                    clearInterval(this.timerInterval);
                    soundFx.playWrong();

                    document.getElementById('arcade-game-screen').classList.add('hidden');
                    document.getElementById('arcade-end-screen').classList.remove('hidden');

                    document.getElementById('arcade-res-score').textContent = this.score;
                    document.getElementById('arcade-res-combo').textContent = `x${this.maxCombo}`;

                    const currentHigh = parseInt(localStorage.getItem('esl_arcade_high_score') || '0', 10);
                    if (this.score > currentHigh) {
                        localStorage.setItem('esl_arcade_high_score', this.score);
                        document.getElementById('arcade-high-score-val').textContent = this.score;
                    }
                }
            }
        };

        window.addEventListener('DOMContentLoaded', () => {
            app.init();
        });
    </script>
</body>
</html>
