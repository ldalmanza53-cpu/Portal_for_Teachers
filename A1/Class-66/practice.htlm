                <!-- Conversation 1 Box -->
                <div class="bg-slate-50 dark:bg-slate-900/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-200 dark:border-slate-700 pb-2">
                        <h4 class="font-bold text-sm text-indigo-600 dark:text-indigo-400 flex items-center gap-2">
                            <i class="fa-solid fa-comments"></i> Conversation 1: Summer Trip to Paris
                        </h4>
                        <button onclick="app.future.playConversation(1)" class="text-xs font-bold px-3 py-1 bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 rounded-lg hover:bg-indigo-200 transition flex items-center space-x-1">
                            <i class="fa-solid fa-play"></i>
                            <span>Listen Conversation</span>
                        </button>
