                        <button onclick="app.speakText(document.getElementById('sandbox-output-text').textContent)" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold transition flex items-center space-x-1">
                            <i class="fa-solid fa-volume-high"></i>
                            <span>Listen</span>
                        </button>
                    </div>

                    <p id="sandbox-output-text" class="text-lg font-bold text-slate-800 dark:text-slate-100 font-mono">
                        I am going to take a French course this summer.
                    </p>

                    <!-- Grammar Validation Indicator -->
                    <div id="sandbox-validation-box" class="p-3 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300">
                        <i class="fa-solid fa-circle-check mr-1"></i> Grammar Validated: Correct future intention structure!
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: FUTURE TENSES LAB -->
        <section id="tab-future" class="tab-content hidden space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-amber-500 via-orange-600 to-indigo-600 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <div class="flex items-center space-x-2 mb-3">
                        <span class="px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider rounded-full">
                            Interchange 10 SB-198 • Exercise 1
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">Future Tenses Lab: Present vs. Future & Be Going To</h2>
                    <p class="text-amber-100 text-sm sm:text-base leading-relaxed">
                        Practice identifying whether Present Continuous describes <strong>Present (P)</strong> or <strong>Future (F)</strong> actions, and complete dialogue roleplays using <strong>be going to</strong>.
                    </p>
                </div>
            </div>

            <!-- PART A: Present vs Future Classification -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-3 flex justify-between items-center">
