                    </div>
                    <div class="w-32 bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                        <div id="indirect-progress-bar" class="bg-indigo-600 h-full w-0 transition-all duration-300"></div>
                    </div>
                </div>

                <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
