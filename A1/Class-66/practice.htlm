        <!-- TAB 3: INDIRECT MESSAGES LAB -->
        <section id="tab-indirect" class="tab-content hidden space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-purple-600 via-indigo-600 to-emerald-600 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-3xl">
                    <div class="flex items-center space-x-2 mb-3">
                        <span class="px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider rounded-full">
                            Interchange 10 SB-198 • Exercise 2
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">Indirect Messages Lab: Statements & Requests</h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Convert direct speech into indirect messages using <strong class="underline decoration-emerald-300">tell + that</strong>, <strong class="underline decoration-purple-300">ask + to</strong>, and <strong class="underline decoration-rose-300">negative infinitives (ask + not to)</strong>.
                    </p>
                </div>
            </div>

            <!-- Global Lab Progress -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
