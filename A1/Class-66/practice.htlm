                        <i class="fa-solid fa-check-double"></i>
                        <span>Check All Items</span>
                    </button>
                    <button onclick="app.indirect.resetAll()" class="px-3 py-2 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs sm:text-sm font-medium transition">
