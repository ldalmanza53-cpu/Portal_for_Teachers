            </div>

            <!-- Interactive Office & Chat Forwarding Simulator -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Real-World Application</span>
