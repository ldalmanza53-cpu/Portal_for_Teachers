                            <span class="font-bold text-slate-700 dark:text-slate-300 min-w-[80px]">Tony:</span>
                            <div class="flex-grow flex flex-wrap items-center gap-1.5">
                                <span>Wow!</span>
                                <input type="text" id="dlg-q2" placeholder="(you / live)" class="p-1.5 px-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 font-semibold focus:ring-2 focus:ring-indigo-500 text-xs w-48">
                                <span>with a host family?</span>
                            </div>
