<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ESL Master Suite: Interchange Unit 10 Grammar Plus</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        },
                        tell: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        ask: {
                            50: '#faf5ff',
                            100: '#f3e8ff',
                            500: '#a855f7',
                            600: '#9333ea',
                            700: '#7e22ce',
                        },
                        future: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        heading: ['Outfit', 'Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome CDN for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.6);
        }
        .token-item {
            user-select: none;
            touch-action: manipulation;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        @keyframes pulseSuccess {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); box-shadow: 0 0 20px rgba(34, 197, 94, 0.4); }
            100% { transform: scale(1); }
        }
        @keyframes pulseError {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
            100% { transform: scale(1); }
        }
        .animate-success {
            animation: pulseSuccess 0.4s ease-in-out;
        }
        .animate-error {
            animation: pulseError 0.4s ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- APP HEADER -->
    <header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-amber-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <h1 class="text-base sm:text-xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-600 bg-clip-text text-transparent">
                        ESL Master Suite
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium hidden sm:block">
                        Interchange 10 Grammar Plus (SB-198) • <span class="text-amber-600 dark:text-amber-400 font-bold">Future Tenses</span> & <span class="text-indigo-600 dark:text-indigo-400 font-bold">Indirect Messages</span>
                    </p>
                </div>
            </div>

            <!-- Global Score, Streak & Utilities -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <!-- Streak Badge -->
                <div class="flex items-center space-x-1.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 text-amber-700 dark:text-amber-300 px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold" title="Current Streak">
                    <i class="fa-solid fa-fire text-amber-500 animate-bounce"></i>
                    <span id="global-streak">0</span>
                </div>

                <!-- Total Score Badge -->
                <div class="flex items-center space-x-1.5 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full text-xs sm:text-sm font-bold" title="Total Points">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span id="global-score">0</span>
                    <span class="text-xs text-indigo-400 dark:text-indigo-500">pts</span>
                </div>

                <!-- Audio Toggle Button -->
                <button id="btn-toggle-sound" onclick="app.toggleSound()" class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition" title="Toggle Sound FX & Speech Audio">
                    <i id="icon-sound" class="fa-solid fa-volume-high text-indigo-600 dark:text-indigo-400"></i>
                </button>

                <!-- Theme Toggle Button -->
                <button id="btn-toggle-theme" onclick="app.toggleTheme()" class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition" title="Toggle Theme">
                    <i id="icon-theme" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- NAVIGATION TABS -->
    <nav class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 sm:px-8 sticky top-16 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto flex space-x-2 sm:space-x-4 overflow-x-auto py-2.5 no-scrollbar">
            <button onclick="app.switchTab('matrix')" id="tab-btn-matrix" class="tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 font-semibold shadow-xs">
                <i class="fa-solid fa-book-open"></i>
                <span>📚 Grammar Matrix</span>
            </button>
            <button onclick="app.switchTab('future')" id="tab-btn-future" class="tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-crystal-ball"></i>
                <span>🔮 Future Tenses Lab</span>
            </button>
            <button onclick="app.switchTab('indirect')" id="tab-btn-indirect" class="tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-comments"></i>
                <span>💬 Indirect Messages Lab</span>
            </button>
            <button onclick="app.switchTab('arcade')" id="tab-btn-arcade" class="tab-btn flex items-center space-x-2 px-4 py-2 rounded-xl font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-gamepad"></i>
                <span>🎮 Practice Arcade</span>
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT WRAPPER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- TAB 1: GRAMMAR MATRIX & FORMULA GUIDE -->
        <section id="tab-matrix" class="tab-content block space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-indigo-600 via-purple-600 to-amber-600 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
                <div class="absolute -right-6 -bottom-8 opacity-10 text-white text-9xl">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div class="relative z-10 max-w-3xl">
                    <div class="flex items-center space-x-2 mb-3">
                        <span class="px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider rounded-full text-indigo-100">
                            Interchange 10 Grammar Plus (SB-198)
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">Grammar Matrix & Formula Guide</h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Master future time references with <strong class="underline decoration-amber-300">Present Continuous vs. Be Going To</strong> and reported communication with <strong class="underline decoration-emerald-300">Tell + That</strong>, <strong class="underline decoration-purple-300">Ask + To</strong>, and <strong class="underline decoration-rose-300">Negative Infinitives (Ask + Not To)</strong>.
                    </p>
                </div>
            </div>

            <!-- Rule Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1: Present Continuous (Present vs Future) -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border-2 border-amber-500/30 shadow-md space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-3">
                            <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-amber-500 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-clock"></i></span>
                                Present Continuous
                            </h3>
                            <span class="text-[10px] bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-extrabold px-2 py-0.5 rounded">UNIT 10 PART 1</span>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                            <strong>Present:</strong> Action happening <em>right now</em>.
                            <br>
                            <strong>Future:</strong> Scheduled plans with a <em>future time expression</em> (e.g., <i>tonight, on Friday, this weekend</i>).
                        </p>
                        <div class="p-3 bg-amber-50 dark:bg-amber-950/30 rounded-xl border border-amber-200 dark:border-amber-800/60 text-xs space-y-1.5">
                            <p class="font-bold text-amber-800 dark:text-amber-300">Form:</p>
                            <p class="font-mono text-slate-700 dark:text-slate-200 font-bold">Subject + am/is/are + verb-ing</p>
                        </div>
                        <div class="space-y-1.5 text-xs">
                            <p class="text-slate-500 font-semibold">Examples:</p>
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                                <span><strong class="text-amber-600">Present:</strong> "Who is talking at the door?"</span>
                                <button onclick="app.speakText('Who is talking at the door?')" class="text-amber-600 hover:text-amber-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                                <span><strong class="text-amber-600">Future:</strong> "We are watching a movie <u class="decoration-amber-400">tonight</u>."</span>
                                <button onclick="app.speakText('We are watching a movie tonight.')" class="text-amber-600 hover:text-amber-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Be Going To -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border-2 border-indigo-500/30 shadow-md space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-3">
                            <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-rocket"></i></span>
                                Future with Be Going To
                            </h3>
                            <span class="text-[10px] bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 font-extrabold px-2 py-0.5 rounded">FUTURE PLANS</span>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                            Use <strong>be going to + base verb</strong> to talk about future intentions, plans, or predictions based on evidence.
                        </p>
                        <div class="p-3 bg-indigo-50 dark:bg-indigo-950/30 rounded-xl border border-indigo-200 dark:border-indigo-800/60 text-xs space-y-1.5">
                            <p class="font-bold text-indigo-800 dark:text-indigo-300">Form:</p>
                            <p class="font-mono text-slate-700 dark:text-slate-200 font-bold">Subject + am/is/are + going to + base verb</p>
                        </div>
                        <div class="space-y-1.5 text-xs">
                            <p class="text-slate-500 font-semibold">Examples:</p>
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                                <span>"I'm <strong>going to take</strong> a French course."</span>
                                <button onclick="app.speakText('I am going to take a French course.')" class="text-indigo-600 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                                <span>"Is Sam <strong>going to work</strong> this summer?"</span>
                                <button onclick="app.speakText('Is Sam going to work this summer?')" class="text-indigo-600 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Indirect Messages (Tell / Ask / Negative Infinitives) -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border-2 border-emerald-500/30 shadow-md space-y-4 flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-3">
                            <h3 class="text-base font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                                <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-xs"><i class="fa-solid fa-paper-plane"></i></span>
                                Indirect Messages
                            </h3>
                            <span class="text-[10px] bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-extrabold px-2 py-0.5 rounded">UNIT 10 PART 2</span>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                            <strong>Tell + that:</strong> Statements ("tell Haru that...").<br>
                            <strong>Ask + to:</strong> Requests ("ask Caitlin to...").<br>
                            <strong>Ask + NOT to:</strong> Negative requests ("ask Alex <em>not to</em> bring...").
                        </p>
                        <div class="p-3 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl border border-emerald-200 dark:border-emerald-800/60 text-xs space-y-1">
                            <p class="font-bold text-emerald-800 dark:text-emerald-300">Negative Request Form:</p>
                            <p class="font-mono text-slate-700 dark:text-slate-200 font-bold">Ask + person + NOT + TO + base verb</p>
                        </div>
                        <div class="space-y-1.5 text-xs">
                            <p class="text-slate-500 font-semibold">Examples:</p>
                            <div class="bg-slate-50 dark:bg-slate-900 p-2 rounded-lg border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                                <span>"Please ask Alex <strong>not to bring</strong> extra luggage."</span>
                                <button onclick="app.speakText('Please ask Alex not to bring extra luggage.')" class="text-emerald-600 hover:text-emerald-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interactive Formula Builder Sandbox -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Interactive Rule Builder</span>
                        <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">Live Grammar Construction Engine</h2>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="app.matrix.setSandboxMode('future')" id="sandbox-btn-future" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white">
                            Future Tense Mode
                        </button>
                        <button onclick="app.matrix.setSandboxMode('indirect')" id="sandbox-btn-indirect" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                            Indirect Message Mode
                        </button>
                    </div>
                </div>

                <!-- Future Tense Mode Controls -->
                <div id="sandbox-future-controls" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">1. Subject</label>
                        <select id="sf-subject" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="I">I</option>
                            <option value="We">We</option>
                            <option value="Sam">Sam</option>
                            <option value="They">They</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">2. Be Auxiliary</label>
                        <select id="sf-aux" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="am">am ('m)</option>
                            <option value="are">are ('re)</option>
                            <option value="is">is ('s)</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">3. Verb Structure</label>
                        <select id="sf-verb" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="going to take">going to take (be going to)</option>
                            <option value="taking">taking (Present Continuous)</option>
                            <option value="going to work">going to work (be going to)</option>
                            <option value="watching">watching (Present Continuous)</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">4. Time Expression</label>
                        <select id="sf-time" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="this summer">this summer</option>
                            <option value="tonight">tonight</option>
                            <option value="on Friday night">on Friday night</option>
                            <option value="this weekend">this weekend</option>
                        </select>
                    </div>
                </div>

                <!-- Indirect Message Mode Controls -->
                <div id="sandbox-indirect-controls" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">1. Opener</label>
                        <select id="si-opener" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="Please">Please</option>
                            <option value="Could you">Could you</option>
                            <option value="Would you">Would you</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">2. Main Verb</label>
                        <select id="si-verb" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="tell">tell (Statement)</option>
                            <option value="ask">ask (Request)</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">3. Target Person</label>
                        <select id="si-person" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="Patrick">Patrick</option>
                            <option value="Ana">Ana</option>
                            <option value="Alex">Alex</option>
                            <option value="Sarah">Sarah</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">4. Connector</label>
                        <select id="si-connector" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="that">that (for Statements)</option>
                            <option value="to">to (for Positive Requests)</option>
                            <option value="not to">not to (for Negative Requests)</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-bold text-slate-400 uppercase">5. Message Phrase</label>
                        <select id="si-clause" onchange="app.matrix.updateSandbox()" class="w-full p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-xs font-semibold">
                            <option value="we don't have class tomorrow">we don't have class tomorrow</option>
                            <option value="lend me her dictionary">lend me her dictionary</option>
                            <option value="bring extra luggage on the trip">bring extra luggage on the trip</option>
                            <option value="the deadline is 5:00 PM">the deadline is 5:00 PM</option>
                        </select>
                    </div>
                </div>

