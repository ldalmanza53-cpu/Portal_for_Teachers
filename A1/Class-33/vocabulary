    <script>
        // Default Part A Chart Sample Data
        const chartData = {
            1: ["gym across from the park", "supermarket near the bus station", "library on Main Street"],
            2: ["coffee shops near the center", "banks on 5th Avenue", "restaurants near my house"],
            3: ["bookstore in our neighborhood", "movie theater near here", "gas station on this street"],
            4: ["clothing stores near the park", "laundromats in this area", "hair salons on 2nd Street"]
        };

        // Neighborhood Map Interactive Toggle Data
        const mapItems = [
            { id: "gym", name: "Gym", icon: "fa-dumbbell", isPlural: false, present: true, location: "across from the park" },
            { id: "coffee", name: "Coffee Shops", icon: "fa-mug-hot", isPlural: true, present: true, location: "near the center" },
            { id: "supermarket", name: "Supermarket", icon: "fa-cart-shopping", isPlural: false, present: true, location: "on Main Street" },
            { id: "bookstore", name: "Bookstore", icon: "fa-book", isPlural: false, present: false, location: "near here" },
            { id: "laundromat", name: "Laundromats", icon: "fa-soap", isPlural: true, present: false, location: "in our area" },
            { id: "park", name: "Park", icon: "fa-tree", isPlural: false, present: true, location: "on 5th Avenue" }
        ];

        // Game Survey Questions
        const surveyQuestions = [
            { place: "gym", type: "singular", text: "Is there a gym in your neighborhood?" },
            { place: "coffee shops", type: "plural", text: "Are there any coffee shops?" },
            { place: "bookstore", type: "singular", text: "Is there a bookstore in your neighborhood?" },
            { place: "supermarket", type: "singular", text: "Is there a supermarket nearby?" },
            { place: "clothing stores", type: "plural", text: "Are there any clothing stores in your area?" },
            { place: "banks", type: "plural", text: "Are there any banks near your house?" }
        ];

        // Simulated Answers for Game
        const possibleAnswers = [
            { answer: "Yes, there's one across from the park.", type: "YES", points: 2 },
            { answer: "Yes, there are some near the station.", type: "YES", points: 2 },
            { answer: "No, there isn't one in our neighborhood.", type: "NO", points: 0 },
            { answer: "No, there aren't any near here.", type: "NO", points: 0 },
            { answer: "Sorry, I don't know.", type: "UNKNOWN", points: 1 }
        ];

        // App State
        let currentSurveyIndex = 0;
        let yesCount = 0;
        let points = 0;

        // Web Audio API
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'yes') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(783.99, audioCtx.currentTime + 0.2);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.35);
            } else if (type === 'no') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, audioCtx.currentTime);
                osc.frequency.setValueAtTime(180, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.25);
            } else if (type === 'click') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(440, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.05);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.05);
            }
        }

        // Speech Synthesis TTS
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            renderChart();
            renderMapGrid();
            updateMapSummary();
            updateSurveyQuestion();
        });

        // Tab Switching
        function switchTab(tabId) {
            playSound('click');
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('bg-emerald-600', 'text-white', 'shadow');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow');
            activeBtn.classList.remove('text-slate-300');
        }

        /* --- PART A: CHART BUILDER --- */
        function renderChart() {
            for (let q = 1; q <= 4; q++) {
                const container = document.getElementById(`quadrant-${q}`);
                container.innerHTML = '';
                chartData[q].forEach((item, idx) => {
                    const div = document.createElement('div');
                    div.className = 'bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex justify-between items-center text-xs text-white';
                    div.innerHTML = `
                        <span class="font-medium">${item}</span>
                        <div class="flex items-center gap-2">
                            <button onclick="speakChartItem(${q}, ${idx})" class="text-indigo-400 hover:text-indigo-300">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                            <button onclick="removeChartItem(${q}, ${idx})" class="text-slate-600 hover:text-rose-400">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    `;
                    container.appendChild(div);
                });
            }
        }

        function addChartItem(q) {
            const input = document.getElementById(`input-q${q}`);
            const val = input.value.trim();
            if (val) {
                playSound('click');
                chartData[q].push(val);
                input.value = '';
                renderChart();
            }
        }

        function removeChartItem(q, idx) {
            playSound('click');
            chartData[q].splice(idx, 1);
            renderChart();
        }

        function clearAllChartEntries() {
            playSound('click');
            for (let q = 1; q <= 4; q++) chartData[q] = [];
            renderChart();
        }

        function speakChartItem(q, idx) {
            const item = chartData[q][idx];
            let prefix = "";
            if (q === 1) prefix = "There is a ";
            else if (q === 2) prefix = "There are some ";
            else if (q === 3) prefix = "There isn't a ";
            else if (q === 4) prefix = "There aren't any ";
            speakText(`${prefix} ${item}`);
        }

        /* --- PART B: SURVEY GAME --- */
        function updateSurveyQuestion() {
            const q = surveyQuestions[currentSurveyIndex];
            document.getElementById('gameQuestionText').innerText = `"${q.text}"`;
            document.getElementById('surveyAnswerCard').classList.add('hidden');
            document.getElementById('btnAskQuestion').disabled = false;
        }

        function askSurveyQuestion() {
            playSound('click');
            const randAns = possibleAnswers[Math.floor(Math.random() * possibleAnswers.length)];
            const card = document.getElementById('surveyAnswerCard');
            const textEl = document.getElementById('surveyAnswerText');
            const pointsEl = document.getElementById('surveyPointsAdded');

            card.classList.remove('hidden');
            textEl.innerText = `"${randAns.answer}"`;

            if (randAns.type === 'YES') {
                playSound('yes');
                yesCount++;
                points += randAns.points;
                card.className = "p-5 rounded-xl border text-center space-y-2 bg-emerald-950/80 border-emerald-500 text-emerald-200";
                pointsEl.innerText = `+${randAns.points} Points! (YES answer)`;
                confetti({ particleCount: 40, spread: 50 });
            } else if (randAns.type === 'UNKNOWN') {
                playSound('click');
                points += randAns.points;
                card.className = "p-5 rounded-xl border text-center space-y-2 bg-amber-950/80 border-amber-500 text-amber-200";
                pointsEl.innerText = `+${randAns.points} Point (Sorry, I don't know)`;
            } else {
                playSound('no');
                card.className = "p-5 rounded-xl border text-center space-y-2 bg-rose-950/80 border-rose-500 text-rose-200";
                pointsEl.innerText = `0 Points (NO answer)`;
            }

            document.getElementById('yesDisplay').innerText = yesCount;
            document.getElementById('pointsDisplay').innerText = points;
            speakText(randAns.answer);
            document.getElementById('btnAskQuestion').disabled = true;
        }

        function nextSurveyQuestion() {
            playSound('click');
            currentSurveyIndex = (currentSurveyIndex + 1) % surveyQuestions.length;
            updateSurveyQuestion();
        }

        /* --- MAP EXPLORER --- */
        function renderMapGrid() {
            const grid = document.getElementById('mapGrid');
            grid.innerHTML = '';

            mapItems.forEach(item => {
                const btn = document.createElement('button');
                btn.className = `map-grid-cell p-4 rounded-xl border flex flex-col items-center justify-center gap-2 font-bold text-xs transition ${
                    item.present 
                    ? 'bg-emerald-950/60 border-emerald-500 text-emerald-300' 
                    : 'bg-slate-950 border-slate-800 text-slate-500 line-through'
                }`;
                btn.onclick = () => toggleMapItem(item.id);
                btn.innerHTML = `
                    <i class="fa-solid ${item.icon} text-2xl ${item.present ? 'text-emerald-400' : 'text-slate-600'}"></i>
                    <span>${item.name}</span>
                    <span class="text-[10px] font-normal ${item.present ? 'text-emerald-400' : 'text-slate-600'}">
                        ${item.present ? 'PRESENT' : 'ABSENT'}
                    </span>
                `;
                grid.appendChild(btn);
            });
        }

        function toggleMapItem(id) {
            playSound('click');
            const item = mapItems.find(x => x.id === id);
            if (item) {
                item.present = !item.present;
                renderMapGrid();
                updateMapSummary();
            }
        }

        function updateMapSummary() {
            const summaryContainer = document.getElementById('mapGrammarSummary');
            summaryContainer.innerHTML = '';

            mapItems.forEach(item => {
                let sentence = "";
                if (item.present) {
                    if (item.isPlural) sentence = `There are some ${item.name.toLowerCase()} ${item.location}.`;
                    else sentence = `There is a ${item.name.toLowerCase()} ${item.location}.`;
                } else {
                    if (item.isPlural) sentence = `There aren't any ${item.name.toLowerCase()} in our neighborhood.`;
                    else sentence = `There isn't a ${item.name.toLowerCase()} in our neighborhood.`;
                }

                const p = document.createElement('p');
                p.className = `p-2 rounded-lg border ${item.present ? 'bg-emerald-950/40 border-emerald-500/30 text-emerald-300' : 'bg-rose-950/40 border-rose-500/30 text-rose-300'}`;
                p.innerText = sentence;
                summaryContainer.appendChild(p);
            });
        }

        function readMapSummary() {
            const texts = Array.from(document.querySelectorAll('#mapGrammarSummary p')).map(p => p.innerText);
            speakText(texts.join(" "));
        }

        /* --- DIALOGUE TRAINER --- */
        function playFullDialogue() {
            const lines = [
                "Is there a gym in your neighborhood?",
                "Yes, there is one across from the park.",
                "Are there any coffee shops?",
                "No, there are not any in our neighborhood.",
                "Is there a bookstore in your neighborhood?",
                "Sorry, I don't know."
            ];
            speakText(lines.join(" "));
        }
    </script>
</body>
</html>
