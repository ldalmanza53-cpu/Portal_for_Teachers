                            <button onclick="setExBAnswer(1, false)" id="exb_btn_1_no" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-rose-500 transition">
                                <i class="fa-solid fa-xmark"></i> No
                            </button>
                        </div>
                    </div>
                    <div id="exb_response_1" class="hidden transition-all duration-300 pt-2 border-t border-slate-700/60">
                        <!-- Dynamic answer injected by JS -->
                    </div>
                </div>

                <!-- Q2 -->
                <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-3 shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="font-bold text-sm text-cyan-300">2. Is your teacher from Canada?</span>
                        <div class="flex items-center gap-2">
                            <button onclick="setExBAnswer(2, true)" id="exb_btn_2_yes" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-emerald-500 transition">
                                <i class="fa-solid fa-check"></i> Yes
                            </button>
                            <button onclick="setExBAnswer(2, false)" id="exb_btn_2_no" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-rose-500 transition">
                                <i class="fa-solid fa-xmark"></i> No
                            </button>
                        </div>
                    </div>
                    <div id="exb_response_2" class="hidden transition-all duration-300 pt-2 border-t border-slate-700/60">
                        <!-- Dynamic answer injected by JS -->
                    </div>
                </div>

                <!-- Q3 -->
                <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-3 shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="font-bold text-sm text-cyan-300">3. Is your English class in the morning?</span>
                        <div class="flex items-center gap-2">
                            <button onclick="setExBAnswer(3, true)" id="exb_btn_3_yes" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-emerald-500 transition">
                                <i class="fa-solid fa-check"></i> Yes
                            </button>
                            <button onclick="setExBAnswer(3, false)" id="exb_btn_3_no" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-rose-500 transition">
                                <i class="fa-solid fa-xmark"></i> No
                            </button>
                        </div>
                    </div>
                    <div id="exb_response_3" class="hidden transition-all duration-300 pt-2 border-t border-slate-700/60">
                        <!-- Dynamic answer injected by JS -->
                    </div>
                </div>

                <!-- Q4 -->
                <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-3 shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <span class="font-bold text-sm text-cyan-300">4. Are you free after class?</span>
                        <div class="flex items-center gap-2">
                            <button onclick="setExBAnswer(4, true)" id="exb_btn_4_yes" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-emerald-500 transition">
                                <i class="fa-solid fa-check"></i> Yes
                            </button>
                            <button onclick="setExBAnswer(4, false)" id="exb_btn_4_no" class="px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-300 hover:border-rose-500 transition">
                                <i class="fa-solid fa-xmark"></i> No
                            </button>
                        </div>
                    </div>
                    <div id="exb_response_4" class="hidden transition-all duration-300 pt-2 border-t border-slate-700/60">
                        <!-- Dynamic answer injected by JS -->
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: VIP PARTY ROLE-PLAY -->
        <section id="sec-tabPassport" class="hidden space-y-6">
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700/80 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 shadow-xl">
                <div>
                    <h2 class="text-base font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-champagne-glasses text-amber-400"></i> VIP Party Role-Play Simulator
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Role-play as a Security Officer checking the guest identity against the guest list!</p>
                </div>
                <button onclick="generateRandomVIPCard()" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow-lg transition flex items-center gap-2">
                    <i class="fa-solid fa-shuffle"></i> Generate New Guest Card
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Guest Badge Card -->
                <div class="bg-slate-800/90 p-5 rounded-2xl border border-amber-500/40 relative overflow-hidden shadow-xl space-y-4">
                    <div class="absolute -right-6 -top-6 w-24 h-24 bg-amber-500/10 rounded-full blur-xl"></div>
                    <div class="flex justify-between items-start border-b border-slate-700 pb-3">
                        <div>
                            <span class="text-[10px] font-extrabold text-amber-400 uppercase tracking-widest block">VIP GUEST BADGE</span>
                            <h3 id="vipName" class="text-lg font-black text-white mt-0.5">Arturo Perez</h3>
                        </div>
                        <span class="w-8 h-8 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm border border-amber-500/30">
                            <i class="fa-solid fa-id-badge"></i>
                        </span>
                    </div>

                    <div class="space-y-2.5 text-xs">
                        <div class="flex justify-between items-center py-1 border-b border-slate-700/50">
                            <span class="text-slate-400"><i class="fa-solid fa-globe text-cyan-400 mr-1.5"></i> Country:</span>
                            <span id="vipCountry" class="font-bold text-white">Mexico</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-b border-slate-700/50">
                            <span class="text-slate-400"><i class="fa-solid fa-clock text-amber-400 mr-1.5"></i> Class Time:</span>
                            <span id="vipClassTime" class="font-bold text-white">9:00 AM</span>
                        </div>
                        <div class="flex justify-between items-center py-1">
                            <span class="text-slate-400"><i class="fa-solid fa-calendar-check text-emerald-400 mr-1.5"></i> Free Status:</span>
                            <span id="vipFreeStatus" class="font-bold text-emerald-400">Free after class</span>
                        </div>
                    </div>

                    <div class="pt-2">
                        <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-700 text-[11px] text-slate-300 leading-relaxed">
                            <i class="fa-solid fa-info-circle text-amber-400 mr-1"></i>
                            Practice asking this guest Yes/No questions using <strong class="text-emerald-400">Is...</strong> and <strong class="text-emerald-400">Are...</strong>!
                        </div>
                    </div>
                </div>

                <!-- Interactive Role-Play Dialog -->
                <div class="lg:col-span-2 bg-slate-950 p-6 rounded-2xl border border-slate-800 space-y-4 shadow-xl">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                        <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-comments"></i> Security Check Dialogue
                        </h3>
                        <button onclick="speakRoleplayDialogue()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-volume-high"></i> Read Dialogue Aloud
                        </button>
                    </div>

                    <div id="roleplayBox" class="space-y-3 text-xs text-slate-300 leading-relaxed font-sans">
                        <!-- Dialogue generated dynamically by JS -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800 py-4 mt-auto text-center text-xs text-slate-500">
        <p>A1 ESL Grammar Learning Studio • Based on "Yes/No questions and short answers with <em>be</em>"</p>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Global Application State
        let scoreA = 0;
        let scoreB = 0;
        const maxScoreA = 12;
        const maxScoreB = 4;
        const totalPossibleScore = maxScoreA + maxScoreB; // 16 Points

        // Track answers for Exercise B
        const exBData = {
            1: { answered: false, choice: null, textValid: false },
            2: { answered: false, choice: null, textValid: false },
            3: { answered: false, choice: null, textValid: false },
            4: { answered: false, choice: null, textValid: false }
        };

        // Text-to-Speech Helper
        function speak(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.lang = 'en-US';
                utter.rate = 0.88;
                utter.pitch = 1.0;
                window.speechSynthesis.speak(utter);
            }
        }

        // Tab Switcher
        function switchTab(tabId) {
            ['tabChart', 'tabExA', 'tabExB', 'tabPassport'].forEach(t => {
                const sec = document.getElementById(`sec-${t}`);
                const btn = document.getElementById(`btn-${t}`);
                if (sec) sec.classList.add('hidden');
                if (btn) btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap';
            });

            const activeSec = document.getElementById(`sec-${tabId}`);
            const activeBtn = document.getElementById(`btn-${tabId}`);
            if (activeSec) activeSec.classList.remove('hidden');
            if (activeBtn) activeBtn.className = 'tab-btn active px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 whitespace-nowrap';
        }

        // Exercise A Logic
        const exAAnswers = {
            'exa_1_1': ['is'],
            'exa_1_2': ['is'],
            'exa_1_3': ["he's", "he is"],
            'exa_2_1': ['is'],
            'exa_2_2': ["isn't", "is not", "'s not"],
            'exa_2_3': ["it's", "it is"],
            'exa_3_1': ['are'],
            'exa_3_2': ['are'],
            'exa_3_3': ["we're", "we are"],
            'exa_4_1': ['are'],
            'exa_4_2': ["aren't", "are not", "'re not"],
            'exa_4_3': ["they're", "they are"]
        };

        function checkExerciseA() {
            scoreA = 0;
            Object.keys(exAAnswers).forEach(id => {
                const input = document.getElementById(id);
                if (!input) return;
                const val = input.value.trim().toLowerCase();
                const isCorrect = exAAnswers[id].includes(val);

                if (isCorrect) {
                    input.className = "w-20 bg-slate-900 border rounded-lg px-2.5 py-1 text-center font-bold focus:outline-none correct";
                    scoreA++;
                } else {
                    input.className = "w-20 bg-slate-900 border rounded-lg px-2.5 py-1 text-center font-bold focus:outline-none incorrect";
                }
            });

            updateTotalScore();
        }

        function resetExerciseA() {
            scoreA = 0;
            Object.keys(exAAnswers).forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.value = '';
                    input.className = "w-20 bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1 text-center font-bold text-amber-300 focus:outline-none focus:border-emerald-500 transition";
                }
            });
            updateTotalScore();
        }

        // Exercise B Logic
        function setExBAnswer(qNum, isYes) {
            const yesBtn = document.getElementById(`exb_btn_${qNum}_yes`);
            const noBtn = document.getElementById(`exb_btn_${qNum}_no`);
            const responseDiv = document.getElementById(`exb_response_${qNum}`);

            exBData[qNum].answered = true;
            exBData[qNum].choice = isYes;

            if (isYes) {
                yesBtn.className = "px-4 py-1.5 rounded-xl text-xs font-bold border border-emerald-500 bg-emerald-600 text-white shadow-md transition";
                noBtn.className = "px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-400 hover:border-rose-500 transition";
                
                let defaultShortAnswer = "";
                if (qNum === 1 || qNum === 4) defaultShortAnswer = "Yes, I am.";
                else if (qNum === 2) defaultShortAnswer = "Yes, he/she is.";
                else if (qNum === 3) defaultShortAnswer = "Yes, it is.";

                responseDiv.innerHTML = `
                    <div class="flex items-center gap-2 text-emerald-400 font-semibold text-xs">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Correct Short Answer: <strong>"${defaultShortAnswer}"</strong></span>
                    </div>
                `;
                responseDiv.classList.remove('hidden');
                exBData[qNum].textValid = true;
            } else {
                noBtn.className = "px-4 py-1.5 rounded-xl text-xs font-bold border border-rose-500 bg-rose-600 text-white shadow-md transition";
                yesBtn.className = "px-4 py-1.5 rounded-xl text-xs font-bold border border-slate-600 bg-slate-900 text-slate-400 hover:border-emerald-500 transition";

                let promptText = "";
                let placeholderText = "";
                if (qNum === 1) { promptText = "No, I'm not."; placeholderText = "e.g., I'm from Colombia."; }
                else if (qNum === 2) { promptText = "No, my teacher isn't."; placeholderText = "e.g., My teacher is from the USA."; }
                else if (qNum === 3) { promptText = "No, it's not."; placeholderText = "e.g., My class is in the afternoon."; }
                else if (qNum === 4) { promptText = "No, I'm not."; placeholderText = "e.g., I have work after class."; }

                responseDiv.innerHTML = `
                    <div class="space-y-2">
                        <div class="text-rose-300 font-semibold text-xs flex items-center gap-2">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>Short Answer: <strong>"${promptText}"</strong></span>
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-2">
                            <label class="text-[11px] text-slate-400 shrink-0">Provide correct info:</label>
                            <input type="text" id="exb_text_${qNum}" oninput="validateExBText(${qNum})" placeholder="${placeholderText}" 
                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-emerald-300 focus:outline-none focus:border-cyan-500 transition">
                        </div>
                    </div>
                `;
                responseDiv.classList.remove('hidden');
                exBData[qNum].textValid = false;
            }

            calculateExBScore();
        }

        function validateExBText(qNum) {
            const input = document.getElementById(`exb_text_${qNum}`);
            if (!input) return;
            if (input.value.trim().length >= 3) {
                input.className = "w-full bg-slate-900 border rounded-xl px-3 py-1.5 text-xs focus:outline-none correct font-medium";
                exBData[qNum].textValid = true;
            } else {
                input.className = "w-full bg-slate-900 border rounded-xl px-3 py-1.5 text-xs focus:outline-none incorrect font-medium";
                exBData[qNum].textValid = false;
            }
            calculateExBScore();
        }

        function calculateExBScore() {
            scoreB = 0;
            Object.keys(exBData).forEach(qNum => {
                if (exBData[qNum].answered && exBData[qNum].textValid) {
                    scoreB++;
                }
            });
            updateTotalScore();
        }

        let confettiFired = false;

        function updateTotalScore() {
            const currentTotal = scoreA + scoreB;
            
            document.getElementById('scoreDisplay').innerText = `${currentTotal} / ${totalPossibleScore} Points`;
            document.getElementById('mobileScore').innerText = `${currentTotal}/${totalPossibleScore}`;

            const percent = Math.round((currentTotal / totalPossibleScore) * 100);
            document.getElementById('progressBar').style.width = `${percent}%`;

            if (currentTotal === totalPossibleScore && !confettiFired) {
                confettiFired = true;
                confetti({
                    particleCount: 100,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            } else if (currentTotal < totalPossibleScore) {
                confettiFired = false;
            }
        }

        // VIP Guest Database
        const vipDatabase = [
            { name: "Arturo Perez", country: "Mexico", classTime: "9:00 AM", isFree: true },
            { name: "Giovanna Rossi", country: "Italy", classTime: "2:00 PM", isFree: false },
            { name: "Alexa Silva", country: "Brazil", classTime: "10:00 AM", isFree: true },
            { name: "Mr. Jones", country: "United States", classTime: "11:30 AM", isFree: false },
            { name: "Mrs. Flores", country: "Peru", classTime: "3:00 PM", isFree: true }
        ];

        let currentVIP = vipDatabase[0];

        function generateRandomVIPCard() {
            const randomIndex = Math.floor(Math.random() * vipDatabase.length);
            currentVIP = vipDatabase[randomIndex];

            document.getElementById('vipName').innerText = currentVIP.name;
            document.getElementById('vipCountry').innerText = currentVIP.country;
            document.getElementById('vipClassTime').innerText = currentVIP.classTime;
            
            const freeEl = document.getElementById('vipFreeStatus');
            if (currentVIP.isFree) {
                freeEl.innerText = "Free after class";
                freeEl.className = "font-bold text-emerald-400";
            } else {
                freeEl.innerText = "Not free after class";
                freeEl.className = "font-bold text-rose-400";
            }

            renderRoleplayDialogue();
        }

        function renderRoleplayDialogue() {
            const box = document.getElementById('roleplayBox');
            box.innerHTML = `
                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 space-y-1">
                    <p class="font-semibold text-amber-300"><i class="fa-solid fa-user-shield mr-1"></i> Security Guard:</p>
                    <p class="text-slate-200">"Excuse me, <strong>is</strong> your name ${currentVIP.name}?"</p>
                    <p class="font-semibold text-emerald-400 mt-2"><i class="fa-solid fa-id-card mr-1"></i> Guest:</p>
                    <p class="text-slate-200">"Yes, <strong>it is</strong>."</p>
                </div>

                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 space-y-1">
                    <p class="font-semibold text-amber-300"><i class="fa-solid fa-user-shield mr-1"></i> Security Guard:</p>
                    <p class="text-slate-200">"<strong>Are</strong> you from ${currentVIP.country}?"</p>
                    <p class="font-semibold text-emerald-400 mt-2"><i class="fa-solid fa-id-card mr-1"></i> Guest:</p>
                    <p class="text-slate-200">"Yes, <strong>I am</strong>."</p>
                </div>

                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 space-y-1">
                    <p class="font-semibold text-amber-300"><i class="fa-solid fa-user-shield mr-1"></i> Security Guard:</p>
                    <p class="text-slate-200">"<strong>Is</strong> your English class at 4:00 PM?"</p>
                    <p class="font-semibold text-emerald-400 mt-2"><i class="fa-solid fa-id-card mr-1"></i> Guest:</p>
                    <p class="text-slate-200">"No, <strong>it isn't</strong>. <strong>It's</strong> at ${currentVIP.classTime}."</p>
                </div>

                <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 space-y-1">
                    <p class="font-semibold text-amber-300"><i class="fa-solid fa-user-shield mr-1"></i> Security Guard:</p>
                    <p class="text-slate-200">"<strong>Are</strong> you free after class?"</p>
                    <p class="font-semibold text-emerald-400 mt-2"><i class="fa-solid fa-id-card mr-1"></i> Guest:</p>
                    <p class="text-slate-200">"${currentVIP.isFree ? "Yes, <strong>I am</strong>! Welcome to the VIP party." : "No, <strong>I'm not</strong>. I have to go home."}"</p>
                </div>
            `;
        }

        function speakRoleplayDialogue() {
            const dialogueText = `Security Guard says: Excuse me, is your name ${currentVIP.name}? Guest says: Yes, it is. Security Guard says: Are you from ${currentVIP.country}? Guest says: Yes, I am. Security Guard says: Is your English class at 4:00 PM? Guest says: No, it isn't. It's at ${currentVIP.classTime}. Security Guard says: Are you free after class? Guest says: ${currentVIP.isFree ? "Yes, I am!" : "No, I'm not."}`;
            speak(dialogueText);
        }

        // Initialize App on Page Load
        window.addEventListener('DOMContentLoaded', () => {
            generateRandomVIPCard();
        });
    </script>
</body>
</html>
