<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Life Experiences • Word Power Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Poppins', sans-serif; }
        .tab-active { background-color: #2563eb !important; color: #ffffff !important; box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35); }
        .phrase-card { cursor: pointer; transition: all 0.2s ease; }
        .phrase-card:hover { transform: translateY(-2px); }
        .selected-card { ring: 3px; ring-color: #3b82f6; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-rose-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
                    <i class="fa-solid fa-compass"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight text-white flex items-center gap-2">
                        Word Power: Life Experiences
                        <span class="bg-amber-900/80 text-amber-300 border border-amber-500/40 text-[10px] px-2 py-0.5 rounded-full font-extrabold uppercase">A1-A2 Vocabulary</span>
                    </h1>
                    <p class="text-xs text-slate-400">Verb-Noun Collocations & Pair Interview Studio</p>
                </div>
            </div>

            <!-- Timer & Actions -->
            <div class="flex items-center gap-3 bg-slate-900/90 px-4 py-2 rounded-xl border border-slate-700 text-sm">
                <div class="flex items-center gap-2 text-amber-400">
                    <i class="fa-solid fa-stopwatch text-lg"></i>
                    <span id="timerDisplay" class="font-mono font-bold text-lg">15:00</span>
                    <button onclick="toggleTimer()" id="timerBtn" class="bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs px-2 py-1 rounded font-bold transition ml-1">Start</button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-slate-800/90 border-t border-slate-700/60 px-4">
            <div class="max-w-7xl mx-auto flex gap-2 overflow-x-auto py-2">
                <button onclick="switchTab('chart')" id="tab-chart" class="nav-tab tab-active px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-table-cells"></i> 1. Part A: Collocation Chart
                </button>
                <button onclick="switchTab('expansion')" id="tab-expansion" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-plus-circle"></i> 2. Part B: Add Your Own
                </button>
                <button onclick="switchTab('speaking')" id="tab-speaking" class="nav-tab text-slate-300 hover:bg-slate-700 px-4 py-2 rounded-lg font-medium text-sm transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-comments"></i> 3. Speaking: "Have You Ever?"
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 md:p-6">

        <!-- TAB 1: COLLOCATION CHART (PART A) -->
        <section id="sec-chart" class="tab-content block space-y-6">
            
            <!-- Instructions & Word Bank -->
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-700 pb-3">
                    <div>
                        <h2 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-amber-400"></i> Word Bank (12 Phrases)
                        </h2>
                        <p class="text-xs text-slate-400">
                            Click a phrase below, then click the correct verb box to assign it! Find <strong>2 phrases per verb</strong>.
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="checkAnswers()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl font-bold text-xs transition flex items-center gap-2 shadow-md">
                            <i class="fa-solid fa-circle-check"></i> Check Answers
                        </button>
                        <button onclick="resetChart()" class="bg-slate-700 hover:bg-slate-600 text-slate-300 px-3 py-2 rounded-xl font-bold text-xs transition">
                            <i class="fa-solid fa-rotate-right"></i> Reset
                        </button>
                    </div>
                </div>

                <!-- Word Bank Container -->
                <div class="flex flex-wrap gap-2.5" id="wordBankContainer">
                    <!-- Dynamic rendering -->
                </div>
            </div>

            <!-- Verb Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="verbGrid">
                <!-- Verb Cards Rendered Dynamically -->
            </div>
        </section>

        <!-- TAB 2: PART B EXPANSION -->
        <section id="sec-expansion" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-amber-900/60 text-amber-300 border border-amber-500/40 text-xs font-bold rounded-full uppercase">Part B Challenge</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Add Another Phrase For Each Verb</h2>
                    <p class="text-sm text-slate-400">Think of one new word or phrase that goes with each verb!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="expansionGrid">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </section>

        <!-- TAB 3: SPEAKING PRACTICE -->
        <section id="sec-speaking" class="tab-content hidden space-y-6">
            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-xl space-y-6">
                <div>
                    <span class="px-3 py-1 bg-blue-900/60 text-blue-300 border border-blue-500/40 text-xs font-bold rounded-full uppercase">Pair Interview Studio</span>
                    <h2 class="text-2xl font-bold text-white mt-1">Have You Ever...?</h2>
                    <p class="text-sm text-slate-400">Select a collocation to generate an interview question and audio model.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-900 p-5 rounded-2xl border border-slate-700">
                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-amber-400 uppercase block mb-1">Select Verb</label>
                            <select id="speakingVerb" onchange="updateSpeakingOptions()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                                <option value="eat">eat (past participle: eaten)</option>
                                <option value="drink">drink (past participle: drunk)</option>
                                <option value="drive">drive (past participle: driven)</option>
                                <option value="lose">lose (past participle: lost)</option>
                                <option value="ride">ride (past participle: ridden)</option>
                                <option value="wear">wear (past participle: worn)</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-xs font-bold text-blue-400 uppercase block mb-1">Select Noun Phrase</label>
                            <select id="speakingNoun" onchange="generateSpeakingQuestion()" class="w-full bg-slate-800 border border-slate-600 rounded-xl p-3 text-sm text-white focus:outline-none">
                                <!-- Populated dynamically -->
                            </select>
                        </div>
                    </div>

                    <!-- Audio & Question Box -->
                    <div class="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest block mb-1">Question Prompt:</span>
                            <p id="speakingQuestion" class="text-xl font-bold text-amber-300">"Have you ever eaten sushi?"</p>
                        </div>

                        <div class="space-y-2">
                            <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block">Answer Options:</span>
                            <div class="text-xs text-slate-300 space-y-1">
                                <p>• <strong class="text-emerald-400">Yes:</strong> "Yes, I have eaten [phrase]." / "Yes, I have!"</p>
                                <p>• <strong class="text-rose-400">No:</strong> "No, I haven't." / "No, I've never eaten [phrase]."</p>
                            </div>
                        </div>

                        <button onclick="speakText(document.getElementById('speakingQuestion').innerText)" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Listen to Audio
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Word Power: Life Experiences • Interactive ESL Activity (A1-A2)
    </footer>

    <script>
        // Data derived from task prompt
        const phrasesData = [
            { id: 'p1', text: 'a bike', correctVerb: 'ride' },
            { id: 'p2', text: 'your English books', correctVerb: 'lose' },
            { id: 'p3', text: 'a costume', correctVerb: 'wear' },
            { id: 'p4', text: 'a truck', correctVerb: 'drive' },
            { id: 'p5', text: 'your phone', correctVerb: 'lose' },
            { id: 'p6', text: 'a motorcycle', correctVerb: 'ride' },
            { id: 'p7', text: 'sushi', correctVerb: 'eat' },
            { id: 'p8', text: 'chocolate soda', correctVerb: 'drink' },
            { id: 'p9', text: 'iced coffee', correctVerb: 'drink' },
            { id: 'p10', text: 'octopus', correctVerb: 'eat' },
            { id: 'p11', text: 'a sports car', correctVerb: 'drive' },
            { id: 'p12', text: 'a uniform', correctVerb: 'wear' }
        ];

        const verbsData = [
            { id: 'eat', name: 'eat', icon: 'fa-utensils', pp: 'eaten' },
            { id: 'drink', name: 'drink', icon: 'fa-glass-water', pp: 'drunk' },
            { id: 'drive', name: 'drive', icon: 'fa-car', pp: 'driven' },
            { id: 'lose', name: 'lose', icon: 'fa-magnifying-glass-minus', pp: 'lost' },
            { id: 'ride', name: 'ride', icon: 'fa-motorcycle', pp: 'ridden' },
            { id: 'wear', name: 'wear', icon: 'fa-shirt', pp: 'worn' }
        ];

        let selectedPhraseId = null;
        let chartState = { eat: [], drink: [], drive: [], lose: [], ride: [], wear: [] };
        let timerSeconds = 900;
        let timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderWordBank();
            renderVerbGrid();
            renderExpansionGrid();
            updateSpeakingOptions();
        });

        // Speech Synthesis
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        // Word Bank Render
        function renderWordBank() {
            const container = document.getElementById('wordBankContainer');
            container.innerHTML = '';

            const unassigned = phrasesData.filter(p => !isPhraseAssigned(p.id));

            if (unassigned.length === 0) {
                container.innerHTML = `<span class="text-xs text-emerald-400 font-bold"><i class="fa-solid fa-check-double"></i> All phrases placed! Click "Check Answers" above.</span>`;
                return;
            }

            unassigned.forEach(p => {
                const isSelected = selectedPhraseId === p.id;
                const card = document.createElement('div');
                card.className = `phrase-card px-3.5 py-2 rounded-xl border text-xs font-bold transition flex items-center gap-2 ${
                    isSelected ? 'bg-amber-500 text-slate-900 border-amber-300 shadow-lg scale-105' : 'bg-slate-900 border-slate-700 text-slate-200 hover:border-amber-500/50'
                }`;
                card.innerHTML = `<i class="fa-solid fa-tag text-amber-400"></i> ${p.text}`;
                card.onclick = () => {
                    selectedPhraseId = p.id;
                    renderWordBank();
                    speakText(p.text);
                };
                container.appendChild(card);
            });
        }

        function isPhraseAssigned(id) {
            return Object.values(chartState).some(arr => arr.includes(id));
        }

        // Render Verb Grid
        function renderVerbGrid() {
            const grid = document.getElementById('verbGrid');
            grid.innerHTML = '';

            verbsData.forEach(v => {
                const assigned = chartState[v.id];
                const card = document.createElement('div');
                card.className = 'bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg space-y-3 flex flex-col justify-between';
                
                let slotsHTML = '';
                assigned.forEach(phraseId => {
                    const phraseObj = phrasesData.find(p => p.id === phraseId);
                    slotsHTML += `
                        <div class="bg-slate-900 border border-slate-700 px-3 py-2 rounded-xl text-xs font-bold text-slate-200 flex items-center justify-between">
                            <span><i class="fa-solid fa-check text-amber-400 mr-1.5"></i> ${phraseObj.text}</span>
                            <button onclick="removePhraseFromVerb('${v.id}', '${phraseId}')" class="text-rose-400 hover:text-rose-300 font-bold ml-2">✕</button>
                        </div>
                    `;
                });

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between border-b border-slate-700 pb-2 mb-3">
                            <h3 class="font-extrabold text-lg text-amber-400 capitalize flex items-center gap-2">
                                <i class="fa-solid ${v.icon}"></i> ${v.name}
                            </h3>
                            <span class="text-[10px] bg-slate-700 text-slate-300 px-2 py-0.5 rounded font-bold">${assigned.length}/2</span>
                        </div>
                        <div class="space-y-2">
                            ${slotsHTML || '<p class="text-[11px] text-slate-500 italic py-2">Click a word from bank, then click here</p>'}
                        </div>
                    </div>
                    <button onclick="assignSelectedToVerb('${v.id}')" class="w-full mt-3 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold py-2 rounded-xl transition border border-slate-600 flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-plus text-amber-400"></i> Add Selected Phrase
                    </button>
                `;
                grid.appendChild(card);
            });
        }

        function assignSelectedToVerb(verbId) {
            if (!selectedPhraseId) {
                alert("Please select a phrase from the Word Bank first!");
                return;
            }
            if (chartState[verbId].length >= 2) {
                alert("This verb already has 2 phrases!");
                return;
            }

            chartState[verbId].push(selectedPhraseId);
            selectedPhraseId = null;
            renderWordBank();
            renderVerbGrid();
        }

        function removePhraseFromVerb(verbId, phraseId) {
            chartState[verbId] = chartState[verbId].filter(id => id !== phraseId);
            renderWordBank();
            renderVerbGrid();
        }

        function checkAnswers() {
            let totalPlaced = 0;
            let correctCount = 0;

            verbsData.forEach(v => {
                chartState[v.id].forEach(phraseId => {
                    totalPlaced++;
                    const phraseObj = phrasesData.find(p => p.id === phraseId);
                    if (phraseObj.correctVerb === v.id) correctCount++;
                });
            });

            if (totalPlaced < 12) {
                alert(`You have placed ${totalPlaced} out of 12 phrases. Please assign all phrases before checking!`);
                return;
            }

            if (correctCount === 12) {
                confetti({ particleCount: 50, spread: 70 });
                alert("🎉 Outstanding! All 12 verb-noun collocations are correct!");
            } else {
                alert(`You got ${correctCount} out of 12 correct. Review your placements and try again!`);
            }
        }

        function resetChart() {
            chartState = { eat: [], drink: [], drive: [], lose: [], ride: [], wear: [] };
            selectedPhraseId = null;
            renderWordBank();
            renderVerbGrid();
        }

        // Render Expansion Grid (Part B)
        function renderExpansionGrid() {
            const container = document.getElementById('expansionGrid');
            container.innerHTML = '';

            verbsData.forEach(v => {
                const card = document.createElement('div');
                card.className = 'bg-slate-900 border border-slate-700 p-4 rounded-xl space-y-2';
                card.innerHTML = `
                    <label class="text-xs font-bold text-amber-400 uppercase flex items-center gap-2">
                        <i class="fa-solid ${v.icon}"></i> ${v.name} + ...
                    </label>
                    <input type="text" placeholder="Add custom noun phrase..." class="w-full bg-slate-800 border border-slate-600 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                `;
                container.appendChild(card);
            });
        }

        // Speaking Generator
        function updateSpeakingOptions() {
            const verbVal = document.getElementById('speakingVerb').value;
            const nounSelect = document.getElementById('speakingNoun');
            nounSelect.innerHTML = '';

            const matches = phrasesData.filter(p => p.correctVerb === verbVal);
            matches.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m.text;
                opt.innerText = m.text;
                nounSelect.appendChild(opt);
            });

            generateSpeakingQuestion();
        }

        function generateSpeakingQuestion() {
            const verbVal = document.getElementById('speakingVerb').value;
            const nounVal = document.getElementById('speakingNoun').value;
            const verbObj = verbsData.find(v => v.id === verbVal);

            const qEl = document.getElementById('speakingQuestion');
            qEl.innerText = `"Have you ever ${verbObj.pp} ${nounVal}?"`;
        }

        // Navigation
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-tab').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('text-slate-300');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-${tabId}`);
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-300');
        }

        // Timer
        function toggleTimer() {
            const btn = document.getElementById('timerBtn');
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
                btn.innerText = "Start";
            } else {
                btn.innerText = "Pause";
                timerInterval = setInterval(() => {
                    if (timerSeconds > 0) {
                        timerSeconds--;
                        const m = Math.floor(timerSeconds / 60).toString().padStart(2, '0');
                        const s = (timerSeconds % 60).toString().padStart(2, '0');
                        document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    }
                }, 1000);
            }
        }
    </script>
</body>
</html>
