<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Categories & Culinary Preferences • ESL Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Outfit', sans-serif; }
        .tab-active { background-color: #0284c7 !important; color: #ffffff !important; font-weight: 700; box-shadow: 0 4px 14px 0 rgba(2, 132, 199, 0.4); }
        .bucket-hover { border-color: #38bdf8 !important; background-color: rgba(56, 189, 248, 0.08) !important; }
        .item-selected { ring: 3px; ring-color: #38bdf8; scale: 1.05; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col selection:bg-sky-500 selection:text-white">

    <!-- Application Header -->
    <header class="bg-slate-800/90 border-b border-slate-700 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-emerald-500 to-sky-500 flex items-center justify-center text-white text-xl shadow-md">
                    <i class="fa-solid fa-utensils"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-base md:text-lg text-white leading-tight">Food Categories & Preferences</h1>
                    <p class="text-[11px] text-slate-400">Word Power • ESL Beginner (A1–A2)</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="bg-slate-900 border border-slate-700 px-3 py-1.5 rounded-xl text-xs flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span>Sorted: <strong id="globalScore" class="text-sky-400">0 / 15</strong></span>
                </div>
                <button onclick="toggleAudioHelp()" id="audioToggleBtn" title="Speech Audio Status" class="p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sky-400 text-xs transition">
                    <i class="fa-solid fa-volume-high" id="audioToggleIcon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="bg-slate-800/50 border-b border-slate-700/60 sticky top-[61px] z-40 backdrop-blur-sm">
        <div class="max-w-6xl mx-auto px-4 flex gap-2 py-2.5 overflow-x-auto">
            <button onclick="switchTab('tabSectionA')" id="btnTabSectionA" class="tab-active px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-boxes-packing"></i> Section A: Food Sorting Game
            </button>
            <button onclick="switchTab('tabSectionB')" id="btnTabSectionB" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-comments"></i> Section B: Favorites & Untried Foods
            </button>
            <button onclick="switchTab('tabSectionC')" id="btnTabSectionC" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-headphones"></i> Section C: Flashcards & Listening Quiz
            </button>
        </div>
    </div>

    <!-- Main Container -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 md:p-6 space-y-6">

        <!-- SECTION A: FOOD SORTING CHALLENGE -->
        <section id="tabSectionA" class="space-y-6">
            
            <!-- Instructions Banner -->
            <div class="bg-slate-800 p-4 md:p-5 rounded-2xl border border-slate-700 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-base md:text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-sky-400"></i> Complete the Food Chart
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Tap a food item to select it, then tap a category bucket below to assign it. You can also drag & drop!</p>
                </div>
                <div class="flex gap-2 w-full md:w-auto">
                    <button onclick="resetSortingGame()" class="flex-1 md:flex-none px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                    <button onclick="checkSortingAnswers()" class="flex-1 md:flex-none px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-xl text-xs font-bold transition shadow-lg flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-circle-check"></i> Check Answers
                    </button>
                </div>
            </div>

            <!-- Unsorted Food Pool -->
            <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700 space-y-3">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-basket-shopping"></i> Unsorted Food Items (<span id="unsortedCount">15</span> remaining)
                    </span>
                    <span id="selectHint" class="text-[11px] text-slate-400 italic">Click an item to listen or assign</span>
                </div>

                <div id="unsortedPool" class="flex flex-wrap gap-2.5 min-h-[70px] p-3 bg-slate-900/90 rounded-xl border border-slate-800">
                    <!-- Dynamic food items render here -->
                </div>
            </div>

            <!-- 5 Category Buckets -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4" id="categoryBucketsGrid">
                <!-- Fruit Bucket -->
                <div data-category="Fruit" onclick="handleCategoryClick('Fruit')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'Fruit')"
                     class="category-bucket bg-slate-800 p-4 rounded-2xl border-2 border-amber-500/40 hover:border-amber-400 transition flex flex-col justify-between space-y-3 min-h-[220px]">
                    <div>
                        <div class="flex justify-between items-center pb-2 border-b border-slate-700/80 mb-3">
                            <h3 class="font-extrabold text-sm text-amber-300 flex items-center gap-1.5">
                                <span>🍎</span> Fruit
                            </h3>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800/50 count-badge">0 items</span>
                        </div>
                        <div class="bucket-contents space-y-2 min-h-[100px]" id="bucket-Fruit">
                            <p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>
                        </div>
                    </div>
                    <!-- Extra Word Input -->
                    <div class="pt-2 border-t border-slate-700/60" onclick="event.stopPropagation()">
                        <div class="flex gap-1.5">
                            <input type="text" id="extra-Fruit" placeholder="+ Add 1 extra fruit" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-amber-200 placeholder-slate-500 focus:outline-none focus:border-amber-500">
                            <button onclick="addCustomWord('Fruit')" class="px-2 py-1 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div id="customList-Fruit" class="flex flex-wrap gap-1 mt-1.5"></div>
                    </div>
                </div>

                <!-- Vegetables Bucket -->
                <div data-category="Vegetables" onclick="handleCategoryClick('Vegetables')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'Vegetables')"
                     class="category-bucket bg-slate-800 p-4 rounded-2xl border-2 border-emerald-500/40 hover:border-emerald-400 transition flex flex-col justify-between space-y-3 min-h-[220px]">
                    <div>
                        <div class="flex justify-between items-center pb-2 border-b border-slate-700/80 mb-3">
                            <h3 class="font-extrabold text-sm text-emerald-300 flex items-center gap-1.5">
                                <span>🥦</span> Vegetables
                            </h3>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50 count-badge">0 items</span>
                        </div>
                        <div class="bucket-contents space-y-2 min-h-[100px]" id="bucket-Vegetables">
                            <p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60" onclick="event.stopPropagation()">
                        <div class="flex gap-1.5">
                            <input type="text" id="extra-Vegetables" placeholder="+ Add 1 extra vegetable" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-emerald-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500">
                            <button onclick="addCustomWord('Vegetables')" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div id="customList-Vegetables" class="flex flex-wrap gap-1 mt-1.5"></div>
                    </div>
                </div>

                <!-- Grains Bucket -->
                <div data-category="Grains" onclick="handleCategoryClick('Grains')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'Grains')"
                     class="category-bucket bg-slate-800 p-4 rounded-2xl border-2 border-yellow-500/40 hover:border-yellow-400 transition flex flex-col justify-between space-y-3 min-h-[220px]">
                    <div>
                        <div class="flex justify-between items-center pb-2 border-b border-slate-700/80 mb-3">
                            <h3 class="font-extrabold text-sm text-yellow-300 flex items-center gap-1.5">
                                <span>🌾</span> Grains
                            </h3>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-yellow-950 text-yellow-400 border border-yellow-800/50 count-badge">0 items</span>
                        </div>
                        <div class="bucket-contents space-y-2 min-h-[100px]" id="bucket-Grains">
                            <p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60" onclick="event.stopPropagation()">
                        <div class="flex gap-1.5">
                            <input type="text" id="extra-Grains" placeholder="+ Add 1 extra grain" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-yellow-200 placeholder-slate-500 focus:outline-none focus:border-yellow-500">
                            <button onclick="addCustomWord('Grains')" class="px-2 py-1 bg-yellow-600 hover:bg-yellow-500 text-white rounded-lg text-xs"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div id="customList-Grains" class="flex flex-wrap gap-1 mt-1.5"></div>
                    </div>
                </div>

                <!-- Meat Bucket -->
                <div data-category="Meat" onclick="handleCategoryClick('Meat')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'Meat')"
                     class="category-bucket bg-slate-800 p-4 rounded-2xl border-2 border-rose-500/40 hover:border-rose-400 transition flex flex-col justify-between space-y-3 min-h-[220px]">
                    <div>
                        <div class="flex justify-between items-center pb-2 border-b border-slate-700/80 mb-3">
                            <h3 class="font-extrabold text-sm text-rose-300 flex items-center gap-1.5">
                                <span>🥩</span> Meat
                            </h3>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-rose-950 text-rose-400 border border-rose-800/50 count-badge">0 items</span>
                        </div>
                        <div class="bucket-contents space-y-2 min-h-[100px]" id="bucket-Meat">
                            <p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60" onclick="event.stopPropagation()">
                        <div class="flex gap-1.5">
                            <input type="text" id="extra-Meat" placeholder="+ Add 1 extra meat" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-rose-200 placeholder-slate-500 focus:outline-none focus:border-rose-500">
                            <button onclick="addCustomWord('Meat')" class="px-2 py-1 bg-rose-600 hover:bg-rose-500 text-white rounded-lg text-xs"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div id="customList-Meat" class="flex flex-wrap gap-1 mt-1.5"></div>
                    </div>
                </div>

                <!-- Seafood Bucket -->
                <div data-category="Seafood" onclick="handleCategoryClick('Seafood')" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'Seafood')"
                     class="category-bucket bg-slate-800 p-4 rounded-2xl border-2 border-sky-500/40 hover:border-sky-400 transition flex flex-col justify-between space-y-3 min-h-[220px]">
                    <div>
                        <div class="flex justify-between items-center pb-2 border-b border-slate-700/80 mb-3">
                            <h3 class="font-extrabold text-sm text-sky-300 flex items-center gap-1.5">
                                <span>🦐</span> Seafood
                            </h3>
                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-950 text-sky-400 border border-sky-800/50 count-badge">0 items</span>
                        </div>
                        <div class="bucket-contents space-y-2 min-h-[100px]" id="bucket-Seafood">
                            <p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60" onclick="event.stopPropagation()">
                        <div class="flex gap-1.5">
                            <input type="text" id="extra-Seafood" placeholder="+ Add 1 extra seafood" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-sky-200 placeholder-slate-500 focus:outline-none focus:border-sky-500">
                            <button onclick="addCustomWord('Seafood')" class="px-2 py-1 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div id="customList-Seafood" class="flex flex-wrap gap-1 mt-1.5"></div>
                    </div>
                </div>
            </div>

            <!-- Validation Modal / Notification Toast Banner -->
            <div id="sortingFeedbackBanner" class="hidden bg-slate-800 p-4 rounded-2xl border border-slate-700 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div id="bannerIcon" class="w-10 h-10 rounded-xl flex items-center justify-center text-xl"></div>
                    <div>
                        <h4 id="bannerTitle" class="font-bold text-sm text-white">Result</h4>
                        <p id="bannerText" class="text-xs text-slate-300">Feedback description...</p>
                    </div>
                </div>
                <button onclick="dismissBanner()" class="text-slate-400 hover:text-white px-2 py-1 text-xs">Dismiss</button>
            </div>
        </section>

        <!-- SECTION B: FAVORITES & UNTRIED FOODS INTERACTIVE SURVEY -->
        <section id="tabSectionB" class="hidden space-y-6">
            
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-2">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-comments text-amber-400"></i> Section B: Food Preferences Survey
                </h2>
                <p class="text-xs text-slate-400">Select your favorite foods and check off foods you haven't tried yet. Practice reading your personal speaking sentences aloud!</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                
                <!-- Survey Controls -->
                <div class="space-y-6">
                    
                    <!-- 1. Favorite Foods Pickers -->
                    <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-4">
                        <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-heart text-rose-400"></i> What's your favorite food in each category?
                        </h3>

                        <div class="grid grid-cols-1 gap-3 text-xs" id="favoritesPickersContainer">
                            <!-- Dynamic category favorites selectors -->
                        </div>
                    </div>

                    <!-- 2. Untried Foods Checklist -->
                    <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-3">
                        <h3 class="text-xs font-bold text-sky-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-question-circle text-sky-400"></i> Which of these foods have you NEVER tried?
                        </h3>
                        <p class="text-[11px] text-slate-400">Click any food items you haven't tasted yet:</p>

                        <div id="untriedChecklistGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                            <!-- Dynamic untried checkboxes -->
                        </div>
                    </div>
                </div>

                <!-- Dynamic Speech Practice Generator -->
                <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-6">
                    <div class="space-y-4">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-bullhorn"></i> Dynamic Speaking Scripts
                            </span>
                            <span class="text-[10px] font-mono text-slate-500">Live Sentence Builder</span>
                        </div>

                        <!-- Generated Favorite Sentence Card -->
                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-2">
                            <span class="text-[10px] font-bold text-slate-400 uppercase">Sentence 1 • My Favorites:</span>
                            <p id="scriptFavorites" class="text-sm font-medium text-amber-200 leading-relaxed italic">
                                "My favorite fruit is mangoes, my favorite vegetable is corn, my favorite grain is rice, my favorite meat is chicken, and my favorite seafood is shrimp."
                            </p>
                            <div class="flex justify-end pt-1">
                                <button onclick="speakScript('scriptFavorites')" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5">
                                    <i class="fa-solid fa-volume-high"></i> Listen Sentence 1
                                </button>
                            </div>
                        </div>

                        <!-- Generated Untried Sentence Card -->
                        <div class="bg-slate-900 p-4 rounded-xl border border-slate-800 space-y-2">
                            <span class="text-[10px] font-bold text-slate-400 uppercase">Sentence 2 • Untried Foods:</span>
                            <p id="scriptUntried" class="text-sm font-medium text-sky-200 leading-relaxed italic">
                                "I have never tried octopus or lamb."
                            </p>
                            <div class="flex justify-end pt-1">
                                <button onclick="speakScript('scriptUntried')" class="px-3 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1.5">
                                    <i class="fa-solid fa-volume-high"></i> Listen Sentence 2
                                </button>
                            </div>
                        </div>

                        <!-- Full Combined Speech -->
                        <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80 space-y-2">
                            <span class="text-[10px] font-bold text-slate-400 uppercase">Sentence 3 • Full Monologue:</span>
                            <p id="scriptCombined" class="text-xs text-slate-300 leading-relaxed">
                                ...
                            </p>
                        </div>
                    </div>

                    <button onclick="speakScript('scriptCombined')" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl font-bold text-xs transition flex items-center justify-center gap-2 shadow-lg">
                        <i class="fa-solid fa-circle-play text-base"></i> Read Full Presentation Aloud
                    </button>
                </div>

            </div>
        </section>

        <!-- SECTION C: INTERACTIVE FLASHCARDS & LISTENING QUIZ -->
        <section id="tabSectionC" class="hidden space-y-6">
            
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-headphones text-sky-400"></i> Section C: Audio Flashcards & Quiz
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Study food pronunciation with flashcards or test your listening comprehension in the mini quiz.</p>
                </div>

                <!-- Sub-tab switcher -->
                <div class="flex bg-slate-900 p-1 rounded-xl border border-slate-700 text-xs font-bold">
                    <button onclick="switchSubTab('flashcards')" id="subTabFlashcards" class="px-3 py-1.5 rounded-lg text-sky-400 bg-slate-800">Flashcards</button>
                    <button onclick="switchSubTab('quiz')" id="subTabQuiz" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white">Listening Quiz</button>
                </div>
            </div>

            <!-- SUB-TAB 1: FLASHCARDS GRID -->
            <div id="subViewFlashcards" class="space-y-4">
                <!-- Search and filter -->
                <div class="flex flex-wrap gap-2 justify-between items-center bg-slate-800/60 p-3 rounded-xl border border-slate-700">
                    <div class="flex gap-1.5 overflow-x-auto text-xs" id="flashcardFilterBtns">
                        <button onclick="filterFlashcards('All')" class="fc-filter-btn px-3 py-1 rounded-lg bg-sky-600 text-white font-bold">All</button>
                        <button onclick="filterFlashcards('Fruit')" class="fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300">Fruit</button>
                        <button onclick="filterFlashcards('Vegetables')" class="fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300">Vegetables</button>
                        <button onclick="filterFlashcards('Grains')" class="fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300">Grains</button>
                        <button onclick="filterFlashcards('Meat')" class="fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300">Meat</button>
                        <button onclick="filterFlashcards('Seafood')" class="fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300">Seafood</button>
                    </div>

                    <div class="w-full sm:w-auto">
                        <input type="text" id="flashcardSearch" onkeyup="renderFlashcards()" placeholder="Search food..." class="w-full sm:w-48 bg-slate-900 border border-slate-700 rounded-lg px-3 py-1 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-sky-500">
                    </div>
                </div>

                <!-- Flashcards Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3" id="flashcardsGrid">
                    <!-- Dynamic Flashcards -->
                </div>
            </div>

            <!-- SUB-TAB 2: LISTENING QUIZ -->
            <div id="subViewQuiz" class="hidden space-y-6">
                <div class="bg-slate-950 p-6 md:p-8 rounded-2xl border border-slate-800 text-center max-w-2xl mx-auto space-y-6">
                    <div class="flex justify-between items-center text-xs text-slate-400">
                        <span>Listening Comprehension Task</span>
                        <span>Streak: <strong id="quizStreak" class="text-amber-400">0</strong> 🔥</span>
                    </div>

                    <div class="py-4 space-y-4">
                        <button onclick="playQuizTargetAudio()" class="w-24 h-24 rounded-full bg-sky-600 hover:bg-sky-500 text-white text-4xl mx-auto flex items-center justify-center shadow-2xl transition hover:scale-105 border-4 border-sky-900">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Click button to hear the mystery food word</p>
                    </div>

                    <!-- Choices Grid -->
                    <div class="grid grid-cols-2 gap-3" id="quizChoicesGrid">
                        <!-- 4 choices rendered here -->
                    </div>

                    <div id="quizFeedback" class="min-h-[24px] text-xs font-bold"></div>
                </div>
            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        Food Categories Studio • ESL Word Power Interactive Application
    </footer>

    <script>
        // Target Vocabulary Items Data (15 Textbook items)
        const targetFoodItems = [
            { id: 'bread', name: 'bread', category: 'Grains', emoji: '🍞', phonetic: '/bred/' },
            { id: 'chicken', name: 'chicken', category: 'Meat', emoji: '🍗', phonetic: '/ˈtʃɪk.ɪn/' },
            { id: 'corn', name: 'corn', category: 'Vegetables', emoji: '🌽', phonetic: '/kɔːrn/' },
            { id: 'fish', name: 'fish', category: 'Seafood', emoji: '🐟', phonetic: '/fɪʃ/' },
            { id: 'grapes', name: 'grapes', category: 'Fruit', emoji: '🍇', phonetic: '/ɡreɪps/' },
            { id: 'lamb', name: 'lamb', category: 'Meat', emoji: '🥩', phonetic: '/læm/' },
            { id: 'mangoes', name: 'mangoes', category: 'Fruit', emoji: '🥭', phonetic: '/ˈmæŋ.ɡoʊz/' },
            { id: 'octopus', name: 'octopus', category: 'Seafood', emoji: '🐙', phonetic: '/ˈɑːk.tə.pəs/' },
            { id: 'pasta', name: 'pasta', category: 'Grains', emoji: '🍝', phonetic: '/ˈpɑː.stə/' },
            { id: 'peas', name: 'peas', category: 'Vegetables', emoji: '🫛', phonetic: '/piːz/' },
            { id: 'potatoes', name: 'potatoes', category: 'Vegetables', emoji: '🥔', phonetic: '/pəˈteɪ.toʊz/' },
            { id: 'rice', name: 'rice', category: 'Grains', emoji: '🍚', phonetic: '/raɪs/' },
            { id: 'shrimp', name: 'shrimp', category: 'Seafood', emoji: '🦐', phonetic: '/ʃrɪmp/' },
            { id: 'strawberries', name: 'strawberries', category: 'Fruit', emoji: '🍓', phonetic: '/ˈstrɔːˌber.iz/' },
            { id: 'turkey', name: 'turkey', category: 'Meat', emoji: '🦃', phonetic: '/ˈtɜːr.ki/' }
        ];

        // State variables
        let soundEnabled = true;
        let selectedItemId = null;
        let sortedAssignments = {}; // { itemId: categoryName }
        let customWords = { Fruit: [], Vegetables: [], Grains: [], Meat: [], Seafood: [] };
        
        let surveyFavorites = {
            Fruit: 'mangoes',
            Vegetables: 'corn',
            Grains: 'rice',
            Meat: 'chicken',
            Seafood: 'shrimp'
        };
        let surveyUntried = ['octopus', 'lamb'];

        let flashcardCategoryFilter = 'All';
        let currentQuizItem = null;
        let quizStreak = 0;

        function speakWord(text, rate = 0.9) {
            if (!soundEnabled) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = rate;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }

        function toggleAudioHelp() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('audioToggleIcon');
            const btn = document.getElementById('audioToggleBtn');
            
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high';
                btn.className = 'p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-sky-400 text-xs transition';
                speakWord('Audio enabled');
            } else {
                icon.className = 'fa-solid fa-volume-xmark';
                btn.className = 'p-2 bg-slate-700 hover:bg-slate-600 rounded-xl text-rose-400 text-xs transition';
            }
        }

        function switchTab(tabId) {
            ['tabSectionA', 'tabSectionB', 'tabSectionC'].forEach(t => {
                document.getElementById(t).classList.add('hidden');
                const btn = document.getElementById(`btn${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (btn) btn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2 whitespace-nowrap';
            });

            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = document.getElementById(`btn${tabId.charAt(0).toUpperCase() + tabId.slice(1)}`);
            if (activeBtn) activeBtn.className = 'tab-active px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2 whitespace-nowrap';
        }

        function renderSortingGame() {
            const unsortedPool = document.getElementById('unsortedPool');
            unsortedPool.innerHTML = '';

            const categories = ['Fruit', 'Vegetables', 'Grains', 'Meat', 'Seafood'];
            
            // Clear bucket DOMs
            categories.forEach(cat => {
                const bEl = document.getElementById(`bucket-${cat}`);
                bEl.innerHTML = '';
            });

            let unsortedCount = 0;

            targetFoodItems.forEach(item => {
                const assignedCategory = sortedAssignments[item.id];

                // Create item card HTML
                const card = document.createElement('div');
                card.id = `foodCard-${item.id}`;
                card.draggable = true;
                card.ondragstart = (e) => handleDragStart(e, item.id);
                card.onclick = (e) => {
                    e.stopPropagation();
                    handleItemClick(item.id);
                };

                const isSelected = selectedItemId === item.id;
                let borderStyle = isSelected ? 'border-sky-400 ring-2 ring-sky-400 scale-105' : 'border-slate-700 hover:border-slate-500';

                card.className = `p-2 bg-slate-800 border ${borderStyle} rounded-xl text-xs font-semibold text-white flex items-center gap-2 cursor-pointer shadow-md select-none transition-all`;

                card.innerHTML = `
                    <span class="text-base">${item.emoji}</span>
                    <span>${item.name}</span>
                    <button onclick="event.stopPropagation(); speakWord('${item.name}')" class="text-slate-400 hover:text-sky-300 ml-auto px-1">
                        <i class="fa-solid fa-volume-high text-[10px]"></i>
                    </button>
                `;

                if (!assignedCategory) {
                    unsortedPool.appendChild(card);
                    unsortedCount++;
                } else {
                    const bucket = document.getElementById(`bucket-${assignedCategory}`);
                    bucket.appendChild(card);
                }
            });

            // Update unsorted count
            document.getElementById('unsortedCount').innerText = unsortedCount;

            if (unsortedCount === 0) {
                unsortedPool.innerHTML = `<p class="text-xs text-emerald-400 font-bold italic py-2 w-full text-center"><i class="fa-solid fa-circle-check"></i> All items have been assigned! Click "Check Answers" above.</p>`;
            }

            // Update category badge counts
            categories.forEach(cat => {
                const bucketEl = document.getElementById(`bucket-${cat}`);
                const countBadge = bucketEl.closest('.category-bucket').querySelector('.count-badge');
                const emptyMsg = bucketEl.querySelector('.empty-msg');
                const itemCount = bucketEl.querySelectorAll('[id^="foodCard-"]').length;
                
                countBadge.innerText = `${itemCount} items`;

                if (itemCount === 0 && !emptyMsg) {
                    bucketEl.innerHTML = `<p class="text-[11px] text-slate-500 italic text-center pt-6 empty-msg">Drop or tap items here</p>`;
                } else if (itemCount > 0 && emptyMsg) {
                    emptyMsg.remove();
                }
            });

            // Update Score tracker header
            const sortedTotal = Object.keys(sortedAssignments).length;
            document.getElementById('globalScore').innerText = `${sortedTotal} / 15`;
        }

        function handleItemClick(itemId) {
            const item = targetFoodItems.find(f => f.id === itemId);
            speakWord(item.name);

            if (selectedItemId === itemId) {
                selectedItemId = null; // Unselect
            } else {
                selectedItemId = itemId; // Select
            }
            renderSortingGame();
        }

        function handleCategoryClick(category) {
            if (selectedItemId) {
                sortedAssignments[selectedItemId] = category;
                selectedItemId = null;
                renderSortingGame();
            }
        }

        // HTML5 Drag and drop handlers
        function handleDragStart(e, itemId) {
            e.dataTransfer.setData('text/plain', itemId);
            selectedItemId = itemId;
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('bucket-hover');
        }

        function handleDragLeave(e) {
            e.currentTarget.classList.remove('bucket-hover');
        }

        function handleDrop(e, category) {
            e.preventDefault();
            e.currentTarget.classList.remove('bucket-hover');
            const itemId = e.dataTransfer.getData('text/plain') || selectedItemId;
            if (itemId) {
                sortedAssignments[itemId] = category;
                selectedItemId = null;
                renderSortingGame();
            }
        }

        function addCustomWord(category) {
            const input = document.getElementById(`extra-${category}`);
            const val = input.value.trim();
            if (val) {
                customWords[category].push(val);
                input.value = '';
                renderCustomWords(category);
                speakWord(val);
            }
        }

        function renderCustomWords(category) {
            const container = document.getElementById(`customList-${category}`);
            container.innerHTML = '';
            customWords[category].forEach((w, idx) => {
                const tag = document.createElement('span');
                tag.className = "px-2 py-0.5 bg-slate-900 text-amber-300 border border-slate-700 rounded text-[10px] flex items-center gap-1";
                tag.innerHTML = `
                    <span>+ ${w}</span>
                    <button onclick="removeCustomWord('${category}', ${idx})" class="text-slate-500 hover:text-rose-400"><i class="fa-solid fa-xmark"></i></button>
                `;
                container.appendChild(tag);
            });
        }

        function removeCustomWord(category, idx) {
            customWords[category].splice(idx, 1);
            renderCustomWords(category);
        }

        function resetSortingGame() {
            sortedAssignments = {};
            selectedItemId = null;
            renderSortingGame();
            dismissBanner();
        }

        function checkSortingAnswers() {
            let correctCount = 0;
            let totalAssigned = Object.keys(sortedAssignments).length;

            if (totalAssigned === 0) {
                showBanner('error', 'No Items Sorted', 'Please place some food items into the category buckets first!');
                return;
            }

            targetFoodItems.forEach(item => {
                const assigned = sortedAssignments[item.id];
                if (assigned && assigned === item.category) {
                    correctCount++;
                }
            });

            if (correctCount === 15) {
                showBanner('success', 'Perfect Score! 🌟', 'Excellent job! All 15 food items are categorized correctly!');
                confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
                speakWord('Awesome job! All food categories are correct!');
            } else {
                showBanner('info', 'Check Progress', `You have correctly sorted ${correctCount} out of 15 target foods. Keep practicing!`);
            }
        }

        function showBanner(type, title, text) {
            const banner = document.getElementById('sortingFeedbackBanner');
            const icon = document.getElementById('bannerIcon');
            const titleEl = document.getElementById('bannerTitle');
            const textEl = document.getElementById('bannerText');

            banner.classList.remove('hidden');

            if (type === 'success') {
                icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center text-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40';
                icon.innerHTML = '<i class="fa-solid fa-trophy"></i>';
            } else if (type === 'error') {
                icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center text-xl bg-rose-500/20 text-rose-400 border border-rose-500/40';
                icon.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
            } else {
                icon.className = 'w-10 h-10 rounded-xl flex items-center justify-center text-xl bg-sky-500/20 text-sky-400 border border-sky-500/40';
                icon.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            titleEl.innerText = title;
            textEl.innerText = text;
        }

        function dismissBanner() {
            document.getElementById('sortingFeedbackBanner').classList.add('hidden');
        }

        function renderSurvey() {
            const favoritesContainer = document.getElementById('favoritesPickersContainer');
            favoritesContainer.innerHTML = '';

            const categories = ['Fruit', 'Vegetables', 'Grains', 'Meat', 'Seafood'];

            categories.forEach(cat => {
                const catItems = targetFoodItems.filter(f => f.category === cat);
                
                const row = document.createElement('div');
                row.className = "bg-slate-900 p-3 rounded-xl border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2";
                
                let optionsHtml = catItems.map(item => `
                    <option value="${item.name}" ${surveyFavorites[cat] === item.name ? 'selected' : ''}>${item.emoji} ${item.name}</option>
                `).join('');

                row.innerHTML = `
                    <span class="font-bold text-slate-300 w-28 uppercase text-[11px]">${cat}:</span>
                    <select onchange="updateFavorite('${cat}', this.value)" class="w-full sm:w-auto bg-slate-800 border border-slate-700 text-amber-300 font-bold rounded-lg px-3 py-1.5 focus:outline-none focus:border-amber-500">
                        ${optionsHtml}
                    </select>
                `;
                favoritesContainer.appendChild(row);
            });

            // Render Untried checklist
            const untriedGrid = document.getElementById('untriedChecklistGrid');
            untriedGrid.innerHTML = '';

            targetFoodItems.forEach(item => {
                const isChecked = surveyUntried.includes(item.name);
                const btn = document.createElement('button');
                btn.onclick = () => toggleUntried(item.name);
                
                let btnStyle = isChecked ? 'bg-sky-950 border-sky-500 text-sky-300' : 'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700';

                btn.className = `p-2 rounded-xl border ${btnStyle} text-xs font-semibold flex items-center justify-between transition`;
                btn.innerHTML = `
                    <span class="flex items-center gap-1.5">${item.emoji} ${item.name}</span>
                    <i class="fa-solid ${isChecked ? 'fa-square-check text-sky-400' : 'fa-square text-slate-700'}"></i>
                `;
                untriedGrid.appendChild(btn);
            });

            updateScripts();
        }

        function updateFavorite(category, val) {
            surveyFavorites[category] = val;
            updateScripts();
            speakWord(val);
        }

        function toggleUntried(foodName) {
            const idx = surveyUntried.indexOf(foodName);
            if (idx > -1) {
                surveyUntried.splice(idx, 1);
            } else {
                surveyUntried.push(foodName);
                speakWord(foodName);
            }
            renderSurvey();
        }

        function updateScripts() {
            const f = surveyFavorites;
            const favStr = `My favorite fruit is ${f.Fruit}, my favorite vegetable is ${f.Vegetables}, my favorite grain is ${f.Grains}, my favorite meat is ${f.Meat}, and my favorite seafood is ${f.Seafood}.`;
            
            document.getElementById('scriptFavorites').innerText = `"${favStr}"`;

            let untriedStr = "";
            if (surveyUntried.length === 0) {
                untriedStr = "I love food! I have tried all of these foods before.";
            } else if (surveyUntried.length === 1) {
                untriedStr = `I haven't tried ${surveyUntried[0]} yet.`;
            } else {
                const last = surveyUntried[surveyUntried.length - 1];
                const rest = surveyUntried.slice(0, -1).join(', ');
                untriedStr = `I have never tried ${rest} or ${last}.`;
            }

            document.getElementById('scriptUntried').innerText = `"${untriedStr}"`;
            document.getElementById('scriptCombined').innerText = `"${favStr} ${untriedStr}"`;
        }

        function speakScript(elementId) {
            const text = document.getElementById(elementId).innerText;
            speakWord(text.replace(/"/g, ''), 0.85);
        }

        function switchSubTab(sub) {
            if (sub === 'flashcards') {
                document.getElementById('subViewFlashcards').classList.remove('hidden');
                document.getElementById('subViewQuiz').classList.add('hidden');
                document.getElementById('subTabFlashcards').className = 'px-3 py-1.5 rounded-lg text-sky-400 bg-slate-800';
                document.getElementById('subTabQuiz').className = 'px-3 py-1.5 rounded-lg text-slate-400 hover:text-white';
            } else {
                document.getElementById('subViewFlashcards').classList.add('hidden');
                document.getElementById('subViewQuiz').classList.remove('hidden');
                document.getElementById('subTabFlashcards').className = 'px-3 py-1.5 rounded-lg text-slate-400 hover:text-white';
                document.getElementById('subTabQuiz').className = 'px-3 py-1.5 rounded-lg text-sky-400 bg-slate-800';
                initQuizQuestion();
            }
        }

        function filterFlashcards(category) {
            flashcardCategoryFilter = category;
            
            // Highlight filter button
            document.querySelectorAll('.fc-filter-btn').forEach(btn => {
                if (btn.innerText === category) {
                    btn.className = 'fc-filter-btn px-3 py-1 rounded-lg bg-sky-600 text-white font-bold';
                } else {
                    btn.className = 'fc-filter-btn px-3 py-1 rounded-lg bg-slate-700 text-slate-300';
                }
            });

            renderFlashcards();
        }

        function renderFlashcards() {
            const grid = document.getElementById('flashcardsGrid');
            const searchVal = document.getElementById('flashcardSearch').value.toLowerCase();
            grid.innerHTML = '';

            const filtered = targetFoodItems.filter(item => {
                const matchesCat = (flashcardCategoryFilter === 'All' || item.category === flashcardCategoryFilter);
                const matchesSearch = item.name.toLowerCase().includes(searchVal);
                return matchesCat && matchesSearch;
            });

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-slate-800 hover:bg-slate-700/80 border border-slate-700 hover:border-sky-500/50 p-4 rounded-2xl text-center space-y-2 transition group flex flex-col justify-between";
                
                card.innerHTML = `
                    <div class="space-y-1">
                        <span class="text-3xl block group-hover:scale-110 transition-transform">${item.emoji}</span>
                        <h4 class="font-bold text-sm text-white capitalize">${item.name}</h4>
                        <p class="text-[10px] font-mono text-slate-400">${item.phonetic}</p>
                    </div>
                    <div class="pt-2 flex justify-between items-center border-t border-slate-700/60 text-[10px]">
                        <span class="px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-700">${item.category}</span>
                        <button onclick="speakWord('${item.name}')" class="p-1.5 text-sky-400 hover:text-sky-300">
                            <i class="fa-solid fa-volume-high text-xs"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Mini Listening Quiz logic
        function initQuizQuestion() {
            document.getElementById('quizFeedback').innerText = '';
            
            // Select random item as target
            const randomTarget = targetFoodItems[Math.floor(Math.random() * targetFoodItems.length)];
            currentQuizItem = randomTarget;

            // Pick 3 distractors
            let choices = [randomTarget];
            while (choices.length < 4) {
                const rand = targetFoodItems[Math.floor(Math.random() * targetFoodItems.length)];
                if (!choices.includes(rand)) {
                    choices.push(rand);
                }
            }

            // Shuffle choices
            choices.sort(() => Math.random() - 0.5);

            // Render choices
            const grid = document.getElementById('quizChoicesGrid');
            grid.innerHTML = '';

            choices.forEach(choice => {
                const btn = document.createElement('button');
                btn.className = "p-4 bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-sky-500 rounded-2xl flex flex-col items-center justify-center gap-2 transition";
                btn.onclick = () => checkQuizAnswer(choice);
                
                btn.innerHTML = `
                    <span class="text-3xl">${choice.emoji}</span>
                    <span class="text-xs font-bold text-white capitalize">${choice.name}</span>
                `;
                grid.appendChild(btn);
            });

            // Automatically play sound
            setTimeout(() => {
                playQuizTargetAudio();
            }, 300);
        }

        function playQuizTargetAudio() {
            if (currentQuizItem) {
                speakWord(currentQuizItem.name);
            }
        }

        function checkQuizAnswer(choice) {
            const feedback = document.getElementById('quizFeedback');
            if (choice.id === currentQuizItem.id) {
                quizStreak++;
                document.getElementById('quizStreak').innerText = quizStreak;
                feedback.className = 'min-h-[24px] text-xs font-bold text-emerald-400';
                feedback.innerText = `✨ Correct! That was "${currentQuizItem.name}".`;
                speakWord('Correct!');
                setTimeout(initQuizQuestion, 1200);
            } else {
                quizStreak = 0;
                document.getElementById('quizStreak').innerText = quizStreak;
                feedback.className = 'min-h-[24px] text-xs font-bold text-rose-400';
                feedback.innerText = `❌ Try again! Listen carefully.`;
                playQuizTargetAudio();
            }
        }

        // Initialize on DOM load
        window.addEventListener('DOMContentLoaded', () => {
            renderSortingGame();
            renderSurvey();
            renderFlashcards();
            ['Fruit', 'Vegetables', 'Grains', 'Meat', 'Seafood'].forEach(renderCustomWords);
        });
    </script>
</body>
</html>
