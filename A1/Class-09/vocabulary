            activeBtn.classList.remove('text-white/80', 'hover:bg-white/10');

            if (tabId === 'timeline') renderTimeline();
            if (tabId === 'vocab') renderVocabGrid();
            if (tabId === 'games') initMatchGame();
            if (tabId === 'pairwork') updatePairWorkUI();
        }

        function toggleSpanishSupport() {
            sfx.playClick();
            showSpanish = !showSpanish;
            document.getElementById('spanishToggleText').innerText = showSpanish ? "Spanish On" : "Spanish Off";
            const transElements = document.querySelectorAll('.es-trans');
            transElements.forEach(el => {
                if (showSpanish) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
        }

        function addStars(pts) {
            starPoints += pts;
            document.getElementById('starScore').innerText = starPoints;
            sfx.playFanfare();
        }

        // Survey Helper Functions
        function setQuickInput(inputId, val) {
            sfx.playClick();
            document.getElementById(inputId).value = val;
        }

        function handlePresetQuestionChange(selectEl) {
            sfx.playClick();
            const qInput = document.getElementById('customQuestion');
            if (selectEl.value !== 'custom') {
                qInput.value = selectEl.value;
            } else {
                qInput.value = '';
            }
            updateSurveyStory();
        }

        function updateSurveyStory() {
            const q1 = document.getElementById('q1').value.trim() || "[time you get up]";
            const q2 = document.getElementById('q2').value.trim() || "[what you do after]";
            const q3 = document.getElementById('q3').value.trim() || "[where you go]";
            const q4 = document.getElementById('q4').value.trim() || "[what you do in the evening]";
            const q5 = document.getElementById('q5').value.trim() || "[when you go to bed]";
            
            const customQ = document.getElementById('customQuestion').value.trim();
            const customA = document.getElementById('customAnswer').value.trim();

            let customSentence = "";
            if (customQ && customA) {
                customSentence = ` Regarding <strong>"${customQ}"</strong>, ${customA}.`;
            } else if (customA) {
                customSentence = ` Also, ${customA}.`;
            }

            const paragraphHTML = `
                On my perfect day, I get up <strong>${q1}</strong>. 
                After I get up, I <strong>${q2}</strong>. 
                In the afternoon, I go <strong>${q3}</strong>. 
                In the evening, I <strong>${q4}</strong>.${customSentence} 
                Finally, I go to bed <strong>${q5}</strong>. It is a wonderful day!
            `;

            document.getElementById('storyText').innerHTML = paragraphHTML;

            // Update Progress counter
            let answered = 0;
            if (document.getElementById('q1').value.trim()) answered++;
            if (document.getElementById('q2').value.trim()) answered++;
            if (document.getElementById('q3').value.trim()) answered++;
            if (document.getElementById('q4').value.trim()) answered++;
            if (document.getElementById('q5').value.trim()) answered++;
            if (customA) answered++;

            const pct = Math.round((answered / 6) * 100);
            document.getElementById('completionPercent').innerText = pct + "%";
            document.getElementById('completedCount').innerText = `${answered} of 6 answered`;

            if (pct === 100 && !window.surveyCelebrated) {
                window.surveyCelebrated = true;
                confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
                addStars(50);
            }
        }

        function readGeneratedStory() {
            const rawText = document.getElementById('storyText').innerText;
            speakText(rawText);
        }

        function copyStoryText() {
            sfx.playClick();
            const rawText = document.getElementById('storyText').innerText;
            navigator.clipboard.writeText(rawText).then(() => {
                alert("Story copied to clipboard!");
            });
        }

        function transferToTimeline() {
            sfx.playClick();
            const q1Time = document.getElementById('q1_time').value || "09:00";
            const q1Val = document.getElementById('q1').value || "Get up";
            const q2Val = document.getElementById('q2').value || "Eat breakfast";
            const q3Val = document.getElementById('q3').value || "Go to the beach";
            const q4Val = document.getElementById('q4').value || "Watch movie";
            const q5Time = document.getElementById('q5_time').value || "23:00";

            timelineEvents = [
                { id: Date.now() + 1, slot: 'morning', time: q1Time, title: `Get up (${q1Val}) & ${q2Val}`, icon: 'fa-sun' },
                { id: Date.now() + 2, slot: 'afternoon', time: '02:00 PM', title: `Go ${q3Val}`, icon: 'fa-umbrella-beach' },
                { id: Date.now() + 3, slot: 'evening', time: '07:30 PM', title: q4Val, icon: 'fa-film' },
                { id: Date.now() + 4, slot: 'night', time: q5Time, title: 'Go to bed', icon: 'fa-bed' }
            ];

            switchTab('timeline');
        }

        // Timeline Functions
        function renderTimeline() {
            ['morning', 'afternoon', 'evening', 'night'].forEach(slot => {
                const slotEl = document.getElementById(`slot-${slot}`);
                const items = timelineEvents.filter(e => e.slot === slot);
                
                if (items.length === 0) {
                    slotEl.innerHTML = `<div class="text-xs text-slate-400 italic p-3 text-center border border-dashed rounded-xl">No events planned</div>`;
                    return;
                }

                slotEl.innerHTML = items.map(item => `
                    <div class="bg-white p-3 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between group hover:shadow-md transition">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center text-sm font-bold">
                                <i class="fa-solid ${item.icon}"></i>
                            </div>
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">${item.time}</span>
                                <p class="text-xs font-bold text-slate-800">${item.title}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1 opacity-80 group-hover:opacity-100">
                            <button onclick="speakText('${item.title}')" class="text-sky-600 hover:text-sky-800 p-1 rounded">
                                <i class="fa-solid fa-volume-high text-xs"></i>
                            </button>
                            <button onclick="deleteTimelineEvent(${item.id})" class="text-rose-400 hover:text-rose-600 p-1 rounded">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            });
        }

        function deleteTimelineEvent(id) {
            sfx.playClick();
            timelineEvents = timelineEvents.filter(e => e.id !== id);
            renderTimeline();
        }

        function resetTimeline() {
            sfx.playClick();
            timelineEvents = [];
            renderTimeline();
        }

        function openAddEventModal() {
            sfx.playClick();
            document.getElementById('addEventModal').classList.remove('hidden');
        }

        function closeAddEventModal() {
            sfx.playClick();
            document.getElementById('addEventModal').classList.add('hidden');
        }

        function saveNewTimelineEvent() {
            sfx.playClick();
            const slot = document.getElementById('newEventTimeSlot').value;
            const time = document.getElementById('newEventTime').value || '12:00 PM';
            const title = document.getElementById('newEventTitle').value || 'New Activity';
            const icon = document.getElementById('newEventIcon').value;

            timelineEvents.push({
                id: Date.now(),
                slot,
                time,
                title,
                icon
            });

            closeAddEventModal();
            renderTimeline();
        }

        // Vocabulary Grid Renderer
        function renderVocabGrid() {
            const container = document.getElementById('vocabGrid');
            container.innerHTML = vocabularyData.map(v => `
                <div class="card-flip-container h-48 cursor-pointer group" onclick="this.classList.toggle('card-flipped')">
                    <div class="card-flip-inner relative w-full h-full duration-500">
                        
                        <!-- CARD FRONT -->
                        <div class="card-front absolute inset-0 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-teal-300 transition">
                            <div class="flex items-start justify-between">
                                <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-lg">
                                    <i class="fa-solid ${v.icon}"></i>
                                </div>
                                <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">${v.cat}</span>
                            </div>

                            <div>
                                <h4 class="font-display font-extrabold text-slate-800 text-xl">${v.phrase}</h4>
                                <p class="text-xs text-teal-600 font-mono mt-0.5">${v.ipa}</p>
                                <p class="es-trans text-xs text-amber-600 font-semibold mt-1 ${showSpanish ? '' : 'hidden'}">${v.es}</p>
                            </div>

                            <div class="flex items-center justify-between border-t pt-2 text-xs text-slate-400">
                                <button onclick="event.stopPropagation(); speakText('${v.phrase}')" class="text-teal-600 hover:text-teal-800 font-bold flex items-center gap-1">
                                    <i class="fa-solid fa-volume-high"></i> Listen
                                </button>
                                <span class="text-[11px]"><i class="fa-solid fa-rotate mr-1"></i> Flip for example</span>
                            </div>
                        </div>

                        <!-- CARD BACK -->
                        <div class="card-back absolute inset-0 bg-gradient-to-br from-teal-600 to-emerald-700 p-5 rounded-2xl text-white shadow-md flex flex-col justify-between">
                            <div class="space-y-2">
                                <span class="text-[10px] uppercase font-extrabold text-teal-200 tracking-wider">Example Sentence</span>
                                <p class="text-xs sm:text-sm italic leading-snug font-medium">"${v.ex}"</p>
                                <p class="text-xs text-teal-100 border-t border-white/20 pt-2">${v.def}</p>
                            </div>

                            <button onclick="event.stopPropagation(); speakText('${v.ex}')" class="bg-white/20 hover:bg-white/30 text-white font-bold py-1.5 px-3 rounded-xl text-xs transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-volume-high"></i> Listen Example
                            </button>
                        </div>

                    </div>
                </div>
            `).join('');
        }

        function playAllVocab() {
            sfx.playClick();
            let delay = 0;
            vocabularyData.forEach(v => {
                setTimeout(() => {
                    speakText(v.phrase);
                }, delay);
                delay += 1800;
            });
        }

        // Sub-game switching
        function switchSubGame(gameKey) {
            sfx.playClick();
            ['match', 'fill', 'quiz'].forEach(k => {
                document.getElementById(`game-${k}`).classList.add('hidden');
                const btn = document.getElementById(`sub-${k}`);
                btn.classList.remove('bg-white', 'text-amber-800');
                btn.classList.add('text-white', 'hover:bg-white/10');
            });

            document.getElementById(`game-${gameKey}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`sub-${gameKey}`);
            activeBtn.classList.add('bg-white', 'text-amber-800');
            activeBtn.classList.remove('text-white', 'hover:bg-white/10');

            if (gameKey === 'match') initMatchGame();
            if (gameKey === 'fill') initFillGame();
            if (gameKey === 'quiz') initQuizGame();
        }

        // GAME 1: Q&A MATCH GAME
        const matchData = [
            { id: 1, q: "What time do you get up?", a: "At 9:30 AM on my perfect day." },
            { id: 2, q: "What do you do after you get up?", a: "I eat a delicious breakfast." },
            { id: 3, q: "Where do you go?", a: "I go to the beach with friends." },
            { id: 4, q: "What do you do in the evening?", a: "I watch a movie and relax." },
            { id: 5, q: "When do you go to bed?", a: "I go to bed at 11:00 PM." }
        ];

        let selectedQ = null;

        function initMatchGame() {
            selectedQ = null;
            const container = document.getElementById('matchGameContainer');
            
            // Shuffle answers
            const shuffledAnswers = [...matchData].sort(() => Math.random() - 0.5);

            container.innerHTML = `
                <div class="space-y-3">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400">Questions</h4>
                    ${matchData.map(m => `
                        <div id="match-q-${m.id}" onclick="selectMatchQ(${m.id})" class="p-3 bg-slate-50 border-2 border-slate-200 hover:border-sky-400 rounded-xl cursor-pointer transition font-bold text-slate-700 text-xs sm:text-sm flex items-center justify-between">
                            <span>${m.q}</span>
                            <i class="fa-solid fa-chevron-right text-slate-300 text-xs"></i>
                        </div>
                    `).join('')}
                </div>

                <div class="space-y-3">
                    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400">Answers</h4>
                    ${shuffledAnswers.map(a => `
                        <div id="match-a-${a.id}" onclick="selectMatchA(${a.id})" class="p-3 bg-slate-50 border-2 border-slate-200 hover:border-amber-400 rounded-xl cursor-pointer transition font-medium text-slate-700 text-xs sm:text-sm">
                            ${a.a}
                        </div>
                    `).join('')}
                </div>
            `;
        }

        function selectMatchQ(id) {
            sfx.playClick();
            selectedQ = id;
            matchData.forEach(m => {
                const el = document.getElementById(`match-q-${m.id}`);
                if (el) el.classList.remove('border-sky-500', 'bg-sky-50');
            });
            const activeEl = document.getElementById(`match-q-${id}`);
            if (activeEl) activeEl.classList.add('border-sky-500', 'bg-sky-50');
        }

        function selectMatchA(ansId) {
            if (!selectedQ) {
                alert("Please select a question on the left first!");
                return;
            }

            if (selectedQ === ansId) {
                sfx.playCorrect();
                const qEl = document.getElementById(`match-q-${selectedQ}`);
                const aEl = document.getElementById(`match-a-${ansId}`);

                qEl.className = "p-3 bg-emerald-50 border-2 border-emerald-500 text-emerald-800 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-between";
                qEl.innerHTML += ` <i class="fa-solid fa-check text-emerald-600"></i>`;
                
                aEl.className = "p-3 bg-emerald-50 border-2 border-emerald-500 text-emerald-800 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-between";
                aEl.innerHTML += ` <i class="fa-solid fa-check text-emerald-600"></i>`;

                qEl.onclick = null;
                aEl.onclick = null;
                selectedQ = null;
                addStars(10);
            } else {
                sfx.playWrong();
                alert("Not a match! Try again.");
            }
        }

        // GAME 2: FILL IN THE BLANKS
        const fillSentences = [
            { text: "On my perfect day, I _____ up at 9:00 AM.", ans: "get", hint: "get / go / eat" },
            { text: "After I get up, I eat a big _____.", ans: "breakfast", hint: "dinner / breakfast / sleep" },
            { text: "In the afternoon, I go _____ the beach.", ans: "to", hint: "at / to / in" },
            { text: "In the _____, I watch movies with my family.", ans: "evening", hint: "morning / evening / midnight" },
            { text: "I go to _____ at 11:00 PM.", ans: "bed", hint: "park / bed / kitchen" }
        ];

        function initFillGame() {
            const list = document.getElementById('fillBlankList');
            list.innerHTML = fillSentences.map((s, idx) => `
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
                    <p class="font-bold text-slate-800 text-sm">${idx + 1}. ${s.text.replace('_____', `<input type="text" id="fill-in-${idx}" class="mx-1 px-3 py-1 border border-slate-300 rounded-lg text-sky-700 font-bold focus:outline-none focus:ring-2 focus:ring-sky-500 w-32 inline-block">`)}</p>
                    <p class="text-xs text-slate-400">Hint options: <span class="font-semibold text-slate-600">${s.hint}</span></p>
                </div>
            `).join('');
        }

        function checkFillAnswers() {
            let correctCount = 0;
            fillSentences.forEach((s, idx) => {
                const input = document.getElementById(`fill-in-${idx}`);
                if (input.value.trim().toLowerCase() === s.ans.toLowerCase()) {
                    input.className = "mx-1 px-3 py-1 border-2 border-emerald-500 bg-emerald-50 text-emerald-800 rounded-lg font-bold w-32 inline-block";
                    correctCount++;
                } else {
                    input.className = "mx-1 px-3 py-1 border-2 border-rose-500 bg-rose-50 text-rose-800 rounded-lg font-bold w-32 inline-block";
                }
            });

            if (correctCount === fillSentences.length) {
                sfx.playCorrect();
                confetti({ particleCount: 50, spread: 50 });
                addStars(25);
                alert("Great job! All answers are correct!");
            } else {
                sfx.playWrong();
                alert(`You got ${correctCount} out of ${fillSentences.length} correct. Check the red boxes and try again!`);
            }
        }

        // GAME 3: SPEED QUIZ
        const quizQuestions = [
            { q: "Which preposition is correct: '____ the evening'?", opts: ["In", "At", "On", "To"], correct: 0 },
            { q: "Complete: 'What time do you ____ up?'", opts: ["make", "get", "go", "eat"], correct: 1 },
            { q: "Which action comes last in the day?", opts: ["Eat breakfast", "Get up", "Go to bed", "Go to school"], correct: 2 },
            { q: "Which phrase means 'irse a la cama'?", opts: ["Go to bed", "Go to the beach", "Eat dinner", "Relax"], correct: 0 },
            { q: "We say: 'I go to bed ____ 10:00 PM.'", opts: ["in", "on", "at", "by"], correct: 2 }
        ];

        let quizIndex = 0;

        function initQuizGame() {
            quizIndex = 0;
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            if (quizIndex >= quizQuestions.length) {
                sfx.playFanfare();
                document.getElementById('quizCard').innerHTML = `
                    <div class="text-center py-6 space-y-3">
                        <i class="fa-solid fa-trophy text-amber-400 text-5xl animate-bounce"></i>
                        <h4 class="font-display font-extrabold text-2xl text-slate-800">Quiz Complete!</h4>
                        <p class="text-sm text-slate-600">You earned 30 extra star points!</p>
                        <button onclick="initQuizGame()" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-5 rounded-xl shadow transition text-xs">Play Again</button>
                    </div>
                `;
                addStars(30);
                return;
            }

            const q = quizQuestions[quizIndex];
            document.getElementById('quizNum').innerText = quizIndex + 1;
            document.getElementById('quizQuestionText').innerText = q.q;

            const optsBox = document.getElementById('quizOptions');
            optsBox.innerHTML = q.opts.map((opt, idx) => `
                <button onclick="handleQuizAnswer(${idx})" class="p-3 bg-white border border-slate-200 hover:border-amber-400 hover:bg-amber-50 rounded-xl font-bold text-slate-700 text-sm transition text-left">
                    ${opt}
                </button>
            `).join('');
        }

        function handleQuizAnswer(selectedIdx) {
            const q = quizQuestions[quizIndex];
            if (selectedIdx === q.correct) {
                sfx.playCorrect();
                quizIndex++;
                renderQuizQuestion();
            } else {
                sfx.playWrong();
                alert("Incorrect answer! Try again.");
            }
        }

        // Pair Work Functions
        function switchPairMode(mode) {
            sfx.playClick();
            if (mode === 'dialogue') {
                document.getElementById('pair-dialogue-mode').classList.remove('hidden');
                document.getElementById('pair-compare-mode').classList.add('hidden');
                document.getElementById('pair-dialogue-btn').className = "pair-mode-btn active px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-rose-800";
                document.getElementById('pair-compare-btn').className = "pair-mode-btn px-3 py-1.5 rounded-xl text-xs font-bold text-white hover:bg-white/10";
            } else {
                document.getElementById('pair-dialogue-mode').classList.add('hidden');
                document.getElementById('pair-compare-mode').classList.remove('hidden');
                document.getElementById('pair-dialogue-btn').className = "pair-mode-btn px-3 py-1.5 rounded-xl text-xs font-bold text-white hover:bg-white/10";
                document.getElementById('pair-compare-btn').className = "pair-mode-btn active px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-rose-800";
                updatePartnerComparison();
            }
        }

        function updatePairWorkUI() {
            const q1 = document.getElementById('q1').value || "at 9:00 AM";
            const q3 = document.getElementById('q3').value || "to the beach";
            const q4 = document.getElementById('q4').value || "watch a movie";

            const container = document.getElementById('dialogueContainer');
            container.innerHTML = `
                <div class="p-4 bg-sky-50 border border-sky-200 rounded-2xl space-y-1">
                    <span class="text-xs font-extrabold text-sky-700 uppercase">Student A</span>
                    <p class="font-bold text-slate-800 text-sm">"What time do you get up on your perfect day?"</p>
                    <button onclick="speakText('What time do you get up on your perfect day?')" class="text-xs text-sky-600 hover:underline font-semibold mt-1">
                        <i class="fa-solid fa-volume-high"></i> Listen Line
                    </button>
                </div>

                <div class="p-4 bg-purple-50 border border-purple-200 rounded-2xl space-y-1">
                    <span class="text-xs font-extrabold text-purple-700 uppercase">Student B</span>
                    <p class="font-bold text-slate-800 text-sm">"I get up <strong>${q1}</strong>. What about you?"</p>
                    <button onclick="speakText('I get up ${q1}. What about you?')" class="text-xs text-purple-600 hover:underline font-semibold mt-1">
                        <i class="fa-solid fa-volume-high"></i> Listen Line
                    </button>
                </div>

                <div class="p-4 bg-sky-50 border border-sky-200 rounded-2xl space-y-1">
                    <span class="text-xs font-extrabold text-sky-700 uppercase">Student A</span>
                    <p class="font-bold text-slate-800 text-sm">"Where do you go in the afternoon?"</p>
                    <button onclick="speakText('Where do you go in the afternoon?')" class="text-xs text-sky-600 hover:underline font-semibold mt-1">
                        <i class="fa-solid fa-volume-high"></i> Listen Line
                    </button>
                </div>

                <div class="p-4 bg-purple-50 border border-purple-200 rounded-2xl space-y-1">
                    <span class="text-xs font-extrabold text-purple-700 uppercase">Student B</span>
                    <p class="font-bold text-slate-800 text-sm">"I go <strong>${q3}</strong>. In the evening, I <strong>${q4}</strong>."</p>
                    <button onclick="speakText('I go ${q3}. In the evening, I ${q4}.')" class="text-xs text-purple-600 hover:underline font-semibold mt-1">
                        <i class="fa-solid fa-volume-high"></i> Listen Line
                    </button>
                </div>
            `;

            // Partner Summary card A
            document.getElementById('partnerA_Summary').innerHTML = `
                <p>• <strong>Gets up:</strong> ${q1}</p>
                <p>• <strong>Goes to:</strong> ${q3}</p>
                <p>• <strong>In evening:</strong> ${q4}</p>
            `;
        }

        function playFullDialogue() {
            sfx.playClick();
            const q1 = document.getElementById('q1').value || "at 9:00 AM";
            const q3 = document.getElementById('q3').value || "to the beach";
            const q4 = document.getElementById('q4').value || "watch a movie";

            const script = [
                "What time do you get up on your perfect day?",
                `I get up ${q1}. What about you?`,
                "Where do you go in the afternoon?",
                `I go ${q3}. In the evening, I ${q4}.`
            ];

            let delay = 0;
            script.forEach(line => {
                setTimeout(() => speakText(line), delay);
                delay += 2500;
            });
        }

        function updatePartnerComparison() {
            const name = document.getElementById('partner_name').value.trim() || "Partner";
            const partnerQ1 = document.getElementById('partner_q1').value.trim() || "10:00 AM";
            const partnerQ3 = document.getElementById('partner_q3').value.trim() || "to the park";
            const partnerQ4 = document.getElementById('partner_q4').value.trim() || "play games";

            const myQ1 = document.getElementById('q1').value || "9:00 AM";
            const myQ3 = document.getElementById('q3').value || "the beach";

            const compBox = document.getElementById('comparisonResults');
            compBox.innerHTML = `
                <div class="space-y-2">
                    <p class="font-bold text-slate-800">📊 Schedule Summary comparison with ${name}:</p>
                    <ul class="list-disc list-inside space-y-1 text-slate-700">
                        <li>You get up <strong>${myQ1}</strong> while ${name} gets up <strong>${partnerQ1}</strong>.</li>
                        <li>You go to <strong>${myQ3}</strong> while ${name} goes <strong>${partnerQ3}</strong>.</li>
                        <li>In the evening, ${name} likes to <strong>${partnerQ4}</strong>.</li>
                    </ul>
                </div>
            `;
            sfx.playClick();
        }

        // Initialization on page load
        window.onload = function() {
            updateSurveyStory();
            renderTimeline();
            renderVocabGrid();
            initMatchGame();
            initFillGame();
        };
    </script>
</body>
