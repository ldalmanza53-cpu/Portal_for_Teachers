<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Perfect Day - Interactive ESL Learning App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        },
                        accent: {
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom scrollbar and interactive transitions */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .card-flip-inner {
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        .card-flipped .card-flip-inner {
            transform: rotateY(180deg);
        }
        .card-front, .card-back {
            backface-visibility: hidden;
        }
        .card-back {
            transform: rotateY(180deg);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- TOP HEADER -->
    <header class="bg-gradient-to-r from-sky-600 via-indigo-600 to-purple-600 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="bg-white/20 p-2.5 rounded-2xl backdrop-blur-md text-amber-300 text-2xl shadow-inner">
                    <i class="fa-solid font-bold fa-sun animate-spin-slow"></i>
                </div>
                <div>
                    <h1 class="font-display font-extrabold text-xl sm:text-2xl tracking-tight leading-none text-white">
                        My Perfect Day <span class="text-amber-300 text-sm font-semibold px-2 py-0.5 bg-white/10 rounded-full ml-1">ESL A1-A2</span>
                    </h1>
                    <p class="text-xs text-sky-100 font-medium mt-0.5">Speaking & Vocabulary Interactive Survey</p>
                </div>
            </div>

            <!-- Score & Global Controls -->
            <div class="flex items-center space-x-3 sm:space-x-4">
                <div class="flex items-center bg-white/15 px-3 py-1.5 rounded-xl backdrop-blur-md border border-white/20">
                    <i class="fa-solid fa-star text-amber-300 text-lg mr-1.5 animate-bounce"></i>
                    <span id="starScore" class="font-bold text-lg">0</span>
                    <span class="text-xs text-sky-100 ml-1">pts</span>
                </div>

                <button id="spanishToggleBtn" onclick="toggleSpanishSupport()" class="text-xs font-semibold px-3 py-1.5 bg-white/15 hover:bg-white/25 rounded-xl border border-white/20 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-language text-sm"></i>
                    <span id="spanishToggleText">Spanish Off</span>
                </button>
            </div>
        </div>

        <!-- MAIN NAV TABS -->
        <nav class="bg-black/10 backdrop-blur-md border-t border-white/10 px-4">
            <div class="max-w-7xl mx-auto flex space-x-1 sm:space-x-2 overflow-x-auto py-2 no-scrollbar">
                <button onclick="switchTab('survey')" id="tab-survey" class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center space-x-2 bg-white text-sky-700 shadow-md">
                    <i class="fa-solid fa-clipboard-list"></i>
                    <span>1. Survey & Story</span>
                </button>
                <button onclick="switchTab('timeline')" id="tab-timeline" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center space-x-2 text-white/80 hover:bg-white/10">
                    <i class="fa-solid fa-clock"></i>
                    <span>2. Schedule Timeline</span>
                </button>
                <button onclick="switchTab('vocab')" id="tab-vocab" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center space-x-2 text-white/80 hover:bg-white/10">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>3. Vocabulary Cards</span>
                </button>
                <button onclick="switchTab('games')" id="tab-games" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center space-x-2 text-white/80 hover:bg-white/10">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>4. Practice Games</span>
                </button>
                <button onclick="switchTab('pairwork')" id="tab-pairwork" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all flex items-center space-x-2 text-white/80 hover:bg-white/10">
                    <i class="fa-solid fa-comments"></i>
                    <span>5. Pair Work</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ================================================================= -->
        <!-- TAB 1: SURVEY & STORY BUILDER -->
        <!-- ================================================================= -->
        <section id="view-survey" class="space-y-6">
            <div class="bg-gradient-to-r from-sky-500 to-indigo-600 rounded-3xl p-6 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="space-y-2 text-center md:text-left">
                    <span class="inline-block bg-white/20 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/20">Speaking Exercise 5A</span>
                    <h2 class="text-2xl sm:text-3xl font-display font-bold">Survey: My Perfect Day</h2>
                    <p class="text-sky-100 text-sm max-w-2xl">
                        Imagine your ideal day! Answer the questions below, add one custom question of your own, and build your personal daily story.
                    </p>
                </div>
                <div class="flex-shrink-0 bg-white/10 p-4 rounded-2xl border border-white/20 text-center">
                    <p class="text-xs text-sky-200 uppercase font-semibold">Survey Status</p>
                    <div class="text-2xl font-black text-amber-300 mt-1" id="completionPercent">0%</div>
                    <p class="text-xs text-sky-100" id="completedCount">0 of 6 answered</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Survey Form Column (7 cols) -->
                <div class="lg:col-span-7 space-y-4">
                    <form id="surveyForm" onsubmit="event.preventDefault();" class="space-y-4">
                        
                        <!-- Question 1 -->
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-sky-300 transition space-y-3">
                            <div class="flex items-center justify-between">
                                <label for="q1" class="font-display font-bold text-slate-800 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center text-sm font-extrabold">1</span>
                                    <span>What time do you get up?</span>
                                </label>
                                <button type="button" onclick="speakText('What time do you get up?')" class="text-sky-600 hover:text-sky-800 p-1.5 rounded-lg hover:bg-sky-50">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                            <p class="es-trans text-xs text-slate-500 hidden font-medium">¿A qué hora te levantas?</p>
                            <div class="flex gap-2">
                                <input type="time" id="q1_time" value="09:00" onchange="updateSurveyStory()" class="px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none font-semibold text-slate-700">
                                <input type="text" id="q1" placeholder="e.g. at 9:00 AM, very late, early" oninput="updateSurveyStory()" class="flex-1 px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none text-slate-700">
                            </div>
                            <div class="flex flex-wrap gap-1.5 text-xs">
                                <span class="text-slate-400 font-medium">Quick options:</span>
                                <button type="button" onclick="setQuickInput('q1', 'at 8:00 AM'); setQuickInput('q1_time', '08:00'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">at 8:00 AM</button>
                                <button type="button" onclick="setQuickInput('q1', 'at 10:30 AM'); setQuickInput('q1_time', '10:30'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">at 10:30 AM</button>
                                <button type="button" onclick="setQuickInput('q1', 'whenever I wake up'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">whenever I wake up</button>
                            </div>
                        </div>

                        <!-- Question 2 -->
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-sky-300 transition space-y-3">
                            <div class="flex items-center justify-between">
                                <label for="q2" class="font-display font-bold text-slate-800 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center text-sm font-extrabold">2</span>
                                    <span>What do you do after you get up?</span>
                                </label>
                                <button type="button" onclick="speakText('What do you do after you get up?')" class="text-sky-600 hover:text-sky-800 p-1.5 rounded-lg hover:bg-sky-50">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                            <p class="es-trans text-xs text-slate-500 hidden font-medium">¿Qué haces después de levantarte?</p>
                            <input type="text" id="q2" placeholder="e.g. eat a big breakfast, drink coffee, do yoga" oninput="updateSurveyStory()" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none text-slate-700">
                            <div class="flex flex-wrap gap-1.5 text-xs">
                                <span class="text-slate-400 font-medium">Ideas:</span>
                                <button type="button" onclick="setQuickInput('q2', 'eat a delicious breakfast and drink coffee'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">eat a big breakfast</button>
                                <button type="button" onclick="setQuickInput('q2', 'listen to my favorite music'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">listen to music</button>
                                <button type="button" onclick="setQuickInput('q2', 'go for a morning walk'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">go for a walk</button>
                            </div>
                        </div>

                        <!-- Question 3 -->
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-sky-300 transition space-y-3">
                            <div class="flex items-center justify-between">
                                <label for="q3" class="font-display font-bold text-slate-800 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center text-sm font-extrabold">3</span>
                                    <span>Where do you go?</span>
                                </label>
                                <button type="button" onclick="speakText('Where do you go?')" class="text-sky-600 hover:text-sky-800 p-1.5 rounded-lg hover:bg-sky-50">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                            <p class="es-trans text-xs text-slate-500 hidden font-medium">¿A dónde vas?</p>
                            <input type="text" id="q3" placeholder="e.g. to the beach, to the park, stay at home" oninput="updateSurveyStory()" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none text-slate-700">
                            <div class="flex flex-wrap gap-1.5 text-xs">
                                <span class="text-slate-400 font-medium">Ideas:</span>
                                <button type="button" onclick="setQuickInput('q3', 'to the beach with friends'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">🏖️ to the beach</button>
                                <button type="button" onclick="setQuickInput('q3', 'to a nice cafe'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">☕ to a cafe</button>
                                <button type="button" onclick="setQuickInput('q3', 'to the mountains'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">🏔️ to the mountains</button>
                            </div>
                        </div>

                        <!-- Question 4 -->
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-sky-300 transition space-y-3">
                            <div class="flex items-center justify-between">
                                <label for="q4" class="font-display font-bold text-slate-800 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center text-sm font-extrabold">4</span>
                                    <span>What do you do in the evening?</span>
                                </label>
                                <button type="button" onclick="speakText('What do you do in the evening?')" class="text-sky-600 hover:text-sky-800 p-1.5 rounded-lg hover:bg-sky-50">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                            <p class="es-trans text-xs text-slate-500 hidden font-medium">¿Qué haces por la noche?</p>
                            <input type="text" id="q4" placeholder="e.g. watch a movie, cook dinner, play video games" oninput="updateSurveyStory()" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none text-slate-700">
                            <div class="flex flex-wrap gap-1.5 text-xs">
                                <span class="text-slate-400 font-medium">Ideas:</span>
                                <button type="button" onclick="setQuickInput('q4', 'watch a great movie and relax'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">🎬 watch a movie</button>
                                <button type="button" onclick="setQuickInput('q4', 'eat dinner with my family'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">🍝 eat dinner</button>
                                <button type="button" onclick="setQuickInput('q4', 'read a good book'); updateSurveyStory()" class="px-2.5 py-1 bg-slate-100 hover:bg-sky-100 hover:text-sky-700 rounded-lg transition">📖 read a book</button>
                            </div>
                        </div>

                        <!-- Question 5 -->
                        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 hover:border-sky-300 transition space-y-3">
                            <div class="flex items-center justify-between">
                                <label for="q5" class="font-display font-bold text-slate-800 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-sky-100 text-sky-700 rounded-lg flex items-center justify-center text-sm font-extrabold">5</span>
                                    <span>When do you go to bed?</span>
                                </label>
                                <button type="button" onclick="speakText('When do you go to bed?')" class="text-sky-600 hover:text-sky-800 p-1.5 rounded-lg hover:bg-sky-50">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                            <p class="es-trans text-xs text-slate-500 hidden font-medium">¿A qué hora te vas a la cama?</p>
                            <div class="flex gap-2">
                                <input type="time" id="q5_time" value="23:00" onchange="updateSurveyStory()" class="px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none font-semibold text-slate-700">
                                <input type="text" id="q5" placeholder="e.g. at 11:00 PM, at midnight" oninput="updateSurveyStory()" class="flex-1 px-4 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:outline-none text-slate-700">
                            </div>
                        </div>

                        <!-- Question 6 (Custom Question Prompt requirement) -->
                        <div class="bg-gradient-to-br from-amber-50 to-orange-50 p-5 rounded-2xl shadow-sm border border-amber-200 space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="font-display font-bold text-amber-900 text-base flex items-center gap-2">
                                    <span class="w-7 h-7 bg-amber-500 text-white rounded-lg flex items-center justify-center text-sm font-extrabold">6</span>
                                    <span>Add One More Question (Your Own!)</span>
                                </label>
                                <span class="text-xs bg-amber-200 text-amber-800 font-bold px-2 py-0.5 rounded-full">Custom</span>
                            </div>
                            
                            <div class="space-y-2">
                                <p class="text-xs text-amber-800 font-medium">Select a prompt or write your own question:</p>
                                <select id="customQ_preset" onchange="handlePresetQuestionChange(this)" class="w-full px-3 py-2 bg-white border border-amber-300 rounded-xl text-sm font-medium text-slate-700 focus:ring-2 focus:ring-amber-500">
                                    <option value="custom">✍️ Write my own custom question</option>
                                    <option value="Who do you spend time with?">Who do you spend time with?</option>
                                    <option value="What do you eat for lunch?">What do you eat for lunch?</option>
                                    <option value="What music do you listen to?">What music do you listen to?</option>
                                    <option value="What do you wear?">What do you wear?</option>
                                </select>
                                
                                <input type="text" id="customQuestion" placeholder="Write your question here (e.g. Who do you spend time with?)" oninput="updateSurveyStory()" class="w-full px-4 py-2 border border-amber-300 rounded-xl focus:ring-2 focus:ring-amber-500 text-slate-800 font-medium bg-white">
                                <input type="text" id="customAnswer" placeholder="Write your answer here (e.g. I spend time with my best friends)" oninput="updateSurveyStory()" class="w-full px-4 py-2 border border-amber-300 rounded-xl focus:ring-2 focus:ring-amber-500 text-slate-800 bg-white">
                            </div>
                        </div>

                    </form>
                </div>

                <!-- Generated Story & Actions Column (5 cols) -->
                <div class="lg:col-span-5 space-y-4">
                    <div class="bg-white p-6 rounded-3xl shadow-lg border border-slate-200 sticky top-24 space-y-4">
                        <div class="flex items-center justify-between border-b pb-3">
                            <h3 class="font-display font-bold text-slate-800 text-lg flex items-center gap-2">
                                <i class="fa-solid fa-book-open text-sky-600"></i>
                                <span>My Perfect Day Story</span>
                            </h3>
                            <span class="text-xs bg-sky-100 text-sky-700 px-2.5 py-1 rounded-full font-bold">Live Preview</span>
                        </div>

                        <!-- Generated Text Output Box -->
                        <div id="storyContainer" class="p-4 bg-slate-50 border border-slate-200 rounded-2xl min-h-[220px] text-slate-700 leading-relaxed text-sm space-y-2">
                            <p id="storyText" class="font-medium text-slate-600">
                                <em>Fill out the survey questions on the left to automatically construct your personal reading & speaking paragraph!</em>
                            </p>
                        </div>

                        <!-- Text-To-Speech Controls -->
                        <div class="space-y-3 bg-slate-100 p-4 rounded-2xl">
                            <div class="flex items-center justify-between text-xs text-slate-600 font-semibold">
                                <span><i class="fa-solid fa-sliders mr-1"></i> Audio Controls</span>
                                <span id="rateLabel">Speed: 1.0x</span>
                            </div>

                            <div class="flex items-center gap-2">
                                <input type="range" id="speechRate" min="0.5" max="1.2" step="0.1" value="0.9" oninput="document.getElementById('rateLabel').innerText = 'Speed: ' + this.value + 'x'" class="w-full accent-sky-600">
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <button onclick="readGeneratedStory()" class="w-full bg-sky-600 hover:bg-sky-700 text-white font-bold py-2.5 px-3 rounded-xl shadow transition flex items-center justify-center gap-2 text-sm">
                                    <i class="fa-solid fa-circle-play text-base"></i>
                                    <span>Listen Story</span>
                                </button>
                                <button onclick="stopSpeech()" class="w-full bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold py-2.5 px-3 rounded-xl transition flex items-center justify-center gap-2 text-sm">
                                    <i class="fa-solid fa-circle-stop text-base"></i>
                                    <span>Stop</span>
                                </button>
                            </div>
                        </div>

                        <!-- Secondary Actions -->
                        <div class="flex gap-2">
                            <button onclick="copyStoryText()" class="flex-1 py-2 px-3 border border-slate-300 hover:bg-slate-50 rounded-xl text-xs font-bold text-slate-700 transition flex items-center justify-center gap-1.5">
                                <i class="fa-regular fa-copy"></i>
                                <span>Copy Text</span>
                            </button>
                            <button onclick="transferToTimeline()" class="flex-1 py-2 px-3 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-xl text-xs font-bold text-indigo-700 transition flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-arrow-right"></i>
                                <span>Send to Timeline</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================================================================= -->
        <!-- TAB 2: VISUAL SCHEDULE TIMELINE -->
        <!-- ================================================================= -->
        <section id="view-timeline" class="hidden space-y-6">
            <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-3xl p-6 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
                <div>
                    <span class="inline-block bg-white/20 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-white/20">Visual Planning</span>
                    <h2 class="text-2xl sm:text-3xl font-display font-bold mt-1">Interactive Daily Schedule</h2>
                    <p class="text-indigo-100 text-sm">Map out your perfect day visually from morning to night!</p>
                </div>

                <div class="flex gap-2">
                    <button onclick="resetTimeline()" class="bg-white/10 hover:bg-white/20 border border-white/20 px-3 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-right"></i> Reset
                    </button>
                    <button onclick="openAddEventModal()" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-4 py-2 rounded-xl text-xs transition shadow flex items-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> Add Event
                    </button>
                </div>
            </div>

            <!-- Timeline Blocks Grid -->
