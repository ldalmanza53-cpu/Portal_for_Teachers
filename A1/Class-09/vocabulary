            { id: 2, phrase: "go to bed", ipa: "/ɡoʊ tuː bɛd/", cat: "verb", es: "irse a la cama", def: "To lie down in bed to sleep at night.", ex: "When do you go to bed on weekends?", icon: "fa-moon" },
            { id: 3, phrase: "in the morning", ipa: "/ɪn ðə ˈmɔːrnɪŋ/", cat: "time", es: "por la mañana", def: "The early part of the day ending at noon.", ex: "In the morning, I drink delicious coffee.", icon: "fa-sun" },
            { id: 4, phrase: "in the evening", ipa: "/ɪn ðə ˈiːvnɪŋ/", cat: "time", es: "por la noche (temprano)", def: "The period of time at the end of the day.", ex: "What do you do in the evening?", icon: "fa-city" },
            { id: 5, phrase: "go to the beach", ipa: "/ɡoʊ tuː ðə biːtʃ/", cat: "place", es: "ir a la playa", def: "To travel to the ocean seaside.", ex: "On my perfect day, I go to the beach.", icon: "fa-umbrella-beach" },
            { id: 6, phrase: "eat breakfast", ipa: "/iːt ˈbrɛkfəst/", cat: "verb", es: "desayunar", def: "To eat the first meal of the day.", ex: "After I get up, I eat breakfast.", icon: "fa-utensils" },
            { id: 7, phrase: "relax at home", ipa: "/rɪˈlæks æt hoʊm/", cat: "verb", es: "relajarse en casa", def: "To rest and spend calm time indoors.", ex: "I like to relax at home in the evening.", icon: "fa-couch" },
