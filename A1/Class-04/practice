            <!-- Hero banner -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-sky-900/60 via-slate-800 to-indigo-950/60 border border-sky-500/20 p-6 lg:p-8">
                <div class="relative z-10 max-w-3xl">
