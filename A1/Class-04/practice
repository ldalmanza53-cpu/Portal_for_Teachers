                        ${answer}
                    </div>
                </div>
            `;

            if (consoleEl) {
                consoleEl.innerHTML += userBubble + aiBubble;
                consoleEl.scrollTop = consoleEl.scrollHeight;
            }

            // Speak response
            speakText(`${p.firstName} says: ${answer}`);
        }

