                        </div>
                    </div>

                    <!-- User Question 3 -->
                    <div class="space-y-1">
                        <label for="userQ3" class="text-xs font-semibold text-slate-300 flex items-center justify-between">
                            <span>Question 3:</span>
                            <span class="text-[10px] text-slate-400">e.g. "What do you do?" or "Who is your teacher?"</span>
