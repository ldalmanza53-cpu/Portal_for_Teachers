                const p = attendees[key];
                return `
                    <div class="bg-slate-800/90 border border-slate-700/80 rounded-2xl p-5 relative overflow-hidden shadow-lg group hover:border-sky-500/50 transition">
                        <!-- Top Tag Bar -->
                        <div class="flex items-center justify-between border-b border-slate-700/60 pb-3 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Conference Badge</span>
                            <span class="bg-sky-500/20 text-sky-300 text-[10px] font-semibold px-2 py-0.5 rounded-full">Unit 1 Participant</span>
                        </div>

                        <!-- Attendee Info -->
                        <div class="flex items-start space-x-3">
                            <div class="w-12 h-12 rounded-xl ${p.avatarColor} text-white font-extrabold text-lg flex items-center justify-center shadow-md">
                                ${p.firstName[0]}${p.lastName[0]}
                            </div>
                            <div>
                                <h4 class="text-base font-bold text-white leading-tight">
                                    ${p.firstName} ${p.lastName}
                                </h4>
                                <p class="text-xs text-sky-400 font-semibold mt-0.5">${p.job}</p>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-700/40 space-y-1.5 text-xs text-slate-300">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400"><i class="fa-solid fa-location-dot text-rose-400 mr-1.5"></i>From:</span>
                                <span class="font-medium text-white">${p.city}, ${p.country}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400"><i class="fa-solid fa-tag text-amber-400 mr-1.5"></i>Badge Spot:</span>
                                <span class="font-medium text-slate-200">${p.badgeLocation}</span>
                            </div>
                        </div>

                        <button onclick="speakText('${p.firstName} ${p.lastName} is a ${p.job} from ${p.city}, ${p.country}.')" class="w-full mt-4 bg-slate-700/60 hover:bg-slate-700 text-slate-200 text-xs font-semibold py-2 rounded-xl transition flex items-center justify-center space-x-1.5">
                            <i class="fa-solid fa-volume-high text-sky-400"></i>
                            <span>Listen Profile</span>
                        </button>
                    </div>
                `;
            }).join('');
        }

        // Role-Play Conversation Script Data
        const roleplayDialogues = {
            mike: [
                { receptionist: "Excuse me, is your last name Chu?", participant: "No, it isn't. It's O'Neill!" },
                { receptionist: "Oh, sorry! Where are you from, Mike?", participant: "I'm from Chicago, USA." },
                { receptionist: "And what do you do?", participant: "I am a Graphic Designer!" }
            ],
            rachel: [
                { receptionist: "Hello! Are you Rachel Green?", participant: "Yes, I am!" },
                { receptionist: "Welcome! Are you an interior designer?", participant: "Yes, that's right! I'm from Toronto." },
                { receptionist: "Great, here is your conference badge!", participant: "Thank you very much!" }
            ],
            evan: [
                { receptionist: "Hi! What is your first name?", participant: "My first name is Evan." },
                { receptionist: "Are Evan and Bill friends?", participant: "Yes, we are! Bill is over there." },
                { receptionist: "Where is your name tag?", participant: "It's right here on my jacket clip." }
            ]
        };

        function initRoleplay() {
            const charKey = document.getElementById('roleplayCharacter')?.value || 'mike';
            state.roleplayIndex = 0;
            renderRoleplayStep(charKey);
        }

        function renderRoleplayStep(charKey) {
            const scripts = roleplayDialogues[charKey];
            const chatEl = document.getElementById('roleplayChat');
            const optionsEl = document.getElementById('roleplayOptions');

            if (!scripts || !chatEl || !optionsEl) return;

            const current = scripts[state.roleplayIndex];

            // Render existing history up to index
            let html = "";
            for (let i = 0; i <= state.roleplayIndex; i++) {
                const item = scripts[i];
                html += `
                    <div class="flex items-start space-x-2">
                        <div class="w-6 h-6 rounded-full bg-slate-700 text-sky-400 font-bold flex items-center justify-center text-[10px]">A</div>
                        <div class="bg-slate-800 border border-slate-700 text-slate-200 rounded-2xl rounded-tl-none px-3 py-2 text-xs max-w-[85%]">
                            <span class="font-bold text-[10px] text-sky-400">Receptionist:</span> ${item.receptionist}
                        </div>
                    </div>
                    <div class="flex items-end justify-end space-x-2">
                        <div class="bg-purple-600 text-white rounded-2xl rounded-tr-none px-3 py-2 text-xs max-w-[85%]">
                            <span class="font-bold text-[10px] text-purple-200">${attendees[charKey].firstName}:</span> ${item.participant}
                        </div>
                    </div>
                `;
            }

            chatEl.innerHTML = html;
            chatEl.scrollTop = chatEl.scrollHeight;

            // Render buttons for user to advance dialogue
            if (state.roleplayIndex < scripts.length - 1) {
                optionsEl.innerHTML = `
                    <button onclick="advanceRoleplay('${charKey}')" class="w-full bg-purple-600 hover:bg-purple-500 text-white font-semibold py-2.5 px-4 rounded-xl text-xs transition flex items-center justify-center space-x-2">
                        <span>Continue Conversation Line ${state.roleplayIndex + 2}</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                `;
            } else {
                optionsEl.innerHTML = `
                    <button onclick="initRoleplay()" class="w-full bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold py-2.5 px-4 rounded-xl text-xs transition flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Replay Conversation</span>
                    </button>
                `;
            }

            // Speak active line automatically
            if (current) {
                speakText(`Receptionist asks: ${current.receptionist}. ${attendees[charKey].firstName} answers: ${current.participant}`);
            }
        }

        function advanceRoleplay(charKey) {
            state.roleplayIndex++;
            renderRoleplayStep(charKey);
        }

        // Badge Score Updater
        function updateBadge(secKey, current, total) {
            const badge = document.getElementById(`badge-${secKey}`);
            if (badge) {
                badge.textContent = `${current}/${total}`;
                if (current === total) {
                    badge.className = "ml-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold px-2 py-0.5 rounded-full";
                } else if (current > 0) {
                    badge.className = "ml-1 bg-amber-500/20 text-amber-400 text-[10px] font-bold px-1.5 py-0.5 rounded-full";
                } else {
                    badge.className = "ml-1 bg-slate-700 text-slate-300 text-[10px] font-bold px-1.5 py-0.5 rounded-full";
                }
            }
        }

        function updateTotalScore() {
            let total = 0;
            // Count sec 9
            sec9Questions.forEach(q => {
                if (state.sec9Answers[q.id] === q.correct) total++;
            });
            // Count sec 10
            sec10Questions.forEach(q => {
                if (state.sec10Answers[q.id] === q.correct) total++;
            });

            const scoreEl = document.getElementById('totalScoreText');
            if (scoreEl) {
                scoreEl.textContent = `${total} / 10 Points`;
            }
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        }

        // Initialization
        window.onload = function() {
            renderSection9();
            renderSection10();
            renderClassmateSelector();
            renderBadges();
            initRoleplay();
        };
    </script>
</body>
</html>
