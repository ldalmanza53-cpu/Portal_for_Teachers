        function askClassmateQuestion(qNum) {
            const inputVal = document.getElementById(`userQ${qNum}`)?.value.trim();
            if (!inputVal) return;

            const p = attendees[state.selectedClassmate || 'mike'];
            const consoleEl = document.getElementById('interviewConsole');

            // Generate intelligent response based on question keywords
            let answer = "";
            const lowerQ = inputVal.toLowerCase();

            if (lowerQ.includes('last name') || lowerQ.includes('surname')) {
                answer = `My last name is ${p.lastName}.`;
            } else if (lowerQ.includes('from') || lowerQ.includes('where')) {
                answer = `I am from ${p.city}, ${p.country}.`;
            } else if (lowerQ.includes('do') || lowerQ.includes('job') || lowerQ.includes('work')) {
                answer = `I am an ${p.job}.`;
            } else if (lowerQ.includes('first name')) {
                answer = `My first name is ${p.firstName}.`;
            } else if (lowerQ.includes('tag') || lowerQ.includes('badge')) {
                answer = `My name tag is ${p.badgeLocation}.`;
            } else {
                answer = `Nice to meet you! I'm ${p.firstName} ${p.lastName} from ${p.city}.`;
            }

            // Append dialogue line
            const userBubble = `
                <div class="flex items-end justify-end space-x-2">
                    <div class="bg-emerald-600 text-white rounded-2xl rounded-tr-none px-3 py-2 text-xs max-w-[85%]">
