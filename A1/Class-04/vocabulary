<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>What's Your Opinion? - ESL Emotion Vocabulary App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Lexend', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        accent: {
                            50: '#eef2ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .animated-pulse-subtle {
            animation: pulse-subtle 2s infinite ease-in-out;
        }
        @keyframes pulse-subtle {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Application Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex flex-col md:flex-row items-center justify-between gap-3">
                
                <!-- Title & Badge -->
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 text-white flex items-center justify-center text-2xl shadow-md shadow-indigo-200 font-bold">
                        6
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-xl font-bold text-slate-900 tracking-tight">What's Your Opinion?</h1>
                            <span class="bg-indigo-100 text-indigo-700 text-xs px-2.5 py-0.5 rounded-full font-semibold">ESL VRB-67</span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">Beginner Emotion Vocabulary & Speaking Activity</p>
                    </div>
                </div>

                <!-- Controls & Stats Bar -->
                <div class="flex items-center flex-wrap gap-3 sm:gap-4 justify-center md:justify-end w-full md:w-auto">
                    
                    <!-- Stars / Score Counter -->
                    <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-800 px-3 py-1.5 rounded-xl shadow-xs">
                        <i class="fa-solid fa-star text-amber-500 text-lg"></i>
                        <span id="star-count" class="font-bold text-base">0</span>
                        <span class="text-xs text-amber-700 font-medium hidden sm:inline">Stars</span>
                    </div>

                    <!-- Progress Bar -->
                    <div class="flex flex-col min-w-[120px] sm:min-w-[150px]">
                        <div class="flex justify-between items-center text-xs text-slate-500 font-medium mb-1">
                            <span>Progress</span>
                            <span id="progress-text">0%</span>
                        </div>
                        <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden">
                            <div id="progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full w-0 transition-all duration-500"></div>
                        </div>
                    </div>

                    <!-- Speech Speed Toggle -->
                    <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 text-xs">
                        <span class="text-slate-500 px-2 font-medium hidden sm:inline"><i class="fa-solid fa-gauge-high"></i> Speed:</span>
                        <button id="speed-slow-btn" onclick="setSpeed(0.75)" class="px-2.5 py-1 rounded-lg font-medium transition-all text-slate-600 hover:text-slate-900">
                            🐢 Slow
                        </button>
                        <button id="speed-normal-btn" onclick="setSpeed(1.0)" class="px-2.5 py-1 rounded-lg font-medium bg-white text-indigo-600 shadow-xs transition-all">
                            🐇 Normal
                        </button>
                    </div>

                </div>
            </div>

            <!-- Tab Navigation Buttons -->
            <nav class="flex items-center justify-start sm:justify-center gap-1 sm:gap-2 mt-3 pt-2 border-t border-slate-100 overflow-x-auto custom-scrollbar">
                <button onclick="switchTab('scenarios')" id="tab-scenarios" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap bg-indigo-600 text-white shadow-xs transition-all">
                    <i class="fa-solid fa-film"></i>
                    <span>Scenarios</span>
                </button>
                <button onclick="switchTab('flashcards')" id="tab-flashcards" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>Flashcards</span>
                </button>
                <button onclick="switchTab('games')" id="tab-games" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>Practice Games</span>
                </button>
                <button onclick="switchTab('partner')" id="tab-partner" class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-users"></i>
                    <span>Partner Discussion</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">

        <!-- TAB 1: Core Scenarios -->
        <section id="content-scenarios" class="tab-content block space-y-6">
            
            <div class="bg-gradient-to-r from-indigo-900 to-slate-900 text-white p-6 rounded-3xl shadow-lg relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-indigo-500/30 border border-indigo-400/30 text-indigo-200 text-xs px-3 py-1 rounded-full uppercase tracking-wider font-semibold mb-2 inline-block">Interactive Activity</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">What's Your Opinion?</h2>
                    <p class="text-slate-300 text-sm sm:text-base">Look at each scene from the event. What do you think the characters are feeling? Choose your opinion, then build your reason sentence!</p>
                </div>
                <div class="absolute right-4 bottom-0 opacity-10 text-9xl pointer-events-none">
                    <i class="fa-solid fa-comments"></i>
                </div>
            </div>

            <!-- Scenarios Grid -->
            <div id="scenarios-container" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Dynamically rendered via JS -->
            </div>

            <!-- Global Sentence Builder & Speaking Pad -->
            <div class="bg-white border-2 border-indigo-100 rounded-3xl p-6 shadow-md relative">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-lg">
                            <i class="fa-solid fa-microphone-lines"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900 text-lg">"Why Do You Think So?" Speaking Assistant</h3>
                            <p class="text-xs text-slate-500">Practice saying your complete opinion sentence clearly.</p>
                        </div>
                    </div>
                    <button onclick="speakCurrentSentence()" class="bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white font-semibold px-4 py-2 rounded-xl text-sm flex items-center gap-2 transition-all shadow-sm">
                        <i class="fa-solid fa-volume-high"></i>
                        <span>Listen to Sentence</span>
                    </button>
                </div>

                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-4">
                    <p id="constructed-sentence-display" class="text-base sm:text-lg font-medium text-slate-700 italic">
                        "Select a scenario above to start building your sentence..."
                    </p>
                    <button onclick="saveActiveOpinion()" id="save-opinion-btn" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm flex items-center justify-center gap-2 shadow-xs transition-all opacity-50 cursor-not-allowed" disabled>
                        <i class="fa-solid fa-check-circle"></i>
                        <span>Save My Opinion (+10 Stars)</span>
                    </button>
                </div>
            </div>

        </section>

        <!-- TAB 2: Flashcards -->
        <section id="content-flashcards" class="tab-content hidden space-y-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-900">Emotion Vocabulary Flashcards</h2>
                        <p class="text-slate-500 text-sm">Listen to native pronunciation, study definitions, and practice your speaking!</p>
                    </div>
                    <div class="flex items-center gap-2 text-xs bg-slate-100 px-3 py-1.5 rounded-xl text-slate-600">
                        <i class="fa-solid fa-circle-info text-indigo-500"></i>
                        <span>Click audio buttons to hear pronunciation</span>
                    </div>
                </div>

                <!-- Flashcard Grid -->
                <div id="flashcards-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Cards rendered by JS -->
                </div>
            </div>
        </section>

        <!-- TAB 3: Games -->
        <section id="content-games" class="tab-content hidden space-y-6">
            
            <!-- Games Header Subnav -->
            <div class="bg-white border border-slate-200 rounded-2xl p-2 flex items-center justify-center gap-2 max-w-xl mx-auto shadow-xs">
                <button onclick="switchSubGame('matcher')" id="subgame-matcher-btn" class="subgame-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 text-white transition-all text-center">
                    <i class="fa-solid fa-puzzle-piece mr-1"></i> Matcher
                </button>
                <button onclick="switchSubGame('blanks')" id="subgame-blanks-btn" class="subgame-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:bg-slate-100 transition-all text-center">
                    <i class="fa-solid fa-pen-to-square mr-1"></i> Fill Blanks
                </button>
                <button onclick="switchSubGame('quiz')" id="subgame-quiz-btn" class="subgame-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:bg-slate-100 transition-all text-center">
                    <i class="fa-solid fa-bolt mr-1"></i> Speed Quiz
                </button>
            </div>

            <!-- SUB-GAME 1: Scenario Matcher -->
            <div id="subgame-matcher" class="subgame-panel block bg-white border border-slate-200 rounded-3xl p-6 shadow-xs">
                <div class="mb-6 text-center max-w-lg mx-auto">
                    <h3 class="text-xl font-bold text-slate-900 mb-1">Emotion & Situation Matcher</h3>
                    <p class="text-xs text-slate-500">Select an emotion word on the left, then tap its matching scenario on the right!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
                    <!-- Left: Emotions -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">1. Select Emotion</h4>
                        <div id="matcher-emotions-list" class="space-y-2"></div>
                    </div>

                    <!-- Right: Situations -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">2. Select Matching Situation</h4>
                        <div id="matcher-scenarios-list" class="space-y-2"></div>
                    </div>
                </div>

                <div class="mt-6 flex justify-center">
                    <button onclick="resetMatcherGame()" class="text-xs font-semibold text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-xl transition-all">
                        <i class="fa-solid fa-rotate-right mr-1"></i> Reset Game
                    </button>
                </div>
            </div>

            <!-- SUB-GAME 2: Fill in the Blanks -->
            <div id="subgame-blanks" class="subgame-panel hidden bg-white border border-slate-200 rounded-3xl p-6 shadow-xs">
                <div class="mb-6 text-center max-w-lg mx-auto">
                    <h3 class="text-xl font-bold text-slate-900 mb-1">Fill in the Blanks</h3>
                    <p class="text-xs text-slate-500">Complete each sentence with the correct emotion word from the word bank.</p>
                </div>

                <!-- Word Bank -->
                <div id="word-bank-container" class="flex flex-wrap justify-center gap-2 mb-8 bg-indigo-50 border border-indigo-100 p-4 rounded-2xl">
                    <!-- Words rendered by JS -->
                </div>

                <!-- Sentences List -->
                <div id="blanks-sentences-container" class="space-y-4 max-w-3xl mx-auto">
                    <!-- Questions rendered by JS -->
                </div>

                <div class="mt-6 text-center">
                    <button onclick="checkFillBlanksAnswers()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-2xl shadow-md transition-all active:scale-95">
                        <i class="fa-solid fa-check mr-2"></i> Check Answers
                    </button>
                </div>
            </div>

            <!-- SUB-GAME 3: Speed Quiz -->
            <div id="subgame-quiz" class="subgame-panel hidden bg-white border border-slate-200 rounded-3xl p-6 shadow-xs">
                <div id="quiz-start-screen" class="text-center py-8 max-w-md mx-auto space-y-4">
                    <div class="w-20 h-20 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center text-3xl mx-auto shadow-inner">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <h3 class="text-2xl font-extrabold text-slate-900">Emotion Speed Challenge</h3>
                    <p class="text-slate-500 text-sm">Test your vocabulary speed! Answer 5 quick questions about emotions and earn bonus stars.</p>
                    <button onclick="startSpeedQuiz()" class="bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold px-8 py-3 rounded-2xl shadow-lg transition-all transform active:scale-95 text-lg">
                        Start Quiz 🚀
                    </button>
                </div>

                <!-- Active Quiz View -->
                <div id="quiz-active-screen" class="hidden max-w-xl mx-auto space-y-6 py-4">
                    <div class="flex justify-between items-center text-sm border-b border-slate-100 pb-3">
                        <span id="quiz-progress-indicator" class="font-bold text-slate-500">Question 1 of 5</span>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-slate-400">Streak:</span>
                            <span id="quiz-streak-count" class="font-bold text-amber-500 text-base">🔥 0</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 text-center">
                        <p id="quiz-question-text" class="text-lg font-bold text-slate-800">
                            Loading question...
                        </p>
                        <button onclick="speakQuizQuestion()" class="mt-2 text-xs text-indigo-600 hover:text-indigo-800 font-semibold inline-flex items-center gap-1">
                            <i class="fa-solid fa-volume-high"></i> Read Question
                        </button>
                    </div>

                    <div id="quiz-options-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Options generated by JS -->
                    </div>
                </div>

                <!-- Quiz Results Screen -->
                <div id="quiz-result-screen" class="hidden text-center py-8 max-w-md mx-auto space-y-4">
                    <div class="text-5xl">🎉</div>
                    <h3 class="text-2xl font-bold text-slate-900">Quiz Completed!</h3>
                    <p id="quiz-score-summary" class="text-slate-600 text-base font-medium">You scored 5 out of 5!</p>
                    <button onclick="startSpeedQuiz()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-2.5 rounded-xl shadow-md transition-all">
                        Try Again 🔄
                    </button>
                </div>
            </div>

        </section>

        <!-- TAB 4: Partner Comparison Mode -->
        <section id="content-partner" class="tab-content hidden space-y-6">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xs">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wide">Classroom Pair Work</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Compare Opinions with a Partner 👥</h2>
                    <p class="text-slate-500 text-sm mt-1">Student 1 and Student 2 can input their choices below to compare answers and practice speaking together!</p>
                </div>

                <!-- Dual Input Panels -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- Student 1 Box -->
                    <div class="bg-slate-50 border-2 border-indigo-200 rounded-2xl p-5 space-y-4">
                        <div class="flex items-center gap-2 border-b border-indigo-100 pb-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">1</div>
                            <h3 class="font-bold text-slate-800 text-lg">Student A's Opinions</h3>
                        </div>

                        <div id="partner-s1-options" class="space-y-4">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                    <!-- Student 2 Box -->
                    <div class="bg-slate-50 border-2 border-teal-200 rounded-2xl p-5 space-y-4">
                        <div class="flex items-center gap-2 border-b border-teal-100 pb-3">
                            <div class="w-8 h-8 rounded-full bg-teal-600 text-white flex items-center justify-center font-bold text-sm">2</div>
                            <h3 class="font-bold text-slate-800 text-lg">Student B's Opinions</h3>
                        </div>

                        <div id="partner-s2-options" class="space-y-4">
                            <!-- Populated dynamically -->
                        </div>
                    </div>

                </div>

                <!-- Comparison Action Button -->
                <div class="mt-8 text-center">
                    <button onclick="comparePartnerOpinions()" class="bg-gradient-to-r from-indigo-600 to-teal-600 hover:from-indigo-700 hover:to-teal-700 text-white font-bold px-8 py-3.5 rounded-2xl shadow-lg transition-all active:scale-95 text-base">
                        <i class="fa-solid fa-code-compare mr-2"></i> Compare Opinions & Get Speaking Prompts
                    </button>
                </div>

                <!-- Output Comparison Results -->
                <div id="partner-results-container" class="mt-8 hidden bg-slate-900 text-white p-6 rounded-3xl space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <h3 class="text-xl font-bold flex items-center gap-2">
                            <i class="fa-solid fa-comments text-amber-400"></i> Partner Speaking Cards
                        </h3>
                        <span class="text-xs text-slate-400">Read these prompts out loud together!</span>
                    </div>

                    <div id="partner-prompts-list" class="grid grid-cols-1 gap-4">
                        <!-- Rendered by JS -->
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-400">
            <p>What's Your Opinion? • ESL Interactive Learning Module • Designed for English Beginners</p>
        </div>
    </footer>

    <script>
        
        // App State
        const state = {
            stars: 0,
            speechSpeed: 1.0,
            activeTab: 'scenarios',
            activeScenarioId: 1,
            completedScenarios: {},
            scenarioSelections: {
                1: { option: null, reason: null },
                2: { option: null, reason: null },
                3: { option: null, reason: null }
            },
            partner1Selections: { 1: null, 2: null, 3: null },
            partner2Selections: { 1: null, 2: null, 3: null }
        };

        // Data Definitions
        const vocabularyData = [
            {
                id: 'angry',
                word: 'Angry',
                emoji: '😠',
                pronunciation: '/ˈæŋ.ɡri/',
                definition: 'Feeling mad or upset when something goes wrong or is unfair.',
                example: 'The clerk felt angry when the computer broke down.',
                synonyms: ['Mad', 'Upset', 'Annoyed'],
                antonyms: ['Calm', 'Happy', 'Pleased'],
                color: 'bg-red-50 border-red-200 text-red-700'
            },
            {
                id: 'amused',
                word: 'Amused',
                emoji: '😄',
                pronunciation: '/əˈmjuːzd/',
                definition: 'Finding something funny, enjoyable, or entertaining.',
                example: 'He was amused by the silly mistake on the poster.',
                synonyms: ['Entertained', 'Tickled', 'Smiling'],
                antonyms: ['Bored', 'Serious', 'Unhappy'],
                color: 'bg-amber-50 border-amber-200 text-amber-700'
            },
            {
                id: 'confused',
                word: 'Confused',
                emoji: '😕',
                pronunciation: '/kənˈfjuːzd/',
                definition: 'Unable to understand clearly or not knowing what is happening.',
                example: 'She felt confused when she lost her name tag in the bag.',
                synonyms: ['Puzzled', 'Uncertain', 'Baffled'],
                antonyms: ['Clear', 'Certain', 'Sure'],
                color: 'bg-purple-50 border-purple-200 text-purple-700'
            },
            {
                id: 'pleased',
                word: 'Pleased',
                emoji: '😊',
                pronunciation: '/pliːzd/',
                definition: 'Happy, satisfied, or glad about a good situation or meeting someone.',
                example: 'Evan was pleased to meet his new friends at the party.',
                synonyms: ['Happy', 'Glad', 'Satisfied'],
                antonyms: ['Disappointed', 'Sad', 'Upset'],
                color: 'bg-emerald-50 border-emerald-200 text-emerald-700'
            },
            {
                id: 'surprised',
                word: 'Surprised',
                emoji: '😲',
                pronunciation: '/səˈpraɪzd/',
                definition: 'Feeling shocked or astonished because something unexpected happened.',
                example: 'He was surprised to see his old friend at the event.',
                synonyms: ['Astonished', 'Amazed', 'Shocked'],
                antonyms: ['Expected', 'Unsurprised'],
                color: 'bg-sky-50 border-sky-200 text-sky-700'
            },
            {
                id: 'embarrassed',
                word: 'Embarrassed',
                emoji: '😳',
