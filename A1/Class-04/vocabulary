            });

            matcherState.scenarios.forEach(sc => {
                const isMatchedKey = Object.keys(matcherState.matchedPairs).find(k => matcherState.matchedPairs[k] === sc.id);

                const btn = document.createElement('button');
                btn.className = `w-full text-left p-3 rounded-2xl border text-xs sm:text-sm font-medium flex items-center justify-between transition-all ${
                    isMatchedKey ? 'bg-emerald-50 border-emerald-300 text-emerald-800 opacity-60 cursor-default' :
                    'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100'
                }`;
                btn.disabled = !!isMatchedKey;
                btn.onclick = () => {
                    if (!matcherState.selectedEmotion) {
                        showToast("Please select an emotion word on the left first!", "warning");
                        return;
                    }
                    if (matcherState.selectedEmotion === sc.id) {
                        playSound('correct');
                        matcherState.matchedPairs[matcherState.selectedEmotion] = sc.id;
                        matcherState.selectedEmotion = null;
                        addStars(5);
                        showToast("Correct Match! +5 Stars!", "success");
                        renderMatcherGame();

                        if (Object.keys(matcherState.matchedPairs).length === matcherState.emotions.length) {
                            confetti({ particleCount: 80, spread: 70 });
                            showToast("You matched all emotions! Great job!", "success");
                        }
                    } else {
                        playSound('wrong');
                        showToast("Not quite! Try another match.", "warning");
                    }
                };

                btn.innerHTML = `
                    <span>"${sc.text}"</span>
                    <i class="fa-solid ${isMatchedKey ? 'fa-check text-emerald-600' : 'fa-hand-pointer text-slate-300'}"></i>
                `;
                scenariosList.appendChild(btn);
            });
        }

        function resetMatcherGame() {
            matcherState.selectedEmotion = null;
            matcherState.matchedPairs = {};
            renderMatcherGame();
        }

        // Game 2: Fill in the Blanks
        const blanksData = [
            { id: 1, sentence: "When I called my teacher by the wrong name, I felt ________.", answer: "embarrassed" },
            { id: 2, sentence: "The manager was very ________ with our excellent teamwork.", answer: "pleased" },
            { id: 3, sentence: "She felt ________ when she looked at the map and realized she was lost.", answer: "confused" },
            { id: 4, sentence: "He was ________ by the puppy's funny tricks and laughed out loud.", answer: "amused" }
        ];

        let blanksSelections = { 1: '', 2: '', 3: '' };

        function initBlanksGame() {
            const wordBank = ['embarrassed', 'pleased', 'confused', 'amused', 'angry', 'surprised'];
            const bankContainer = document.getElementById('word-bank-container');
            bankContainer.innerHTML = wordBank.map(word => `
                <span onclick="speak('${word}')" class="bg-white border border-indigo-200 text-indigo-700 font-bold px-3 py-1.5 rounded-xl text-xs sm:text-sm shadow-xs cursor-pointer hover:bg-indigo-600 hover:text-white transition-all">
                    ${word} <i class="fa-solid fa-volume-low text-[10px] ml-1"></i>
                </span>
            `).join('');

            const sentencesContainer = document.getElementById('blanks-sentences-container');
            sentencesContainer.innerHTML = blanksData.map((item, idx) => `
                <div class="bg-slate-50 border border-slate-200 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <p class="text-sm font-semibold text-slate-800">
                        ${idx + 1}. ${item.sentence.replace('________', `<span class="inline-block border-b-2 border-indigo-600 min-w-[100px] text-indigo-600 text-center font-bold px-2">${blanksSelections[item.id] || '_______'}</span>`)}
                    </p>
                    <select onchange="blanksSelections[${item.id}] = this.value" class="bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-xl px-3 py-2 focus:outline-none focus:border-indigo-600">
                        <option value="">-- Choose Word --</option>
                        ${wordBank.map(w => `<option value="${w}">${w}</option>`).join('')}
                    </select>
                </div>
            `).join('');
        }

        function checkFillBlanksAnswers() {
            let correct = 0;
            blanksData.forEach(item => {
                if (blanksSelections[item.id] === item.answer) {
                    correct++;
                }
            });

            if (correct === blanksData.length) {
                playSound('correct');
                addStars(15);
                showToast("Perfect! All sentences completed correctly! +15 Stars", "success");
                confetti({ particleCount: 70, spread: 60 });
            } else {
                playSound('wrong');
                showToast(`You got ${correct} of ${blanksData.length} correct. Check again!`, "warning");
            }
        }

        // Game 3: Speed Quiz
        const quizQuestions = [
            { q: "How do you feel when you can't find your name tag and don't know where it went?", options: ["Confused", "Pleased", "Angry"], correct: 0 },
            { q: "How do you feel when you meet friendly new people at an event?", options: ["Embarrassed", "Pleased", "Angry"], correct: 1 },
            { q: "How do you feel when you make a funny mistake in front of everyone?", options: ["Embarrassed", "Confused", "Amused"], correct: 0 },
            { q: "How do you feel when someone gives you an unexpected birthday gift?", options: ["Surprised", "Confused", "Angry"], correct: 0 },
            { q: "How do you feel when a dog does a funny trick?", options: ["Amused", "Embarrassed", "Pleased"], correct: 0 }
        ];

        let quizState = { current: 0, score: 0, streak: 0 };

        function startSpeedQuiz() {
            quizState = { current: 0, score: 0, streak: 0 };
            document.getElementById('quiz-start-screen').classList.add('hidden');
            document.getElementById('quiz-result-screen').classList.add('hidden');
            document.getElementById('quiz-active-screen').classList.remove('hidden');
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            const q = quizQuestions[quizState.current];
            document.getElementById('quiz-progress-indicator').innerText = `Question ${quizState.current + 1} of ${quizQuestions.length}`;
            document.getElementById('quiz-streak-count').innerText = `🔥 ${quizState.streak}`;
            document.getElementById('quiz-question-text').innerText = `"${q.q}"`;

            const optionsContainer = document.getElementById('quiz-options-container');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="answerQuiz(${idx})" class="w-full bg-slate-50 hover:bg-indigo-50 border-2 border-slate-200 hover:border-indigo-500 rounded-2xl p-4 text-slate-800 font-bold text-base transition-all shadow-xs active:scale-95 text-center">
                    ${opt}
                </button>
            `).join('');

            speak(q.q);
        }

        function speakQuizQuestion() {
            speak(quizQuestions[quizState.current].q);
        }

        function answerQuiz(optionIndex) {
            const q = quizQuestions[quizState.current];
            if (optionIndex === q.correct) {
                playSound('correct');
                quizState.score++;
                quizState.streak++;
                addStars(5);
                showToast("Correct! +5 Stars", "success");
            } else {
                playSound('wrong');
                quizState.streak = 0;
                showToast(`Incorrect! The right answer was ${q.options[q.correct]}`, "warning");
            }

            quizState.current++;
            if (quizState.current < quizQuestions.length) {
                setTimeout(renderQuizQuestion, 600);
            } else {
                setTimeout(showQuizResults, 600);
            }
        }

        function showQuizResults() {
            document.getElementById('quiz-active-screen').classList.add('hidden');
            document.getElementById('quiz-result-screen').classList.remove('hidden');
            document.getElementById('quiz-score-summary').innerText = `You scored ${quizState.score} out of ${quizQuestions.length}!`;
            if (quizState.score >= 4) {
                confetti({ particleCount: 100, spread: 80 });
            }
        }

        function switchSubGame(gameKey) {
            playSound('click');
            document.querySelectorAll('.subgame-btn').forEach(btn => {
                btn.className = "subgame-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:bg-slate-100 transition-all text-center";
            });
            document.querySelectorAll('.subgame-panel').forEach(p => p.classList.add('hidden'));

            document.getElementById(`subgame-${gameKey}-btn`).className = "subgame-btn flex-1 py-2 px-3 rounded-xl text-xs sm:text-sm font-bold bg-indigo-600 text-white transition-all text-center";
            document.getElementById(`subgame-${gameKey}`).classList.remove('hidden');

            if (gameKey === 'matcher') initMatcherGame();
            if (gameKey === 'blanks') initBlanksGame();
        }


        function renderPartnerInputs() {
            const s1Box = document.getElementById('partner-s1-options');
            const s2Box = document.getElementById('partner-s2-options');

            s1Box.innerHTML = '';
            s2Box.innerHTML = '';

            scenariosData.forEach(sc => {
                s1Box.innerHTML += `
                    <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-1.5">
                        <p class="text-xs font-bold text-slate-700">Scenario ${sc.id}: ${sc.character}</p>
                        <select onchange="state.partner1Selections[${sc.id}] = this.value" class="w-full bg-slate-50 border border-slate-300 text-xs font-semibold rounded-lg p-2">
                            <option value="">Select Student A Opinion</option>
                            ${sc.options.map(o => `<option value="${o.word}">${o.emoji} ${o.text}</option>`).join('')}
                        </select>
                    </div>
                `;

                s2Box.innerHTML += `
                    <div class="bg-white p-3 rounded-xl border border-slate-200 space-y-1.5">
                        <p class="text-xs font-bold text-slate-700">Scenario ${sc.id}: ${sc.character}</p>
                        <select onchange="state.partner2Selections[${sc.id}] = this.value" class="w-full bg-slate-50 border border-slate-300 text-xs font-semibold rounded-lg p-2">
                            <option value="">Select Student B Opinion</option>
                            ${sc.options.map(o => `<option value="${o.word}">${o.emoji} ${o.text}</option>`).join('')}
                        </select>
                    </div>
                `;
            });
        }

        function comparePartnerOpinions() {
            playSound('correct');
            const container = document.getElementById('partner-results-container');
            const promptsList = document.getElementById('partner-prompts-list');

            promptsList.innerHTML = '';

            scenariosData.forEach(sc => {
                const ans1 = state.partner1Selections[sc.id] || "unselected";
                const ans2 = state.partner2Selections[sc.id] || "unselected";

                const isAgreed = ans1 === ans2 && ans1 !== "unselected";

                const card = document.createElement('div');
                card.className = "bg-slate-800 border border-slate-700 p-4 rounded-2xl space-y-2";

                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-indigo-400">Scenario ${sc.id}: ${sc.character}</span>
                        <span class="text-xs font-bold px-2.5 py-0.5 rounded-full ${isAgreed ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-sky-500/20 text-sky-400 border border-sky-500/30'}">
                            ${isAgreed ? '🎯 Same Opinion!' : '💡 Different Perspectives'}
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs py-1">
                        <div class="bg-slate-900/60 p-2 rounded-lg">
                            <span class="text-slate-400 block">Student A:</span>
                            <span class="font-bold text-indigo-300 capitalize">${ans1}</span>
                        </div>
                        <div class="bg-slate-900/60 p-2 rounded-lg">
                            <span class="text-slate-400 block">Student B:</span>
                            <span class="font-bold text-teal-300 capitalize">${ans2}</span>
                        </div>
                    </div>

                    <div class="bg-indigo-950/80 border border-indigo-800/50 p-3 rounded-xl text-xs space-y-1">
                        <p class="text-amber-300 font-bold"><i class="fa-solid fa-comments mr-1"></i> Partner Discussion Prompt:</p>
                        <p class="text-slate-200 italic">
                            Student A says: "I think ${sc.character} feels <strong>${ans1}</strong>. What about you?"<br>
                            Student B replies: "I chose <strong>${ans2}</strong> because..."
                        </p>
                    </div>
                `;

                promptsList.appendChild(card);
            });

            container.classList.remove('hidden');
            container.scrollIntoView({ behavior: 'smooth' });
            confetti({ particleCount: 40, spread: 50 });
        }


        function switchTab(tabKey) {
            playSound('click');
            state.activeTab = tabKey;

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all";
            });
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));

            const activeBtn = document.getElementById(`tab-${tabKey}`);
            if (activeBtn) {
                activeBtn.className = "tab-btn px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2 whitespace-nowrap bg-indigo-600 text-white shadow-xs transition-all";
            }

            const activeContent = document.getElementById(`content-${tabKey}`);
            if (activeContent) {
                activeContent.classList.remove('hidden');
            }

            if (tabKey === 'scenarios') renderScenarios();
            if (tabKey === 'flashcards') renderFlashcards();
            if (tabKey === 'games') switchSubGame('matcher');
            if (tabKey === 'partner') renderPartnerInputs();
        }

        // Window Init
        window.onload = function() {
            renderScenarios();
            renderFlashcards();
            renderPartnerInputs();
            updateProgress();
        };
    </script>
</body>
</html>
