<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Future Plans & Invitations Lab (Be Going To)</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        heading: ['Outfit', 'Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <!-- FontAwesome CDN for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s, color 0.3s;
        }
        h1, h2, h3, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.3);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.6);
        }
        .pulse-correct {
            animation: pulseGreen 0.5s ease-in-out;
        }
        .pulse-wrong {
            animation: pulseRed 0.5s ease-in-out;
        }
        @keyframes pulseGreen {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); box-shadow: 0 0 20px rgba(16, 185, 129, 0.4); }
            100% { transform: scale(1); }
        }
        @keyframes pulseRed {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
            100% { transform: scale(1); }
        }
        .token-item {
            user-select: none;
            touch-action: manipulation;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- TOP HEADER -->
    <header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
                    <i class="fa-solid fa-calendar-check text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-bold tracking-tight bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent">
                        Future Plans Lab
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium hidden sm:block">Grammar & Invitations: <em>Be Going To</em></p>
                </div>
            </div>

            <!-- Global Score & Sound Tools -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <!-- Streak Badge -->
                <div class="flex items-center space-x-1.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 text-amber-700 dark:text-amber-300 px-3 py-1.5 rounded-full text-xs sm:text-sm font-semibold" title="Current Streak">
                    <i class="fa-solid fa-fire text-amber-500 animate-bounce"></i>
                    <span id="global-streak">0</span>
                </div>

                <!-- Total Score Badge -->
                <div class="flex items-center space-x-1.5 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full text-xs sm:text-sm font-semibold" title="Total Points">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span id="global-score">0</span>
                    <span class="text-xs text-indigo-400 dark:text-indigo-500">pts</span>
                </div>

                <!-- Mute / Unmute Sound Audio -->
                <button id="btn-toggle-sound" onclick="app.toggleSound()" class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition" title="Toggle Sound FX">
                    <i id="icon-sound" class="fa-solid fa-volume-high"></i>
                </button>

                <!-- Theme Toggle Button -->
                <button id="btn-toggle-theme" onclick="app.toggleTheme()" class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition" title="Toggle Theme">
                    <i id="icon-theme" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- TAB NAVIGATION BAR -->
    <nav class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 sm:px-8 sticky top-16 z-30">
        <div class="max-w-7xl mx-auto flex space-x-1 sm:space-x-4 overflow-x-auto py-2 no-scrollbar">
            <button onclick="app.switchTab('rules')" id="tab-btn-rules" class="tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 font-semibold">
                <i class="fa-solid fa-book-bookmark"></i>
                <span>1. Grammar Rules</span>
            </button>
            <button onclick="app.switchTab('exercises')" id="tab-btn-exercises" class="tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-pen-to-square"></i>
                <span>2. Exercises & Matching</span>
            </button>
            <button onclick="app.switchTab('builder')" id="tab-btn-builder" class="tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-comments"></i>
                <span>3. Roleplay Studio</span>
            </button>
            <button onclick="app.switchTab('arcade')" id="tab-btn-arcade" class="tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i class="fa-solid fa-gamepad"></i>
                <span>4. Practice Arcade</span>
            </button>
        </div>
    </nav>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">

        <!-- TAB 1: GRAMMAR RULES & INVITATION FORMULAS -->
        <section id="tab-rules" class="tab-content block space-y-6">
            <!-- Banner Callout -->
            <div class="bg-gradient-to-r from-indigo-600 via-indigo-700 to-purple-800 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-10 text-white text-9xl">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div class="relative z-10 max-w-3xl">
                    <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-bold uppercase tracking-wider rounded-full mb-3 text-indigo-100">
                        Future Expressions • ESL Grammar Focus
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mb-2">Making Future Plans & Invitations with <em>Be Going To</em></h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Use <strong>be going to + base verb</strong> to discuss prior decisions, future intentions, and scheduled activities. Combine it with invitation formulas like <em>Would you like to...?</em> or <em>Do you want to...?</em> to make plans with others!
                    </p>
                </div>
            </div>

            <!-- Structure Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Affirmative & Negative -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-3">
                        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-circle-plus text-emerald-500"></i> Statements (Affirmative & Negative)
                        </h3>
                        <span class="text-xs bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold px-2.5 py-0.5 rounded">Formulas</span>
                    </div>

                    <div class="space-y-3 text-sm">
                        <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                            <p class="font-bold text-slate-700 dark:text-slate-300 mb-1">Affirmative Formula:</p>
                            <p class="font-mono text-indigo-600 dark:text-indigo-400 font-medium">Subject + am / is / are + going to + Base Verb</p>
                            <div class="mt-2 text-xs text-slate-600 dark:text-slate-300 flex justify-between items-center bg-white dark:bg-slate-800 p-2 rounded border border-slate-100 dark:border-slate-700">
                                <span>"I <strong>am going to work</strong> late tonight."</span>
                                <button onclick="app.speakText('I am going to work late tonight.')" class="text-indigo-500 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>

                        <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                            <p class="font-bold text-slate-700 dark:text-slate-300 mb-1">Negative Formula:</p>
                            <p class="font-mono text-rose-600 dark:text-rose-400 font-medium">Subject + am not / is not / are not + going to + Base Verb</p>
                            <div class="mt-2 text-xs text-slate-600 dark:text-slate-300 flex justify-between items-center bg-white dark:bg-slate-800 p-2 rounded border border-slate-100 dark:border-slate-700">
                                <span>"I <strong>am not going to stay</strong> home on Saturday."</span>
                                <button onclick="app.speakText('I am not going to stay home on Saturday.')" class="text-indigo-500 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Questions (Yes/No & Wh-) -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-3">
                        <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-circle-question text-indigo-500"></i> Question Structures
                        </h3>
                        <span class="text-xs bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 font-bold px-2.5 py-0.5 rounded">Asking Plans</span>
                    </div>

                    <div class="space-y-3 text-sm">
                        <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                            <p class="font-bold text-slate-700 dark:text-slate-300 mb-1">Yes / No Questions:</p>
                            <p class="font-mono text-indigo-600 dark:text-indigo-400 font-medium">Am / Is / Are + Subject + going to + Base Verb?</p>
                            <div class="mt-2 text-xs text-slate-600 dark:text-slate-300 flex justify-between items-center bg-white dark:bg-slate-800 p-2 rounded border border-slate-100 dark:border-slate-700">
                                <span>"<strong>Are</strong> you <strong>going to stay</strong> in town next weekend?"</span>
                                <button onclick="app.speakText('Are you going to stay in town next weekend?')" class="text-indigo-500 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>

                        <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700">
                            <p class="font-bold text-slate-700 dark:text-slate-300 mb-1">Wh- Questions:</p>
                            <p class="font-mono text-indigo-600 dark:text-indigo-400 font-medium">Wh- Word + am / is / are + Subject + going to + Base Verb?</p>
                            <div class="mt-2 text-xs text-slate-600 dark:text-slate-300 flex justify-between items-center bg-white dark:bg-slate-800 p-2 rounded border border-slate-100 dark:border-slate-700">
                                <span>"What <strong>are</strong> you <strong>going to do</strong> tonight?"</span>
                                <button onclick="app.speakText('What are you going to do tonight?')" class="text-indigo-500 hover:text-indigo-700"><i class="fa-solid fa-volume-high"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invitations & Polite Responses Matrix -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-3">
                    <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                        <i class="fa-solid fa-glass-water text-purple-500"></i> Politeness & Invitation Pragmatics
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">How to extend invitations and accept or decline politely using future reasons.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Column 1: Extending Invitations -->
                    <div class="bg-purple-50/60 dark:bg-purple-950/30 p-4 rounded-xl border border-purple-100 dark:border-purple-900/60 space-y-2">
                        <h4 class="font-bold text-purple-900 dark:text-purple-300 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-envelope"></i> Making an Invitation
                        </h4>
                        <ul class="text-xs space-y-2 text-slate-700 dark:text-slate-300">
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-purple-100 dark:border-purple-900 flex justify-between items-center">
                                <span>"<strong>Would you like to</strong> go out tonight?"</span>
                                <button onclick="app.speakText('Would you like to go out tonight?')" class="text-purple-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-purple-100 dark:border-purple-900 flex justify-between items-center">
                                <span>"<strong>Do you want to</strong> see a movie?"</span>
                                <button onclick="app.speakText('Do you want to see a movie?')" class="text-purple-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                        </ul>
                    </div>

                    <!-- Column 2: Accepting -->
                    <div class="bg-emerald-50/60 dark:bg-emerald-950/30 p-4 rounded-xl border border-emerald-100 dark:border-emerald-900/60 space-y-2">
                        <h4 class="font-bold text-emerald-900 dark:text-emerald-300 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-thumbs-up"></i> Accepting
                        </h4>
                        <ul class="text-xs space-y-2 text-slate-700 dark:text-slate-300">
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-emerald-100 dark:border-emerald-900 flex justify-between items-center">
                                <span>"We'd love to come!"</span>
                                <button onclick="app.speakText('Wed love to come!')" class="text-emerald-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-emerald-100 dark:border-emerald-900 flex justify-between items-center">
                                <span>"Sure! Let's try to go on Saturday."</span>
                                <button onclick="app.speakText('Sure! Lets try to go on Saturday.')" class="text-emerald-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                        </ul>
                    </div>

                    <!-- Column 3: Declining with Reason -->
                    <div class="bg-rose-50/60 dark:bg-rose-950/30 p-4 rounded-xl border border-rose-100 dark:border-rose-900/60 space-y-2">
                        <h4 class="font-bold text-rose-900 dark:text-rose-300 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-user-xmark"></i> Declining + Future Reason
                        </h4>
                        <ul class="text-xs space-y-2 text-slate-700 dark:text-slate-300">
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-rose-100 dark:border-rose-900 flex justify-between items-center">
                                <span>"Sorry, I can't. I'm going to work late."</span>
                                <button onclick="app.speakText('Sorry, I cant. Im going to work late.')" class="text-rose-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                            <li class="bg-white dark:bg-slate-800 p-2 rounded border border-rose-100 dark:border-rose-900 flex justify-between items-center">
                                <span>"I'm going to stay at the office till 7:00."</span>
                                <button onclick="app.speakText('Im going to stay at the office till 7:00.')" class="text-rose-500"><i class="fa-solid fa-volume-high"></i></button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: INTERACTIVE EXERCISES & MATCHING GAME -->
        <section id="tab-exercises" class="tab-content hidden space-y-8">
            <!-- Gap Fill Section -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Section A • Practice Worksheet</span>
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Complete Responses with <em>be going to</em></h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Fill in the blanks using the correct form of <strong>be going to</strong> + verb.</p>
                    </div>
                    <div class="flex items-center space-x-2 self-end sm:self-auto">
                        <button onclick="app.exercises.checkFillGaps()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold transition flex items-center space-x-2 shadow-sm">
                            <i class="fa-solid fa-check-double"></i>
                            <span>Check All Gaps</span>
                        </button>
                        <button onclick="app.exercises.resetFillGaps()" class="px-3 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 rounded-lg text-sm font-medium transition" title="Reset worksheet">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                    </div>
                </div>

                <!-- Worksheet Grid Layout (Column A vs Column B) -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Column A: Invitations & Questions -->
                    <div class="space-y-6">
                        <h3 class="font-bold text-lg text-indigo-700 dark:text-indigo-400 border-b border-indigo-100 dark:border-indigo-900 pb-2 flex items-center justify-between">
                            <span>Column A (Invitations & Questions)</span>
                            <i class="fa-solid fa-circle-question"></i>
                        </h3>

                        <!-- Item 1 -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-indigo-600 dark:text-indigo-400 text-sm">1.</span>
                                <button onclick="app.speakText('What are you going to do tonight? Would you like to go out?')" class="text-slate-400 hover:text-indigo-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                What 
                                <input type="text" id="gap-a1-1" placeholder="are" class="w-20 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                you 
                                <input type="text" id="gap-a1-2" placeholder="going to do" class="w-36 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                (do) tonight? Would you like to go out?
                            </div>
                        </div>

                        <!-- Item 2 -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-indigo-600 dark:text-indigo-400 text-sm">2.</span>
                                <button onclick="app.speakText('Are you going to do anything on Friday night? Do you want to see a movie?')" class="text-slate-400 hover:text-indigo-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                <input type="text" id="gap-a2-1" placeholder="Are" class="w-20 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                you 
                                <input type="text" id="gap-a2-2" placeholder="going to do" class="w-36 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                (do) anything on Friday night? Do you want to see a movie?
                            </div>
                        </div>

                        <!-- Item 3 -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
