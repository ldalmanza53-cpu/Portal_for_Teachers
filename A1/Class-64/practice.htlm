                                <span class="font-bold text-indigo-600 dark:text-indigo-400 text-sm">4.</span>
                                <button onclick="app.speakText('Are you going to stay in town next weekend? Do you want to go for a hike?')" class="text-slate-400 hover:text-indigo-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                <input type="text" id="gap-a4-1" placeholder="Are" class="w-20 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                you 
                                <input type="text" id="gap-a4-2" placeholder="going to stay" class="w-40 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                                (stay) in town next weekend? Do you want to go for a hike?
                            </div>
                        </div>
                    </div>

                    <!-- Column B: Responses -->
                    <div class="space-y-6">
                        <h3 class="font-bold text-lg text-purple-700 dark:text-purple-400 border-b border-purple-100 dark:border-purple-900 pb-2 flex items-center justify-between">
                            <span>Column B (Responses)</span>
                            <i class="fa-solid fa-reply"></i>
                        </h3>

                        <!-- Item a -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-purple-600 dark:text-purple-400 text-sm">a.</span>
                                <button onclick="app.speakText('I am going to be here on Saturday, but not Sunday. Lets try to go on Saturday.')" class="text-slate-400 hover:text-purple-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                I 
                                <input type="text" id="gap-ba-1" placeholder="am going to be" class="w-44 px-2 py-1 mx-1 text-center font-bold text-purple-600 dark:text-purple-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-purple-500 outline-none">
                                (be) here on Saturday, but not Sunday. Let's try to go on Saturday.
                            </div>
                        </div>

                        <!-- Item b -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-purple-600 dark:text-purple-400 text-sm">b.</span>
                                <button onclick="app.speakText('Well, my father is going to visit my brother at college. But my mother and I are going to be home. Wed love to come!')" class="text-slate-400 hover:text-purple-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                Well, my father 
                                <input type="text" id="gap-bb-1" placeholder="is going to visit" class="w-44 px-2 py-1 mx-1 text-center font-bold text-purple-600 dark:text-purple-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-purple-500 outline-none">
                                (visit) my brother at college. But my mother and I 
                                <input type="text" id="gap-bb-2" placeholder="are going to be" class="w-44 px-2 py-1 mx-1 text-center font-bold text-purple-600 dark:text-purple-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-purple-500 outline-none">
                                (be) home. We'd love to come!
                            </div>
                        </div>

                        <!-- Item c -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-purple-600 dark:text-purple-400 text-sm">c.</span>
                                <button onclick="app.speakText('Sorry, I cant. I am going to work late tonight. How about tomorrow night?')" class="text-slate-400 hover:text-purple-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                Sorry, I can't. I 
                                <input type="text" id="gap-bc-1" placeholder="am going to work" class="w-44 px-2 py-1 mx-1 text-center font-bold text-purple-600 dark:text-purple-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-purple-500 outline-none">
                                (work) late tonight. How about tomorrow night?
                            </div>
                        </div>

                        <!-- Item d -->
                        <div class="p-4 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-purple-600 dark:text-purple-400 text-sm">d.</span>
                                <button onclick="app.speakText('Can we go to a late show? I am going to stay at the office till 7:00.')" class="text-slate-400 hover:text-purple-500 text-xs"><i class="fa-solid fa-volume-high"></i> Listen</button>
                            </div>
                            <div class="text-sm sm:text-base leading-relaxed text-slate-800 dark:text-slate-200">
                                Can we go to a late show? I 
                                <input type="text" id="gap-bd-1" placeholder="am going to stay" class="w-44 px-2 py-1 mx-1 text-center font-bold text-purple-600 dark:text-purple-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-purple-500 outline-none">
                                (stay) at the office till 7:00.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Worksheet Feedback Banner -->
                <div id="worksheet-feedback-banner" class="hidden p-4 rounded-xl text-center font-bold text-sm transition-all">
                    <!-- Feedback injected dynamically -->
                </div>
            </div>

            <!-- Matching Game Section -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Section B • Invitation Matching Game</span>
                    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Match Invitations (Column A) with Responses (Column B)</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Click an invitation card on the left, then click its corresponding response card on the right to pair them.</p>
                </div>

                <!-- Matching Cards Container -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative" id="matching-cards-container">
                    <!-- Column A Side -->
                    <div class="space-y-3" id="match-col-a">
                        <!-- Cards injected by JS -->
                    </div>

                    <!-- Column B Side -->
                    <div class="space-y-3" id="match-col-b">
                        <!-- Cards injected by JS -->
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <span id="matching-status-text" class="text-sm font-semibold text-slate-500 dark:text-slate-400">Select an Invitation on the left to start pairing...</span>
                    <button onclick="app.exercises.resetMatching()" class="px-4 py-2 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-medium transition">
                        <i class="fa-solid fa-rotate-left mr-1"></i> Reset Pairs
                    </button>
                </div>
            </div>
        </section>

        <!-- TAB 3: ROLEPLAY & CONVERSATION BUILDER -->
        <section id="tab-builder" class="tab-content hidden space-y-6">
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
                <div class="border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Dialogue Generator</span>
                    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Interactive Roleplay Studio</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Customize future plans, choose invitation formulas, and build realistic dialogues with natural speech playback.</p>
                </div>

                <!-- Configuration Panel -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 bg-slate-50 dark:bg-slate-900/60 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                    <!-- Time Frame -->
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">1. Time Frame</label>
                        <select id="role-time" onchange="app.builder.generateDialogue()" class="w-full p-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm font-semibold focus:ring-2 focus:ring-indigo-500">
                            <option value="tonight">tonight</option>
                            <option value="Friday night">Friday night</option>
                            <option value="Sunday">Sunday</option>
                            <option value="next weekend">next weekend</option>
                            <option value="tomorrow afternoon">tomorrow afternoon</option>
                        </select>
                    </div>

                    <!-- Proposed Activity -->
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">2. Activity</label>
                        <select id="role-activity" onchange="app.builder.generateDialogue()" class="w-full p-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm font-semibold focus:ring-2 focus:ring-indigo-500">
                            <option value="go out for dinner">go out for dinner</option>
                            <option value="see a movie">see a movie</option>
                            <option value="have a barbecue">have a barbecue</option>
                            <option value="go for a hike">go for a hike</option>
                            <option value="study at the library">study at the library</option>
                        </select>
                    </div>

                    <!-- Invitation Style -->
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">3. Invitation Formula</label>
                        <select id="role-style" onchange="app.builder.generateDialogue()" class="w-full p-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm font-semibold focus:ring-2 focus:ring-indigo-500">
                            <option value="would">Would you like to...?</option>
                            <option value="want">Do you want to...?</option>
                        </select>
                    </div>

                    <!-- Response Outcome -->
                    <div class="space-y-1">
                        <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">4. Response Outcome</label>
                        <select id="role-response" onchange="app.builder.generateDialogue()" class="w-full p-2.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm font-semibold focus:ring-2 focus:ring-indigo-500">
                            <option value="accept">Accept Enthusiastically</option>
                            <option value="decline_work">Decline: Work late excuse</option>
                            <option value="decline_family">Decline: Visit family excuse</option>
                            <option value="decline_office">Decline: Stay at office till 7:00</option>
                        </select>
                    </div>
                </div>

                <!-- Generated Dialogue Chat Bubbles Display -->
                <div class="bg-indigo-50/40 dark:bg-indigo-950/20 p-6 rounded-2xl border border-indigo-100 dark:border-indigo-900/40 space-y-4">
                    <div class="flex items-center justify-between border-b border-indigo-100 dark:border-indigo-900/60 pb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-comments"></i> Generated Practice Conversation
                        </span>
                        <button onclick="app.builder.playFullConversation()" class="px-4 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition flex items-center space-x-2 shadow-sm">
                            <i class="fa-solid fa-play"></i>
                            <span>Play Full Dialogue (TTS)</span>
                        </button>
                    </div>

                    <!-- Person A Bubble -->
                    <div class="flex items-start space-x-3">
                        <div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                            A
                        </div>
                        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl rounded-tl-none border border-slate-200 dark:border-slate-700 shadow-sm max-w-xl space-y-1">
                            <p class="text-xs font-bold text-indigo-600 dark:text-indigo-400">Person A (Inviter)</p>
                            <p id="dialogue-line-a" class="text-base font-semibold text-slate-800 dark:text-slate-100 leading-relaxed">
                                What are you going to do tonight? Would you like to go out for dinner?
                            </p>
                        </div>
                    </div>

                    <!-- Person B Bubble -->
                    <div class="flex items-start space-x-3 justify-end">
                        <div class="bg-indigo-600 text-white p-4 rounded-2xl rounded-tr-none shadow-sm max-w-xl space-y-1 text-right">
                            <p class="text-xs font-bold text-indigo-200">Person B (Respondent)</p>
                            <p id="dialogue-line-b" class="text-base font-medium leading-relaxed">
                                Sorry, I can't. I am going to work late tonight. How about another time?
                            </p>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-sm">
                            B
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 4: PRACTICE ARCADE (GAMES & QUIZ) -->
        <section id="tab-arcade" class="tab-content hidden space-y-8">
            <!-- Game 1: Sentence Builder Scramble -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-purple-600 dark:text-purple-400">Arcade Game 1</span>
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100">Sentence Scramble Puzzle</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Click word tokens in order to assemble correct <em>be going to</em> sentences.</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span id="scramble-step-indicator" class="text-xs font-bold bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300 px-3 py-1 rounded-full">
                            Puzzle 1 / 4
                        </span>
                        <button onclick="app.arcade.nextScramble()" class="px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold transition">
                            Next <i class="fa-solid fa-arrow-right ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Drop Target Slot Zone -->
                <div class="space-y-2">
                    <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Assembled Sentence:</label>
                    <div id="scramble-drop-zone" class="min-h-[64px] p-3 rounded-xl border-2 border-dashed border-purple-300 dark:border-purple-700/60 bg-purple-50/40 dark:bg-purple-950/20 flex flex-wrap items-center gap-2 transition-all">
                        <p id="scramble-placeholder" class="text-sm text-slate-400 italic">Click word tokens below to construct sentence...</p>
                    </div>
                </div>

                <!-- Token Pool -->
                <div class="space-y-2 pt-2">
                    <label class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Word Bank (Scrambled):</label>
                    <div id="scramble-token-pool" class="min-h-[60px] p-3 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-wrap items-center gap-2">
                        <!-- Tokens injected here -->
                    </div>
                </div>

                <!-- Action Controls & Feedback -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-3 border-t border-slate-100 dark:border-slate-700">
                    <div id="scramble-feedback" class="text-sm font-semibold flex items-center space-x-2 min-h-[24px]">
                        <!-- Feedback text -->
                    </div>
                    <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
                        <button onclick="app.arcade.resetCurrentScramble()" class="px-4 py-2 border border-slate-300 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg text-sm font-medium transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> Clear
                        </button>
                        <button onclick="app.arcade.verifyScramble()" class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-semibold transition shadow-sm flex items-center space-x-2">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Check Sentence</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Game 2: Speed Quiz Challenge -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-slate-700 shadow-sm max-w-4xl mx-auto space-y-6">
                <!-- Game Header Bar -->
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 dark:border-slate-700/60 pb-4">
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-indigo-100 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 uppercase tracking-wider">Arcade Game 2</span>
                            <span id="quiz-round-badge" class="text-xs font-bold text-slate-500 dark:text-slate-400">Question 1 / 5</span>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mt-1">Plans & Invitations Speed Quiz</h2>
                    </div>

                    <!-- Live Arcade Stats -->
                    <div class="flex items-center space-x-4 bg-slate-50 dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div class="text-center">
                            <span class="text-xs text-slate-400 block font-semibold">SCORE</span>
                            <span id="quiz-score" class="text-lg font-black text-indigo-600 dark:text-indigo-400">0</span>
                        </div>
                        <div class="w-px h-8 bg-slate-200 dark:bg-slate-700"></div>
                        <div class="text-center">
                            <span class="text-xs text-slate-400 block font-semibold">STREAK</span>
                            <span id="quiz-streak" class="text-lg font-black text-amber-500">0 🔥</span>
                        </div>
                    </div>
                </div>

                <!-- Quiz Card -->
                <div id="quiz-card" class="space-y-6">
                    <div class="w-full bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                        <div id="quiz-progress-bar" class="bg-indigo-600 h-full w-full transition-all duration-300"></div>
                    </div>

                    <div class="bg-indigo-50/60 dark:bg-indigo-950/40 p-6 rounded-2xl border border-indigo-100 dark:border-indigo-900/60 text-center space-y-2">
                        <span id="quiz-category" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-widest">GRAMMAR CHALLENGE</span>
                        <h3 id="quiz-question-text" class="text-xl sm:text-2xl font-extrabold text-slate-800 dark:text-slate-100">
                            Which sentence correctly asks about someone's plans for Friday night?
                        </h3>
                    </div>

                    <!-- Options Grid -->
                    <div id="quiz-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Injected by JS -->
                    </div>

                    <!-- Feedback Banner -->
                    <div id="quiz-feedback-banner" class="hidden p-4 rounded-xl text-center font-bold text-sm transition-all">
                        <!-- Banner text -->
                    </div>
                </div>

                <!-- Results Screen -->
                <div id="quiz-results-screen" class="hidden text-center space-y-6 py-6">
                    <div class="w-20 h-20 bg-amber-100 dark:bg-amber-950/60 rounded-full flex items-center justify-center text-amber-500 text-4xl mx-auto shadow-inner">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <h3 class="text-3xl font-extrabold text-slate-800 dark:text-slate-100">Arcade Round Complete!</h3>
                        <p class="text-slate-500 dark:text-slate-400 mt-1">Excellent job practicing English future plans and invitations!</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto bg-slate-50 dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div>
                            <span class="text-xs text-slate-400 font-semibold block">QUIZ SCORE</span>
                            <span id="res-quiz-score" class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400">0</span>
                        </div>
                        <div>
                            <span class="text-xs text-slate-400 font-semibold block">ACCURACY</span>
                            <span id="res-quiz-accuracy" class="text-2xl font-extrabold text-emerald-500">100%</span>
                        </div>
                    </div>

                    <div>
                        <button onclick="app.arcade.startQuiz()" class="px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-xl font-bold shadow-lg shadow-indigo-500/25 transition transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-rotate-right mr-2"></i> Play Again
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-6 mt-12 transition-colors">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 dark:text-slate-400 space-y-2">
            <p>Future Plans & Invitations Lab • Interactive ESL Learning Application</p>
            <p>Designed for practice with <em>be going to</em>, making invitations (<em>Would you like to...? / Do you want to...?</em>) and polite responses.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT CORE LOGIC -->
    <script>
        const soundFx = {
            ctx: null,
            init() {
                if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            },
            playCorrect() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
                osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.35);
            },
            playWrong() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(130, now + 0.2);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.25);
            },
            playClick() {
                if (!appState.soundEnabled) return;
                this.init();
                if (!this.ctx) return;
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, now);
                gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start(now);
                osc.stop(now + 0.05);
            }
        };

        const appState = {
            score: 0,
            streak: 0,
            soundEnabled: true,
            darkMode: false,
            activeTab: 'rules'
        };

        const app = {
            init() {
                this.loadProgress();
                this.applyTheme();
                this.exercises.initMatching();
                this.builder.generateDialogue();
                this.arcade.loadScramble(0);
                this.arcade.startQuiz();
            },

            loadProgress() {
                const saved = localStorage.getItem('future_plans_lab_save');
                if (saved) {
                    try {
                        const parsed = JSON.parse(saved);
                        appState.score = parsed.score || 0;
                        appState.streak = parsed.streak || 0;
                        appState.soundEnabled = parsed.soundEnabled ?? true;
                        appState.darkMode = parsed.darkMode ?? false;
                    } catch(e) {
                        console.error("Storage load error", e);
                    }
                }
                this.updateHeaderStats();
            },

            saveProgress() {
                const data = {
                    score: appState.score,
                    streak: appState.streak,
                    soundEnabled: appState.soundEnabled,
                    darkMode: appState.darkMode
                };
                localStorage.setItem('future_plans_lab_save', JSON.stringify(data));
                this.updateHeaderStats();
            },

            updateHeaderStats() {
                document.getElementById('global-score').textContent = appState.score;
                document.getElementById('global-streak').textContent = appState.streak;
                const soundIcon = document.getElementById('icon-sound');
                if (appState.soundEnabled) {
                    soundIcon.className = 'fa-solid fa-volume-high text-indigo-600 dark:text-indigo-400';
                } else {
                    soundIcon.className = 'fa-solid fa-volume-xmark text-slate-400';
                }
            },

            toggleSound() {
                appState.soundEnabled = !appState.soundEnabled;
                this.saveProgress();
                if (appState.soundEnabled) soundFx.playClick();
            },

            toggleTheme() {
                appState.darkMode = !appState.darkMode;
                this.applyTheme();
                this.saveProgress();
            },

            applyTheme() {
                const html = document.documentElement;
                const themeIcon = document.getElementById('icon-theme');
                if (appState.darkMode) {
                    html.classList.add('dark');
                    html.classList.remove('light');
                    themeIcon.className = 'fa-solid fa-sun text-amber-400';
                } else {
                    html.classList.remove('dark');
                    html.classList.add('light');
                    themeIcon.className = 'fa-solid fa-moon text-slate-600';
                }
            },

            switchTab(tabKey) {
                soundFx.playClick();
                appState.activeTab = tabKey;
                document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
                const target = document.getElementById(`tab-${tabKey}`);
                if (target) target.classList.remove('hidden');

                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.className = 'tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800';
                });
                const activeBtn = document.getElementById(`tab-btn-${tabKey}`);
                if (activeBtn) {
                    activeBtn.className = 'tab-btn flex items-center space-x-2 px-4 py-2.5 rounded-lg font-medium text-sm transition whitespace-nowrap bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 font-semibold';
                }
            },

            speakText(text) {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.rate = 0.9;
                utterance.lang = 'en-US';
                window.speechSynthesis.speak(utterance);
            },

            exercises: {
                gapAnswers: {
                    'gap-a1-1': ['are'],
                    'gap-a1-2': ['going to do'],
                    'gap-a2-1': ['are'],
                    'gap-a2-2': ['going to do'],
                    'gap-a3-1': ['are going to have'],
                    'gap-a4-1': ['are'],
                    'gap-a4-2': ['going to stay'],
                    'gap-ba-1': ['am going to be', "i'm going to be", "im going to be"],
                    'gap-bb-1': ['is going to visit'],
                    'gap-bb-2': ['are going to be'],
                    'gap-bc-1': ['am going to work', "i'm going to work", "im going to work"],
                    'gap-bd-1': ['am going to stay', "i'm going to stay", "im going to stay"]
                },

                checkFillGaps() {
                    let total = Object.keys(this.gapAnswers).length;
                    let correctCount = 0;

                    for (const [id, validList] of Object.entries(this.gapAnswers)) {
                        const inputEl = document.getElementById(id);
                        if (!inputEl) continue;
                        const userVal = inputEl.value.trim().toLowerCase();
                        const isCorrect = validList.some(v => v.toLowerCase() === userVal);

                        if (isCorrect) {
                            correctCount++;
                            inputEl.classList.remove('border-slate-300', 'border-rose-500', 'bg-rose-50');
                            inputEl.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/40');
                        } else {
                            inputEl.classList.remove('border-slate-300', 'border-emerald-500', 'bg-emerald-50');
                            inputEl.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/40');
                        }
                    }

                    const banner = document.getElementById('worksheet-feedback-banner');
                    banner.classList.remove('hidden');

                    if (correctCount === total) {
                        banner.className = "p-4 rounded-xl text-center font-bold text-sm bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300";
                        banner.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Perfect! All ${total} gap-fill responses are 100% correct!`;
                        soundFx.playCorrect();
                        appState.score += 50;
                        appState.streak += 1;
                        app.saveProgress();
                    } else {
                        banner.className = "p-4 rounded-xl text-center font-bold text-sm bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200 border border-amber-300";
                        banner.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-1"></i> You got ${correctCount} out of ${total} correct. Review red boxes and try again!`;
                        soundFx.playWrong();
                    }
                },

                resetFillGaps() {
                    for (const id of Object.keys(this.gapAnswers)) {
                        const inputEl = document.getElementById(id);
                        if (inputEl) {
                            inputEl.value = '';
                            inputEl.className = "w-36 px-2 py-1 mx-1 text-center font-bold text-indigo-600 dark:text-indigo-400 rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none";
                        }
                    }
                    document.getElementById('worksheet-feedback-banner').classList.add('hidden');
                    soundFx.playClick();
                },

                matchingDataColA: [
                    { id: '1', text: '1. What are you going to do tonight? Would you like to go out?' },
                    { id: '2', text: '2. Are you going to do anything on Friday night? Do you want to see a movie?' },
                    { id: '3', text: '3. We are going to have friends over for a barbecue on Sunday. Would you and your parents like to come?' },
                    { id: '4', text: '4. Are you going to stay in town next weekend? Do you want to go for a hike?' }
                ],

                matchingDataColB: [
                    { id: 'a', text: "a. I'm going to be here on Saturday, but not Sunday. Let's try to go on Saturday." },
                    { id: 'b', text: "b. Well, my father is going to visit my brother at college. But my mother and I are going to be home. We'd love to come!" },
                    { id: 'c', text: "c. Sorry, I can't. I'm going to work late tonight. How about tomorrow night?" },
                    { id: 'd', text: "d. Can we go to a late show? I'm going to stay at the office till 7:00." }
                ],

                matchingPairs: { '1': 'c', '2': 'd', '3': 'b', '4': 'a' },
                selectedA: null,
                userMatches: {},

                initMatching() {
                    const containerA = document.getElementById('match-col-a');
                    const containerB = document.getElementById('match-col-b');

                    containerA.innerHTML = this.matchingDataColA.map(item => `
                        <button id="match-a-${item.id}" onclick="app.exercises.selectMatchA('${item.id}')" class="w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-indigo-500 transition shadow-sm font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between group">
                            <span>${item.text}</span>
                            <span id="badge-a-${item.id}" class="text-xs font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-400">Select</span>
                        </button>
                    `).join('');

                    containerB.innerHTML = this.matchingDataColB.map(item => `
                        <button id="match-b-${item.id}" onclick="app.exercises.selectMatchB('${item.id}')" class="w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-purple-500 transition shadow-sm font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between group">
                            <span>${item.text}</span>
                            <span id="badge-b-${item.id}" class="text-xs font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-400">Select</span>
                        </button>
                    `).join('');
                },

                selectMatchA(id) {
                    soundFx.playClick();
                    this.selectedA = id;
                    document.getElementById('matching-status-text').textContent = `Invitation #${id} selected. Now click its response on the right...`;
                    
                    // Highlight selected A card
                    this.matchingDataColA.forEach(item => {
                        const btn = document.getElementById(`match-a-${item.id}`);
                        if (item.id === id) {
                            btn.className = "w-full text-left p-4 rounded-xl border-2 border-indigo-500 bg-indigo-50 dark:bg-indigo-950/40 shadow-md font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between";
                        } else if (!this.userMatches[item.id]) {
                            btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-indigo-500 transition shadow-sm font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between";
                        }
                    });
                },

                selectMatchB(bId) {
                    if (!this.selectedA) {
                        document.getElementById('matching-status-text').textContent = "Please select an Invitation on the left first!";
                        soundFx.playWrong();
                        return;
                    }

                    const aId = this.selectedA;
                    const isCorrect = this.matchingPairs[aId] === bId;

                    if (isCorrect) {
                        soundFx.playCorrect();
                        this.userMatches[aId] = bId;

                        // Style matched cards
                        document.getElementById(`match-a-${aId}`).className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between opacity-90";
                        document.getElementById(`badge-a-${aId}`).className = "text-xs font-bold px-2 py-0.5 rounded bg-emerald-600 text-white";
                        document.getElementById(`badge-a-${aId}`).textContent = `Matched (${bId})`;

                        document.getElementById(`match-b-${bId}`).className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 font-medium text-sm text-slate-800 dark:text-slate-100 flex items-start justify-between opacity-90";
                        document.getElementById(`badge-b-${bId}`).className = "text-xs font-bold px-2 py-0.5 rounded bg-emerald-600 text-white";
                        document.getElementById(`badge-b-${bId}`).textContent = `Matched (#${aId})`;

                        this.selectedA = null;
                        document.getElementById('matching-status-text').textContent = `Great! Invitation #${aId} correctly matched with Response (${bId}).`;

                        appState.score += 25;
                        appState.streak += 1;
                        app.saveProgress();
                    } else {
                        soundFx.playWrong();
                        document.getElementById('matching-status-text').textContent = `Incorrect pair. Invitation #${aId} does not match Response (${bId}). Try again!`;
                    }
                },

                resetMatching() {
                    soundFx.playClick();
                    this.selectedA = null;
                    this.userMatches = {};
                    this.initMatching();
                    document.getElementById('matching-status-text').textContent = "Select an Invitation on the left to start pairing...";
                }
            },

            builder: {
                generateDialogue() {
                    const time = document.getElementById('role-time').value;
                    const activity = document.getElementById('role-activity').value;
                    const style = document.getElementById('role-style').value;
                    const response = document.getElementById('role-response').value;

                    // Line A Construction
                    let formulaPrefix = style === 'would' ? 'Would you like to' : 'Do you want to';
                    let lineA = `What are you going to do ${time}? ${formulaPrefix} ${activity}?`;

                    // Line B Construction
                    let lineB = "";
                    if (response === 'accept') {
                        lineB = `I am going to be free ${time}. I'd love to ${activity}!`;
                    } else if (response === 'decline_work') {
                        lineB = `Sorry, I can't. I am going to work late ${time}. How about another time?`;
                    } else if (response === 'decline_family') {
                        lineB = `Well, my family and I are going to visit relatives ${time}. We'd love to come next time!`;
                    } else if (response === 'decline_office') {
                        lineB = `Sorry, I can't. I am going to stay at the office till 7:00 ${time}.`;
                    }

                    document.getElementById('dialogue-line-a').textContent = lineA;
                    document.getElementById('dialogue-line-b').textContent = lineB;
                },

                playFullConversation() {
                    const lineA = document.getElementById('dialogue-line-a').textContent;
                    const lineB = document.getElementById('dialogue-line-b').textContent;

                    app.speakText(lineA);
                    setTimeout(() => {
                        app.speakText(lineB);
                    }, 3500);
                }
            },

            arcade: {
                scramblePuzzles: [
                    {
                        target: "What are you going to do tonight?",
                        tokens: ["going", "do", "you", "What", "tonight?", "are", "to"]
                    },
                    {
                        target: "We are going to have a barbecue on Sunday.",
                        tokens: ["barbecue", "are", "We", "a", "on", "to", "going", "have", "Sunday."]
                    },
                    {
                        target: "I am going to work late tonight.",
                        tokens: ["tonight.", "work", "going", "am", "I", "late", "to"]
                    },
                    {
                        target: "Are you going to stay in town next weekend?",
                        tokens: ["in", "going", "you", "next", "to", "town", "Are", "stay", "weekend?"]
                    }
                ],
                currentScrambleIndex: 0,
                selectedTokens: [],

                loadScramble(idx) {
                    this.currentScrambleIndex = idx;
                    const p = this.scramblePuzzles[idx];
                    this.selectedTokens = [];

                    document.getElementById('scramble-step-indicator').textContent = `Puzzle ${idx + 1} / ${this.scramblePuzzles.length}`;
                    document.getElementById('scramble-feedback').innerHTML = '';
                    this.renderScrambleTokens();
                },

                renderScrambleTokens() {
                    const p = this.scramblePuzzles[this.currentScrambleIndex];
                    const dropZone = document.getElementById('scramble-drop-zone');
                    const tokenPool = document.getElementById('scramble-token-pool');

                    if (this.selectedTokens.length === 0) {
                        dropZone.innerHTML = `<p id="scramble-placeholder" class="text-sm text-slate-400 italic">Click word tokens below to construct sentence...</p>`;
                    } else {
                        dropZone.innerHTML = this.selectedTokens.map((t, i) => `
                            <button onclick="app.arcade.removeScrambleToken(${i})" class="token-item px-3 py-1.5 bg-purple-600 text-white rounded-lg font-medium text-sm shadow-sm hover:bg-purple-700 transition flex items-center space-x-1">
                                <span>${t}</span>
                                <i class="fa-solid fa-xmark text-xs opacity-70"></i>
                            </button>
                        `).join('');
                    }

                    const remainingPool = p.tokens.filter((tok, poolIdx) => {
                        const usedInSelected = this.selectedTokens.filter(t => t === tok).length;
                        const currentOccurrences = p.tokens.slice(0, poolIdx + 1).filter(t => t === tok).length;
                        return currentOccurrences > usedInSelected;
                    });

                    tokenPool.innerHTML = remainingPool.map(tok => `
                        <button onclick="app.arcade.addScrambleToken('${tok.replace(/'/g, "\\'")}')" class="token-item px-3 py-1.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-purple-500 text-slate-800 dark:text-slate-100 rounded-lg font-medium text-sm shadow-sm transition transform active:scale-95">
                            ${tok}
                        </button>
                    `).join('');
                },

                addScrambleToken(tok) {
                    soundFx.playClick();
                    this.selectedTokens.push(tok);
                    this.renderScrambleTokens();
                },

                removeScrambleToken(index) {
                    soundFx.playClick();
                    this.selectedTokens.splice(index, 1);
                    this.renderScrambleTokens();
                },

                resetCurrentScramble() {
                    soundFx.playClick();
                    this.selectedTokens = [];
                    this.renderScrambleTokens();
                    document.getElementById('scramble-feedback').innerHTML = '';
                },

                verifyScramble() {
                    const p = this.scramblePuzzles[this.currentScrambleIndex];
                    const constructed = this.selectedTokens.join(' ');
                    const fb = document.getElementById('scramble-feedback');

                    if (constructed === p.target) {
                        fb.className = "text-sm font-bold text-emerald-600 dark:text-emerald-400 flex items-center space-x-2";
                        fb.innerHTML = `<i class="fa-solid fa-circle-check text-lg"></i> <span>Correct! Excellent word order.</span>`;
                        soundFx.playCorrect();
                        app.speakText(p.target);
                        appState.score += 30;
                        appState.streak += 1;
                        app.saveProgress();
                    } else {
                        fb.className = "text-sm font-bold text-rose-600 dark:text-rose-400 flex items-center space-x-2";
                        fb.innerHTML = `<i class="fa-solid fa-circle-xmark text-lg"></i> <span>Not quite right. Try reordering tokens.</span>`;
                        soundFx.playWrong();
                    }
                },

                nextScramble() {
                    soundFx.playClick();
                    const nextIdx = (this.currentScrambleIndex + 1) % this.scramblePuzzles.length;
                    this.loadScramble(nextIdx);
                },

                // Arcade Speed Quiz
                quizQuestions: [
                    {
                        question: "Which sentence correctly asks about plans for Friday night?",
                        options: [
                            "Are you going to do anything on Friday night?",
                            "Do you going to do anything on Friday night?",
                            "Will you to do anything on Friday night?",
                            "You are going to do anything on Friday night?"
                        ],
                        correct: 0,
                        explanation: "Yes/No questions with 'be going to' require: Am/Is/Are + Subject + going to + verb."
                    },
                    {
                        question: "How do you invite someone politely using 'would'?",
                        options: [
                            "Would you like to see a movie?",
                            "Would you liking see a movie?",
                            "Would you to go see a movie?",
                            "Do you would like to see a movie?"
                        ],
                        correct: 0,
                        explanation: "The formula is: 'Would you like to + base verb?'"
                    },
                    {
                        question: "Which response politely declines an invitation with a future reason?",
                        options: [
                            "Sorry, I can't. I'm going to work late tonight.",
                            "No, I don't want to go out.",
                            "I am going to work late tomorrow maybe.",
                            "Sorry, I can't because I will stay always."
                        ],
                        correct: 0,
                        explanation: "Polite refusals start with 'Sorry, I can't' followed by a future reason with 'be going to'."
                    },
                    {
                        question: "Complete: 'My father ________ my brother at college on Sunday.'",
                        options: [
                            "is going to visit",
                            "are going to visit",
                            "is going visit",
                            "going to visit"
                        ],
                        correct: 0,
                        explanation: "'My father' is singular (he), so use 'is going to visit'."
                    },
                    {
                        question: "Complete: 'My mother and I ________ home.'",
                        options: [
                            "are going to be",
                            "is going to be",
                            "am going to be",
                            "going to be"
                        ],
                        correct: 0,
                        explanation: "'My mother and I' = We (plural), so use 'are going to be'."
                    }
                ],
                currentQuizIndex: 0,
                quizScore: 0,

                startQuiz() {
                    this.currentQuizIndex = 0;
                    this.quizScore = 0;
                    document.getElementById('quiz-card').classList.remove('hidden');
                    document.getElementById('quiz-results-screen').classList.add('hidden');
                    this.loadQuizQuestion();
                },

                loadQuizQuestion() {
                    if (this.currentQuizIndex >= this.quizQuestions.length) {
                        this.endQuiz();
                        return;
                    }

                    const q = this.quizQuestions[this.currentQuizIndex];
                    document.getElementById('quiz-round-badge').textContent = `Question ${this.currentQuizIndex + 1} / ${this.quizQuestions.length}`;
                    document.getElementById('quiz-question-text').textContent = q.question;
                    document.getElementById('quiz-score').textContent = this.quizScore;
                    document.getElementById('quiz-streak').textContent = `${appState.streak} 🔥`;

                    const pct = (this.currentQuizIndex / this.quizQuestions.length) * 100;
                    document.getElementById('quiz-progress-bar').style.width = `${pct}%`;

                    document.getElementById('quiz-feedback-banner').classList.add('hidden');

                    const grid = document.getElementById('quiz-options-grid');
                    grid.innerHTML = q.options.map((opt, i) => `
                        <button onclick="app.arcade.selectQuizOption(${i})" class="quiz-opt-btn p-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-indigo-500 text-left text-sm font-semibold text-slate-800 dark:text-slate-100 transition flex items-center justify-between group">
                            <span>${opt}</span>
                            <i class="fa-solid fa-arrow-right opacity-0 group-hover:opacity-100 text-indigo-500 transition"></i>
                        </button>
                    `).join('');
                },

                selectQuizOption(index) {
                    const q = this.quizQuestions[this.currentQuizIndex];
                    const isCorrect = index === q.correct;
                    const fb = document.getElementById('quiz-feedback-banner');
                    fb.classList.remove('hidden');

                    document.querySelectorAll('.quiz-opt-btn').forEach(btn => btn.disabled = true);

                    if (isCorrect) {
                        this.quizScore += 50;
                        appState.streak += 1;
                        fb.className = "p-4 rounded-xl text-center font-bold text-sm bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-300";
                        fb.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Correct! ${q.explanation}`;
                        soundFx.playCorrect();
                    } else {
                        appState.streak = 0;
                        fb.className = "p-4 rounded-xl text-center font-bold text-sm bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-300";
                        fb.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> Incorrect. ${q.explanation}`;
                        soundFx.playWrong();
                    }

                    document.getElementById('quiz-score').textContent = this.quizScore;
                    document.getElementById('quiz-streak').textContent = `${appState.streak} 🔥`;

                    setTimeout(() => {
                        this.currentQuizIndex++;
                        this.loadQuizQuestion();
                    }, 2000);
                },

                endQuiz() {
                    document.getElementById('quiz-card').classList.add('hidden');
                    document.getElementById('quiz-results-screen').classList.remove('hidden');

                    document.getElementById('res-quiz-score').textContent = this.quizScore;
                    document.getElementById('res-quiz-accuracy').textContent = `${Math.round((this.quizScore / (this.quizQuestions.length * 50)) * 100)}%`;

                    appState.score += this.quizScore;
                    app.saveProgress();
                }
            }
        };

        window.addEventListener('DOMContentLoaded', () => {
            app.init();
        });
    </script>
</body>
</html>
