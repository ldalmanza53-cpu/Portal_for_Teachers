<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free-Time Activities & Event Planner • ESL Vocabulary Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body { font-family: 'Outfit', sans-serif; }
        .active-tab { background-color: #8b5cf6 !important; color: #ffffff !important; font-weight: 700; }
        .drag-over { border-color: #a855f7 !important; background-color: rgba(168, 85, 247, 0.15) !important; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-slate-800/90 border-b border-slate-700 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-6xl mx-auto px-4 py-3.5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-500 to-fuchsia-500 flex items-center justify-center text-white text-xl shadow-md">
                    <i class="fa-solid fa-ticket"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg text-white leading-tight">Free-Time Activities & Events</h1>
                    <p class="text-[11px] text-slate-400">A1–A2 Interactive Vocabulary Practice</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="bg-slate-900 border border-slate-700 px-3 py-1.5 rounded-xl text-xs flex items-center gap-2">
                    <i class="fa-solid fa-trophy text-amber-400"></i>
                    <span>Score: <strong id="globalScore" class="text-purple-400">0 / 12</strong></span>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="bg-slate-800/50 border-b border-slate-700/60">
        <div class="max-w-6xl mx-auto px-4 flex gap-2 py-2 overflow-x-auto">
            <button onclick="switchTab('exerciseA')" id="tab-exerciseA" class="active-tab px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2">
                <i class="fa-solid fa-layer-group"></i> Part A: Sort Events
            </button>
            <button onclick="switchTab('exerciseB')" id="tab-exerciseB" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2">
                <i class="fa-solid fa-volume-high"></i> Part B: Audio & Practice
            </button>
            <button onclick="switchTab('exerciseC')" id="tab-exerciseC" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2">
                <i class="fa-solid fa-calendar-days"></i> Part C: Weekend Planner
            </button>
        </div>
    </div>

    <!-- Main Container -->
    <main class="flex-grow max-w-6xl w-full mx-auto p-4 md:p-6">

        <!-- SECTION A: EVENT SORTING -->
        <section id="sec-exerciseA" class="space-y-6">
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 flex flex-wrap justify-between items-center gap-4">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-shapes text-purple-400"></i> Section A: Categorize Free-Time Activities
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Select an event card or drag it into the correct category column below.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="resetSectionA()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl text-xs font-bold transition">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                    <button onclick="checkSectionA()" class="px-5 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-bold transition shadow-lg flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i> Check Answers
                    </button>
                </div>
            </div>

            <!-- Unsorted Word Pool -->
            <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 space-y-2">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider"><i class="fa-solid fa-cube"></i> Unsorted Events Pool:</span>
                    <span id="poolCount" class="text-xs font-mono text-purple-400">12 items remaining</span>
                </div>
                <div id="wordPool" class="flex flex-wrap gap-2.5 min-h-[50px]">
                    <!-- Generated via JS -->
                </div>
            </div>

            <!-- Category Columns Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Sports and Games -->
                <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 flex flex-col justify-between space-y-3">
                    <div>
                        <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-3">
                            <i class="fa-solid fa-trophy text-emerald-400 text-lg"></i>
                            <h3 class="font-bold text-sm text-white">Sports and Games</h3>
                        </div>
                        <div id="col-sports" ondragover="allowDrop(event)" ondrop="handleDrop(event, 'sports')" class="bg-slate-900/60 p-3 rounded-xl border-2 border-dashed border-slate-700 min-h-[220px] space-y-2 transition">
                            <!-- Items go here -->
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60 flex gap-2">
                        <input type="text" id="extra-sports" placeholder="+ Add 1 extra idea..." class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-purple-500 flex-grow">
                        <button onclick="addExtra('sports')" class="bg-slate-700 hover:bg-slate-600 text-xs text-white px-3 py-1.5 rounded-lg font-bold">Add</button>
                    </div>
                </div>

                <!-- Friends and Family -->
                <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 flex flex-col justify-between space-y-3">
                    <div>
                        <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-3">
                            <i class="fa-solid fa-users text-amber-400 text-lg"></i>
                            <h3 class="font-bold text-sm text-white">Friends and Family</h3>
                        </div>
                        <div id="col-friends" ondragover="allowDrop(event)" ondrop="handleDrop(event, 'friends')" class="bg-slate-900/60 p-3 rounded-xl border-2 border-dashed border-slate-700 min-h-[220px] space-y-2 transition">
                            <!-- Items go here -->
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60 flex gap-2">
                        <input type="text" id="extra-friends" placeholder="+ Add 1 extra idea..." class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-purple-500 flex-grow">
                        <button onclick="addExtra('friends')" class="bg-slate-700 hover:bg-slate-600 text-xs text-white px-3 py-1.5 rounded-lg font-bold">Add</button>
                    </div>
                </div>

                <!-- Art and Performances -->
                <div class="bg-slate-800 p-4 rounded-2xl border border-slate-700 flex flex-col justify-between space-y-3">
                    <div>
                        <div class="flex items-center gap-2 border-b border-slate-700 pb-2 mb-3">
                            <i class="fa-solid fa-masks-theater text-fuchsia-400 text-lg"></i>
                            <h3 class="font-bold text-sm text-white">Art and Performances</h3>
                        </div>
                        <div id="col-art" ondragover="allowDrop(event)" ondrop="handleDrop(event, 'art')" class="bg-slate-900/60 p-3 rounded-xl border-2 border-dashed border-slate-700 min-h-[220px] space-y-2 transition">
                            <!-- Items go here -->
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-700/60 flex gap-2">
                        <input type="text" id="extra-art" placeholder="+ Add 1 extra idea..." class="bg-slate-900 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white focus:outline-none focus:border-purple-500 flex-grow">
                        <button onclick="addExtra('art')" class="bg-slate-700 hover:bg-slate-600 text-xs text-white px-3 py-1.5 rounded-lg font-bold">Add</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION B: AUDIO & PRACTICE -->
        <section id="sec-exerciseB" class="hidden space-y-6">
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-headphones text-fuchsia-400"></i> Section B: Pronunciation & Dialogue Explorer
                </h2>
                <p class="text-xs text-slate-400 mt-1">Click on any event card below to hear standard American pronunciation and practice future simple dialogue models.</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" id="audioCardGrid">
                <!-- Audio Cards generated via JS -->
            </div>

            <div id="audioDetail" class="bg-slate-800 p-6 rounded-2xl border border-slate-700 text-center space-y-3 min-h-[140px] flex flex-col items-center justify-center">
                <p class="text-xs text-slate-400">Select an event card above to listen and view sentence models!</p>
            </div>
        </section>

        <!-- SECTION C: WEEKEND PLANNER -->
        <section id="sec-exerciseC" class="hidden space-y-6">
            <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-check text-purple-400"></i> Section C: Interactive Weekend Planner
                </h2>
                <p class="text-xs text-slate-400 mt-1">Select activities to build your schedule for the upcoming weekend, then read your future plans aloud.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Activity Picker -->
                <div class="bg-slate-800 p-5 rounded-2xl border border-slate-700 space-y-3">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Choose Activities:</h3>
                    <div class="space-y-1.5" id="plannerPicker">
                        <!-- Choices generated by JS -->
                    </div>
                </div>

                <!-- Schedule Grid -->
                <div class="lg:col-span-2 bg-slate-950 p-6 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                            <span class="text-xs font-bold text-purple-400 uppercase tracking-wider"><i class="fa-solid fa-clock"></i> Your Weekend Timetable</span>
                            <span id="scheduleCount" class="text-xs font-mono text-slate-400">0 events scheduled</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="timetableGrid">
                            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                                <span class="text-[10px] font-bold text-purple-400 uppercase">Friday Evening</span>
                                <select id="time-fri" onchange="updateSchedule()" class="mt-1 w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-slate-200">
                                    <option value="">(No event planned)</option>
                                </select>
                            </div>
                            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                                <span class="text-[10px] font-bold text-purple-400 uppercase">Saturday Morning</span>
                                <select id="time-sat-m" onchange="updateSchedule()" class="mt-1 w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-slate-200">
                                    <option value="">(No event planned)</option>
                                </select>
                            </div>
                            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                                <span class="text-[10px] font-bold text-purple-400 uppercase">Saturday Evening</span>
                                <select id="time-sat-e" onchange="updateSchedule()" class="mt-1 w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-slate-200">
                                    <option value="">(No event planned)</option>
                                </select>
                            </div>
                            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
                                <span class="text-[10px] font-bold text-purple-400 uppercase">Sunday Afternoon</span>
                                <select id="time-sun-a" onchange="updateSchedule()" class="mt-1 w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-xs text-slate-200">
                                    <option value="">(No event planned)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-slate-800 space-y-3">
                        <div id="scheduleSentence" class="bg-slate-900 p-3 rounded-xl border border-slate-800 text-xs text-slate-300 italic">
                            "Select activities in the timetable above to generate your spoken plan!"
                        </div>
                        <button onclick="speakSchedule()" id="btnSpeakSchedule" disabled class="w-full bg-purple-600 hover:bg-purple-500 disabled:bg-slate-800 disabled:text-slate-600 text-white py-3 rounded-xl font-bold text-xs transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-volume-high"></i> Read My Weekend Plan Aloud
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <script>
        // Target Vocabulary Data
        const eventsData = [
            { id: 'e1', phrase: 'a rock concert', cat: 'art', icon: 'fa-guitar' },
            { id: 'e2', phrase: 'a barbecue', cat: 'friends', icon: 'fa-drumstick-bite' },
            { id: 'e3', phrase: 'a wedding', cat: 'friends', icon: 'fa-rings-wedding' },
            { id: 'e4', phrase: 'a hip-hop dance performance', cat: 'art', icon: 'fa-person-dancing' },
            { id: 'e5', phrase: 'a soccer game', cat: 'sports', icon: 'fa-futbol' },
            { id: 'e6', phrase: 'a film festival', cat: 'art', icon: 'fa-film' },
            { id: 'e7', phrase: 'a musical', cat: 'art', icon: 'fa-music' },
            { id: 'e8', phrase: 'a video game tournament', cat: 'sports', icon: 'fa-gamepad' },
            { id: 'e9', phrase: 'a birthday party', cat: 'friends', icon: 'fa-cake-candles' },
            { id: 'e10', phrase: 'a class reunion', cat: 'friends', icon: 'fa-graduation-cap' },
            { id: 'e11', phrase: 'a car race', cat: 'sports', icon: 'fa-car-side' },
            { id: 'e12', phrase: 'a baseball game', cat: 'sports', icon: 'fa-baseball-bat-ball' }
        ];

        let selectedCardId = null;
        let sortedState = {}; // maps event id -> category string

        window.addEventListener('DOMContentLoaded', () => {
            initSectionA();
            renderSectionB();
            renderSectionC();
        });

        // Tab Switcher
        function switchTab(tabId) {
            ['exerciseA', 'exerciseB', 'exerciseC'].forEach(t => {
                document.getElementById(`sec-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).className = 'px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center gap-2';
            });
            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-${tabId}`).className = 'active-tab px-4 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-2';
        }

        // --- SECTION A LOGIC ---
        function initSectionA() {
            sortedState = {};
            const pool = document.getElementById('wordPool');
            pool.innerHTML = '';
            document.getElementById('col-sports').innerHTML = '';
            document.getElementById('col-friends').innerHTML = '';
            document.getElementById('col-art').innerHTML = '';

            eventsData.forEach(item => {
                const badge = createWordBadge(item);
                pool.appendChild(badge);
            });

            updatePoolCount();
            document.getElementById('globalScore').innerText = `0 / ${eventsData.length}`;
        }

        function createWordBadge(item) {
            const el = document.createElement('div');
            el.id = `item-${item.id}`;
            el.draggable = true;
            el.ondragstart = (e) => dragStart(e, item.id);
            el.onclick = () => selectBadge(item.id);
            el.className = 'bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs px-3 py-2 rounded-xl font-medium cursor-pointer flex items-center gap-2 shadow-sm transition active:scale-95 text-slate-200';
            el.innerHTML = `<i class="fa-solid ${item.icon} text-purple-400"></i> ${item.phrase}`;
            return el;
        }

        function selectBadge(id) {
            if (selectedCardId === id) {
                selectedCardId = null;
                document.getElementById(`item-${id}`).classList.remove('ring-2', 'ring-purple-500');
                return;
            }

            if (selectedCardId) {
                const prev = document.getElementById(`item-${selectedCardId}`);
                if (prev) prev.classList.remove('ring-2', 'ring-purple-500');
            }

            selectedCardId = id;
            document.getElementById(`item-${id}`).classList.add('ring-2', 'ring-purple-500');
        }

        function allowDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        function handleDrop(e, cat) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');

            const id = e.dataTransfer ? e.dataTransfer.getData('text/plain') : selectedCardId;
            if (id) moveItemToCategory(id, cat);
        }

        function dragStart(e, id) {
            e.dataTransfer.setData('text/plain', id);
            selectedCardId = id;
        }

        function moveItemToCategory(id, cat) {
            const item = eventsData.find(x => x.id === id);
            if (!item) return;

            sortedState[id] = cat;
            const targetCol = document.getElementById(`col-${cat}`);
            const badge = document.getElementById(`item-${id}`);

            if (badge) {
                badge.classList.remove('ring-2', 'ring-purple-500');
                targetCol.appendChild(badge);
            }

            selectedCardId = null;
            updatePoolCount();
        }

        function updatePoolCount() {
            const count = eventsData.length - Object.keys(sortedState).length;
            document.getElementById('poolCount').innerText = `${count} items remaining in pool`;
        }

        function checkSectionA() {
            let correct = 0;

            eventsData.forEach(item => {
                const badge = document.getElementById(`item-${item.id}`);
                const userCat = sortedState[item.id];

                if (userCat === item.cat) {
                    correct++;
                    if (badge) badge.className = 'bg-emerald-950/80 border border-emerald-500/50 text-emerald-200 text-xs px-3 py-2 rounded-xl font-medium flex items-center gap-2';
                } else if (userCat) {
                    if (badge) badge.className = 'bg-rose-950/80 border border-rose-500/50 text-rose-200 text-xs px-3 py-2 rounded-xl font-medium flex items-center gap-2';
                }
            });

            document.getElementById('globalScore').innerText = `${correct} / ${eventsData.length}`;

            if (correct === eventsData.length) {
                confetti({ particleCount: 80, spread: 80 });
            }
        }

        function resetSectionA() {
            initSectionA();
        }

        function addExtra(cat) {
            const input = document.getElementById(`extra-${cat}`);
            const val = input.value.trim();
            if (!val) return;

            const targetCol = document.getElementById(`col-${cat}`);
            const extraEl = document.createElement('div');
            extraEl.className = 'bg-purple-950/60 border border-purple-500/40 text-purple-200 text-xs px-3 py-2 rounded-xl font-medium flex items-center gap-2';
            extraEl.innerHTML = `<i class="fa-solid fa-plus text-purple-400"></i> ${val} <span class="text-[10px] opacity-70">(Extra Idea)</span>`;
            targetCol.appendChild(extraEl);

            input.value = '';
        }

        // --- SECTION B LOGIC ---
        function renderSectionB() {
            const grid = document.getElementById('audioCardGrid');
            grid.innerHTML = '';

            eventsData.forEach(item => {
                const card = document.createElement('button');
                card.className = 'bg-slate-800 hover:bg-slate-700 border border-slate-700 hover:border-fuchsia-500 p-3.5 rounded-xl text-left flex items-center gap-3 transition group';
                card.onclick = () => showAudioDetail(item);
                card.innerHTML = `
                    <div class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-700 flex items-center justify-center text-fuchsia-400 group-hover:scale-110 transition-transform">
                        <i class="fa-solid ${item.icon}"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-200">${item.phrase}</span>
                `;
                grid.appendChild(card);
            });
        }

        function showAudioDetail(item) {
            const detail = document.getElementById('audioDetail');
            const question = `Are you going to go to ${item.phrase}?`;
            const answer = `Yes, I am going to ${item.phrase} this weekend!`;

            detail.innerHTML = `
                <div class="space-y-3 w-full">
                    <div class="flex items-center justify-center gap-3">
                        <h3 class="text-base font-bold text-fuchsia-400 capitalize">${item.phrase}</h3>
                        <button onclick="speakText('${item.phrase}')" class="text-slate-400 hover:text-amber-400 text-base">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>

                    <div class="bg-slate-900 p-3 rounded-xl border border-slate-800 space-y-1 text-left max-w-md mx-auto text-xs">
                        <p class="text-slate-400"><strong class="text-purple-400">A:</strong> "${question}"</p>
                        <p class="text-slate-200"><strong class="text-emerald-400">B:</strong> "${answer}"</p>
                    </div>
                </div>
            `;

            speakText(item.phrase);
        }

        // --- SECTION C LOGIC ---
        function renderSectionC() {
            const optionsHtml = eventsData.map(e => `<option value="${e.phrase}">${e.phrase}</option>`).join('');

            ['time-fri', 'time-sat-m', 'time-sat-e', 'time-sun-a'].forEach(id => {
                const sel = document.getElementById(id);
                sel.innerHTML = `<option value="">(No event planned)</option>` + optionsHtml;
            });

            const picker = document.getElementById('plannerPicker');
            picker.innerHTML = eventsData.map(e => `
                <div class="p-2 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-300 flex items-center gap-2">
                    <i class="fa-solid ${e.icon} text-purple-400"></i> ${e.phrase}
                </div>
            `).join('');
        }

        function updateSchedule() {
            const fri = document.getElementById('time-fri').value;
            const satM = document.getElementById('time-sat-m').value;
            const satE = document.getElementById('time-sat-e').value;
            const sunA = document.getElementById('time-sun-a').value;

            const plans = [];
            if (fri) plans.push(`On Friday evening, I am going to ${fri}`);
            if (satM) plans.push(`On Saturday morning, I am going to ${satM}`);
            if (satE) plans.push(`On Saturday evening, I am going to ${satE}`);
            if (sunA) plans.push(`On Sunday afternoon, I am going to ${sunA}`);

            const textEl = document.getElementById('scheduleSentence');
            const btn = document.getElementById('btnSpeakSchedule');
            const countEl = document.getElementById('scheduleCount');

            countEl.innerText = `${plans.length} events scheduled`;

            if (plans.length === 0) {
                textEl.innerText = `"Select activities in the timetable above to generate your spoken plan!"`;
                btn.disabled = true;
            } else {
                textEl.innerText = `"${plans.join('. ')}."`;
                btn.disabled = false;
            }
        }

        function speakSchedule() {
            const text = document.getElementById('scheduleSentence').innerText.replace(/"/g, '');
            if (text) speakText(text);
        }

        // Speech Utility
        function speakText(text) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance(text);
                utter.rate = 0.9;
                utter.lang = 'en-US';
                window.speechSynthesis.speak(utter);
            }
        }
