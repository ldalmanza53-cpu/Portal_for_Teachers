                    <span class="px-1.5 py-0.5 bg-slate-100 text-indigo-700 rounded font-extrabold">${item.priceString}</span>
                `;
                pool.appendChild(tag);
            });

            // Render Bins
            ['cheap', 'reasonable', 'ok', 'expensive'].forEach(category => {
                const binContainer = document.getElementById(`items-bin-${category}`);
                binContainer.innerHTML = '';

                sortedBins[category].forEach(item => {
