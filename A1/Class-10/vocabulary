        function renderScaleGame() {
            const pool = document.getElementById('unsorted-pool');
            pool.innerHTML = '';

            unsortedItems.forEach(item => {
                const tag = document.createElement('div');
                tag.draggable = true;
                tag.ondragstart = (e) => e.dataTransfer.setData('text/plain', item.id);
