            e.preventDefault();
            const itemId = e.dataTransfer.getData('text/plain');
            moveItemToBin(itemId, targetCategory);
        }

        function quickAssignItem(itemId) {
            // Prompt student to pick bin if tapped on touch device
            const item = unsortedItems.find(i => i.id === itemId);
            if (!item) return;

            // Target based on item category or default prompt
            moveItemToBin(itemId, item.evaluation);
        }

        function moveItemToBin(itemId, category) {
            const itemIdx = unsortedItems.findIndex(i => i.id === itemId);
            if (itemIdx !== -1) {
                const [item] = unsortedItems.splice(itemIdx, 1);
                sortedBins[category].push(item);
                playSound('correct');
            }
            renderScaleGame();
        }

        function removeFromBin(itemId, category) {
            const itemIdx = sortedBins[category].findIndex(i => i.id === itemId);
            if (itemIdx !== -1) {
                const [item] = sortedBins[category].splice(itemIdx, 1);
                unsortedItems.push(item);
            }
            renderScaleGame();
        }

        function resetScaleGame() {
            initScaleGame();
        }

        function checkScaleGame() {
            let correctCount = 0;
            let total = products.length;

            Object.keys(sortedBins).forEach(category => {
                sortedBins[category].forEach(item => {
                    if (item.evaluation === category) {
                        correctCount++;
                    }
                });
            });

            if (correctCount === total && unsortedItems.length === 0) {
                playSound('correct');
                addStars(20);
                triggerConfetti();
                document.getElementById('celebration-modal').classList.remove('hidden');
            } else {
                playSound('wrong');
                alert(`You categorized ${correctCount} out of ${total} items correctly! Keep refining your price evaluations.`);
            }
        }

        function insertWord(word) {
            const inputs = ['blank-1', 'blank-2', 'blank-3', 'blank-4', 'blank-5'];
            for (let id of inputs) {
                const el = document.getElementById(id);
                if (!el.value) {
                    el.value = word;
                    break;
                }
            }
        }

        function checkFillBlanks() {
            const b1 = document.getElementById('blank-1').value.trim().toLowerCase();
            const b2 = document.getElementById('blank-2').value.trim().toLowerCase();
            const b3 = document.getElementById('blank-3').value.trim().toLowerCase();
            const b4 = document.getElementById('blank-4').value.trim().toLowerCase();
            const b5 = document.getElementById('blank-5').value.trim().toLowerCase();

            const feedback = document.getElementById('fill-feedback');
            feedback.classList.remove('hidden');

            if (b1 === 'these' && b2 === 'which' && b3 === 'ones' && (b4 === "they're" || b4 === "they are") && b5 === 'cheap') {
                feedback.className = "p-3 rounded-xl bg-emerald-100 text-emerald-800 text-xs font-bold block";
                feedback.innerText = "🎉 Perfect! All dialogue blanks are correct (+15 pts)";
                playSound('correct');
                addStars(15);
            } else {
                feedback.className = "p-3 rounded-xl bg-rose-100 text-rose-800 text-xs font-bold block";
                feedback.innerText = "❌ Some answers are incorrect. Hint: 1: these | 2: Which | 3: ones | 4: They're | 5: cheap";
                playSound('wrong');
            }
        }

        const quizData = [
            {
                question: "1. Pink Sunglasses are $5.00. What is your reaction?",
                options: ["That's expensive!", "That's cheap!", "Which ones?"],
                correct: 1
            },
            {
                question: "2. Designer Sunglasses are $120.00. What is your reaction?",
                options: ["That's cheap!", "That's OK.", "That's expensive!"],
                correct: 2
            },
            {
                question: "3. How do we ask about plural items (boots, caps)?",
                options: ["How much is this boots?", "How much are these boots?", "How much boots?"],
                correct: 1
            }
        ];

        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            container.innerHTML = '';

            quizData.forEach((q, idx) => {
                const card = document.createElement('div');
                card.className = "p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-3";

                let optionsHTML = '';
                q.options.forEach((opt, optIdx) => {
                    optionsHTML += `
                        <label class="flex items-center gap-2.5 p-2 bg-white rounded-xl border border-slate-200 cursor-pointer hover:bg-indigo-50 text-xs font-semibold">
                            <input type="radio" name="q-${idx}" value="${optIdx}" class="text-indigo-600 focus:ring-indigo-500">
                            <span>${opt}</span>
                        </label>
                    `;
                });

                card.innerHTML = `
                    <p class="font-bold text-slate-800 text-xs sm:text-sm">${q.question}</p>
                    <div class="space-y-2">${optionsHTML}</div>
                `;
                container.appendChild(card);
            });
        }

        function checkQuizAnswers() {
            let score = 0;
            quizData.forEach((q, idx) => {
                const selected = document.querySelector(`input[name="q-${idx}"]:checked`);
                if (selected && parseInt(selected.value) === q.correct) {
                    score++;
                }
            });

            const feedback = document.getElementById('quiz-feedback');
            feedback.classList.remove('hidden');

            if (score === quizData.length) {
                feedback.className = "p-3 rounded-xl bg-emerald-100 text-emerald-800 text-xs font-bold block";
                feedback.innerText = `🌟 Excellent! You scored ${score}/${quizData.length} (+15 pts)`;
                playSound('correct');
                addStars(15);
            } else {
                feedback.className = "p-3 rounded-xl bg-amber-100 text-amber-800 text-xs font-bold block";
                feedback.innerText = `You scored ${score}/${quizData.length}. Review the prices and try again!`;
                playSound('wrong');
            }
        }

        function generateRandomRoleplay() {
            const prod = products[Math.floor(Math.random() * products.length)];

            document.getElementById('rp-cust-line-1').innerText = `"How much are these ${prod.category}?"`;
            document.getElementById('rp-cust-line-2').innerText = `"The ${prod.color} ones."`;
            document.getElementById('rp-cust-line-3').innerText = `"${prod.opinionText}"`;

            document.getElementById('rp-shop-line-1').innerText = `"Which ones?"`;
            document.getElementById('rp-shop-line-2').innerText = `"They're ${prod.priceString}."`;

            const preview = document.getElementById('roleplay-item-preview');
            preview.innerHTML = `
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12">${prod.svgTag}</div>
                    <div>
                        <p class="font-bold text-sm text-slate-800">${prod.name}</p>
                        <p class="text-xs text-indigo-600 font-bold">${prod.priceString} — Target Reaction: ${prod.opinionText}</p>
                    </div>
                </div>
                <button onclick="speakText('How much are these ${prod.category}? Which ones? The ${prod.color} ones. They are ${prod.price} dollars. ${prod.opinionText}')" class="px-3 py-1.5 bg-purple-600 text-white rounded-xl text-xs font-bold shadow hover:bg-purple-700">
                    <i class="fa-solid fa-play"></i> Play Model
                </button>
            `;

            playSound('chaching');
        }

        function speakRoleplayLine(role) {
            if (role === 'customer') {
                const text1 = document.getElementById('rp-cust-line-1').innerText;
                const text2 = document.getElementById('rp-cust-line-2').innerText;
                const text3 = document.getElementById('rp-cust-line-3').innerText;
                speakText(`${text1} ... ${text2} ... ${text3}`);
            } else {
                const text1 = document.getElementById('rp-shop-line-1').innerText;
                const text2 = document.getElementById('rp-shop-line-2').innerText;
                speakText(`${text1} ... ${text2}`);
            }
        }

        function triggerConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            const particles = [];
            const colors = ['#6366f1', '#ec4899', '#f59e0b', '#10b981', '#8b5cf6'];

            for (let i = 0; i < 50; i++) {
                particles.push({
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.5) * 8 - 2,
                    size: Math.random() * 6 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    life: 100
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;

                particles.forEach(p => {
                    if (p.life > 0) {
                        alive = true;
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += 0.1; // gravity
                        p.life--;

                        ctx.fillStyle = p.color;
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                        ctx.fill();
                    }
                });

                if (alive) {
                    requestAnimationFrame(animate);
                }
            }

            animate();
        }

        function closeCelebrationModal() {
            document.getElementById('celebration-modal').classList.add('hidden');
        }

        window.onload = function() {
            renderStoreInventory();
            initScaleGame();
            renderQuiz();
            generateRandomRoleplay();
        };
    </script>
</body>
</html>
