<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping & Prices - ESL Interactive Store</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Fredoka', 'cursive'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
        .font-display {
            font-family: 'Fredoka', cursive;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .price-tag-hang {
            transform-origin: top center;
            animation: swing 3s ease-in-out infinite alternate;
        }
        @keyframes swing {
            0% { transform: rotate(-3deg); }
            100% { transform: rotate(3deg); }
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 9999px;
        }
        .bounce-subtle {
            animation: bounceSubtle 2s infinite;
        }
        @keyframes bounceSubtle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-4px); }
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <!-- Header Navbar -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <!-- Logo -->
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('store')">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 via-purple-600 to-pink-500 flex items-center justify-center text-white shadow-lg shadow-indigo-200">
                    <i class="fa-solid fa-bag-shopping text-2xl"></i>
                </div>
                <div>
                    <h1 class="font-display text-xl sm:text-2xl font-bold bg-gradient-to-r from-indigo-600 to-pink-600 bg-clip-text text-transparent">
                        SmartShop English
                    </h1>
                    <p class="text-xs text-slate-500 font-medium">Interactive ESL Shopping & Prices</p>
                </div>
            </div>

            <!-- Stats & Sound Controls -->
            <div class="flex items-center gap-3">
                <div class="bg-amber-50 border border-amber-200/80 px-3 py-1.5 rounded-full flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-star text-amber-500 text-lg"></i>
                    <span id="star-count" class="font-bold text-amber-700 text-sm sm:text-base">0</span>
                    <span class="text-xs text-amber-600 font-medium hidden sm:inline">pts</span>
                </div>

                <button id="sound-btn" onclick="toggleAudio()" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-colors">
                    <i id="sound-icon" class="fa-solid fa-volume-high"></i>
                </button>
            </div>
        </div>

        <!-- Tab Navigation Bar -->
        <nav class="bg-slate-50 border-t border-slate-200/60 overflow-x-auto custom-scrollbar">
            <div class="max-w-7xl mx-auto px-4 flex space-x-1 sm:space-x-2 min-w-max">
                <button onclick="switchTab('store')" id="tab-btn-store" class="tab-btn flex items-center gap-2 py-3 px-4 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-indigo-600 text-indigo-600 bg-white shadow-sm">
                    <i class="fa-solid fa-store"></i> 1. Boutique & Dialogues
                </button>
                <button onclick="switchTab('scale')" id="tab-btn-scale" class="tab-btn flex items-center gap-2 py-3 px-4 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-600 hover:text-slate-900">
                    <i class="fa-solid fa-tags"></i> 2. Price Scale Game
                </button>
                <button onclick="switchTab('exercises')" id="tab-btn-exercises" class="tab-btn flex items-center gap-2 py-3 px-4 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-600 hover:text-slate-900">
                    <i class="fa-solid fa-pen-to-square"></i> 3. Exercises & Quiz
                </button>
                <button onclick="switchTab('roleplay')" id="tab-btn-roleplay" class="tab-btn flex items-center gap-2 py-3 px-4 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-600 hover:text-slate-900">
                    <i class="fa-solid fa-comments"></i> 4. Partner Roleplay
                </button>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex-1 w-full">

        <!-- TAB 1: BOUTIQUE STORE & DIALOGUE -->
        <div id="tab-store" class="tab-content block space-y-8">
            <!-- Intro Banner -->
            <div class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-white/20 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full backdrop-blur-md">Unit 4: Shopping</span>
                    <h2 class="font-display text-2xl sm:text-4xl font-bold mt-2 mb-2">Asking About Prices</h2>
                    <p class="text-indigo-100 text-sm sm:text-base leading-relaxed">
                        Click on any product or price tag in the store to practice asking <span class="underline underline-offset-4 decoration-amber-300 font-semibold">"How much are these...?"</span> and giving opinions on prices!
                    </p>
                </div>
                <!-- Decorative Circles -->
                <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
            </div>

            <!-- Main Interactive Store Grid & Dialogue Deck -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Left Column: Product Showcase -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="flex items-center justify-between">
                        <h3 class="font-display text-xl font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-shirt text-indigo-600"></i> Store Inventory
                        </h3>
                        <span class="text-xs text-slate-500 font-medium">Click an item to inspect</span>
                    </div>

                    <!-- Products Grid (6 Items matching lesson) -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4" id="store-products-grid">
                        <!-- Product items injected by JS -->
                    </div>

                    <!-- Expression Helper Bar -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                            <i class="fa-solid fa-lightbulb text-amber-500"></i> Useful Expressions Checklist
                        </h4>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button onclick="speakText('That\'s cheap!')" class="p-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-semibold flex items-center justify-between group transition">
                                <span>That's cheap!</span>
                                <i class="fa-solid fa-volume-low text-emerald-500 group-hover:scale-110 transition"></i>
                            </button>
                            <button onclick="speakText('That\'s reasonable.')" class="p-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-800 text-xs sm:text-sm font-semibold flex items-center justify-between group transition">
                                <span>That's reasonable.</span>
                                <i class="fa-solid fa-volume-low text-amber-500 group-hover:scale-110 transition"></i>
                            </button>
                            <button onclick="speakText('That\'s OK, or not bad.')" class="p-2.5 rounded-xl bg-orange-50 hover:bg-orange-100 border border-orange-200 text-orange-800 text-xs sm:text-sm font-semibold flex items-center justify-between group transition">
                                <span>That's OK / not bad.</span>
                                <i class="fa-solid fa-volume-low text-orange-500 group-hover:scale-110 transition"></i>
                            </button>
                            <button onclick="speakText('That\'s expensive!')" class="p-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold flex items-center justify-between group transition">
                                <span>That's expensive!</span>
                                <i class="fa-solid fa-volume-low text-rose-500 group-hover:scale-110 transition"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Interactive Dialogue Builder -->
                <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-200/80 p-6 shadow-lg sticky top-28 space-y-6">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div>
                            <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Practice Dialogue</span>
                            <h3 id="active-item-title" class="font-display text-xl font-bold text-slate-800">Brown Boots</h3>
                        </div>
                        <!-- Speed Control Toggle -->
                        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl">
                            <button id="speed-normal" onclick="setSpeed(1.0)" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-white text-indigo-600 shadow-sm">🐇 1.0x</button>
                            <button id="speed-slow" onclick="setSpeed(0.75)" class="px-2.5 py-1 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900">🐢 0.75x</button>
                        </div>
                    </div>

                    <!-- Chat Bubbles Area -->
                    <div id="dialogue-container" class="space-y-4 min-h-[320px] flex flex-col justify-center">
                        <!-- Populated dynamically by JS -->
                    </div>

                    <!-- Audio Controls & Grammar Notes -->
                    <div class="pt-2 border-t border-slate-100 space-y-3">
                        <button onclick="playFullDialogue()" class="w-full py-3.5 px-4 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold rounded-2xl shadow-md hover:shadow-indigo-200 transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-circle-play text-lg"></i> Listen to Full Conversation
                        </button>

                        <div class="bg-indigo-50/70 p-3.5 rounded-2xl border border-indigo-100 text-xs text-indigo-900 space-y-1">
                            <p class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-graduation-cap text-indigo-600"></i> Grammar Tip:</p>
                            <p>We use <strong class="text-indigo-700">these</strong> for plural items (boots, caps, sunglasses). Use <strong class="text-indigo-700">ones</strong> to avoid repeating the noun: <em>"The brown ones"</em>.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: PRICE SCALE & SORTING GAME -->
        <div id="tab-scale" class="tab-content hidden space-y-8">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-6">
                <div class="max-w-2xl">
                    <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">Interactive Sorting Game</span>
                    <h2 class="font-display text-2xl sm:text-3xl font-bold text-slate-800">Price Spectrum & Evaluation</h2>
                    <p class="text-slate-600 text-sm mt-1">Categorize each item based on its price tag into the correct opinion category ($ cheap to $$$$ expensive)!</p>
                </div>

                <!-- Price Scale Legend Visualizer -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                    <div class="p-3 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-xl">
                        <span class="text-xs font-bold text-emerald-600 uppercase">🟢 Cheap</span>
                        <p class="text-sm font-bold text-emerald-900">$1.00 – $10.00</p>
                        <p class="text-xs text-emerald-700 italic">"That's cheap!"</p>
                    </div>
                    <div class="p-3 bg-amber-50 border-l-4 border-amber-500 rounded-r-xl">
                        <span class="text-xs font-bold text-amber-600 uppercase">🟡 Reasonable</span>
                        <p class="text-sm font-bold text-amber-900">$10.01 – $30.00</p>
                        <p class="text-xs text-amber-700 italic">"That's reasonable."</p>
                    </div>
                    <div class="p-3 bg-orange-50 border-l-4 border-orange-500 rounded-r-xl">
                        <span class="text-xs font-bold text-orange-600 uppercase">🟠 OK / Not Bad</span>
                        <p class="text-sm font-bold text-orange-900">$30.01 – $60.00</p>
                        <p class="text-xs text-orange-700 italic">"That's OK/not bad."</p>
                    </div>
                    <div class="p-3 bg-rose-50 border-l-4 border-rose-500 rounded-r-xl">
                        <span class="text-xs font-bold text-rose-600 uppercase">🔴 Expensive</span>
                        <p class="text-sm font-bold text-rose-900">$60.01+</p>
                        <p class="text-xs text-rose-700 italic">"That's expensive!"</p>
                    </div>
                </div>

                <!-- Unsorted Items Pool -->
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center justify-between">
                        <span>Items to Categorize (Click or Drag into Category Bins)</span>
                        <button onclick="resetScaleGame()" class="text-indigo-600 text-xs font-bold hover:underline"><i class="fa-solid fa-rotate-right"></i> Reset</button>
                    </h4>
                    <div id="unsorted-pool" class="flex flex-wrap gap-3 min-h-[70px] items-center">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- Category Drop Targets Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Bin 1: Cheap -->
                    <div ondragover="allowDrop(event)" ondrop="handleDrop(event, 'cheap')" id="bin-cheap" class="bg-emerald-50/50 border-2 border-dashed border-emerald-300 rounded-2xl p-4 min-h-[180px] flex flex-col justify-between transition hover:bg-emerald-50">
                        <div class="flex items-center justify-between border-b border-emerald-200 pb-2 mb-2">
                            <span class="font-bold text-emerald-800 text-sm">🟢 That's cheap.</span>
                            <i class="fa-solid fa-piggy-bank text-emerald-500"></i>
                        </div>
                        <div id="items-bin-cheap" class="space-y-2 flex-1"></div>
                    </div>

                    <!-- Bin 2: Reasonable -->
                    <div ondragover="allowDrop(event)" ondrop="handleDrop(event, 'reasonable')" id="bin-reasonable" class="bg-amber-50/50 border-2 border-dashed border-amber-300 rounded-2xl p-4 min-h-[180px] flex flex-col justify-between transition hover:bg-amber-50">
                        <div class="flex items-center justify-between border-b border-amber-200 pb-2 mb-2">
                            <span class="font-bold text-amber-800 text-sm">🟡 That's reasonable.</span>
                            <i class="fa-solid fa-scale-balanced text-amber-500"></i>
                        </div>
                        <div id="items-bin-reasonable" class="space-y-2 flex-1"></div>
                    </div>

                    <!-- Bin 3: OK/Not Bad -->
                    <div ondragover="allowDrop(event)" ondrop="handleDrop(event, 'ok')" id="bin-ok" class="bg-orange-50/50 border-2 border-dashed border-orange-300 rounded-2xl p-4 min-h-[180px] flex flex-col justify-between transition hover:bg-orange-50">
                        <div class="flex items-center justify-between border-b border-orange-200 pb-2 mb-2">
                            <span class="font-bold text-orange-800 text-sm">🟠 That's OK/not bad.</span>
                            <i class="fa-solid fa-thumbs-up text-orange-500"></i>
                        </div>
                        <div id="items-bin-ok" class="space-y-2 flex-1"></div>
                    </div>

                    <!-- Bin 4: Expensive -->
                    <div ondragover="allowDrop(event)" ondrop="handleDrop(event, 'expensive')" id="bin-expensive" class="bg-rose-50/50 border-2 border-dashed border-rose-300 rounded-2xl p-4 min-h-[180px] flex flex-col justify-between transition hover:bg-rose-50">
                        <div class="flex items-center justify-between border-b border-rose-200 pb-2 mb-2">
                            <span class="font-bold text-rose-800 text-sm">🔴 That's expensive!</span>
                            <i class="fa-solid fa-gem text-rose-500"></i>
                        </div>
                        <div id="items-bin-expensive" class="space-y-2 flex-1"></div>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex justify-end pt-2">
                    <button onclick="checkScaleGame()" class="py-3 px-8 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-lg transition flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i> Check Answers
                    </button>
                </div>
            </div>
        </div>

        <!-- TAB 3: EXERCISES & QUIZ -->
        <div id="tab-exercises" class="tab-content hidden space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Part 1: Fill in the Dialogue -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-md space-y-5">
                    <div>
                        <span class="text-xs font-bold text-indigo-600 uppercase tracking-wider">Part A: Grammar Practice</span>
                        <h3 class="font-display text-xl font-bold text-slate-800">Complete the Dialogue</h3>
                        <p class="text-xs text-slate-500 mt-1">Select the correct word from the word bank to fill in the blanks.</p>
                    </div>

                    <!-- Word Bank -->
                    <div class="bg-slate-50 p-3.5 rounded-2xl border border-slate-200">
                        <span class="text-xs font-bold text-slate-400 block mb-2 uppercase">Word Bank:</span>
                        <div class="flex flex-wrap gap-2" id="word-bank-container">
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('these')">these</span>
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('Which')">Which</span>
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('ones')">ones</span>
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('cheap')">cheap</span>
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('expensive')">expensive</span>
                            <span class="px-3 py-1 bg-white border border-slate-300 rounded-lg text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-indigo-50 hover:border-indigo-300" onclick="insertWord('They\'re')">They're</span>
                        </div>
                    </div>

                    <!-- Dialogue Fill-in Form -->
                    <div class="space-y-3 text-sm leading-relaxed">
                        <div class="p-3 rounded-xl bg-slate-50 flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-indigo-600">A:</span>
                            <span>How much are</span>
                            <input type="text" id="blank-1" class="w-24 px-2.5 py-1 text-center font-bold text-indigo-700 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="______">
                            <span>sunglasses?</span>
                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-purple-600">B:</span>
                            <input type="text" id="blank-2" class="w-24 px-2.5 py-1 text-center font-bold text-purple-700 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="______">
                            <span>ones?</span>
                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-indigo-600">A:</span>
                            <span>The pink</span>
                            <input type="text" id="blank-3" class="w-24 px-2.5 py-1 text-center font-bold text-indigo-700 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="______">
                            <span>.</span>
                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-purple-600">B:</span>
                            <input type="text" id="blank-4" class="w-24 px-2.5 py-1 text-center font-bold text-purple-700 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500" placeholder="______">
                            <span>$5.00.</span>
                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 flex items-center gap-2 flex-wrap">
                            <span class="font-bold text-indigo-600">A:</span>
                            <span>That's</span>
                            <input type="text" id="blank-5" class="w-28 px-2.5 py-1 text-center font-bold text-indigo-700 bg-white border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="______">
                            <span>!</span>
                        </div>
                    </div>

                    <div id="fill-feedback" class="hidden p-3 rounded-xl text-xs font-bold"></div>

                    <button onclick="checkFillBlanks()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-md transition">
                        Check Dialogue Answers
                    </button>
                </div>

                <!-- Part 2: Multiple Choice Price Quiz -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-md space-y-5">
                    <div>
                        <span class="text-xs font-bold text-pink-600 uppercase tracking-wider">Part B: Price Reactions</span>
                        <h3 class="font-display text-xl font-bold text-slate-800">Select the Best Reaction</h3>
                        <p class="text-xs text-slate-500 mt-1">Read the price and choose the standard natural English response.</p>
                    </div>

                    <div id="quiz-container" class="space-y-4">
                        <!-- Quiz questions rendered dynamically -->
                    </div>

                    <div id="quiz-feedback" class="hidden p-3 rounded-xl text-xs font-bold"></div>

                    <button onclick="checkQuizAnswers()" class="w-full py-3 bg-pink-600 hover:bg-pink-700 text-white font-bold rounded-2xl shadow-md transition">
                        Submit Quiz
                    </button>
                </div>
            </div>
        </div>

        <!-- TAB 4: PARTNER ROLEPLAY -->
        <div id="tab-roleplay" class="tab-content hidden space-y-8">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-6">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
