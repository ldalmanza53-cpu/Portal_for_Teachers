<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EFL Vocabulary Master - Class 22 (A1): Family & Relationships</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Strict Invisible Scrollbars Globally */
    *::-webkit-scrollbar { display: none !important; }
    * { -ms-overflow-style: none; scrollbar-width: none; }

    /* 3D Card Flip Perspective & Styles */
    .perspective { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
    .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased select-none flex flex-col">

  <!-- TOP COMPACT HEADER & SCOREBOARD -->
  <header class="bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center justify-between shrink-0 shadow-lg">
    <div class="flex items-center space-x-3">
      <span class="bg-amber-500 text-slate-950 text-xs font-black px-2 py-1 rounded tracking-wider uppercase">Class 22 • A1</span>
      <h1 class="text-base font-bold text-slate-100 hidden sm:inline">Family & Relationships Lexicon</h1>
    </div>

    <!-- TEAM SCOREBOARD -->
    <div class="flex items-center space-x-6 bg-slate-950 px-4 py-1.5 rounded-full border border-slate-800">
      <!-- Red Team -->
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
        <span class="text-xs font-bold text-rose-400 uppercase tracking-wide">Red</span>
        <button onclick="adjustScore('red', -1)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center text-xs">-</button>
        <span id="score-red" class="text-lg font-black text-rose-400 min-w-[24px] text-center">0</span>
        <button onclick="adjustScore('red', 1)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center text-xs">+</button>
      </div>
      <div class="h-4 w-px bg-slate-800"></div>
      <!-- Blue Team -->
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-sky-500 inline-block"></span>
        <span class="text-xs font-bold text-sky-400 uppercase tracking-wide">Blue</span>
        <button onclick="adjustScore('blue', -1)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center text-xs">-</button>
        <span id="score-blue" class="text-lg font-black text-sky-400 min-w-[24px] text-center">0</span>
        <button onclick="adjustScore('blue', 1)" class="w-6 h-6 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center text-xs">+</button>
      </div>
    </div>

    <!-- TEACHER PANEL TOGGLE -->
    <button onclick="toggleTeacherPanel()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors flex items-center space-x-1">
      <span>⚙️ Edit Panel</span>
    </button>
  </header>

  <!-- SLEEK HORIZONTAL NAVIGATION (SINGLE LINE, NO WRAP) -->
  <nav class="bg-slate-900/90 border-b border-slate-800 px-3 py-2 shrink-0">
    <div class="flex flex-row items-center whitespace-nowrap overflow-x-auto space-x-2 text-sm font-medium">
      <button id="nav-btn-1" onclick="switchTab(1)" class="tab-btn active bg-indigo-600 text-white px-4 py-2 rounded-lg font-bold transition-all shadow">1. Flashcards</button>
      <button id="nav-btn-2" onclick="switchTab(2)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">2. Match Meaning</button>
      <button id="nav-btn-3" onclick="switchTab(3)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">3. Collocations</button>
      <button id="nav-btn-4" onclick="switchTab(4)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">4. Context Cloze</button>
      <button id="nav-btn-5" onclick="switchTab(5)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">5. Taboo Game</button>
      <button id="nav-btn-6" onclick="switchTab(6)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">6. Odd One Out</button>
      <button id="nav-btn-7" onclick="switchTab(7)" class="tab-btn bg-slate-800 hover:bg-slate-700 text-slate-300 px-4 py-2 rounded-lg font-bold transition-all">7. Discussions</button>
    </div>
  </nav>

  <!-- MAIN CONTENT CONTAINER (FULL WIDTH ACTIVE SLOT) -->
  <main class="flex-1 overflow-y-auto p-4 md:p-6 pb-32">

    <!-- COMMON ERROR / FALSE FRIEND BANNER (IMMERSIVE ENGLISH ONLY) -->
    <div class="mb-6 bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 flex items-start space-x-3">
      <span class="text-2xl">⚠️</span>
      <div>
        <h4 class="text-amber-400 font-bold text-sm uppercase tracking-wide">Common Learner Warning & Cognate Alert</h4>
        <p class="text-slate-300 text-xs md:text-sm mt-0.5">
          <strong class="text-amber-300">Parents vs. Relatives:</strong> "Parents" strictly means your <em>mother and father</em>. Do NOT use it for uncles, aunts, or cousins! For your wider extended family, always use the word <strong>"Relatives"</strong>.
        </p>
      </div>
    </div>

    <!-- SECTION 1: DICTIONARY & FLASHCARDS (DEFAULT ACTIVE) -->
    <section id="section-1" class="activity-section block">
      <div class="max-w-4xl mx-auto flex flex-col items-center">
        <!-- Progress Counter -->
        <div class="mb-3 text-slate-400 font-semibold text-sm">
          Card <span id="card-current-index">1</span> of <span id="card-total-count">12</span>
        </div>

        <!-- 3D Flashcard Container -->
        <div class="w-full max-w-2xl h-[420px] perspective cursor-pointer" onclick="flipCard()">
          <div id="flashcard" class="relative w-full h-full transform-style-3d rounded-2xl shadow-2xl bg-slate-900 border-2 border-indigo-500/40 p-6 flex flex-col justify-between">
            
            <!-- FRONT OF CARD -->
            <div class="absolute inset-0 backface-hidden p-8 flex flex-col items-center justify-center bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 rounded-2xl border-2 border-indigo-500/30 text-center">
              <span class="text-xs uppercase font-bold tracking-widest text-indigo-400 mb-4">Base Form</span>
              <h2 id="card-word-front" class="text-6xl md:text-7xl font-black text-white tracking-tight mb-4">Parents</h2>
              <span id="card-phonetic-front" class="text-xl text-slate-400 font-mono mb-8">/ˈpeərənts/</span>
              
              <button onclick="event.stopPropagation(); speakCurrentWord()" class="bg-indigo-600/80 hover:bg-indigo-600 text-white px-5 py-2.5 rounded-full flex items-center space-x-2 text-sm font-semibold transition-transform active:scale-95 shadow-lg">
                <span>🔊 Pronounce</span>
              </button>
              <p class="text-xs text-slate-500 mt-8">Click card to reveal details & variations 🔄</p>
            </div>

            <!-- BACK OF CARD -->
            <div class="absolute inset-0 backface-hidden rotate-y-180 p-6 md:p-8 flex flex-col justify-between bg-slate-900 rounded-2xl border-2 border-indigo-500/50 overflow-y-auto">
              <div>
                <div class="flex justify-between items-start mb-3 border-b border-slate-800 pb-2">
                  <h3 id="card-word-back" class="text-3xl font-black text-indigo-300">Parents</h3>
                  <span id="card-type" class="text-xs font-semibold px-2.5 py-1 bg-indigo-950 text-indigo-300 border border-indigo-800 rounded-full">Noun</span>
                </div>

                <div class="space-y-3 text-left">
                  <div>
                    <h4 class="text-xs uppercase tracking-wider text-slate-400 font-bold">Definition</h4>
                    <p id="card-definition" class="text-slate-200 text-base font-medium">A mother and a father.</p>
                  </div>

                  <div>
                    <h4 class="text-xs uppercase tracking-wider text-indigo-400 font-bold">Morphological Variations</h4>
                    <p id="card-morphology" class="text-indigo-200 text-sm font-mono">Singular: parent | Plural: parents</p>
                  </div>

                  <div>
                    <h4 class="text-xs uppercase tracking-wider text-emerald-400 font-bold">Essential Collocations</h4>
                    <p id="card-collocations" class="text-emerald-200 text-sm font-medium">loving parents, single parent, elderly parents</p>
                  </div>

                  <div>
                    <h4 class="text-xs uppercase tracking-wider text-amber-400 font-bold">Example Sentences</h4>
                    <ul id="card-examples" class="text-slate-300 text-sm space-y-1 list-disc list-inside">
                      <li>My parents live in a quiet house near the park.</li>
                      <li>She calls her parents every Sunday evening.</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400">
                <span>Click to flip back</span>
                <button onclick="event.stopPropagation(); speakCurrentWord()" class="text-indigo-400 hover:text-indigo-300 font-bold flex items-center space-x-1">
                  <span>🔊 Listen</span>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- Carousel Controls -->
        <div class="flex items-center space-x-4 mt-6">
          <button onclick="prevCard()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-3 rounded-xl transition-all shadow active:scale-95">← Previous</button>
          <button onclick="flipCard()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-3 rounded-xl transition-all shadow active:scale-95">Flip Card 🔄</button>
          <button onclick="nextCard()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-3 rounded-xl transition-all shadow active:scale-95">Next →</button>
        </div>
      </div>
    </section>

    <!-- SECTION 2: MATCH THE MEANING -->
    <section id="section-2" class="activity-section hidden">
      <div class="max-w-5xl mx-auto">
        <div class="mb-4 text-center">
          <h2 class="text-2xl font-bold text-white">Match the Target Vocabulary to Definitions</h2>
          <p class="text-slate-400 text-sm">Click a word on the left, then click its corresponding meaning on the right.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-h-[60vh] overflow-y-auto p-2">
          <!-- Words Column -->
          <div id="match-words-container" class="space-y-3"></div>
          <!-- Definitions Column -->
          <div id="match-defs-container" class="space-y-3"></div>
        </div>

        <div class="mt-6 flex justify-center">
          <button onclick="initMatchGame()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-6 py-2.5 rounded-xl shadow transition-all">Reset Matching Game</button>
        </div>
      </div>
    </section>

    <!-- SECTION 3: COLLOCATION BUILDER -->
    <section id="section-3" class="activity-section hidden">
      <div class="max-w-5xl mx-auto">
        <div class="mb-4 text-center">
          <h2 class="text-2xl font-bold text-white">Collocation & Category Sorting</h2>
          <p class="text-slate-400 text-sm">Sort each target vocabulary phrase into its correct category box.</p>
        </div>

        <!-- Source Bank -->
        <div id="collocation-bank" class="flex flex-wrap gap-2.5 justify-center bg-slate-900 p-4 rounded-xl border border-slate-800 mb-6 min-h-[70px]"></div>

        <!-- Drop Categories -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Bucket 1 -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col min-h-[220px]">
            <h3 class="font-bold text-indigo-400 text-center mb-3 border-b border-slate-800 pb-2">Relationship Verbs</h3>
            <div id="bucket-verbs" onclick="placeInBucket('verbs')" class="flex-1 space-y-2 cursor-pointer bg-slate-950/50 p-2 rounded-lg border border-dashed border-slate-800 hover:border-indigo-500/50 transition-colors"></div>
          </div>
          <!-- Bucket 2 -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col min-h-[220px]">
            <h3 class="font-bold text-emerald-400 text-center mb-3 border-b border-slate-800 pb-2">Immediate Family Nouns</h3>
            <div id="bucket-immediate" onclick="placeInBucket('immediate')" class="flex-1 space-y-2 cursor-pointer bg-slate-950/50 p-2 rounded-lg border border-dashed border-slate-800 hover:border-emerald-500/50 transition-colors"></div>
          </div>
          <!-- Bucket 3 -->
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col min-h-[220px]">
            <h3 class="font-bold text-amber-400 text-center mb-3 border-b border-slate-800 pb-2">Extended & In-Law Family</h3>
            <div id="bucket-extended" onclick="placeInBucket('extended')" class="flex-1 space-y-2 cursor-pointer bg-slate-950/50 p-2 rounded-lg border border-dashed border-slate-800 hover:border-amber-500/50 transition-colors"></div>
          </div>
        </div>

        <div class="mt-6 flex justify-center space-x-4">
          <button onclick="checkCollocations()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-2.5 rounded-xl shadow transition-all">Check Answers</button>
          <button onclick="initCollocationGame()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold px-6 py-2.5 rounded-xl shadow transition-all">Reset Sorting</button>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CONTEXTUAL CLOZE (STRICT TYPED INPUT & ERROR EXPLANATION) -->
    <section id="section-4" class="activity-section hidden">
      <div class="max-w-4xl mx-auto">
        <div class="mb-4 text-center">
          <h2 class="text-2xl font-bold text-white">Contextual Memory Recall (Fill in the Blank)</h2>
          <p class="text-slate-400 text-sm">Read the sentence and type the target word from memory. No multiple choice provided!</p>
        </div>

        <!-- Scrollable Exercises List -->
        <div id="cloze-list" class="space-y-6 max-h-[60vh] overflow-y-auto pr-2"></div>

        <div class="mt-6 flex justify-center">
          <button onclick="checkAllClozeAnswers()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-3 rounded-xl shadow transition-all">Check All Responses</button>
        </div>
      </div>
    </section>

    <!-- SECTION 5: THE TABOO GAME (60s TIMER) -->
    <section id="section-5" class="activity-section hidden">
      <div class="max-w-3xl mx-auto flex flex-col items-center">
        <!-- Timer Header -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 w-full mb-6 flex items-center justify-between shadow-xl">
          <div class="flex items-center space-x-3">
            <span class="text-3xl">⏱️</span>
            <div>
              <span class="text-xs uppercase font-bold text-slate-400">Countdown Timer</span>
              <div id="taboo-timer-display" class="text-4xl font-black text-amber-400 font-mono">01:00</div>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button id="taboo-start-btn" onclick="startTabooTimer()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-lg text-sm transition-all">Start</button>
            <button onclick="pauseTabooTimer()" class="bg-amber-600 hover:bg-amber-500 text-white font-bold px-4 py-2 rounded-lg text-sm transition-all">Pause</button>
            <button onclick="resetTabooTimer()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold px-4 py-2 rounded-lg text-sm transition-all">Reset</button>
          </div>
        </div>

        <!-- Taboo Card Display -->
        <div class="w-full bg-slate-900 border-2 border-rose-500/40 rounded-2xl p-8 text-center shadow-2xl relative overflow-hidden">
          <div class="absolute top-3 right-3 bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-bold px-3 py-1 rounded-full uppercase">Speaking Challenge</div>
          
          <h2 id="taboo-target-word" class="text-5xl md:text-6xl font-black text-white mb-6 tracking-tight">Parents</h2>

          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-6 max-w-md mx-auto">
            <h4 class="text-xs uppercase font-bold text-rose-400 tracking-widest mb-4">Forbidden Words (Do NOT Say!)</h4>
            <ul id="taboo-forbidden-list" class="space-y-3 text-xl font-bold text-slate-300">
              <li class="bg-slate-900 py-2 rounded-lg border border-slate-800">1. Mother</li>
              <li class="bg-slate-900 py-2 rounded-lg border border-slate-800">2. Father</li>
              <li class="bg-slate-900 py-2 rounded-lg border border-slate-800">3. Family</li>
            </ul>
          </div>
        </div>

        <!-- Controls -->
        <div class="mt-6 flex space-x-4">
          <button onclick="prevTabooCard()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-2.5 rounded-xl transition-all">← Previous Card</button>
          <button onclick="nextTabooCard()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-6 py-2.5 rounded-xl transition-all">Next Card →</button>
        </div>
      </div>
    </section>

    <!-- SECTION 6: ODD ONE OUT -->
    <section id="section-6" class="activity-section hidden">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6 text-center">
          <h2 class="text-2xl font-bold text-white">Odd One Out</h2>
          <p class="text-slate-400 text-sm">Identify the item that does not belong in the set and explain your reason orally.</p>
        </div>

        <div id="odd-sets-container" class="space-y-6 max-h-[60vh] overflow-y-auto pr-2"></div>
      </div>
    </section>

    <!-- SECTION 7: REAL-LIFE CONVERSATION QUESTIONS -->
    <section id="section-7" class="activity-section hidden">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6 text-center">
          <h2 class="text-2xl font-bold text-white">Classroom Discussion Prompts</h2>
          <p class="text-slate-400 text-sm">Project these open-ended questions to stimulate natural target language usage.</p>
        </div>

        <div id="questions-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[60vh] overflow-y-auto p-1"></div>

        <div class="mt-6 flex justify-center space-x-4">
          <button onclick="speakRandomQuestion()" class="bg-amber-600 hover:bg-amber-500 text-white font-bold px-6 py-2.5 rounded-xl shadow transition-all">🎲 Pick Random & Read Aloud</button>
        </div>
      </div>
    </section>

  </main>

  <!-- TEACHER LIVE-EDIT PANEL (OFF-CANVAS DRAWER) -->
  <div id="teacher-drawer" class="fixed inset-y-0 right-0 w-80 md:w-96 bg-slate-900 border-l border-slate-800 shadow-2xl p-6 transform translate-x-full transition-transform duration-300 z-50 overflow-y-auto">
    <div class="flex items-center justify-between mb-6 border-b border-slate-800 pb-3">
      <h3 class="text-lg font-bold text-white flex items-center space-x-2">
        <span>⚙️ Teacher Live Edit</span>
      </h3>
      <button onclick="toggleTeacherPanel()" class="text-slate-400 hover:text-white font-bold text-xl">✕</button>
    </div>

    <div class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-slate-300 mb-1">Target Word / Phrase</label>
        <input id="edit-word" type="text" placeholder="e.g. Twins" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
      </div>
      <div>
        <label class="block font-bold text-slate-300 mb-1">Phonetic Transcription</label>
        <input id="edit-phonetic" type="text" placeholder="e.g. /twɪnz/" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
      </div>
      <div>
        <label class="block font-bold text-slate-300 mb-1">Definition</label>
        <textarea id="edit-def" rows="2" placeholder="Short English definition" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white"></textarea>
      </div>
      <div>
        <label class="block font-bold text-slate-300 mb-1">Collocations (comma separated)</label>
        <input id="edit-collocations" type="text" placeholder="identical twins, twin brothers" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
      </div>
      <div>
        <label class="block font-bold text-slate-300 mb-1">Example Sentences (one per line)</label>
        <textarea id="edit-examples" rows="2" placeholder="Sentence 1&#10;Sentence 2" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white"></textarea>
      </div>
      <div>
        <label class="block font-bold text-slate-300 mb-1">Forbidden Words for Taboo (3 words)</label>
        <input id="edit-taboo" type="text" placeholder="Two, Same, Born" class="w-full bg-slate-950 border border-slate-800 rounded p-2 text-white">
      </div>

      <button onclick="addCustomWord()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 rounded-lg shadow transition-all mt-2">➕ Add Word to Live Lesson</button>
    </div>
  </div>

  <!-- SCRIPT & INTERACTIVITY LOGIC -->
  <script>
    // CORE VOCABULARY DATA (Target set: 12 words covering false friends & collocations)
    let vocabularyData = [
      {
        word: "Parents",
        phonetic: "/ˈpeərənts/",
        type: "Noun (plural)",
        definition: "A mother and a father strictly.",
        morphology: "Singular: parent | Plural: parents",
        collocations: "loving parents, single parent, elderly parents",
        examples: [
          "My parents live in a quiet house near the park.",
          "She calls her parents every Sunday evening."
        ],
        taboo: ["Mother", "Father", "Family"],
        category: "immediate"
      },
      {
        word: "Relatives",
        phonetic: "/ˈrelətɪvz/",
        type: "Noun (plural)",
        definition: "People who belong to your broader family (uncles, aunts, cousins, grandparents).",
        morphology: "Singular: relative | Plural: relatives",
        collocations: "close relatives, distant relatives, family relatives",
        examples: [
          "All our relatives gathered for the holiday dinner.",
          "I have distant relatives living in Canada."
        ],
        taboo: ["Aunt", "Uncle", "Cousin"],
        category: "extended"
      },
      {
        word: "Siblings",
        phonetic: "/ˈsɪblɪŋz/",
        type: "Noun (plural)",
        definition: "Brothers and sisters.",
        morphology: "Singular: sibling | Plural: siblings",
        collocations: "older siblings, younger siblings, sibling rivalry",
        examples: [
          "Do you have any siblings or are you an only child?",
          "She gets along very well with her three siblings."
        ],
        taboo: ["Brother", "Sister", "Family"],
        category: "immediate"
      },
      {
        word: "Cousin",
        phonetic: "/ˈkʌzən/",
        type: "Noun",
        definition: "The child of your aunt or uncle.",
        morphology: "Singular: cousin | Plural: cousins",
        collocations: "first cousin, close cousin, distant cousin",
        examples: [
          "My cousin and I played together every summer.",
          "She spent the weekend visiting her cousins."
        ],
        taboo: ["Aunt", "Uncle", "Relative"],
        category: "extended"
      },
