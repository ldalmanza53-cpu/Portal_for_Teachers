      const examples = document.getElementById('edit-examples').value.trim().split('\n');
      const taboo = document.getElementById('edit-taboo').value.trim().split(',');

      if (word && def) {
        vocabularyData.push({
          word,
          phonetic,
          type: "Custom",
          definition: def,
          morphology: `Base: ${word}`,
          collocations: collocations || word,
          examples: examples.length ? examples : [`Usage example of ${word}.`],
          taboo: taboo.length === 3 ? taboo : ["Word1", "Word2", "Word3"],
          category: "extended"
        });

        updateFlashcardUI();
        initCollocationGame();
        toggleTeacherPanel();
        playAudioTone('correct');

        // Clear input fields
        document.getElementById('edit-word').value = '';
        document.getElementById('edit-phonetic').value = '';
        document.getElementById('edit-def').value = '';
        document.getElementById('edit-collocations').value = '';
        document.getElementById('edit-examples').value = '';
        document.getElementById('edit-taboo').value = '';
      }
    }
  </script>
</body>
</html>
